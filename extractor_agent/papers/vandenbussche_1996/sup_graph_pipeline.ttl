@prefix kg: <http://example.org/kg/vandenbussche_1996/> .
@prefix mkg: <http://example.org/mkg#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kg:vandenbussche_1996 a mkg:Sup ;
    rdfs:label "vandenbussche_1996 · A Steady-State Kinetic Model for Methanol Synthesis and the Water Gas Shift Reaction on a Commercial Cu/ZnO/ $ Al_{2}O_{3} $ Catalyst"@en ;
    mkg:hasMetadata kg:vandenbussche_1996_meta ;
    mkg:includes <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eqp5-5>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eqp5-6>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eqp5-8> .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1> a mkg:Law ;
    rdfs:label "vandenbussche_1996 eq 3.1"@en ;
    mkg:computes <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/var/r_MeOH> ;
    mkg:equationNumber "3.1" ;
    mkg:hasMetadata <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1_meta> ;
    mkg:hasParameter <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/par/K_2_prime>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/par/K_3>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/par/K_4>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/par/K_8>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/par/K_9>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/par/K_H_2>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/par/K_H_2O>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/par/K_star>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/par/k_5a_prime> ;
    mkg:latex "r_{\\mathrm{MeOH}}= \\frac{k^{\\prime}_{\\mathrm{5a}}K^{\\prime}_{2}K_{3}K_{4}K_{\\mathrm{H}_{2}}p_{\\mathrm{CO}_{2}}p_{\\mathrm{H}_{2}}\\left[1-(1/K^{*})\\left(p_{\\mathrm{H}_{2}\\mathrm{O}}p_{\\mathrm{CH}_{3}\\mathrm{OH}}/p_{\\mathrm{H}_{2}}^{3}p_{\\mathrm{CO}_{2}}\\right)\\right]}{(1+(K_{\\mathrm{H}_{2}\\mathrm{O}}/K_{8}K_{9}K_{\\mathrm{H}_{2}})(p_{\\mathrm{H}_{2}\\mathrm{O}}/p_{\\mathrm{H}_{2}})+\\sqrt{K_{\\mathrm{H}_{2}}p_{\\mathrm{H}_{2}}}+K_{\\mathrm{H}_{2}\\mathrm{O}}p_{\\mathrm{H}_{2}\\mathrm{O}})^{3}}" ;
    mkg:uses <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/var/p_CH_3OH>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/var/p_CO_2>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/var/p_H_2>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/var/p_H_2O> .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/par/K_2_prime> a mkg:Parameter ;
    rdfs:label "K_{2}^{\\prime} (vandenbussche_1996 eq 3.1)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Equilibrium constant associated with the carbonate-forming CO₂ adsorption step." ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "Values were determined for the frequency and exponential factors of the parameter groups" ;
    mkg:reason "An equilibrium constant for an elementary reaction is a constant of the kinetic law, not an operating condition." ;
    mkg:status "accepted" ;
    mkg:symbol "K_{2}^{\\prime}" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/par/K_3> a mkg:Parameter ;
    rdfs:label "K_{3} (vandenbussche_1996 eq 3.1)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Equilibrium constant for the conversion of adsorbed carbonate to adsorbed bicarbonate." ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "Values were determined for the frequency and exponential factors of the parameter groups" ;
    mkg:reason "An equilibrium constant for an elementary reaction is a constant of the kinetic law, not an operating condition." ;
    mkg:status "accepted" ;
    mkg:symbol "K_{3}" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/par/K_4> a mkg:Parameter ;
    rdfs:label "K_{4} (vandenbussche_1996 eq 3.1)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Equilibrium constant for the conversion of adsorbed bicarbonate to adsorbed formate." ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "Values were determined for the frequency and exponential factors of the parameter groups" ;
    mkg:reason "An equilibrium constant for an elementary reaction is a constant of the kinetic law, not an operating condition." ;
    mkg:status "accepted" ;
    mkg:symbol "K_{4}" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/par/K_8> a mkg:Parameter ;
    rdfs:label "K_{8} (vandenbussche_1996 eq 3.1)"@en ;
    mkg:basis "stated" ;
    mkg:description "Equilibrium constant for the conversion of adsorbed oxygen and hydrogen to adsorbed hydroxyl." ;
    mkg:dimension "dimensionless" ;
    mkg:reason "It is an equilibrium constant for an elementary reaction step, a property of the kinetic law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{8}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/par/K_9> a mkg:Parameter ;
    rdfs:label "K_{9} (vandenbussche_1996 eq 3.1)"@en ;
    mkg:basis "stated" ;
    mkg:description "Equilibrium constant for the conversion of adsorbed hydroxyl and hydrogen to adsorbed water." ;
    mkg:dimension "dimensionless" ;
    mkg:reason "It is an equilibrium constant for an elementary reaction step, a property of the kinetic law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{9}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/par/K_star> a mkg:Parameter ;
    rdfs:label "K^{*} (vandenbussche_1996 eq 3.1)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Equilibrium constant for the overall hydrogenation of CO₂ to methanol." ;
    mkg:dimension "[length] ** 2 * [time] ** 4 / [mass] ** 2" ;
    mkg:reason "An equilibrium constant for the net methanol-synthesis reaction is a constant of the law, not an operating condition." ;
    mkg:siFactor 1e-10 ;
    mkg:status "accepted" ;
    mkg:symbol "K^{*}" ;
    mkg:unit "1 / bar ** 2" ;
    mkg:unitString "bar^-2" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/var/r_MeOH> a mkg:Variable ;
    rdfs:label "r_{MeOH} (vandenbussche_1996 eq 3.1)"@en ;
    mkg:description "Rate of methanol synthesis." ;
    mkg:dimension "[substance] / [mass] / [time]" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "r_{MeOH}" ;
    mkg:unit "mol / kg / s" ;
    mkg:unitString "mol/kgcat/s" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Computes the net methanol synthesis rate from the reactant and product partial pressures and the kinetic parameter groups." ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "Note that the concentrations of adsorbed bicarbonate, formaldehyde, methoxy, methanol, and hydroxyl species were not taken into account, since their concentration is negligible under reaction conditions (16–18, 28, 31)." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Surface concentrations of the listed adsorbed intermediates are neglected because they are considered negligible under reaction conditions." ],
        [ mkg:reasoned true ;
            mkg:severity "warning" ;
            mkg:text "Fugacity corrections are neglected and partial pressures are used because the reported compressibility factors make the changes negligible." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/par/K_H_2O> ;
            mkg:slot "inhibition constant" ],
        [ mkg:boundTo <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/par/k_5a_prime> ;
            mkg:slot "rate constant" ],
        [ mkg:boundTo <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/var/p_H_2O> ;
            mkg:slot "product" ],
        [ mkg:boundTo <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/var/p_H_2> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/var/p_H_2O> ;
            mkg:slot "inhibitor" ],
        [ mkg:boundTo <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/var/p_CO_2> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/par/K_H_2> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/var/p_CH_3OH> ;
            mkg:slot "product" ] ;
    mkg:page "6" ;
    mkg:quote "r_{\\mathrm{MeOH}}= \\frac{k^{\\prime}_{\\mathrm{5a}}K^{\\prime}_{2}K_{3}K_{4}K_{\\mathrm{H}_{2}}p_{\\mathrm{CO}_{2}}p_{\\mathrm{H}_{2}}\\left[1-(1/K^{*})\\left(p_{\\mathrm{H}_{2}\\mathrm{O}}p_{\\mathrm{CH}_{3}\\mathrm{OH}}/p_{\\mathrm{H}_{2}}^{3}p_{\\mathrm{CO}_{2}}\\right)\\right]}{(1+(K_{\\mathrm{H}_{2}\\mathrm{O}}/K_{8}K_{9}K_{\\mathrm{H}_{2}})(p_{\\mathrm{H}_{2}\\mathrm{O}}/p_{\\mathrm{H}_{2}})+\\sqrt{K_{\\mathrm{H}_{2}}p_{\\mathrm{H}_{2}}}+K_{\\mathrm{H}_{2}\\mathrm{O}}p_{\\mathrm{H}_{2}\\mathrm{O}})^{3}}" ;
    mkg:status "pending" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2> a mkg:Law ;
    rdfs:label "vandenbussche_1996 eq 3.2"@en ;
    mkg:computes <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/var/r_RWGS> ;
    mkg:equationNumber "3.2" ;
    mkg:hasMetadata <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2_meta> ;
    mkg:hasParameter <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/par/K_8>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/par/K_9>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/par/K_H_2>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/par/K_H_2O>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/par/k_1_prime> ;
    mkg:latex "r_{\\mathrm{RWGS}}= \\frac{k^{\\prime}_{1}p_{\\mathrm{CO}_{2}}\\left[1-K^{*}_{3}(p_{\\mathrm{H}_{2}\\mathrm{O}}p_{\\mathrm{CO}}/p_{\\mathrm{CO}_{2}}p_{\\mathrm{H}_{2}})\\right]}{(1+(K_{\\mathrm{H}_{2}\\mathrm{O}}/K_{8}K_{9}K_{\\mathrm{H}_{2}})(p_{\\mathrm{H}_{2}\\mathrm{O}}/p_{\\mathrm{H}_{2}})+\\sqrt{K_{\\mathrm{H}_{2}}p_{\\mathrm{H}_{2}}}+K_{\\mathrm{H}_{2}\\mathrm{O}}p_{\\mathrm{H}_{2}\\mathrm{O}})}" ;
    mkg:uses <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/var/K_3_star>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/var/p_CO>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/var/p_CO_2>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/var/p_H_2>,
        <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/var/p_H_2O> .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/par/K_8> a mkg:Parameter ;
    rdfs:label "K_{8} (vandenbussche_1996 eq 3.2)"@en ;
    mkg:basis "stated" ;
    mkg:description "Equilibrium constant for the conversion of adsorbed oxygen and hydrogen to adsorbed hydroxyl." ;
    mkg:dimension "dimensionless" ;
    mkg:reason "It is an equilibrium constant for an elementary reaction step, a property of the kinetic law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{8}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/par/K_9> a mkg:Parameter ;
    rdfs:label "K_{9} (vandenbussche_1996 eq 3.2)"@en ;
    mkg:basis "stated" ;
    mkg:description "Equilibrium constant for the conversion of adsorbed hydroxyl and hydrogen to adsorbed water." ;
    mkg:dimension "dimensionless" ;
    mkg:reason "It is an equilibrium constant for an elementary reaction step, a property of the kinetic law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{9}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/var/K_3_star> a mkg:Variable ;
    rdfs:label "K_{3}^{*} (vandenbussche_1996 eq 3.2)"@en ;
    mkg:description "Equilibrium constant for the water gas shift reaction." ;
    mkg:dimension "dimensionless" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "K_{3}^{*}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/var/r_RWGS> a mkg:Variable ;
    rdfs:label "r_{RWGS} (vandenbussche_1996 eq 3.2)"@en ;
    mkg:description "Rate of the reverse water gas shift reaction." ;
    mkg:dimension "[substance] / [mass] / [time]" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "r_{RWGS}" ;
    mkg:unit "mol / kg / s" ;
    mkg:unitString "mol kgcat^-1 s^-1" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Computes the net reverse water-gas-shift rate from the reactant and product partial pressures and the kinetic parameter groups." ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:reasoned true ;
            mkg:severity "warning" ;
            mkg:text "Fugacity corrections are neglected and partial pressures are used because the reported compressibility factors make the changes negligible." ],
        [ mkg:quote "Note that the concentrations of adsorbed bicarbonate, formaldehyde, methoxy, methanol, and hydroxyl species were not taken into account, since their concentration is negligible under reaction conditions (16–18, 28, 31)." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Surface concentrations of the listed adsorbed intermediates are neglected because they are considered negligible under reaction conditions." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/par/k_1_prime> ;
            mkg:slot "rate constant" ],
        [ mkg:boundTo <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/var/p_H_2> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/var/p_CO_2> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/par/K_H_2O> ;
            mkg:slot "inhibition constant" ],
        [ mkg:boundTo <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/var/p_H_2O> ;
            mkg:slot "product" ],
        [ mkg:boundTo <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/var/p_CO> ;
            mkg:slot "product" ],
        [ mkg:boundTo <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/par/K_H_2> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/var/p_H_2O> ;
            mkg:slot "inhibitor" ] ;
    mkg:page "6" ;
    mkg:quote "r_{\\mathrm{RWGS}}= \\frac{k^{\\prime}_{1}p_{\\mathrm{CO}_{2}}\\left[1-K^{*}_{3}(p_{\\mathrm{H}_{2}\\mathrm{O}}p_{\\mathrm{CO}}/p_{\\mathrm{CO}_{2}}p_{\\mathrm{H}_{2}})\\right]}{(1+(K_{\\mathrm{H}_{2}\\mathrm{O}}/K_{8}K_{9}K_{\\mathrm{H}_{2}})(p_{\\mathrm{H}_{2}\\mathrm{O}}/p_{\\mathrm{H}_{2}})+\\sqrt{K_{\\mathrm{H}_{2}}p_{\\mathrm{H}_{2}}}+K_{\\mathrm{H}_{2}\\mathrm{O}}p_{\\mathrm{H}_{2}\\mathrm{O}})}" ;
    mkg:status "pending" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eqp5-5> a mkg:Law ;
    rdfs:label "vandenbussche_1996 eq p5-5"@en ;
    mkg:computes <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eqp5-5/var/k_1_star> ;
    mkg:equationNumber "p5-5" ;
    mkg:hasMetadata <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eqp5-5_meta> ;
    mkg:latex "\\log_{10}k_{1}^{*}=\\frac{3066}{T}-10.592" ;
    mkg:uses <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eqp5-5/var/T> .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eqp5-5/var/T> a mkg:Variable ;
    rdfs:label "T (vandenbussche_1996 eq p5-5)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Temperature used in the model’s kinetic relations." ;
    mkg:dimension "[temperature]" ;
    mkg:initialQuote "Operating Conditions for the Simulation of the Bench Scale Reactor: T° (K) | -----: 493.2" ;
    mkg:initialValue "493.2 K" ;
    mkg:measured true ;
    mkg:measuredQuote "The temperature profile along the bed was measured by means of eight thermocouples (TC), situated at the central axis of the reactor." ;
    mkg:reason "It is an operating temperature used as a run condition and measured along the reactor bed." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "T" ;
    mkg:unit "K" ;
    mkg:unitString "K" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eqp5-5/var/k_1_star> a mkg:Variable ;
    rdfs:label "k_{1}^{*} (vandenbussche_1996 eq p5-5)"@en ;
    mkg:description "Thermodynamically determined equilibrium constant." ;
    mkg:dimension "[length] ** 2 * [time] ** 4 / [mass] ** 2" ;
    mkg:siFactor 1e-10 ;
    mkg:symbol "k_{1}^{*}" ;
    mkg:unit "1 / bar ** 2" ;
    mkg:unitString "bar^-2" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eqp5-5_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:description "Temperature correlation for the thermodynamically determined equilibrium constant k₁*." ;
    mkg:form "algebraic" ;
    mkg:page "5" ;
    mkg:possibleMisprint "The equation prints lowercase k₁*, whereas the surrounding text identifies this equilibrium constant as uppercase K₁*, suggesting a case misprint." ;
    mkg:quote "\\log_{10}k_{1}^{*}=\\frac{3066}{T}-10.592" ;
    mkg:reviewOutcome "false alarm" ;
    mkg:status "pending" .

