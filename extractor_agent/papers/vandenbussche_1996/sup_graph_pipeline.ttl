<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eqp5-8> a mkg:Law ;
    rdfs:label "vandenbussche_1996 eq p5-8"@en ;
    mkg:computes <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eqp5-8/var/kappa> ;
    mkg:equationNumber "p5-8" ;
    mkg:hasMetadata <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eqp5-8_meta> ;
    mkg:hasParameter <http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eqp5-8/par/A_star>,
