    mkg:valuesByCase "{\"√K_H2 parameter group\": \"30.82\", \"K_H2O parameter group\": \"558.17\", \"K_H2O/(K_8 K_9 K_H2) parameter group\": \"3,453.38\", \"k′_5a K′_2 K_3 parameter group\": \"7,070.34\", \"k′_1 parameter group\": \"1.65\"}" .

