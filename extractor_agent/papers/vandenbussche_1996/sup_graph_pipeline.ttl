<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/var/p_CO_2> a mkg:Variable ;
    rdfs:label "p_{CO_2} (vandenbussche_1996 eq 3.1)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Partial pressure of carbon dioxide." ;
    mkg:dimension "[mass] / [length] / [time] ** 2" ;
    mkg:initialQuote "Operating Conditions for the Simulation of the Bench Scale Reactor" ;
    mkg:initialValue "3.00 mol%" ;
    mkg:reason "A gas-phase partial pressure that varies with feed composition and through the reactor is a process quantity, not a law constant." ;
    mkg:siFactor 1e+05 ;
    mkg:status "accepted" ;
    mkg:symbol "p_{CO_2}" ;
    mkg:unit "bar" ;
    mkg:unitString "bar" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/var/p_H_2> a mkg:Variable ;
    rdfs:label "p_{H_2} (vandenbussche_1996 eq 3.1)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Partial pressure of hydrogen." ;
    mkg:dimension "[mass] / [length] / [time] ** 2" ;
    mkg:initialQuote "Operating Conditions for the Simulation of the Bench Scale Reactor" ;
    mkg:initialValue "82.00 mol%" ;
    mkg:reason "A gas-phase partial pressure set through the feed composition and changing through the reactor is a process quantity, not a law constant." ;
    mkg:siFactor 1e+05 ;
    mkg:status "accepted" ;
    mkg:symbol "p_{H_2}" ;
    mkg:unit "bar" ;
    mkg:unitString "bar" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/par/K_H_2> a mkg:Parameter ;
    rdfs:label "K_{H_2} (vandenbussche_1996 eq 3.2)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Equilibrium constant for dissociative adsorption of hydrogen on two surface sites." ;
    mkg:dimension "[length] * [time] ** 2 / [mass]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "Values were determined for the frequency and exponential factors of the parameter groups" ;
    mkg:reason "An adsorption equilibrium constant is a constant of the kinetic law, not an operating condition." ;
    mkg:siFactor 1e-05 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{H_2}" ;
    mkg:unit "1 / bar" ;
    mkg:unitString "bar^-1" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/par/K_H_2O> a mkg:Parameter ;
    rdfs:label "K_{H_2O} (vandenbussche_1996 eq 3.2)"@en ;
    mkg:basis "stated" ;
    mkg:description "Equilibrium constant for desorption of adsorbed water as gaseous H₂O." ;
    mkg:dimension "[length] * [time] ** 2 / [mass]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "Values were determined for the frequency and exponential factors of the parameter groups" ;
    mkg:reason "It is an equilibrium constant for an adsorption/desorption step, a property of the kinetic law." ;
    mkg:siFactor 1e-05 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{H_2O}" ;
    mkg:unit "1 / bar" ;
    mkg:unitString "bar^-1" ;
    mkg:valueUncertainty "Standard deviation: 10.18 (A*); 3,058 (B)" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/par/k_1_prime> a mkg:Parameter ;
    rdfs:label "k_{1}^{\\prime} (vandenbussche_1996 eq 3.2)"@en ;
    mkg:basis "stated" ;
    mkg:description "Effective rate constant for the rate-determining reverse water gas shift step." ;
    mkg:dimension "[substance] * [time] * [length] / [mass] ** 2" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "Values were determined for the frequency and exponential factors of the parameter groups" ;
    mkg:reason "It is a rate constant of the kinetic law, not a run condition." ;
    mkg:siFactor 1e-05 ;
    mkg:status "accepted" ;
    mkg:symbol "k_{1}^{\\prime}" ;
    mkg:unit "mol / bar / kg / s" ;
    mkg:unitString "mol kgcat^-1 s^-1 bar^-1" ;
    mkg:valueUncertainty "Standard deviation: 0.02 (A*); 1,694 (B)" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/var/p_CO> a mkg:Variable ;
    rdfs:label "p_{CO} (vandenbussche_1996 eq 3.2)"@en ;
    mkg:basis "stated" ;
    mkg:description "Partial pressure of carbon monoxide in the reacting gas." ;
    mkg:dimension "[mass] / [length] / [time] ** 2" ;
    mkg:measured true ;
    mkg:measuredQuote "a gas chromatograph (GC, Packard 438S) determined its composition" ;
    mkg:reason "It is a process-gas partial pressure used as a run-dependent condition in the rate law, rather than a fitted material constant." ;
    mkg:siFactor 1e+05 ;
    mkg:status "accepted" ;
    mkg:symbol "p_{CO}" ;
    mkg:unit "bar" ;
    mkg:unitString "bar" .

