<http://example.org/kg/zentou_2019_monod/law/zentou_2019_eq7_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:correctionQuote "“the mathematical model for the substrate consumption and ethanol production can be expressed as follows:”" ;
    mkg:correctionReason "The printed positive sign makes ethanol decrease as substrate is consumed, so the sign must be negative for the equation to describe ethanol production." ;
    mkg:correctionStatus "accepted" ;
    mkg:description "Ethanol concentration change is computed from the substrate concentration change using the product-specific yield coefficient." ;
    mkg:doi "10.3390/biom9080308" ;
    mkg:form "ODE" ;
    mkg:page "4" ;
    mkg:possibleMisprint "The positive sign in the product-production equation is inconsistent with substrate consumption: because ds/dt is negative as substrate is consumed, it makes dP/dt negative rather than indicating ethanol production." ;
    mkg:quote "\\frac{dP}{dt}=Y_{p/s}\\frac{ds}{dt}" ;
    mkg:reviewOutcome "paper misprint" ;
    mkg:status "pending" .

<http://example.org/kg/zentou_2019_monod/zentou_2019_monod_meta> a mkg:Metadata ;
    mkg:completeModel true ;
    mkg:description "The model represents batch alcoholic fermentation of molasses by Saccharomyces cerevisiae and predicts biomass, sugar substrate, and ethanol concentrations over time. It is a compact dynamic concentration model in which substrate-dependent Monod growth is linked to substrate consumption and ethanol production through yield coefficients. Fermentation was run in a stirred, 1-L-capacity bioreactor with 250 mL of medium, initially micro-aerated and then operated anaerobically. The authors estimated the Monod growth parameters from batch data at low initial sugar concentrations and compared simulated predictions with separate experiments at initial concentrations of 75, 150, and 225 g/L. The model fit best at low substrate concentration and became less accurate at high concentration, where it does not represent substrate inhibition. The authors present it as a practical model for predicting and supporting the optimization and control of molasses fermentation under a suitable, specific range of conditions." ;
    mkg:doi "10.3390/biom9080308" ;
    mkg:form "DAE" ;
    mkg:hasFact [ mkg:basis "stated" ;
            mkg:quote "In order to simplify the calculations, the concentration of other sugars (Fructose and sucrose) was converted into the equivalent concentration of glucose." ;
            mkg:text "Fructose and sucrose concentrations were converted to glucose-equivalent concentrations for the calculations." ;
            mkg:topic "system" ],
        [ mkg:basis "stated" ;
            mkg:quote "a key limitation of R2 is that this statistic cannot determine whether the parameter estimates and predictions are biased, which is why the residual plots must be assessed." ;
            mkg:text "The paper cautions that R² does not establish whether predictions or parameter estimates are biased and says residual plots should also be assessed." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The Monod model showed a good agreement with the experimental data at a low concentration where the maximum R2 values for the biomass, substrate, and ethanol concentrations were achieved at S0 = 50 g.L−1." ;
            mkg:text "The paper gives conflicting locations for the Monod model’s best low-concentration fit: its abstract reports 75 g/L, while the Results discussion says 50 g/L despite listing validation runs at 75, 150, and 225 g/L." ;
            mkg:topic "performance" ],
        [ mkg:basis "stated" ;
            mkg:quote "the classical Monod equation does not consider the inhibitory effect of a high substrate on cell growth." ;
            mkg:text "The Monod model does not include inhibition of cell growth by high substrate concentrations." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "the model presented by Monod (1950) seems to enjoy the widest acceptance model" ;
            mkg:text "The paper identifies Monod (1950) as the widely accepted basic fermentation-growth model on which its Monod formulation is based." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "In the Monod model, an emphasis has been laid to the exponential or logarithmic phase in modelling the microbial cells growth" ;
            mkg:text "The biomass-growth formulation focuses on the exponential or logarithmic growth phase." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "A sample of 5 mL was taken at a predetermined time (0, 2, 4, 6, 8, 10, 12, 18, 24, 30, 36, 48, and 72 h)" ;
            mkg:text "Fermentation samples were collected at 13 times from 0 to 72 h." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "Yeast growth was evaluated by spectrophotometric measurements at 620 nm in Shimadzu UV-1280 spectrophotometer" ;
            mkg:text "Biomass growth was measured by absorbance at 620 nm and calibrated against cell dry weight." ;
            mkg:topic "analytics" ],
        [ mkg:basis "stated" ;
            mkg:quote "Anaerobic fermentation was carried out in a batch bioreactor with a 1-L volume containing 250 mL of culture media" ;
            mkg:text "Fermentation was carried out in a 1-L-capacity batch bioreactor containing 250 mL of culture medium." ;
            mkg:topic "equipment" ],
        [ mkg:basis "stated" ;
            mkg:quote "Initial Substrate Concentration (g.L−1): 5" ;
            mkg:text "The Monod experiments used initial substrate concentrations of 5, 10, 15, 20, and 25 g/L." ;
            mkg:topic "feeding" ],
        [ mkg:basis "stated" ;
            mkg:quote "A sample of 5 mL was taken" ;
            mkg:text "Each fermentation sample was 5 mL." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "the pH value was adjusted at pH = 4.5 by the automatic addition of 0.1 M NaOH and the stirring speed was maintained at 250 rpm. The fermentation temperature was kept at 30 °C using a water jacket." ;
            mkg:text "The fermentation was held at pH 4.5 and 30 °C with stirring at 250 rpm." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The current study aims at developing and validating the Monod and Andrews mathematical models for predicting the dynamics of biomass, substrate, and ethanol" ;
            mkg:text "The model predicts three state concentrations: biomass, growth-limiting substrate, and ethanol." ;
            mkg:topic "states" ],
        [ mkg:basis "inferred" ;
            mkg:text "The formulation is a dynamic, spatially lumped concentration model and can be considered unstructured because it tracks bulk biomass rather than intracellular components." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "The Monod equation describes the dependence of a microorganism's growth rate on the concentration of a limiting substrate" ;
            mkg:text "The Monod law represents growth as substrate-limited, with the specific growth rate approaching a maximum as substrate concentration increases." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "No significant change in both yield coefficients was noted in this range" ;
            mkg:text "The paper says the Monod yield coefficients did not change significantly across the 5–25 g/L range, but its prose and table give inconsistent average values." ;
            mkg:topic "yields" ],
        [ mkg:basis "stated" ;
            mkg:quote "The models were solved and simulated by using the fourth-order Runge–Kutta method ODE 45 with the MATLAB R2014a software (Version 8.3)." ;
            mkg:text "The simulations used MATLAB R2014a and the paper describes solving the models with a fourth-order Runge–Kutta method, ODE 45." ;
            mkg:topic "validation" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper does not report uncertainty intervals for the Monod growth-parameter estimates." ;
            mkg:topic "estimation" ],
        [ mkg:basis "inferred" ;
            mkg:text "As specified by the model formulation, it has three dynamic balances, one algebraic growth-rate relation, and four parameters: two growth-kinetic parameters and two yield coefficients." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "predicting the dynamics of biomass, substrate, and ethanol for the batch fermentation of molasses using Saccharomyces cerevisiae" ;
            mkg:text "The model describes batch alcoholic fermentation of molasses for bioethanol production by Saccharomyces cerevisiae." ;
            mkg:topic "system" ],
        [ mkg:basis "stated" ;
            mkg:quote "The fermentation medium was incubated at 35 °C besides shaking with 250 rpm for 6 h under aerobic conditions." ;
            mkg:text "The inoculum was prepared by incubating yeast in diluted molasses medium with ammonium sulphate and ammonium phosphate for 6 h at 35 °C and 250 rpm under aerobic conditions." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "μmax was 0.179 h−1, which is half of the value reported by Raposo et al. [23] for molasses fermentation, whereas Ks was almost double as compared to the same study" ;
            mkg:text "The paper contrasts its Monod estimates with Raposo et al. (2009), reporting a lower maximum specific growth rate and a higher half-velocity constant than that study." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "The μ values were used to evaluate μmax and Ks by Lineweaver–Burk plots derived from Equation (3)." ;
            mkg:text "The Monod growth parameters were obtained from specific growth rate data using Lineweaver–Burk plots." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "the highest R squared was observed at S0 = 75 g.L−1 with an R squared equal to 0.99956, 0.99954, and 0.99859 for the biomass, substrate, and product concentrations, respectively." ;
            mkg:text "At 75 g/L initial substrate, the paper reports R² values of 0.99956 for biomass, 0.99954 for substrate, and 0.99859 for product." ;
            mkg:topic "performance" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper does not state that its model code or experimental dataset is publicly available." ;
            mkg:topic "availability" ],
        [ mkg:basis "stated" ;
            mkg:quote "The viable cell concentrations both in the carriers and the broth were determined and used for μ determination using Equation (2)." ;
            mkg:text "The paper states that viable-cell concentrations in carriers and broth were used to determine the specific growth rate, although the described batch setup does not otherwise specify carriers." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The low accuracy of the Monod model in a high substrate concentration is due to the fact that the classical Monod equation does not consider the inhibitory effect of a high substrate on cell growth." ;
            mkg:text "The paper concludes that the Monod model is more suitable at low initial substrate concentration, whereas its accuracy decreases at high concentration because it omits substrate inhibition." ;
            mkg:topic "performance" ],
        [ mkg:basis "stated" ;
            mkg:quote "A mathematical model which predicts, simulates, and controls the alcoholic fermentation development would be a valuable technical tool to promote the bioethanol industry" ;
            mkg:text "The authors propose the model as a technical tool for predicting, simulating, and controlling alcoholic fermentation to support the bioethanol industry." ;
            mkg:topic "use" ],
        [ mkg:basis "stated" ;
            mkg:quote "which were too close to the values reported in previous studies [17,18] using sweet sorghum leaves and oil palm jus." ;
            mkg:text "The paper says its Monod kinetic estimates were close to those reported by Rorke and Gueguim Kana (2017) and Srimachai et al. (2015) for other feedstocks." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "The values of substrate concentration used for the validation of the models are different from the concentrations which were used for the modelling" ;
            mkg:text "The validation experiments used initial substrate concentrations of 75, 150, and 225 g/L, which differed from the Monod parameter-estimation range." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "R2 biomass = 0.99956, R2 substrate = 0.99954, and R2 product = 0.99859 to R2 biomass = 0.92462, R2 substrate = 0.921547, and R2 product = 0.916246 for an increase in the initial substrate concentration from 75 to 225 g.L−1." ;
            mkg:text "At 225 g/L initial substrate, the paper reports R² values of 0.92462 for biomass, 0.921547 for substrate, and 0.916246 for product for the Monod model." ;
            mkg:topic "performance" ],
        [ mkg:basis "stated" ;
            mkg:quote "The fermentation was carried out under micro-aeration conditions (1 vvm) for 2 h and turned later to anaerobic during the rest time of fermentation." ;
            mkg:text "The batch was micro-aerated at 1 vvm for 2 h and then kept anaerobic for the remainder of fermentation." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "where Yx/s and Yp/s are the substrate- and product-specific yield coefficients, respectively." ;
            mkg:text "Substrate consumption and ethanol formation are linked to biomass growth through substrate- and product-specific yield coefficients." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "All the used chemicals and materials were sterilized in an autoclave at 121 °C for 20 min before the experiment." ;
            mkg:text "The chemicals and materials used were autoclaved at 121 °C for 20 min." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Yeast was added to the prepared fermentation medium with a concentration of 1 g.L−1 (calculated as fresh baker's yeast)." ;
            mkg:text "Fresh baker’s yeast was added at 1 g/L." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "different initial sugar concentrations (equivalent 5–25 g.L−1 glucose for the Monod model" ;
            mkg:text "The initial sugar range used for Monod parameter estimation was 5–25 g/L glucose-equivalent." ;
            mkg:topic "feeding" ],
        [ mkg:basis "stated" ;
            mkg:quote "Three loops of active dry Saccharomyces cerevisiae yeast from Saf-Levure (Lesaffre, Marcq, France)" ;
            mkg:text "The yeast was active dry Saccharomyces cerevisiae from Saf-Levure." ;
            mkg:topic "system" ],
