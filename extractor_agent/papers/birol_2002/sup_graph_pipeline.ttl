    mkg:latex "\\begin{aligned}\\frac{\\mathrm{d}C_{\\mathrm{L}}}{\\mathrm{d}t}=&-\\frac{\\mu}{Y_{\\mathrm{x/o}}}\\ X-\\frac{\\mu_{\\mathrm{pp}}}{Y_{\\mathrm{p/o}}}\\ X-m_{\\mathrm{o}}X+K_{\\mathrm{la}}(C_{\\mathrm{L}}^{*}-C_{\\mathrm{L}})-\\frac{C_{\\mathrm{L}}}{V}\\\\&\\times\\frac{\\mathrm{d}V}{\\mathrm{d}t}\\tag{12}\\end{aligned}" ;
