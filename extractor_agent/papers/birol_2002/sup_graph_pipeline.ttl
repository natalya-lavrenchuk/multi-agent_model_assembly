    mkg:description "Carbon-dioxide evolution rate from growth, penicillin biosynthesis, and maintenance requirements." ;
    mkg:doi "10.1016/S0098-1354(02)00127-8" ;
    mkg:form "ODE" ;
    mkg:page "7" ;
    mkg:quote "\\frac{\\mathrm{d}\\mathrm{CO}_{2}}{\\mathrm{~d}t}=\\alpha_{1}\\frac{\\mathrm{d}X}{\\mathrm{d}t}+\\alpha_{2}X+\\alpha_{3}" ;
    mkg:status "pending" .

<http://example.org/kg/birol_2002/law/birol_2002_eq1_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The biomass concentration balance accounts for specific growth and loss by culture-volume expansion." ;
    mkg:doi "10.1016/S0098-1354(02)00127-8" ;
    mkg:form "ODE" ;
    mkg:page "3" ;
    mkg:quote "\\frac{\\mathrm{d}X}{\\mathrm{d}t}=\\mu X-\\frac{X}{V}\\frac{\\mathrm{d}V}{\\mathrm{d}t}" ;
    mkg:status "pending" .

<http://example.org/kg/birol_2002/law/birol_2002_eq3> a mkg:Law ;
    rdfs:label "birol_2002 eq 3"@en ;
    mkg:computes <http://example.org/kg/birol_2002/law/birol_2002_eq3/var/mu> ;
    mkg:equationNumber "3" ;
    mkg:hasMetadata <http://example.org/kg/birol_2002/law/birol_2002_eq3_meta> ;
    mkg:hasParameter <http://example.org/kg/birol_2002/law/birol_2002_eq3/par/E_d>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq3/par/E_g>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq3/par/K_1>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq3/par/K_2>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq3/par/K_ox>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq3/par/K_x>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq3/par/R>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq3/par/k_d>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq3/par/k_g>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq3/par/mu_x> ;
    mkg:latex "\\begin{aligned}\\mu&=\\left[\\frac{\\mu_{\\mathrm{x}}}{1+{[K_{1}/[\\mathrm{H}^{+}]]}+[[[\\mathrm{H}^{+}]]/K_{2}]}\\right]\\frac{S}{K_{\\mathrm{x}}X+S}\\\\&\\quad\\times\\frac{C_{\\mathrm{L}}}{K_{\\mathrm{ox}}X+C_{\\mathrm{L}}}\\\\&\\left[k_{\\mathrm{g}}\\exp\\left(-\\frac{E_{\\mathrm{g}}}{\\mathrm{RT}}\\right)\\right]-\\left[k_{\\mathrm{d}}\\exp\\left(-\\frac{E_{\\mathrm{d}}}{\\mathrm{RT}}\\right)\\right].\\end{aligned}" ;
    mkg:uses <http://example.org/kg/birol_2002/law/birol_2002_eq3/var/C_H>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq3/var/C_L>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq3/var/S>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq3/var/T>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq3/var/X> .

<http://example.org/kg/birol_2002/law/birol_2002_eq3/par/E_d> a mkg:Parameter ;
    rdfs:label "E_{d} (birol_2002 eq 3)"@en ;
    mkg:basis "stated" ;
    mkg:description "activation energy for cell death" ;
    mkg:dimension "[mass] * [length] ** 2 / [time] ** 2 / [substance]" ;
    mkg:estimation "from literature" ;
    mkg:estimationQuote "Typical values for these parameters were taken from the literature (Shuler & Kargi, 2002)." ;
    mkg:page "4" ;
    mkg:quote "$ E_d $ are the constant and activation energy for death" ;
    mkg:reason "It is an activation energy in the cell-death Arrhenius law, so it is a parameter." ;
    mkg:siFactor 4.184e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "E_{d}" ;
    mkg:unit "cal / mol" ;
    mkg:unitString "cal/mol" ;
    mkg:value 50000 .

<http://example.org/kg/birol_2002/law/birol_2002_eq3/par/E_g> a mkg:Parameter ;
    rdfs:label "E_{g} (birol_2002 eq 3)"@en ;
    mkg:basis "stated" ;
    mkg:description "activation energy for growth" ;
    mkg:dimension "[mass] * [length] ** 2 / [time] ** 2 / [substance]" ;
    mkg:estimation "from literature" ;
    mkg:estimationQuote "Typical values for these parameters were taken from the literature (Shuler & Kargi, 2002)." ;
    mkg:page "4" ;
    mkg:quote "$ E_g $ are the constant and activation energy for growth" ;
    mkg:reason "It is an activation energy in the growth Arrhenius law, so it is a parameter." ;
    mkg:siFactor 4.184e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "E_{g}" ;
    mkg:unit "cal / mol" ;
    mkg:unitString "cal/mol" ;
    mkg:value 5100 .

<http://example.org/kg/birol_2002/law/birol_2002_eq3/par/R> a mkg:Parameter ;
    rdfs:label "R (birol_2002 eq 3)"@en ;
    mkg:basis "inferred" ;
    mkg:description "universal gas constant in the Arrhenius terms" ;
    mkg:dimension "[mass] * [length] ** 2 / [time] ** 2 / [substance] / [temperature]" ;
    mkg:reason "It is a universal constant in the Arrhenius terms, so it is a parameter." ;
    mkg:siFactor 4.184e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "R" ;
    mkg:unit "cal / K / mol" ;
    mkg:unitString "cal mol^-1 K^-1" .

