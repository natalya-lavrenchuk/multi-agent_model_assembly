<http://example.org/kg/birol_2002/law/birol_2002_eq16_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Total reaction-heat generation rate from biomass growth and biomass-dependent maintenance." ;
    mkg:doi "10.1016/S0098-1354(02)00127-8" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "where $ r_{q_1} $ is assumed to be constant" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The growth-associated heat-generation coefficient is assumed constant." ],
        [ mkg:quote "Because the heat generation and $ CO_2 $ evolution show similar profiles, their production rate due to growth (dX/dt) and biomass (X) should have the same ratio as a first approximation." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The growth-associated and biomass-dependent heat-generation terms are taken to have the same ratio as a first approximation, based on the similarity of heat-generation and CO₂ profiles." ],
        [ mkg:quote "Neglecting all other sources of heat generation except that caused by microbial reactions" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Heat generation from sources other than microbial reactions is neglected." ] ;
    mkg:page "7" ;
    mkg:quote "\\frac{\\mathrm{d}Q_{\\mathrm{rxn}}}{\\mathrm{d}t}=r_{q_{1}}\\frac{\\mathrm{d}X}{\\mathrm{d}t}\\ V+r_{q_{2}}\\ X V" ;
    mkg:status "pending" .

<http://example.org/kg/birol_2002/law/birol_2002_eq17> a mkg:Law ;
    rdfs:label "birol_2002 eq 17"@en ;
    mkg:computes <http://example.org/kg/birol_2002/law/birol_2002_eq17/var/T> ;
    mkg:equationNumber "17" ;
    mkg:hasMetadata <http://example.org/kg/birol_2002/law/birol_2002_eq17_meta> ;
    mkg:hasParameter <http://example.org/kg/birol_2002/law/birol_2002_eq17/par/a>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq17/par/b>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq17/par/c_p>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq17/par/c_pc>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq17/par/rho>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq17/par/rho_c> ;
    mkg:latex "\\begin{aligned}\\frac{\\mathrm{d}T}{\\mathrm{d}t}=&\\frac{F}{s_{\\mathrm{f}}}(T_{\\mathrm{f}}-T)+\\frac{1}{V\\rho c_{\\mathrm{p}}}\\\\&\\times\\left[Q_{\\mathrm{rxn}}-\\frac{a F_{\\mathrm{c}}^{b+1}}{F_{\\mathrm{c}}+(a F_{\\mathrm{c}}^{b}/2\\rho_{\\mathrm{c}}c_{\\mathrm{pc}})}\\right]\\end{aligned}" ;
    mkg:latexCorrected "$$ \\begin{aligned}\\frac{\\mathrm{d}T}{\\mathrm{d}t}=&\\frac{F}{V}(T_{\\mathrm{f}}-T)+\\frac{1}{V\\rho c_{\\mathrm{p}}}\\\\&\\times\\left[Q_{\\mathrm{rxn}}-\\frac{a F_{\\mathrm{c}}^{b+1}}{F_{\\mathrm{c}}+(a F_{\\mathrm{c}}^{b}/2\\rho_{\\mathrm{c}}c_{\\mathrm{pc}})}\\right]\\end{aligned} $$" ;
    mkg:uses <http://example.org/kg/birol_2002/law/birol_2002_eq17/var/F>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq17/var/F_c>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq17/var/Q_rxn>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq17/var/T_f>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq17/var/V>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq17/var/s_f> .

