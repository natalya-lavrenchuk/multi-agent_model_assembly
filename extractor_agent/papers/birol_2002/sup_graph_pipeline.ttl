<http://example.org/kg/birol_2002/law/birol_2002_eq13/par/alpha> a mkg:Parameter ;
    rdfs:label "\\alpha (birol_2002 eq 13)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Constant in the K_{la} relation." ;
    mkg:estimation "set" ;
    mkg:estimationQuote "The values of $ \\alpha $ and $ \\beta $ are assigned so that the dependence of penicillin concentration on $ K_{la} $ showed a very similar behavior to the predictions of Bajpai and Reuss (1980)." ;
    mkg:page "4" ;
    mkg:quote "Constants in $ K_{la} $: $ \\alpha $, $ \\beta $" ;
    mkg:reason "It is a proportionality constant in the K_{la} law." ;
    mkg:status "accepted" ;
    mkg:symbol "\\alpha" ;
    mkg:value 70 .

