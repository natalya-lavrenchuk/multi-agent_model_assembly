    mkg:latex "\\frac{\\mathrm{d}Q_{\\mathrm{rxn}}}{\\mathrm{d}t}=r_{q_{1}}\\frac{\\mathrm{d}X}{\\mathrm{d}t}\\ V+r_{q_{2}}\\ X V" ;
