<http://example.org/kg/birol_2002/law/birol_2002_eq17_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:correctionReason "The printed factor \\(F/s_{\\mathrm{f}}\\) is not a dilution rate: Table 2 gives \\(F\\) in l/h and \\(s_{\\mathrm{f}}\\) in g/l, whereas dividing by culture volume \\(V\\) in l gives the required inverse-time factor." ;
    mkg:correctionStatus "accepted" ;
    mkg:description "Culture-temperature balance accounting for feed-temperature effects, reaction heat, and heat exchange with cooling liquid." ;
    mkg:doi "10.1016/S0098-1354(02)00127-8" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "A lab-scale fermentor was assumed in deciding to use a cooling coil, building the model, and developing the related equations." ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The energy-balance model assumes a lab-scale fermentor with a cooling coil." ] ;
    mkg:page "7" ;
    mkg:possibleMisprint "The feed-temperature term uses F/s_f, but s_f is a feed concentration (g/l), so this factor is dimensionally inconsistent as a dilution rate and likely should be F/V." ;
    mkg:quote "\\begin{aligned}\\frac{\\mathrm{d}T}{\\mathrm{d}t}=&\\frac{F}{s_{\\mathrm{f}}}(T_{\\mathrm{f}}-T)+\\frac{1}{V\\rho c_{\\mathrm{p}}}\\\\&\\times\\left[Q_{\\mathrm{rxn}}-\\frac{a F_{\\mathrm{c}}^{b+1}}{F_{\\mathrm{c}}+(a F_{\\mathrm{c}}^{b}/2\\rho_{\\mathrm{c}}c_{\\mathrm{pc}})}\\right]\\end{aligned}" ;
    mkg:reviewOutcome "paper misprint" ;
    mkg:status "pending" .

