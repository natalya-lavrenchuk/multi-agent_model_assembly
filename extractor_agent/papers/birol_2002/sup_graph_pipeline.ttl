<http://example.org/kg/birol_2002/law/birol_2002_eq15_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:correctionQuote "“We have assumed that the evaporation rate will tend to infinity at the boiling point, and for engineering purposes the exponent 5 is large enough to represent this.”" ;
    mkg:correctionReason "The printed form lacks brackets around the denominator; it should be (T - T0)/(Tv - T0). At the boiling point the exponent is then 5, which the paper says is 'large enough' to stand in for an infinite rate. A (Tv - T) denominator would diverge for real and make that sentence unnecessary." ;
    mkg:correctionStatus "accepted" ;
    mkg:description "Evaporative loss flow rate as a function of culture volume and temperature." ;
    mkg:doi "10.1016/S0098-1354(02)00127-8" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "where $ T_0 $ and $ T_v $ are the freezing and boiling temperatures of the culture medium that were assumed to have the same properties as water, respectively." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The culture medium's freezing and boiling temperatures are taken to be those of water." ],
        [ mkg:reasoned true ;
            mkg:severity "warning" ;
            mkg:text "The evaporative-loss expression is treated as a heuristic rather than as an experimentally based relationship." ],
        [ mkg:quote "We have assumed that the evaporation rate will tend to infinity at the boiling point, and for engineering purposes the exponent 5 is large enough to represent this." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The evaporation rate is assumed to tend to infinity at the boiling point, represented using an exponent of 5." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq15/par/lambda> ;
            mkg:slot "evaporation coefficient" ],
        [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq15/var/F_loss> ;
            mkg:slot "flux" ] ;
    mkg:page "6" ;
    mkg:possibleMisprint "The exponent is printed with T_v-T_0 outside the denominator, making it dimensionally inconsistent and not singular at T=T_v; the stated boiling-point behavior requires (T_v-T_0) as the denominator." ;
    mkg:quote "F_{\\mathrm{l o s s}}=V\\lambda(\\mathrm{e}^{5((T-T_{0})/T_{\\mathrm{v}}-T_{0})}-1)" ;
    mkg:reviewOutcome "paper misprint" ;
    mkg:status "pending" .

<http://example.org/kg/birol_2002/law/birol_2002_eq16> a mkg:Law ;
    rdfs:label "birol_2002 eq 16"@en ;
