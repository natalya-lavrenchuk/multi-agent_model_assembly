@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kg:birol_2002 a mkg:Sup ;
    rdfs:label "birol_2002 · Birol et al. (2002) Penicillin production in a fed-batch fermentor (extended Bajpai and Reuss model)"@en ;
    mkg:hasMetadata kg:birol_2002_meta ;
    mkg:includes <http://example.org/kg/birol_2002/law/birol_2002_eq1>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq10>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq11>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq12>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq13>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq14>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq15>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq16>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq17>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq18>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq3>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq9> .

kg:birol_2002_meta a mkg:Metadata ;
    mkg:description "The model represents penicillin production by a glucose-fed culture in a batch-to-fed-batch fermentor, using a detailed unstructured mechanistic description. It predicts biomass, penicillin, glucose, dissolved oxygen, culture volume, temperature, heat generation and carbon dioxide, while accounting for pH and operating inputs such as aeration, agitation and feed. It combines substrate- and oxygen-dependent growth, pH and temperature effects, non-growth-associated penicillin formation and hydrolysis, material and energy balances, gas transfer, and pH and temperature control. The simulated run begins in batch mode and switches to fed-batch when glucose reaches a threshold; pH and temperature are controlled while glucose feeding is open loop. The authors compare its predictions with published fermentation results and simulations, and provide the simulator as a testbed for process monitoring, fault diagnosis, modeling, optimization and control." ;
    mkg:doi "10.1016/S0098-1354(02)00127-8" ;
    mkg:form "DAE" ;
    mkg:hasFact [ mkg:basis "stated" ;
            mkg:quote "In this study, we have used experimental data available in literature (Pirt & Righoletto, 1967; Metz, Bruijin & van Suijdam, 1981) to improve the simulation of penicillin production by extending the existing mathematical models." ;
            mkg:text "The authors say they used published experimental data from Pirt and Righoletto (1967) and Metz et al. (1981) to improve the simulation." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "pH and temperature are controlled via PID controllers at 5.0 and 25 °C, respectively." ;
            mkg:text "The nominal pH and temperature set points are 5.0 and 25 °C." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Simulations are run under closed-loop control of pH and temperature while glucose addition is performed open-loop." ;
            mkg:text "The simulator runs with pH and temperature under closed-loop control and glucose addition open loop." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "In order to consider the effect of acid/base addition on the total volume change of the culture broth, we have included the second term, F_a/b. We have also included the F_loss term to account for evaporative loss during fermentation." ;
            mkg:text "The culture-volume balance accounts for feed, acid or base addition, and evaporative loss." ;
            mkg:topic "volume" ],
        [ mkg:basis "stated" ;
            mkg:quote "The predictions of the model under different conditions are compared with experimental data of Pirt and Righoletto (1967) and the simulation results of Bajpai and Reuss (1980)." ;
            mkg:text "The authors compared predictions under different conditions with Pirt and Righoletto (1967) experimental data and Bajpai and Reuss (1980) simulation results." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The additional terms that were introduced increased the stiffness of the ordinary differential equations. For that reason, some of the parameter values are readjusted." ;
            mkg:text "The authors took typical temperature-kinetic parameter values from the literature and readjusted some parameter values after adding terms that increased ODE stiffness." ;
            mkg:topic "parameters" ],
        [ mkg:basis "stated" ;
            mkg:quote "For industrial scale fermentors, the heat transfer mechanism should be modified to a jacketed fermentor with baffles and appropriate equations must be substituted." ;
            mkg:text "The cooling-coil heat-transfer model is intended for laboratory scale; industrial use would require a jacketed-fermentor model with appropriate equations." ;
            mkg:topic "scope" ],
        [ mkg:basis "stated" ;
            mkg:quote "A summary of the faults introduced at different stages of fermentation" ;
            mkg:text "The simulator was used to examine a pH-controller shutdown at 10 h, a 95% agitation-power decrease at 30 h, and a 30% substrate-feed decrease at 60 h." ;
            mkg:topic "faults" ],
        [ mkg:basis "stated" ;
            mkg:quote "An adjustment has been made so that an increase in temperature enhanced the biomass formation up to 35 °C." ;
            mkg:text "Temperature effects on growth and cell death are represented with Arrhenius-type kinetics, with biomass formation increasing up to 35 °C before declining." ;
            mkg:topic "growth" ],
        [ mkg:basis "stated" ;
            mkg:quote "The simulator developed for penicillin production is available at http://www.chee.iit.edu/~control/software.html" ;
            mkg:text "The simulation package is made available through the authors' website." ;
            mkg:topic "availability" ],
        [ mkg:basis "stated" ;
            mkg:quote "Under pH control, the hydrogen ion concentration is calculated by taking the dissociation of water and acid/base into account as well as the hydrogen production from biomass." ;
            mkg:text "The model relates hydrogen-ion concentration to biomass formation and uses acid and base additions to represent pH control." ;
            mkg:topic "growth" ],
        [ mkg:basis "stated" ;
            mkg:quote "Two PID controllers are used to manipulate the acid and base control values." ;
            mkg:text "pH control adds concentrated acid or base, with separate PID controllers for the two additions." ;
            mkg:topic "control" ],
        [ mkg:basis "inferred" ;
            mkg:text "Carbon dioxide generation is attributed to growth, penicillin biosynthesis and maintenance." ;
            mkg:topic "transfer" ],
        [ mkg:basis "stated" ;
            mkg:quote "Direct effects of pH and temperature on penicillin production are not considered due to the complex nature of the phenomenon, and unavailability of the experimental data." ;
            mkg:text "The model does not include direct effects of pH or temperature on penicillin production." ;
            mkg:topic "product" ],
        [ mkg:basis "stated" ;
            mkg:quote "Penicillin concentration increased with increasing K_la values, then it levelled off indicating a high degree of dependence of penicillin production on oxygen (Fig. 6)." ;
            mkg:text "Under oxygen limitation defined as oxygen saturation at or below 50%, penicillin concentration increased with the overall mass-transfer coefficient and then leveled off." ;
            mkg:topic "conditions" ],
        [ mkg:basis "stated" ;
            mkg:quote "The dependence of specific growth rate on carbon and oxygen substrates was assumed to follow Contois kinetics (Bajpai & Reuss) to consider the biomass inhibition." ;
            mkg:text "Biomass growth depends on glucose and oxygen and uses Contois kinetics to represent inhibition by biomass." ;
            mkg:topic "growth" ],
        [ mkg:basis "stated" ;
            mkg:quote "The model extends the mechanistic model of Bajpai and Reuss by adding input variables such as pH, temperature, aeration rate, agitation power, and feed flow rate of substrate" ;
            mkg:text "The extensions include pH, temperature, aeration rate, agitation power and substrate feed flow as process inputs." ;
            mkg:topic "inputs" ],
        [ mkg:basis "stated" ;
            mkg:quote "Users are advised to conduct sensitivity studies if the intent is to use large deviations from nominal conditions." ;
            mkg:text "The authors advise sensitivity studies when users intend to make large deviations from nominal conditions." ;
            mkg:topic "scope" ],
        [ mkg:basis "stated" ;
            mkg:quote "Penicillin production showed an increasing trend with an increase in the initial glucose concentration then levelled off." ;
            mkg:text "Simulations tested initial glucose concentrations of 15, 25 and 30 g/L, with penicillin production increasing and then leveling off as initial glucose increased." ;
            mkg:topic "conditions" ],
        [ mkg:basis "stated" ;
            mkg:quote "Since we do not base our F_loss term on experimental findings, this should be treated as a heuristic since as a general tendency, the temperature increase favors evaporative loss." ;
            mkg:text "The evaporation-rate relationship is heuristic rather than experimentally based." ;
            mkg:topic "volume" ],
        [ mkg:basis "stated" ;
            mkg:quote "Substrate inhibition kinetics for penicillin production was originally proposed by Bajpai and Reuss (1980) that successfully represented the observed behavior." ;
            mkg:text "The product-formation rate includes substrate inhibition and oxygen availability." ;
            mkg:topic "product" ],
        [ mkg:basis "stated" ;
            mkg:quote "In unstructured models, all cellular physiology information are gathered into a single biomass term so that there is no explicit structural information left about the cellular activity resulting in a rather simpler model." ;
            mkg:text "The unstructured approach gathers cellular physiology into a single biomass term rather than explicitly representing cell structure." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "Controller type selection; on/off (pH), PID (pH, temperature)." ;
            mkg:text "The simulator offers on/off or PID control for pH and PID control for temperature." ;
            mkg:topic "control" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper reports qualitative profile agreement but gives no numerical fit statistics or prediction-error measures." ;
            mkg:topic "validation" ],
        [ mkg:basis "inferred" ;
            mkg:text "In a simulated batch with a small glucose-feed reduction, the first out-of-control signals occurred at 162.5 h on Hotelling's T² and 152 h on SPE." ;
            mkg:topic "monitoring" ],
        [ mkg:basis "inferred" ;
            mkg:text "For a multivariate monitoring demonstration, the authors generated a historical reference database of 50 simulated batches under normal operation with small random variations." ;
            mkg:topic "monitoring" ],
        [ mkg:basis "stated" ;
            mkg:quote "The simulator mimicked the biomass, penicillin, glucose and oxygen concentrations in a similar fashion to the predictions of Bajpai and Reuss (1980) which were also validated by the experimental results of Pirt and Righoletto (1967)." ;
            mkg:text "The authors report that simulated biomass, penicillin, glucose and oxygen profiles resembled the Bajpai and Reuss predictions, which had been validated against Pirt and Righoletto data." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "A lab-scale fermentor was assumed in deciding to use a cooling coil, building the model, and developing the related equations." ;
            mkg:text "The heat-transfer model assumes a laboratory-scale fermentor with a cooling coil." ;
            mkg:topic "equipment" ],
        [ mkg:basis "stated" ;
            mkg:quote "A detailed unstructured model for penicillin production in a fed-batch fermentor has been developed." ;
            mkg:text "The authors characterize the model as a detailed, unstructured mechanistic model." ;
            mkg:topic "model" ],
        [ mkg:basis "inferred" ;
            mkg:text "The nominal initial culture volume in the parameter table is 100 L." ;
            mkg:topic "equipment" ],
        [ mkg:basis "stated" ;
            mkg:quote "During the product synthesis phase, when the rate of biomass formation becomes very small there is still significant heat generation from metabolic maintenance activities." ;
            mkg:text "The heat-generation model includes contributions from growth and maintenance, and the energy balance represents heat transfer through a cooling coil." ;
            mkg:topic "transfer" ],
        [ mkg:basis "stated" ;
            mkg:quote "This has been done by assigning a threshold value to glucose concentration which was chosen as 0.3 g/l." ;
            mkg:text "Simulations start in batch mode and switch to fed-batch when glucose concentration reaches 0.3 g/L." ;
            mkg:topic "operation" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper does not report a total parameter count, a parameter-estimation method, or parameter uncertainty estimates." ;
            mkg:topic "parameters" ],
        [ mkg:basis "stated" ;
            mkg:quote "The mechanistic model of Bajpai and Reuss (1980), which was shown to give a good agreement with the experimental results of Pirt and Righoletto (1967), was utilized as the starting point for model development." ;
            mkg:text "The model is based on Bajpai and Reuss (1980), whose model had been reported to agree well with the experimental results of Pirt and Righoletto (1967)." ;
            mkg:topic "parameters" ],
        [ mkg:basis "stated" ;
            mkg:quote "In industrial scale fermentations such variables are usually measured off-line via HPLC every 8–10 h." ;
            mkg:text "The paper notes that industrial biomass and penicillin measurements are commonly made off-line by HPLC every 8–10 h." ;
            mkg:topic "measurements" ],
        [ mkg:basis "stated" ;
            mkg:quote "Experimental findings suggest a high degree of dependence of biomass growth on both the carbon source (glucose) and oxygen as substrates (Bajpai & Reuss, 1980)." ;
            mkg:text "The model describes penicillin production in a fermentation process using glucose as a carbon source." ;
            mkg:topic "system" ],
        [ mkg:basis "inferred" ;
            mkg:text "The model tracks eight dynamic states: biomass, penicillin, substrate, dissolved oxygen, culture volume, heat generation, temperature and carbon dioxide." ;
            mkg:topic "states" ],
        [ mkg:basis "stated" ;
            mkg:quote "A detailed fundamental model on penicillin production and its applications based on a morphologically structured model which may be more suitable for such studies, can be found elsewhere (Birol, Undey, Parulekar & Cinar, 2002)." ;
            mkg:text "The authors cite Birol et al. (2002) as a morphologically structured model better suited to studies of strain improvement or fundamental fermentation phenomena." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "for an initial substrate and biomass concentrations of 15 g/l and 0.1 g/l, respectively." ;
            mkg:text "The figure caption reports simulations at initial glucose and biomass concentrations of 15 g/L and 0.1 g/L, respectively." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The production of penicillin is described by non-growth associated product formation kinetics. The hydrolysis of penicillin is also included in the rate expression (Bajpai & Reuss, 1980):" ;
            mkg:text "Penicillin formation is modeled as non-growth-associated, with penicillin hydrolysis also included." ;
            mkg:topic "product" ],
        [ mkg:basis "stated" ;
            mkg:quote "The simulator developed may be used for both research and educational purposes" ;
            mkg:text "The authors present the model and simulator as a testbed for process monitoring, fault diagnosis, empirical modeling, optimization and control, including educational use." ;
            mkg:topic "use" ],
        [ mkg:basis "stated" ;
            mkg:quote "A typical inhibition term that includes hydrogen ion concentration [H+] is introduced into the specific growth rate expression." ;
            mkg:text "The growth-rate expression includes an inhibition effect of hydrogen-ion concentration." ;
            mkg:topic "growth" ],
        [ mkg:basis "stated" ;
            mkg:quote "Here we have assumed K_la to be a function of agitation power input P_w and flow rate of oxygen f_g as suggested by Bailey and Ollis (1986)." ;
            mkg:text "Unlike the original Bajpai and Reuss model, the overall oxygen mass-transfer coefficient varies with agitation power and oxygen flow rate." ;
            mkg:topic "transfer" ],
        [ mkg:basis "stated" ;
            mkg:quote "During the simulation, the sampling time was chosen to be 0.02 h as default." ;
            mkg:text "The default simulation sampling interval is 0.02 h, and the user can change the sampling interval for collecting or plotting results." ;
            mkg:topic "measurements" ],
        [ mkg:basis "stated" ;
            mkg:quote "The utilization of substrate is assumed to be caused by biomass growth and product formation with constant yields and maintenance requirements of the microorganism as suggested by Bajpai and Reuss (1980)." ;
            mkg:text "Glucose and oxygen consumption account for growth, product formation, and microbial maintenance using constant yields and maintenance requirements." ;
            mkg:topic "substrate" ],
        [ mkg:basis "stated" ;
            mkg:quote "In fermentation processes, particularly in penicillin production, parameter values are closely related to medium composition, feed composition and the choice of the strain." ;
            mkg:text "The authors caution that the parameters depend on strain, medium, feed composition and environmental conditions." ;
            mkg:topic "scope" ] ;
    mkg:status "pending" ;
    rdfs:comment "v0 distinct nodes; built from paddle.json (PaddleOCR-VL pipeline) by extractor/graph.py" .

<http://example.org/kg/birol_2002/law/birol_2002_eq1> a mkg:Law ;
    rdfs:label "birol_2002 eq 1"@en ;
    mkg:computes <http://example.org/kg/birol_2002/law/birol_2002_eq1/var/X> ;
    mkg:equationNumber "1" ;
    mkg:hasMetadata <http://example.org/kg/birol_2002/law/birol_2002_eq1_meta> ;
    mkg:latex "\\frac{\\mathrm{d}X}{\\mathrm{d}t}=\\mu X-\\frac{X}{V}\\frac{\\mathrm{d}V}{\\mathrm{d}t}" ;
    mkg:uses <http://example.org/kg/birol_2002/law/birol_2002_eq1/var/V>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq1/var/mu> .

<http://example.org/kg/birol_2002/law/birol_2002_eq1/var/V> a mkg:Variable ;
    rdfs:label "V (birol_2002 eq 1)"@en ;
    mkg:description "culture volume" ;
    mkg:dimension "[length] ** 3" ;
    mkg:siFactor 1e-03 ;
    mkg:symbol "V" ;
    mkg:unit "l" ;
    mkg:unitString "l" .

<http://example.org/kg/birol_2002/law/birol_2002_eq1/var/X> a mkg:Variable ;
    rdfs:label "X (birol_2002 eq 1)"@en ;
    mkg:description "biomass concentration" ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "X" ;
    mkg:unit "g / l" ;
    mkg:unitString "g/l" .

<http://example.org/kg/birol_2002/law/birol_2002_eq1/var/mu> a mkg:Variable ;
    rdfs:label "\\mu (birol_2002 eq 1)"@en ;
    mkg:description "specific growth rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "\\mu" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/birol_2002/law/birol_2002_eq10> a mkg:Law ;
    rdfs:label "birol_2002 eq 10"@en ;
    mkg:computes <http://example.org/kg/birol_2002/law/birol_2002_eq10/var/mu_pp> ;
    mkg:equationNumber "10" ;
    mkg:hasMetadata <http://example.org/kg/birol_2002/law/birol_2002_eq10_meta> ;
    mkg:hasParameter <http://example.org/kg/birol_2002/law/birol_2002_eq10/par/K_I>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq10/par/K_op>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq10/par/K_p>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq10/par/mu_p>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq10/par/p> ;
    mkg:latex "\\mu_{\\mathrm{pp}}=\\mu_{\\mathrm{p}}\\frac{S}{(K_{\\mathrm{p}}+S+S^{2}/K_{\\mathrm{I}})}\\frac{C^{\\mathrm{p}}_{\\mathrm{L}}}{(K_{\\mathrm{op}}X+C^{\\mathrm{p}}_{\\mathrm{L}})}" ;
    mkg:uses <http://example.org/kg/birol_2002/law/birol_2002_eq10/var/C_L>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq10/var/S>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq10/var/X> .

<http://example.org/kg/birol_2002/law/birol_2002_eq10/par/p> a mkg:Parameter ;
    rdfs:label "p (birol_2002 eq 10)"@en ;
    mkg:basis "stated" ;
    mkg:description "Exponent on dissolved oxygen concentration in the oxygen-limitation term" ;
    mkg:dimension "dimensionless" ;
    mkg:reason "It is an exponent in the penicillin production rate law, so it is a constant of that law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "p" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" ;
    mkg:value 3 .

<http://example.org/kg/birol_2002/law/birol_2002_eq10/var/mu_pp> a mkg:Variable ;
    rdfs:label "\\mu_{pp} (birol_2002 eq 10)"@en ;
    mkg:description "specific penicillin production rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "\\mu_{pp}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/birol_2002/law/birol_2002_eq10_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The specific penicillin production rate depends on substrate availability, is inhibited at high substrate concentration, and is limited by oxygen availability." ;
    mkg:doi "10.1016/S0098-1354(02)00127-8" ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq10/var/X> ;
            mkg:slot "biomass" ],
        [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq10/par/mu_p> ;
            mkg:slot "maximum rate" ],
        [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq10/var/C_L> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq10/par/K_I> ;
            mkg:slot "inhibition constant" ],
        [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq10/par/K_op> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq10/par/K_p> ;
            mkg:slot "inhibition constant" ],
        [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq10/var/S> ;
            mkg:slot "substrate" ] ;
    mkg:page "6" ;
    mkg:quote "\\mu_{\\mathrm{pp}}=\\mu_{\\mathrm{p}}\\frac{S}{(K_{\\mathrm{p}}+S+S^{2}/K_{\\mathrm{I}})}\\frac{C^{\\mathrm{p}}_{\\mathrm{L}}}{(K_{\\mathrm{op}}X+C^{\\mathrm{p}}_{\\mathrm{L}})}" ;
    mkg:status "pending" .

<http://example.org/kg/birol_2002/law/birol_2002_eq11> a mkg:Law ;
    rdfs:label "birol_2002 eq 11"@en ;
    mkg:computes <http://example.org/kg/birol_2002/law/birol_2002_eq11/var/S> ;
    mkg:equationNumber "11" ;
    mkg:hasMetadata <http://example.org/kg/birol_2002/law/birol_2002_eq11_meta> ;
    mkg:hasParameter <http://example.org/kg/birol_2002/law/birol_2002_eq11/par/Y_p_s>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq11/par/Y_x_s>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq11/par/m_x> ;
    mkg:latex "\\frac{\\mathrm{d}S}{\\mathrm{d}t}=-\\frac{\\mu}{Y_{\\mathrm{x/s}}}X-\\frac{\\mu_{\\mathrm{pp}}}{Y_{\\mathrm{p/s}}}X-m_{\\mathrm{x}}X+\\frac{Fs_{\\mathrm{f}}}{V}-\\frac{S}{V}\\frac{\\mathrm{d}V}{\\mathrm{d}t}" ;
    mkg:uses <http://example.org/kg/birol_2002/law/birol_2002_eq11/var/F>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq11/var/V>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq11/var/X>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq11/var/mu>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq11/var/mu_pp>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq11/var/s_f> .

<http://example.org/kg/birol_2002/law/birol_2002_eq11/par/Y_p_s> a mkg:Parameter ;
    rdfs:label "Y_{p/s} (birol_2002 eq 11)"@en ;
    mkg:basis "stated" ;
    mkg:description "Yield of penicillin per glucose consumed" ;
    mkg:dimension "dimensionless" ;
    mkg:page "4" ;
    mkg:quote "Yield constant:" ;
    mkg:reason "It is a penicillin yield constant for glucose consumption." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "Y_{p/s}" ;
    mkg:unit "dimensionless" ;
    mkg:unitNote "penicillin glucose" ;
    mkg:unitString "g penicillin/g glucose" ;
    mkg:value 9e-01 .

<http://example.org/kg/birol_2002/law/birol_2002_eq11/par/Y_x_s> a mkg:Parameter ;
    rdfs:label "Y_{x/s} (birol_2002 eq 11)"@en ;
    mkg:basis "stated" ;
    mkg:description "Yield of biomass per glucose consumed" ;
    mkg:dimension "dimensionless" ;
    mkg:page "4" ;
    mkg:quote "Yield constant:" ;
    mkg:reason "It is a biomass yield constant for glucose consumption." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "Y_{x/s}" ;
    mkg:unit "dimensionless" ;
    mkg:unitNote "biomass glucose" ;
    mkg:unitString "g biomass/g glucose" ;
    mkg:value 4.5e-01 .

<http://example.org/kg/birol_2002/law/birol_2002_eq11/par/m_x> a mkg:Parameter ;
    rdfs:label "m_{x} (birol_2002 eq 11)"@en ;
    mkg:basis "stated" ;
    mkg:description "Maintenance coefficient on substrate" ;
    mkg:dimension "1 / [time]" ;
    mkg:page "4" ;
    mkg:quote "Maintenance coefficient on substrate:" ;
    mkg:reason "It is a substrate maintenance coefficient in the model." ;
    mkg:siFactor 2.777778e-04 ;
    mkg:status "accepted" ;
    mkg:symbol "m_{x}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "per h" ;
    mkg:value 1.4e-02 .

