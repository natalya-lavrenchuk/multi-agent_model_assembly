<http://example.org/kg/birol_2002/law/birol_2002_eq3_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The specific growth rate combines Contois-type glucose and oxygen limitation with pH dependence and temperature-dependent growth and death." ;
    mkg:doi "10.1016/S0098-1354(02)00127-8" ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq3/par/K_1> ;
            mkg:slot "inhibition constant" ],
        [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq3/var/X> ;
            mkg:slot "biomass" ],
        [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq3/par/K_2> ;
            mkg:slot "inhibition constant" ],
        [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq3/par/k_d> ;
            mkg:slot "rate constant" ],
        [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq3/var/C_H> ;
            mkg:slot "inhibitor" ],
        [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq3/par/mu_x> ;
            mkg:slot "maximum rate" ],
        [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq3/par/K_x> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq3/par/k_g> ;
            mkg:slot "rate constant" ],
        [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq3/var/S> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq3/par/K_ox> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/birol_2002/law/birol_2002_eq3/var/C_L> ;
            mkg:slot "substrate" ] ;
    mkg:page "3" ;
    mkg:quote "\\begin{aligned}\\mu&=\\left[\\frac{\\mu_{\\mathrm{x}}}{1+{[K_{1}/[\\mathrm{H}^{+}]]}+[[[\\mathrm{H}^{+}]]/K_{2}]}\\right]\\frac{S}{K_{\\mathrm{x}}X+S}\\\\&\\quad\\times\\frac{C_{\\mathrm{L}}}{K_{\\mathrm{ox}}X+C_{\\mathrm{L}}}\\\\&\\left[k_{\\mathrm{g}}\\exp\\left(-\\frac{E_{\\mathrm{g}}}{\\mathrm{RT}}\\right)\\right]-\\left[k_{\\mathrm{d}}\\exp\\left(-\\frac{E_{\\mathrm{d}}}{\\mathrm{RT}}\\right)\\right].\\end{aligned}" ;
    mkg:status "pending" .

<http://example.org/kg/birol_2002/law/birol_2002_eq9> a mkg:Law ;
    rdfs:label "birol_2002 eq 9"@en ;
