    mkg:valuesByCase "{\"no limitation\": \"0 -\", \"with limitation\": \"$ 2 \\\\times 10^{-2} $ -\"}" .

<http://example.org/kg/birol_2002/law/birol_2002_eq3/par/K_x> a mkg:Parameter ;
    rdfs:label "K_{x} (birol_2002 eq 3)"@en ;
    mkg:basis "stated" ;
    mkg:description "Contois saturation constant" ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:page "4" ;
    mkg:quote "Contois saturation constant" ;
    mkg:reason "K_x is the Contois saturation constant in the biomass-growth law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{x}" ;
    mkg:unit "g / l" ;
    mkg:unitString "g/l" ;
    mkg:value 1.5e-01 .

<http://example.org/kg/birol_2002/law/birol_2002_eq3/par/k_d> a mkg:Parameter ;
    rdfs:label "k_{d} (birol_2002 eq 3)"@en ;
    mkg:basis "stated" ;
    mkg:description "Arrhenius constant for cell death" ;
    mkg:dimension "1 / [time]" ;
    mkg:estimation "from literature" ;
    mkg:estimationQuote "Typical values for these parameters were taken from the literature (Shuler & Kargi, 2002)." ;
    mkg:page "4" ;
    mkg:quote "$ k_d $ and  $ E_d $ are the constant and activation energy for death" ;
    mkg:reason "It is a constant in the cell-death Arrhenius law, so it is a parameter." ;
    mkg:siFactor 2.777778e-04 ;
    mkg:status "accepted" ;
    mkg:symbol "k_{d}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" ;
    mkg:value 1e+33 .

<http://example.org/kg/birol_2002/law/birol_2002_eq3/par/k_g> a mkg:Parameter ;
    rdfs:label "k_{g} (birol_2002 eq 3)"@en ;
    mkg:basis "stated" ;
    mkg:description "Arrhenius constant for growth" ;
    mkg:dimension "dimensionless" ;
    mkg:estimation "from literature" ;
    mkg:estimationQuote "Typical values for these parameters were taken from the literature (Shuler & Kargi, 2002)." ;
    mkg:page "4" ;
    mkg:quote "$ k_g $ and  $ E_g $ are the constant and activation energy for growth" ;
    mkg:reason "It is a constant in the growth Arrhenius law, so it is a parameter." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "k_{g}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" ;
    mkg:value 7000 .

<http://example.org/kg/birol_2002/law/birol_2002_eq3/par/mu_x> a mkg:Parameter ;
    rdfs:label "\\mu_{x} (birol_2002 eq 3)"@en ;
    mkg:basis "stated" ;
    mkg:description "maximum specific growth rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:page "4" ;
    mkg:quote "Maximum specific growth rate" ;
    mkg:reason "\\mu_x is the maximum specific growth rate constant in the biomass-growth law." ;
    mkg:siFactor 2.777778e-04 ;
    mkg:status "accepted" ;
    mkg:symbol "\\mu_{x}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "per h" ;
    mkg:value 9.2e-02 .

<http://example.org/kg/birol_2002/law/birol_2002_eq3/var/C_H> a mkg:Variable ;
    rdfs:label "[H^+] (birol_2002 eq 3)"@en ;
    mkg:basis "stated" ;
    mkg:description "hydrogen ion concentration" ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:page "3" ;
    mkg:quote "hydrogen ion concentration" ;
    mkg:reason "The paper treats [H^+] as the culture condition under pH control and gives its initial concentration, rather than as a fitted law constant." ;
    mkg:siFactor 1e+03 ;
    mkg:status "accepted" ;
    mkg:symbol "[H^+]" ;
    mkg:unit "mol / l" ;
    mkg:unitString "mol/l" .

<http://example.org/kg/birol_2002/law/birol_2002_eq3/var/C_L> a mkg:Variable ;
    rdfs:label "C_{L} (birol_2002 eq 3)"@en ;
    mkg:description "dissolved oxygen concentration" ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "C_{L}" ;
    mkg:unit "g / l" ;
    mkg:unitString "g/l" .

<http://example.org/kg/birol_2002/law/birol_2002_eq3/var/S> a mkg:Variable ;
    rdfs:label "S (birol_2002 eq 3)"@en ;
    mkg:description "substrate concentration" ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "S" ;
    mkg:unit "g / l" ;
    mkg:unitString "g/l" .

<http://example.org/kg/birol_2002/law/birol_2002_eq3/var/X> a mkg:Variable ;
    rdfs:label "X (birol_2002 eq 3)"@en ;
    mkg:description "biomass concentration" ;
    mkg:dimension "[mass] / [length] ** 3" ;
