<http://example.org/kg/anane_demo/law/anane_demo_eq18_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:correctionReason "The acetate balance requires the net acetate rate, so replace the printed glucose-uptake term with q_A, which the following equation defines as p_A-q_{sA}." ;
    mkg:correctionStatus "proposed" ;
    mkg:description "Extracellular acetate concentration changes through fed-batch dilution and the net acetate production or uptake rate." ;
    mkg:doi "10.1016/j.bej.2017.05.013" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "considering no addition of acetate in the feed" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "No acetate is added in the feed." ] ;
    mkg:page "4" ;
    mkg:possibleMisprint "The printed term q_s A X is inconsistent with the acetate balance: q_s is glucose uptake, and multiplying it by acetate and biomass concentrations does not give a concentration rate; the term should use the net acetate rate multiplied by X." ;
    mkg:quote "\\frac{d\\boldsymbol{A}}{dt}=\\frac{\\boldsymbol{F}}{V}\\left(\\mathbf{0}-\\boldsymbol{A}\\right)+q_{s}\\boldsymbol{A}\\boldsymbol{X}" ;
    mkg:status "pending" .

<http://example.org/kg/anane_demo/law/anane_demo_eq19> a mkg:Law ;
    rdfs:label "anane_demo eq 19"@en ;
    mkg:computes <http://example.org/kg/anane_demo/law/anane_demo_eq19/var/q_A> ;
    mkg:equationNumber "19" ;
    mkg:hasMetadata <http://example.org/kg/anane_demo/law/anane_demo_eq19_meta> ;
    mkg:latex "q_{A}=p_{A}-q_{sA}" ;
    mkg:uses <http://example.org/kg/anane_demo/law/anane_demo_eq19/var/p_A>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq19/var/q_sA> .

