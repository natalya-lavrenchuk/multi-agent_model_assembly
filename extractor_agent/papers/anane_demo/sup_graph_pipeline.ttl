@prefix kg: <http://example.org/kg/anane_demo/> .
@prefix mkg: <http://example.org/mkg#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kg:anane_demo a mkg:Sup ;
    rdfs:label "anane_demo · Modelling overflow metabolism in Escherichia coli by acetate cycling"@en ;
    mkg:hasMetadata kg:anane_demo_meta ;
    mkg:includes <http://example.org/kg/anane_demo/law/anane_demo_eq12>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq13>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq14>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq15>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq16>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq17>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq18>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq19>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq20>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq21>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq22>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq23>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq24> .

kg:anane_demo_meta a mkg:Metadata ;
    mkg:completeModel true ;
    mkg:description "The model describes fed-batch cultivation of Escherichia coli W3110M and predicts biomass, glucose, acetate, and dissolved-oxygen profiles, along with rates of growth and substrate use. It combines time-dependent fermentation balances with algebraic descriptions of glucose partitioning, acetate production and re-assimilation, oxygen uptake, and dissolved-oxygen probe response. Its central mechanism treats acetate as continuously produced and consumed, with extracellular accumulation occurring when production exceeds re-assimilation. The authors fitted and assessed it using measurements from a 2-L fed-batch cultivation in a bench-top reactor, including periods of batch growth, exponential and constant feeding, and glucose pulses. They present it as a tool for process development, optimization, control, and gradient-based calculations in E. coli fermentation." ;
    mkg:doi "10.1016/j.bej.2017.05.013" ;
    mkg:form "DAE" ;
    mkg:hasFact [ mkg:basis "stated" ;
            mkg:quote "The model comprises a set of ordinary differential equations (ODEs) describing six state variables" ;
            mkg:text "The paper characterizes the formulation as a dynamic macro-kinetic model built from ODEs and auxiliary algebraic equations." ;
            mkg:topic "structure" ],
        [ mkg:basis "stated" ;
            mkg:quote "twelve (12) out of the sixteen (16) parameters were exclusively identified with relative standard deviation less than 10%." ;
            mkg:text "The parameter-estimation problem included 16 parameters, of which 12 had relative standard deviations below 10%." ;
            mkg:topic "uncertainty" ],
        [ mkg:basis "stated" ;
            mkg:quote "Thus, according to Eq. (13), the overall growth of the culture results from usage of glucose through the oxidative (q_sox), acetate uptake (q_SA) and re-use of other products from the overflow route (q_sof), which all contribute energy equivalents for cell growth [14]." ;
            mkg:text "The specific growth rate is a non-inhibited Monod-type rate that combines growth contributions from oxidative glucose use, acetate uptake, and other overflow-route products, with maintenance accounted for." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "The exponential feed was implemented to maintain a set-point specific growth rate (m_set) of 0.22 h⁻¹." ;
            mkg:text "The feed began with 3 h of exponential feeding targeting a specific growth rate of 0.22 h⁻¹." ;
            mkg:topic "feeding" ],
        [ mkg:basis "stated" ;
            mkg:quote "To quantify the uncertainty associated with the PE, the precision of parameter values was assessed with the variance, relative standard deviation and the confidence interval calculated using a Monte Carlo (MC) method." ;
            mkg:text "Parameter uncertainty was assessed by Monte Carlo refitting of replicated data and calculation of parameter variances and 95% confidence intervals." ;
            mkg:topic "uncertainty" ],
        [ mkg:basis "stated" ;
            mkg:quote "As eluent, five mM H₂SO₄ was used at a flow rate of 0.5 mL min⁻¹." ;
            mkg:text "The HPLC eluent was 5 mM sulfuric acid delivered at 0.5 mL/min." ;
            mkg:topic "measurements" ],
        [ mkg:basis "stated" ;
            mkg:quote "The formulation is an advanced version of a similar representation of overflow metabolism in Saccharomyces cerevisiae, as presented by Pham and co-workers [14]." ;
            mkg:text "The paper describes its formulation as an advanced version of the overflow representation by Pham et al. 1998 for Saccharomyces cerevisiae." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "This cycling system can be represented by a set of continuous equations that describe overflow as an off-set of the equilibrium between p_A and q_sA." ;
            mkg:text "The model represents overflow as the net result of continuous intracellular acetate production and re-assimilation." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "The oxygen profile is described with the standard equation" ;
            mkg:text "The dissolved-oxygen balance represents oxygen transfer from the gas phase and cellular oxygen uptake." ;
            mkg:topic "oxygen" ],
        [ mkg:basis "inferred" ;
            mkg:text "The formulation has five differential balances and eight algebraic relations, based on the model's stated set of laws." ;
            mkg:topic "structure" ],
        [ mkg:basis "inferred" ;
            mkg:text "OD600 measurements were converted to cell dry weight using conversion factors developed with the same spectrophotometer and E. coli strain." ;
            mkg:topic "measurements" ],
        [ mkg:basis "stated" ;
            mkg:quote "The uptake of acetate, however, is inhibited in a non-competitive way by the presence of glucose in the medium due to E. coli's higher preference for glucose over acetate [27]." ;
            mkg:text "Acetate uptake follows acetate-saturation kinetics and is inhibited non-competitively by glucose uptake." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "In the exponential feed fed-batch phase, acetate concentration increased further to a maximum of 0.3 g/L due to the higher m_set value (0.22 h⁻¹)" ;
            mkg:text "The measured acetate concentration reached a maximum of 0.3 g/L during exponential feeding at a growth-rate set point of 0.22 h⁻¹." ;
            mkg:topic "performance" ],
        [ mkg:basis "stated" ;
            mkg:quote "The fed-batch phase was initiated with a 300 g/L glucose feed at the exhaustion of the batch phase glucose, signalled by a sudden rise in dissolved oxygen tension." ;
            mkg:text "Fed-batch feeding began when batch glucose was exhausted, as indicated by a sudden rise in dissolved-oxygen tension, using a 300 g/L glucose feed." ;
            mkg:topic "feeding" ],
        [ mkg:basis "stated" ;
            mkg:quote "whereas Nₘ = 11,336 data points were logged online for measured dissolved oxygen (DOT)." ;
            mkg:text "The dissolved-oxygen measurement was logged online at 11,336 data points." ;
            mkg:topic "measurements" ],
        [ mkg:basis "stated" ;
            mkg:quote "namely biomass X and extracellular concentrations of substrate S, acetate A, dissolved oxygen DOTa and DOT, and the feed F (which can be constant or a function of time)." ;
            mkg:text "The paper counts six state variables: biomass, glucose, acetate, actual and measured dissolved oxygen, and feed flow, which may be constant or time-dependent." ;
            mkg:topic "structure" ],
        [ mkg:basis "stated" ;
            mkg:quote "The difference between the two dissolved oxygen profiles DOTa and DOT is due to the response lag of the sensor, which is approximated by first order response kinetics for the DO-probe [25]." ;
            mkg:text "The measured dissolved-oxygen signal is modelled with first-order probe-response dynamics." ;
            mkg:topic "oxygen" ],
        [ mkg:basis "stated" ;
            mkg:quote "The Matlab code and fermentation data can be found at https://gitlab.tubit.tu-berlin.de/nicolas.cruz/E_coli_fed-batch/tree/master/Anane_2017_BEJ." ;
            mkg:text "The Matlab code and fermentation data are available from the authors' GitLab repository." ;
            mkg:topic "availability" ],
        [ mkg:basis "stated" ;
            mkg:quote "To start the batch phase, 2 L of medium was inoculated wit E. coli W3110 to OD₆₀₀ of 0.1." ;
            mkg:text "The batch phase began with 2 L of medium inoculated to an OD600 of 0.1." ;
            mkg:topic "equipment" ],
        [ mkg:basis "stated" ;
            mkg:quote "From an excess substrate (glucose) environment in the batch phase to chronic starvation conditions at the end, the acetate profile evolved according to predictable kinetics (Fig. 2)." ;
            mkg:text "The cultivation covered conditions from excess glucose in batch growth through chronic starvation at the end of the run." ;
            mkg:topic "scope" ],
        [ mkg:basis "stated" ;
            mkg:quote "This formulation of acetate profiles and overflow metabolism is closer to reality since E. coli does not have clear cut switching points in its metabolic routes on the onset of overflow, but rather slow or gradual switching systems from oxidative to overflow metabolism [38,39]." ;
            mkg:text "The formulation describes gradual metabolic switching rather than a sharp threshold between oxidative and overflow metabolism." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "To determine the concentration of residual glucose and acetate, hourly samples were analysed on an Agilent 1200 HPLC system, equipped with a HyperRez™ XP Carbohydrate H+ column (Fisher Scientific, Schwerte, Germany) and a refractive index detector." ;
            mkg:text "Residual glucose and acetate were measured hourly by HPLC using an Agilent 1200 system with a refractive-index detector." ;
            mkg:topic "measurements" ],
        [ mkg:basis "stated" ;
            mkg:quote "There was an adequate fit between the model and the experimental data." ;
            mkg:text "The authors report an adequate fit to the measured profiles and say the estimated parameters gave unique values under the experimental conditions." ;
            mkg:topic "performance" ],
        [ mkg:basis "stated" ;
            mkg:quote "The initial parameter values for PE were based on literature [4,5,17]. The initial values for the search in the parameter space were generated using the Minimum bias Latin hypercube design (MBLHD) [22]." ;
            mkg:text "Initial parameter values came from literature, and initial search points were generated using minimum-bias Latin hypercube design." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The data for model calibration was obtained from a fed-batch culture of non-recombinant E. coli W3110M." ;
            mkg:text "The model was calibrated with a fed-batch culture of non-recombinant E. coli W3110M." ;
            mkg:topic "system" ],
        [ mkg:basis "stated" ;
            mkg:quote "The simulated profiles and the model fit (Fig. 2) reveal a rapid response of E. coli to acetate production/reconsumption after each glucose pulse. The absence of a diauxic delay during the consumption of acetate after each pulse" ;
            mkg:text "The model simulations showed rapid acetate production and re-consumption responses after glucose pulses, without an observed diauxic delay." ;
            mkg:topic "performance" ],
        [ mkg:basis "stated" ;
            mkg:quote "To test the robustness of the acetate equations, intermittent glucose pulses were given in the constant feeding phase, and the corresponding response in all profiles were modelled." ;
            mkg:text "Intermittent glucose pulses were added during constant feeding to test the model's response to disturbances in glucose supply." ;
            mkg:topic "feeding" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper's reported assessment uses the same fed-batch cultivation for calibration and model evaluation, and does not report a separate independent validation dataset." ;
            mkg:topic "scope" ],
        [ mkg:basis "inferred" ;
            mkg:text "Cultivation was run at 37 °C and pH 7.0." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "In total, Nₘ = 19 data points were collected and analysed for each observable variable i.e., biomass (X), glucose (S) and acetate (A)" ;
            mkg:text "There were 19 offline data points for each of biomass, glucose, and acetate." ;
            mkg:topic "measurements" ],
        [ mkg:basis "stated" ;
            mkg:quote "The specific substrate uptake rate is therefore modelled with Mono-type kinetics with non-competitive inhibition" ;
            mkg:text "Glucose uptake follows Monod-type substrate saturation kinetics with non-competitive inhibition by extracellular acetate." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "A major limitation is the discontinuous nature of the functions (e.g., if q_0 < q_0max, then q_A = 0 [8]), which makes further mathematical development and the use of sophisticated simulation and optimization programmes difficult." ;
            mkg:text "The paper identifies discontinuous conditional statements in earlier acetate models as a limitation for mathematical development and gradient-based computation." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "The medium consisted of mineral salts and trace elements, as described by Glazyrina et al. [20], with 5 g/L glucose in the batch phase." ;
            mkg:text "The mineral-salts and trace-elements medium contained 5 g/L glucose during the batch phase." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The equilibrium q_sA=0 is reached when the acetate produced through the overflow route pA is equal to the acetate consumed q_sA." ;
            mkg:text "Extracellular acetate accumulates when acetate production exceeds its consumption, while the reverse balance describes net acetate uptake." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "inferred" ;
            mkg:text "Cultivation was performed in a 3.7-L bench-top BioEngineering bioreactor with a polarographic dissolved-oxygen probe." ;
            mkg:topic "equipment" ],
        [ mkg:basis "stated" ;
            mkg:quote "Due to its continuous characteristics, this model is suitable for simulations that require higher order gradient calculation such as Computational Fluid Dynamics (CFD) models, as well as in complex optimization problems involving the E. coli expression system." ;
            mkg:text "The authors present the model as suitable for calculating higher-order gradients, including in CFD models, and for complex process optimization." ;
            mkg:topic "use" ],
        [ mkg:basis "stated" ;
            mkg:quote "The E. coli model in Section 3 was solved using Matlab R2015a® with the CVODE integrator from SUNDIALS TB [21]. The parameter estimates (PE) were computed using lsqnonlin with the trust region reflective algorithm." ;
            mkg:text "Parameter estimates were obtained by weighted nonlinear least squares using Matlab R2015a, CVODE from SUNDIALS, and lsqnonlin with a trust-region-reflective algorithm." ;
            mkg:topic "estimation" ],
        [ mkg:basis "inferred" ;
            mkg:text "After the exponential phase, the process used constant feeding for 17 h, beginning at a specific growth rate of 0.11 h⁻¹." ;
            mkg:topic "feeding" ],
        [ mkg:basis "inferred" ;
            mkg:text "During constant feeding, the reported specific growth rate fell below 0.05 h⁻¹ when glucose supply fell below 0.1 g glucose per g biomass per hour." ;
            mkg:topic "performance" ],
        [ mkg:basis "stated" ;
            mkg:quote "Cellular growth was monitored by measuring the optical density of samples at 600 nm in a UV–vis spectrophotometer (Novaspec III, Amersham Biosciences, Amersham, UK)." ;
            mkg:text "Growth was monitored by measuring sample OD600 with a Novaspec III UV–vis spectrophotometer." ;
            mkg:topic "measurements" ],
        [ mkg:basis "stated" ;
            mkg:quote "A set of auxiliary algebraic equations describing intracellular interactions relating substrate (glucose), oxygen and acetate consumption as well as biomass formation are coupled to the ODEs to form the kinetic model." ;
            mkg:text "Intracellular interactions are represented through auxiliary algebraic equations coupled to the fermentation balances." ;
            mkg:topic "structure" ],
        [ mkg:basis "stated" ;
            mkg:quote "Nevertheless, Valgepea et al. [10], Peebo et al. [9], and Martinez-Gomez et al. [16] showed that E. coli uses a continuous acetate cycling system for acetate conversion (Fig. 1B)." ;
            mkg:text "The acetate-cycling premise is associated with evidence cited from Peebo et al. 2015, Valgepea et al. 2010, and Martínez-Gómez et al. 2012." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "The mechanistic models of Xu [4], Lin [5] and Neubauer [8] are among the most widely used macro-kinetic models for description of E. coli fermentations." ;
            mkg:text "The model builds on the macro-kinetic glucose-partitioning models of Xu et al. 1999, Lin et al. 2001, and Neubauer et al. 2003." ;
            mkg:topic "comparison" ] ;
    mkg:status "pending" ;
    rdfs:comment "v0 distinct nodes; built from paddle.json (PaddleOCR-VL pipeline) by extractor/graph.py" .

<http://example.org/kg/anane_demo/law/anane_demo_eq12> a mkg:Law ;
    rdfs:label "anane_demo eq 12"@en ;
    mkg:computes <http://example.org/kg/anane_demo/law/anane_demo_eq12/var/X> ;
    mkg:equationNumber "12" ;
    mkg:hasMetadata <http://example.org/kg/anane_demo/law/anane_demo_eq12_meta> ;
    mkg:latex "\\frac{dX}{dt}=\\frac{F}{V}\\left(0-X\\right)+\\mu X" ;
    mkg:uses <http://example.org/kg/anane_demo/law/anane_demo_eq12/var/F>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq12/var/V>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq12/var/mu> .

<http://example.org/kg/anane_demo/law/anane_demo_eq12/var/F> a mkg:Variable ;
    rdfs:label "F (anane_demo eq 12)"@en ;
    mkg:basis "stated" ;
    mkg:description "Feed flow rate" ;
    mkg:dimension "[length] ** 3 / [time]" ;
    mkg:page "2" ;
    mkg:quote "Flow rate (L/h)" ;
    mkg:reason "Feed flow rate, an operating input that can be set or varied during the fed-batch process." ;
    mkg:siFactor 2.777778e-07 ;
    mkg:status "accepted" ;
    mkg:symbol "F" ;
    mkg:unit "l / h" ;
    mkg:unitString "L/h" .

<http://example.org/kg/anane_demo/law/anane_demo_eq12/var/V> a mkg:Variable ;
    rdfs:label "V (anane_demo eq 12)"@en ;
    mkg:basis "stated" ;
    mkg:description "Broth volume" ;
    mkg:dimension "[length] ** 3" ;
    mkg:initialQuote "To start the batch phase, 2 L of medium was inoculated wit E. coli W3110 to OD₆₀₀ of 0.1." ;
    mkg:initialValue "2 L" ;
    mkg:page "3" ;
    mkg:quote "broth volume (V, L)" ;
    mkg:reason "Broth volume, a process quantity that changes during fed-batch operation." ;
    mkg:siFactor 1e-03 ;
    mkg:status "accepted" ;
    mkg:symbol "V" ;
    mkg:unit "l" ;
    mkg:unitString "L" .

<http://example.org/kg/anane_demo/law/anane_demo_eq12/var/X> a mkg:Variable ;
    rdfs:label "X (anane_demo eq 12)"@en ;
    mkg:description "Biomass concentration" ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:measured true ;
    mkg:measuredQuote "Cellular growth was monitored by measuring the optical density of samples at 600 nm in a UV–vis spectrophotometer (Novaspec III, Amersham Biosciences, Amersham, UK)." ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "X" ;
    mkg:unit "g / l" ;
    mkg:unitString "g/L" .

<http://example.org/kg/anane_demo/law/anane_demo_eq12/var/mu> a mkg:Variable ;
    rdfs:label "\\mu (anane_demo eq 12)"@en ;
    mkg:description "Non-inhibited Monod-type specific growth rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "\\mu" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/anane_demo/law/anane_demo_eq12_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Biomass concentration changes through fed-batch dilution and growth at the specific growth rate." ;
    mkg:doi "10.1016/j.bej.2017.05.013" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "inlet concentration of biomass is zero (sterile feed)" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The feed contains no biomass." ],
        [ mkg:quote "in the fed-batch case" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The process is operated in fed-batch mode." ] ;
    mkg:page "4" ;
    mkg:quote "\\frac{dX}{dt}=\\frac{F}{V}\\left(0-X\\right)+\\mu X" ;
    mkg:status "pending" .

<http://example.org/kg/anane_demo/law/anane_demo_eq13> a mkg:Law ;
    rdfs:label "anane_demo eq 13"@en ;
    mkg:computes <http://example.org/kg/anane_demo/law/anane_demo_eq13/var/mu> ;
    mkg:equationNumber "13" ;
    mkg:hasMetadata <http://example.org/kg/anane_demo/law/anane_demo_eq13_meta> ;
    mkg:hasParameter <http://example.org/kg/anane_demo/law/anane_demo_eq13/par/Y_em>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq13/par/Y_xa>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq13/par/Y_xsof>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq13/par/q_m> ;
    mkg:latex "\\mu=\\left(q_{s o x}-q_{m}\\right)Y_{e m}+q_{s o f}Y_{x s o f}+q_{s A}Y_{x a}" ;
    mkg:uses <http://example.org/kg/anane_demo/law/anane_demo_eq13/var/q_sA>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq13/var/q_sof>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq13/var/q_sox> .

<http://example.org/kg/anane_demo/law/anane_demo_eq13/var/mu> a mkg:Variable ;
    rdfs:label "\\mu (anane_demo eq 13)"@en ;
    mkg:description "Non-inhibited Monod-type specific growth rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "\\mu" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/anane_demo/law/anane_demo_eq13_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:description "Specific growth rate is the yield-weighted contribution of oxidative substrate use after maintenance, overflow-route use, and acetate uptake." ;
    mkg:doi "10.1016/j.bej.2017.05.013" ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/anane_demo/law/anane_demo_eq13/par/q_m> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/anane_demo/law/anane_demo_eq13/par/Y_xa> ;
            mkg:slot "yield" ],
        [ mkg:boundTo <http://example.org/kg/anane_demo/law/anane_demo_eq13/var/q_sof> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/anane_demo/law/anane_demo_eq13/par/Y_em> ;
            mkg:slot "yield" ],
        [ mkg:boundTo <http://example.org/kg/anane_demo/law/anane_demo_eq13/var/q_sox> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/anane_demo/law/anane_demo_eq13/var/q_sA> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/anane_demo/law/anane_demo_eq13/par/Y_xsof> ;
            mkg:slot "yield" ] ;
    mkg:page "4" ;
    mkg:quote "\\mu=\\left(q_{s o x}-q_{m}\\right)Y_{e m}+q_{s o f}Y_{x s o f}+q_{s A}Y_{x a}" ;
    mkg:status "pending" .

<http://example.org/kg/anane_demo/law/anane_demo_eq14> a mkg:Law ;
    rdfs:label "anane_demo eq 14"@en ;
    mkg:computes <http://example.org/kg/anane_demo/law/anane_demo_eq14/var/S> ;
    mkg:equationNumber "14" ;
    mkg:hasMetadata <http://example.org/kg/anane_demo/law/anane_demo_eq14_meta> ;
    mkg:latex "\\frac{dS}{dt}=\\frac{F}{V}\\left(S_{i}-S\\right)-q_{s}X" ;
    mkg:uses <http://example.org/kg/anane_demo/law/anane_demo_eq14/var/F>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq14/var/S_i>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq14/var/V>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq14/var/X>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq14/var/q_s> .

<http://example.org/kg/anane_demo/law/anane_demo_eq14/var/F> a mkg:Variable ;
    rdfs:label "F (anane_demo eq 14)"@en ;
    mkg:basis "stated" ;
    mkg:description "Feed flow rate" ;
    mkg:dimension "[length] ** 3 / [time]" ;
    mkg:page "2" ;
    mkg:quote "Flow rate (L/h)" ;
    mkg:reason "Feed flow rate, an operating input that can be set or varied during the fed-batch process." ;
    mkg:siFactor 2.777778e-07 ;
    mkg:status "accepted" ;
    mkg:symbol "F" ;
    mkg:unit "l / h" ;
    mkg:unitString "L/h" .

<http://example.org/kg/anane_demo/law/anane_demo_eq14/var/S> a mkg:Variable ;
    rdfs:label "S (anane_demo eq 14)"@en ;
    mkg:description "Substrate (glucose) concentration." ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:initialQuote "with 5 g/L glucose in the batch phase." ;
    mkg:initialValue "5 g/L" ;
    mkg:measured true ;
    mkg:measuredQuote "In total, Nₘ = 19 data points were collected and analysed for each observable variable i.e., biomass (X), glucose (S) and acetate (A)" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "S" ;
    mkg:unit "g / l" ;
    mkg:unitString "g/L" .

