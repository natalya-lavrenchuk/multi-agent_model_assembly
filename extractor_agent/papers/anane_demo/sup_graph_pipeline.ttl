<http://example.org/kg/anane_demo/law/anane_demo_eq22_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The dissolved-oxygen balance accounts for oxygen transfer from the gas phase and oxygen uptake by the biomass." ;
    mkg:doi "10.1016/j.bej.2017.05.013" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "the feed solution in the fed-batch phase is fully saturated with dissolved oxygen" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The feed solution is fully saturated with dissolved oxygen." ] ;
    mkg:page "4" ;
    mkg:quote "\\frac{d D O T_{a}}{d t}=K_{L a}\\left(D O T^{*}-D O T_{a}\\right)-q_{o}X H" ;
    mkg:status "pending" .

<http://example.org/kg/anane_demo/law/anane_demo_eq23> a mkg:Law ;
    rdfs:label "anane_demo eq 23"@en ;
    mkg:computes <http://example.org/kg/anane_demo/law/anane_demo_eq23/var/q_o> ;
    mkg:equationNumber "23" ;
    mkg:hasMetadata <http://example.org/kg/anane_demo/law/anane_demo_eq23_meta> ;
    mkg:hasParameter <http://example.org/kg/anane_demo/law/anane_demo_eq23/par/Y_oa>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq23/par/Y_os>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq23/par/q_m> ;
    mkg:latex "q_{o}=\\left(q_{s o x}-q_{m}\\right)Y_{o s}+q_{s A}Y_{o a}" ;
    mkg:uses <http://example.org/kg/anane_demo/law/anane_demo_eq23/var/q_sA>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq23/var/q_sox> .

<http://example.org/kg/anane_demo/law/anane_demo_eq23/var/q_o> a mkg:Variable ;
    rdfs:label "q_{o} (anane_demo eq 23)"@en ;
    mkg:description "Oxygen uptake rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "q_{o}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "g g^-1 h^-1" .

<http://example.org/kg/anane_demo/law/anane_demo_eq23_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The specific oxygen uptake rate is calculated from oxidative substrate use, maintenance, and acetate uptake using their oxygen-yield coefficients." ;
    mkg:doi "10.1016/j.bej.2017.05.013" ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/anane_demo/law/anane_demo_eq23/par/Y_os> ;
            mkg:slot "yield" ],
        [ mkg:boundTo <http://example.org/kg/anane_demo/law/anane_demo_eq23/var/q_sA> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/anane_demo/law/anane_demo_eq23/var/q_sox> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/anane_demo/law/anane_demo_eq23/par/q_m> ;
            mkg:slot "maintenance rate" ],
        [ mkg:boundTo <http://example.org/kg/anane_demo/law/anane_demo_eq23/par/Y_oa> ;
            mkg:slot "yield" ] ;
    mkg:page "4" ;
    mkg:quote "q_{o}=\\left(q_{s o x}-q_{m}\\right)Y_{o s}+q_{s A}Y_{o a}" ;
    mkg:status "pending" .

<http://example.org/kg/anane_demo/law/anane_demo_eq24> a mkg:Law ;
    rdfs:label "anane_demo eq 24"@en ;
    mkg:computes <http://example.org/kg/anane_demo/law/anane_demo_eq24/var/DOT> ;
    mkg:equationNumber "24" ;
    mkg:hasMetadata <http://example.org/kg/anane_demo/law/anane_demo_eq24_meta> ;
    mkg:hasParameter <http://example.org/kg/anane_demo/law/anane_demo_eq24/par/K_p> ;
    mkg:latex "\\frac{dDOT}{dt}=K_{p}\\left(DOT_{a}-DOT\\right)" ;
    mkg:uses <http://example.org/kg/anane_demo/law/anane_demo_eq24/var/DOT_a> .

<http://example.org/kg/anane_demo/law/anane_demo_eq24/par/K_p> a mkg:Parameter ;
    rdfs:label "K_{p} (anane_demo eq 24)"@en ;
    mkg:basis "stated" ;
    mkg:description "Static gain of the sensor, given as the inverse of the probe response time" ;
    mkg:dimension "1 / [time]" ;
    mkg:page "4" ;
    mkg:quote "$ K_p = \\frac{1}{\\tau} $ is the static gain of the sensor given as the inverse of the probe response time" ;
    mkg:reason "It is the sensor static gain, an inverse response-time constant in the probe-response law." ;
    mkg:siFactor 2.777778e-04 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{p}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/anane_demo/law/anane_demo_eq24/var/DOT> a mkg:Variable ;
    rdfs:label "DOT (anane_demo eq 24)"@en ;
    mkg:description "Dissolved oxygen tension." ;
    mkg:dimension "dimensionless" ;
    mkg:measured true ;
    mkg:measuredQuote "whereas Nₘ = 11,336 data points were logged online for measured dissolved oxygen (DOT)." ;
    mkg:siFactor 1e-02 ;
    mkg:symbol "DOT" ;
    mkg:unit "%" ;
    mkg:unitString "%" .

<http://example.org/kg/anane_demo/law/anane_demo_eq24/var/DOT_a> a mkg:Variable ;
    rdfs:label "DOT_{a} (anane_demo eq 24)"@en ;
    mkg:description "Actual dissolved oxygen, calculated as a percentage of saturation" ;
    mkg:dimension "dimensionless" ;
    mkg:siFactor 1e-02 ;
    mkg:symbol "DOT_{a}" ;
    mkg:unit "%" ;
    mkg:unitNote "of saturation" ;
    mkg:unitString "% of saturation" .

<http://example.org/kg/anane_demo/law/anane_demo_eq24_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The measured dissolved-oxygen tension follows the actual dissolved-oxygen tension with the sensor response dynamics." ;
    mkg:doi "10.1016/j.bej.2017.05.013" ;
    mkg:form "ODE" ;
    mkg:page "4" ;
    mkg:quote "\\frac{dDOT}{dt}=K_{p}\\left(DOT_{a}-DOT\\right)" ;
    mkg:status "pending" .

