<http://example.org/kg/anane_demo/law/anane_demo_eq21_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:correctionQuote "The uptake of acetate, however, is inhibited in a non-competitive way by the presence of glucose in the medium due to E. coli's higher preference for glucose over acetate [27]." ;
    mkg:correctionReason "The inhibition term should use glucose concentration S, not specific glucose uptake q_s, because the paper describes inhibition by glucose in the medium and lists K_{is} in concentration units." ;
    mkg:correctionStatus "proposed" ;
    mkg:description "The specific acetate uptake rate follows acetate-saturation kinetics and is inhibited by glucose uptake." ;
    mkg:doi "10.1016/j.bej.2017.05.013" ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/anane_demo/law/anane_demo_eq21/var/A> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/anane_demo/law/anane_demo_eq21/par/K_sa> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/anane_demo/law/anane_demo_eq21/par/K_is> ;
            mkg:slot "inhibition constant" ],
        [ mkg:boundTo <http://example.org/kg/anane_demo/law/anane_demo_eq21/par/q_Amax> ;
            mkg:slot "maximum rate" ],
        [ mkg:boundTo <http://example.org/kg/anane_demo/law/anane_demo_eq21/var/q_s> ;
            mkg:slot "inhibitor" ] ;
    mkg:page "4" ;
    mkg:possibleMisprint "The q_{s} term in the glucose-inhibition factor has units of specific uptake rate, whereas K_{is} is given in concentration units, so their ratio is dimensionally inconsistent." ;
    mkg:quote "q_{sA}=\\frac{q_{Amax}}{1+\\frac{q_{s}}{K_{is}}}\\cdot\\frac{A}{A+K_{sa}}" ;
    mkg:status "pending" .

<http://example.org/kg/anane_demo/law/anane_demo_eq22> a mkg:Law ;
    rdfs:label "anane_demo eq 22"@en ;
    mkg:computes <http://example.org/kg/anane_demo/law/anane_demo_eq22/var/DOT_a> ;
    mkg:equationNumber "22" ;
    mkg:hasMetadata <http://example.org/kg/anane_demo/law/anane_demo_eq22_meta> ;
    mkg:hasParameter <http://example.org/kg/anane_demo/law/anane_demo_eq22/par/DOT_star>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq22/par/H>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq22/par/K_La> ;
    mkg:latex "\\frac{d D O T_{a}}{d t}=K_{L a}\\left(D O T^{*}-D O T_{a}\\right)-q_{o}X H" ;
    mkg:uses <http://example.org/kg/anane_demo/law/anane_demo_eq22/var/X>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq22/var/q_o> .

<http://example.org/kg/anane_demo/law/anane_demo_eq22/par/DOT_star> a mkg:Parameter ;
    rdfs:label "DOT^{*} (anane_demo eq 22)"@en ;
    mkg:basis "stated" ;
    mkg:description "Saturating value of DOT in the broth at the given operating conditions" ;
    mkg:dimension "dimensionless" ;
    mkg:page "2" ;
    mkg:quote "DOT $ ^{{*}} $ represents saturating value of DOT in the broth at the given operating conditions" ;
    mkg:reason "It is the saturation value of dissolved oxygen under the operating conditions, a saturation concentration/property." ;
    mkg:siFactor 1e-02 ;
    mkg:status "accepted" ;
    mkg:symbol "DOT^{*}" ;
    mkg:unit "%" ;
    mkg:unitString "%" .

<http://example.org/kg/anane_demo/law/anane_demo_eq22/par/H> a mkg:Parameter ;
    rdfs:label "H (anane_demo eq 22)"@en ;
    mkg:basis "stated" ;
    mkg:description "Henry equilibrium constant" ;
    mkg:dimension "[length] ** 3 / [mass]" ;
    mkg:page "4" ;
    mkg:quote "H the Henry equilibrium constant" ;
    mkg:reason "It is a Henry equilibrium constant, a physical property of the system." ;
    mkg:siFactor 1e-02 ;
    mkg:status "accepted" ;
    mkg:symbol "H" ;
    mkg:unit "l * % / g" ;
    mkg:unitString "% L g^-1" .

<http://example.org/kg/anane_demo/law/anane_demo_eq22/par/K_La> a mkg:Parameter ;
    rdfs:label "K_{La} (anane_demo eq 22)"@en ;
    mkg:basis "stated" ;
    mkg:description "Volumetric mass transfer coefficient" ;
    mkg:dimension "1 / [time]" ;
    mkg:page "4" ;
    mkg:quote "KLa the volumetric mass transfer coefficient" ;
    mkg:reason "It is a volumetric mass transfer coefficient, a system property." ;
    mkg:siFactor 2.777778e-04 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{La}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/anane_demo/law/anane_demo_eq22/var/DOT_a> a mkg:Variable ;
    rdfs:label "DOT_{a} (anane_demo eq 22)"@en ;
    mkg:description "Actual dissolved oxygen, calculated as a percentage of saturation" ;
    mkg:dimension "dimensionless" ;
    mkg:siFactor 1e-02 ;
    mkg:symbol "DOT_{a}" ;
    mkg:unit "%" ;
    mkg:unitNote "of saturation" ;
    mkg:unitString "% of saturation" .

<http://example.org/kg/anane_demo/law/anane_demo_eq22/var/X> a mkg:Variable ;
    rdfs:label "X (anane_demo eq 22)"@en ;
    mkg:description "Biomass concentration" ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:measured true ;
    mkg:measuredQuote "Cellular growth was monitored by measuring the optical density of samples at 600 nm in a UV–vis spectrophotometer (Novaspec III, Amersham Biosciences, Amersham, UK)." ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "X" ;
    mkg:unit "g / l" ;
    mkg:unitString "g/L" .

<http://example.org/kg/anane_demo/law/anane_demo_eq22/var/q_o> a mkg:Variable ;
