<http://example.org/kg/anane_demo/law/anane_demo_eq19_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The net specific acetate rate is the production rate minus the acetate uptake rate." ;
    mkg:doi "10.1016/j.bej.2017.05.013" ;
    mkg:form "algebraic" ;
    mkg:page "4" ;
    mkg:possibleMisprint "The term q_A is labeled a specific acetate consumption rate, but p_A minus q_{sA} gives net acetate production when production exceeds uptake." ;
    mkg:quote "q_{A}=p_{A}-q_{sA}" ;
    mkg:status "pending" .

