<http://example.org/kg/anane_demo/law/anane_demo_eq21> a mkg:Law ;
    rdfs:label "anane_demo eq 21"@en ;
    mkg:computes <http://example.org/kg/anane_demo/law/anane_demo_eq21/var/q_sA> ;
    mkg:equationNumber "21" ;
    mkg:hasMetadata <http://example.org/kg/anane_demo/law/anane_demo_eq21_meta> ;
    mkg:hasParameter <http://example.org/kg/anane_demo/law/anane_demo_eq21/par/K_is>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq21/par/K_sa>,
        <http://example.org/kg/anane_demo/law/anane_demo_eq21/par/q_Amax> ;
    mkg:latex "q_{sA}=\\frac{q_{Amax}}{1+\\frac{q_{s}}{K_{is}}}\\cdot\\frac{A}{A+K_{sa}}" ;
    mkg:latexCorrected "$$ q_{sA}=\\frac{q_{Amax}}{1+\\frac{S}{K_{is}}}\\cdot\\frac{A}{A+K_{sa}} $$" ;
