    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "p_{A}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "g/(g.h)" .

<http://example.org/kg/anane_demo/law/anane_demo_eq19/var/q_A> a mkg:Variable ;
    rdfs:label "q_{A} (anane_demo eq 19)"@en ;
    mkg:description "Specific acetate consumption rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "q_{A}" ;
