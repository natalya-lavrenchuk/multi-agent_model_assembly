<http://example.org/kg/xing_2010/law/xing_2010_eq6.3_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Glutamine balance computes concentration change from cell-associated consumption, maintenance consumption, and glutamine decomposition." ;
    mkg:doi "10.1002/btpr.284" ;
    mkg:form "ODE" ;
    mkg:page "3" ;
    mkg:quote "\\frac{d[\\mathrm{GLN}]}{d t} =-\\left((\\mu-\\mu_{d})/Y_{X_{V}/\\mathrm{g}\\ln}+m_{\\mathrm{g}\\ln}\\right)\\cdot X_{V}-d_{g\\ln}[\\mathrm{GLN}]" ;
    mkg:status "pending" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.4> a mkg:Law ;
    rdfs:label "xing_2010 eq 6.4"@en ;
    mkg:computes <http://example.org/kg/xing_2010/law/xing_2010_eq6.4/var/C_LAC> ;
    mkg:equationNumber "6.4" ;
    mkg:hasMetadata <http://example.org/kg/xing_2010/law/xing_2010_eq6.4_meta> ;
    mkg:hasParameter <http://example.org/kg/xing_2010/law/xing_2010_eq6.4/par/Y_X_V_glc>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.4/par/Y_lac_glc>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.4/par/m_glc> ;
    mkg:latex "\\frac{d[\\mathrm{LAC}]}{d t} =Y_{\\mathrm{lac}/\\mathrm{glc}}\\cdot\\left((\\mu-\\mu_{d})/Y_{X_{V}/\\mathrm{glc}}+m_{\\mathrm{glc}}\\right)\\cdot X_{V}" ;
    mkg:uses <http://example.org/kg/xing_2010/law/xing_2010_eq6.4/var/X_V>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.4/var/mu>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.4/var/mu_d> .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.4/par/Y_X_V_glc> a mkg:Parameter ;
    rdfs:label "Y_{X_V/glc} (xing_2010 eq 6.4)"@en ;
    mkg:basis "stated" ;
    mkg:description "Glucose yield coefficient" ;
    mkg:dimension "[cell] / [substance]" ;
    mkg:page "11" ;
    mkg:quote "Y_{Xv/glc} = glucose yield coefficient, cell L^{-1} mM^{-1}" ;
    mkg:reason "A glucose yield coefficient calculated from cell-culture data and used as a model constant." ;
    mkg:siFactor 1e+11 ;
    mkg:status "accepted" ;
    mkg:symbol "Y_{X_V/glc}" ;
    mkg:unit "cells / mol (x1e+11)" ;
    mkg:unitString "10^11 cells mol^-1" ;
    mkg:value 1.69e+00 ;
    mkg:valueUncertainty "± 0.37" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.4/par/Y_lac_glc> a mkg:Parameter ;
    rdfs:label "Y_{lac/glc} (xing_2010 eq 6.4)"@en ;
    mkg:basis "stated" ;
    mkg:description "lactate yield from glucose" ;
    mkg:dimension "dimensionless" ;
    mkg:page "11" ;
    mkg:quote "Y_{lac/glc} = lactate yield from glucose, mol/mol" ;
    mkg:reason "A yield coefficient relating lactate production to glucose consumption; the paper treats it as a model constant." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "Y_{lac/glc}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "mol mol^-1" ;
    mkg:value 1.23e+00 ;
    mkg:valueUncertainty "± 0.06" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.4/par/m_glc> a mkg:Parameter ;
    rdfs:label "m_{glc} (xing_2010 eq 6.4)"@en ;
