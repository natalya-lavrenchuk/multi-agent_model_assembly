<http://example.org/kg/xing_2010/law/xing_2010_eq6.4_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Lactate balance computes production associated with glucose consumption by the cells." ;
    mkg:doi "10.1002/btpr.284" ;
    mkg:form "ODE" ;
    mkg:page "3" ;
    mkg:quote "\\frac{d[\\mathrm{LAC}]}{d t} =Y_{\\mathrm{lac}/\\mathrm{glc}}\\cdot\\left((\\mu-\\mu_{d})/Y_{X_{V}/\\mathrm{glc}}+m_{\\mathrm{glc}}\\right)\\cdot X_{V}" ;
    mkg:status "pending" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.5> a mkg:Law ;
    rdfs:label "xing_2010 eq 6.5"@en ;
    mkg:computes <http://example.org/kg/xing_2010/law/xing_2010_eq6.5/var/C_AMM> ;
    mkg:equationNumber "6.5" ;
    mkg:hasMetadata <http://example.org/kg/xing_2010/law/xing_2010_eq6.5_meta> ;
    mkg:hasParameter <http://example.org/kg/xing_2010/law/xing_2010_eq6.5/par/Y_X_V_gln>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.5/par/Y_amm_gln>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.5/par/d_gln>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.5/par/r_amm> ;
    mkg:latex "\\frac{d[\\mathrm{AMM}]}{d t} =Y_{\\mathrm{amm}/\\mathrm{g}\\ln}\\cdot\\left((\\mu-\\mu_{d})/Y_{X_{V}/\\mathrm{g}\\ln}\\right)\\cdot X_{V}-r_{\\mathrm{amm}}\\cdot X_{V} +d_{\\mathrm{g}\\ln}[\\mathrm{GLN}]" ;
    mkg:uses <http://example.org/kg/xing_2010/law/xing_2010_eq6.5/var/C_GLN>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.5/var/X_V>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.5/var/mu>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.5/var/mu_d> .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.5/par/Y_X_V_gln> a mkg:Parameter ;
    rdfs:label "Y_{X_V/gln} (xing_2010 eq 6.5)"@en ;
    mkg:basis "stated" ;
    mkg:description "Glutamine yield coefficient" ;
    mkg:dimension "[cell] / [substance]" ;
    mkg:page "11" ;
    mkg:quote "Y_{Xv/gln} = glutamine yield coefficient, cell L^{-1} mM^{-1}" ;
    mkg:reason "A glutamine yield coefficient calculated from cell-culture data and used as a model constant." ;
    mkg:siFactor 1e+11 ;
    mkg:status "accepted" ;
    mkg:symbol "Y_{X_V/gln}" ;
    mkg:unit "cells / mol (x1e+11)" ;
    mkg:unitString "10^11 cells mol^-1" ;
    mkg:value 9.74e+00 ;
    mkg:valueUncertainty "± 1.65" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.5/par/Y_amm_gln> a mkg:Parameter ;
    rdfs:label "Y_{amm/gln} (xing_2010 eq 6.5)"@en ;
    mkg:basis "stated" ;
    mkg:description "ammonia yield from glutamine" ;
    mkg:dimension "dimensionless" ;
    mkg:page "11" ;
    mkg:quote "Y_{amm/gln} = ammonia yield from glutamine, mol/mol" ;
    mkg:reason "A yield coefficient relating ammonia production to glutamine consumption; the paper treats it as a model constant." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "Y_{amm/gln}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "mol mol^-1" ;
    mkg:value 6.7e-01 ;
    mkg:valueUncertainty "± 0.06" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.5/par/d_gln> a mkg:Parameter ;
