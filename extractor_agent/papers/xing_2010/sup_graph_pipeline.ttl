    mkg:unit "cells / l (x1e+09)" ;
    mkg:unitString "10^9 cells L^-1" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.3/var/m_gln> a mkg:Variable ;
    rdfs:label "m_{gln} (xing_2010 eq 6.3)"@en ;
    mkg:description "Glutamine maintenance coefficient" ;
    mkg:dimension "[substance] / [cell] / [time]" ;
    mkg:siFactor 2.777778e-19 ;
    mkg:symbol "m_{gln}" ;
    mkg:unit "mmol / cells / h (x1e-12)" ;
    mkg:unitString "10^-12 mmol cell^-1 h^-1" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.3/var/mu> a mkg:Variable ;
    rdfs:label "\\mu (xing_2010 eq 6.3)"@en ;
    mkg:description "Specific cell growth rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "\\mu" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.3/var/mu_d> a mkg:Variable ;
    rdfs:label "\\mu_{d} (xing_2010 eq 6.3)"@en ;
    mkg:description "Specific cell death rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "\\mu_{d}" ;
