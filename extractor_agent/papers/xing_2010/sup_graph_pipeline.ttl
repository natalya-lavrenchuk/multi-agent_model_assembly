    mkg:page "11" ;
    mkg:quote "r_{amm} = ammonia removal rate, 10^{-9} mmol cell^{-1} h^{-1}" ;
    mkg:reason "A specific ammonia removal-rate coefficient in the ammonia mass-balance law." ;
    mkg:siFactor 2.777778e-19 ;
    mkg:status "accepted" ;
