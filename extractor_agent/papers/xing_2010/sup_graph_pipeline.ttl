@prefix kg: <http://example.org/kg/xing_2010/> .
@prefix mkg: <http://example.org/mkg#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kg:xing_2010 a mkg:Sup ;
    rdfs:label "xing_2010 · Modeling Kinetics of a Large-Scale Fed-Batch CHO Cell Culture by Markov Chain Monte Carlo Method"@en ;
    mkg:hasMetadata kg:xing_2010_meta ;
    mkg:includes <http://example.org/kg/xing_2010/law/xing_2010_eq6.1>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.2>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.3>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.4>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.5>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.6>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq7.1>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq7.2>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq8> .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.1> a mkg:Law ;
    rdfs:label "xing_2010 eq 6.1"@en ;
    mkg:computes <http://example.org/kg/xing_2010/law/xing_2010_eq6.1/var/X_V> ;
    mkg:equationNumber "6.1" ;
    mkg:hasMetadata <http://example.org/kg/xing_2010/law/xing_2010_eq6.1_meta> ;
    mkg:latex "\\frac{d X_{V}}{d t} =(\\mu-\\mu_{d})\\cdot X_{V}" ;
    mkg:uses <http://example.org/kg/xing_2010/law/xing_2010_eq6.1/var/mu>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.1/var/mu_d> .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.1/var/X_V> a mkg:Variable ;
    rdfs:label "X_{V} (xing_2010 eq 6.1)"@en ;
    mkg:description "Viable cell density" ;
    mkg:dimension "[cell] / [length] ** 3" ;
    mkg:initialQuote "Cell cultures were seeded at a viable cell density of $ \\sim0.2 \\times 10^6 $ cells mL $ ^{-1} $." ;
    mkg:initialValue "∼0.2 × 10^6 cells mL^{-1}" ;
    mkg:measured true ;
    mkg:measuredQuote "Viable cell density ( $ X_{v} $) was determined by the average of eight cell counts." ;
    mkg:siFactor 1e+12 ;
    mkg:symbol "X_{V}" ;
    mkg:unit "cells / l (x1e+09)" ;
    mkg:unitString "10^9 cells L^-1" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.1/var/mu> a mkg:Variable ;
    rdfs:label "\\mu (xing_2010 eq 6.1)"@en ;
    mkg:description "Specific cell growth rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "\\mu" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.1/var/mu_d> a mkg:Variable ;
    rdfs:label "\\mu_{d} (xing_2010 eq 6.1)"@en ;
    mkg:description "Specific cell death rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "\\mu_{d}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.1_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Viable-cell-density balance computes net accumulation from specific growth and cell death." ;
    mkg:doi "10.1002/btpr.284" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "The mass balance for titer, [B1], was applied only after 144 h" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The B1 mass balance is applied only after 144 h." ] ;
    mkg:page "3" ;
    mkg:quote "\\frac{d X_{V}}{d t} =(\\mu-\\mu_{d})\\cdot X_{V}" ;
    mkg:status "pending" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.2> a mkg:Law ;
    rdfs:label "xing_2010 eq 6.2"@en ;
    mkg:computes <http://example.org/kg/xing_2010/law/xing_2010_eq6.2/var/C_GLC> ;
    mkg:equationNumber "6.2" ;
    mkg:hasMetadata <http://example.org/kg/xing_2010/law/xing_2010_eq6.2_meta> ;
    mkg:hasParameter <http://example.org/kg/xing_2010/law/xing_2010_eq6.2/par/Y_X_V_glc>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.2/par/m_glc> ;
    mkg:latex "\\frac{d[\\mathrm{GLC}]}{d t} =-\\left((\\mu-\\mu_{d})/Y_{X_{V}/\\mathrm{glc}}+m_{\\mathrm{glc}}\\right)\\cdot X_{V}" ;
    mkg:uses <http://example.org/kg/xing_2010/law/xing_2010_eq6.2/var/X_V>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.2/var/mu>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.2/var/mu_d> .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.2/par/Y_X_V_glc> a mkg:Parameter ;
    rdfs:label "Y_{X_V/glc} (xing_2010 eq 6.2)"@en ;
    mkg:basis "stated" ;
    mkg:description "Glucose yield coefficient" ;
    mkg:dimension "[cell] / [substance]" ;
    mkg:page "11" ;
    mkg:quote "Y_{Xv/glc} = glucose yield coefficient, cell L^{-1} mM^{-1}" ;
    mkg:reason "A glucose yield coefficient calculated from cell-culture data and used as a model constant." ;
    mkg:siFactor 1e+11 ;
    mkg:status "accepted" ;
    mkg:symbol "Y_{X_V/glc}" ;
    mkg:unit "cells / mol (x1e+11)" ;
    mkg:unitString "10^11 cells mol^-1" ;
    mkg:value 1.69e+00 ;
    mkg:valueUncertainty "± 0.37" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.2/par/m_glc> a mkg:Parameter ;
    rdfs:label "m_{glc} (xing_2010 eq 6.2)"@en ;
    mkg:basis "stated" ;
    mkg:description "Glucose maintenance coefficient" ;
    mkg:dimension "[substance] / [cell] / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "Table 3. Model Parameters Estimated by MCMC Sampling Procedure" ;
    mkg:page "11" ;
    mkg:quote "m_{glc} = glucose maintenance coefficient, 10^{-9} mmol cell^{-1} h^{-1}" ;
    mkg:reason "A glucose maintenance coefficient estimated as a kinetic constant for the model." ;
    mkg:siFactor 2.777778e-19 ;
    mkg:status "accepted" ;
    mkg:symbol "m_{glc}" ;
    mkg:unit "mmol / cells / h (x1e-12)" ;
    mkg:unitString "10^-12 mmol cell^-1 h^-1" ;
    mkg:value 6.92e+01 ;
    mkg:valueUncertainty "± 9.0" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.2/var/C_GLC> a mkg:Variable ;
    rdfs:label "[GLC] (xing_2010 eq 6.2)"@en ;
    mkg:description "Glucose concentration" ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:measured true ;
    mkg:measuredQuote "Concentrations of glucose ([GLC]), glutamine ([GLN]), lactate ([LAC]), and ammonia ([AMM]) were measured using a NOVA Bioprofile 400 (NOVA Biomedical, Waltham, MA)." ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "[GLC]" ;
    mkg:unit "mM" ;
    mkg:unitString "mM" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.2/var/X_V> a mkg:Variable ;
    rdfs:label "X_{V} (xing_2010 eq 6.2)"@en ;
    mkg:description "Viable cell density" ;
    mkg:dimension "[cell] / [length] ** 3" ;
    mkg:initialQuote "Cell cultures were seeded at a viable cell density of $ \\sim0.2 \\times 10^6 $ cells mL $ ^{-1} $." ;
    mkg:initialValue "∼0.2 × 10^6 cells mL^{-1}" ;
    mkg:measured true ;
    mkg:measuredQuote "Viable cell density ( $ X_{v} $) was determined by the average of eight cell counts." ;
    mkg:siFactor 1e+12 ;
    mkg:symbol "X_{V}" ;
    mkg:unit "cells / l (x1e+09)" ;
    mkg:unitString "10^9 cells L^-1" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.2/var/mu> a mkg:Variable ;
    rdfs:label "\\mu (xing_2010 eq 6.2)"@en ;
    mkg:description "Specific cell growth rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "\\mu" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.2/var/mu_d> a mkg:Variable ;
    rdfs:label "\\mu_{d} (xing_2010 eq 6.2)"@en ;
    mkg:description "Specific cell death rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "\\mu_{d}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.2_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Glucose balance computes concentration change from cell-associated glucose consumption and maintenance consumption." ;
    mkg:doi "10.1002/btpr.284" ;
    mkg:form "ODE" ;
    mkg:page "3" ;
    mkg:quote "\\frac{d[\\mathrm{GLC}]}{d t} =-\\left((\\mu-\\mu_{d})/Y_{X_{V}/\\mathrm{glc}}+m_{\\mathrm{glc}}\\right)\\cdot X_{V}" ;
    mkg:status "pending" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.3> a mkg:Law ;
    rdfs:label "xing_2010 eq 6.3"@en ;
    mkg:computes <http://example.org/kg/xing_2010/law/xing_2010_eq6.3/var/C_GLN> ;
    mkg:equationNumber "6.3" ;
    mkg:hasMetadata <http://example.org/kg/xing_2010/law/xing_2010_eq6.3_meta> ;
    mkg:hasParameter <http://example.org/kg/xing_2010/law/xing_2010_eq6.3/par/Y_X_V_gln>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.3/par/d_gln> ;
    mkg:latex "\\frac{d[\\mathrm{GLN}]}{d t} =-\\left((\\mu-\\mu_{d})/Y_{X_{V}/\\mathrm{g}\\ln}+m_{\\mathrm{g}\\ln}\\right)\\cdot X_{V}-d_{g\\ln}[\\mathrm{GLN}]" ;
    mkg:uses <http://example.org/kg/xing_2010/law/xing_2010_eq6.3/var/X_V>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.3/var/m_gln>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.3/var/mu>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.3/var/mu_d> .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.3/par/Y_X_V_gln> a mkg:Parameter ;
    rdfs:label "Y_{X_V/gln} (xing_2010 eq 6.3)"@en ;
    mkg:basis "stated" ;
    mkg:description "Glutamine yield coefficient" ;
    mkg:dimension "[cell] / [substance]" ;
    mkg:page "11" ;
    mkg:quote "Y_{Xv/gln} = glutamine yield coefficient, cell L^{-1} mM^{-1}" ;
    mkg:reason "A glutamine yield coefficient calculated from cell-culture data and used as a model constant." ;
    mkg:siFactor 1e+11 ;
    mkg:status "accepted" ;
    mkg:symbol "Y_{X_V/gln}" ;
    mkg:unit "cells / mol (x1e+11)" ;
    mkg:unitString "10^11 cells mol^-1" ;
    mkg:value 9.74e+00 ;
    mkg:valueUncertainty "± 1.65" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.3/par/d_gln> a mkg:Parameter ;
    rdfs:label "d_{gln} (xing_2010 eq 6.3)"@en ;
    mkg:basis "stated" ;
    mkg:description "First-order decomposition rate of glutamine" ;
    mkg:dimension "1 / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "Table 3. Model Parameters Estimated by MCMC Sampling Procedure" ;
    mkg:page "11" ;
    mkg:quote "d_{gln} = first-order decomposition rate of glutamine, h^{-1}" ;
    mkg:reason "A first-order decomposition rate constant for glutamine in the model." ;
    mkg:siFactor 2.777778e-07 ;
    mkg:status "accepted" ;
    mkg:symbol "d_{gln}" ;
    mkg:unit "1 / h (x0.001)" ;
    mkg:unitString "10^-3 h^-1" ;
    mkg:value 7.2e+00 ;
    mkg:valueUncertainty "± 0.4" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.3/var/C_GLN> a mkg:Variable ;
    rdfs:label "[GLN] (xing_2010 eq 6.3)"@en ;
    mkg:description "Glutamine concentration" ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:measured true ;
    mkg:measuredQuote "Concentrations of glucose ([GLC]), glutamine ([GLN]), lactate ([LAC]), and ammonia ([AMM]) were measured using a NOVA Bioprofile 400 (NOVA Biomedical, Waltham, MA)." ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "[GLN]" ;
    mkg:unit "mM" ;
    mkg:unitString "mM" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.3/var/X_V> a mkg:Variable ;
    rdfs:label "X_{V} (xing_2010 eq 6.3)"@en ;
    mkg:description "Viable cell density" ;
