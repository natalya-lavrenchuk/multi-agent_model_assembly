<http://example.org/kg/xing_2010/law/xing_2010_eq6.5_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Ammonia balance computes production from glutamine consumption and decomposition, less ammonia removal." ;
    mkg:doi "10.1002/btpr.284" ;
    mkg:form "ODE" ;
    mkg:page "3" ;
    mkg:quote "\\frac{d[\\mathrm{AMM}]}{d t} =Y_{\\mathrm{amm}/\\mathrm{g}\\ln}\\cdot\\left((\\mu-\\mu_{d})/Y_{X_{V}/\\mathrm{g}\\ln}\\right)\\cdot X_{V}-r_{\\mathrm{amm}}\\cdot X_{V} +d_{\\mathrm{g}\\ln}[\\mathrm{GLN}]" ;
    mkg:status "pending" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.6> a mkg:Law ;
    rdfs:label "xing_2010 eq 6.6"@en ;
    mkg:computes <http://example.org/kg/xing_2010/law/xing_2010_eq6.6/var/C_B1> ;
    mkg:equationNumber "6.6" ;
    mkg:hasMetadata <http://example.org/kg/xing_2010/law/xing_2010_eq6.6_meta> ;
    mkg:hasParameter <http://example.org/kg/xing_2010/law/xing_2010_eq6.6/par/Q_B1>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.6/par/mu_max> ;
    mkg:latex "\\frac{d[\\mathrm{B1}]}{d t} =Q_{B1}\\cdot X_{V}\\cdot\\left(1-\\frac{\\mu}{\\mu_{\\max}}\\right)\\cdot[B1]" ;
    mkg:uses <http://example.org/kg/xing_2010/law/xing_2010_eq6.6/var/X_V>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq6.6/var/mu> .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.6/par/Q_B1> a mkg:Parameter ;
    rdfs:label "Q_{B1} (xing_2010 eq 6.6)"@en ;
    mkg:basis "stated" ;
    mkg:description "specific B1 production rate" ;
    mkg:dimension "[length] ** 3 / [cell] / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "Table 3. Model Parameters Estimated by MCMC Sampling Procedure" ;
    mkg:page "11" ;
    mkg:quote "$ Q_{B1} = \\text{specific B1 production rate } (10^{-9} \\text{ L cell}^{-1} \\text{ h}^{-1}) $" ;
    mkg:reason "A specific B1 production-rate coefficient in the B1 production law." ;
    mkg:siFactor 2.777778e-19 ;
    mkg:status "accepted" ;
    mkg:symbol "Q_{B1}" ;
    mkg:unit "l / cells / h (x1e-12)" ;
    mkg:unitString "10^-12 L cell^-1 h^-1" ;
    mkg:value 4e+00 ;
    mkg:valueUncertainty "± 0.5" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.6/par/mu_max> a mkg:Parameter ;
    rdfs:label "\\mu_{\\max} (xing_2010 eq 6.6)"@en ;
    mkg:basis "stated" ;
    mkg:description "maximum specific cell growth rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:estimation "set" ;
    mkg:estimationQuote "The parameters $\\mu_{max}$ and $k_d$ are determined from 112 historical cell culture runs in 5,000-L bioreactors." ;
    mkg:page "11" ;
    mkg:quote "$ \\mu_{max} $ = maximum specific cell growth rate (h^{-1})" ;
    mkg:reason "A maximum specific cell growth-rate constant used in the growth-rate law." ;
    mkg:siFactor 2.777778e-04 ;
    mkg:status "accepted" ;
    mkg:symbol "\\mu_{\\max}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" ;
    mkg:value 2.9e-02 .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.6/var/C_B1> a mkg:Variable ;
    rdfs:label "[B1] (xing_2010 eq 6.6)"@en ;
    mkg:description "B1 protein titer" ;
    mkg:measured true ;
    mkg:measuredQuote "B1 protein titers ([B1]) were measured by affinity chromatography using an internally developed method." ;
    mkg:symbol "[B1]" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.6/var/X_V> a mkg:Variable ;
    rdfs:label "X_{V} (xing_2010 eq 6.6)"@en ;
    mkg:description "Viable cell density" ;
    mkg:dimension "[cell] / [length] ** 3" ;
    mkg:initialQuote "Cell cultures were seeded at a viable cell density of $ \\sim0.2 \\times 10^6 $ cells mL $ ^{-1} $." ;
    mkg:initialValue "∼0.2 × 10^6 cells mL^{-1}" ;
    mkg:measured true ;
    mkg:measuredQuote "Viable cell density ( $ X_{v} $) was determined by the average of eight cell counts." ;
    mkg:siFactor 1e+12 ;
    mkg:symbol "X_{V}" ;
    mkg:unit "cells / l (x1e+09)" ;
    mkg:unitString "10^9 cells L^-1" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.6/var/mu> a mkg:Variable ;
    rdfs:label "\\mu (xing_2010 eq 6.6)"@en ;
    mkg:description "Specific cell growth rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "\\mu" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.6_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "B1 titer accumulation is proportional to viable-cell density, the arrested-cell fraction, and existing B1 titer." ;
    mkg:doi "10.1002/btpr.284" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "Assuming all viable cells are dividing in exponential growth phase with the specific growth rate of μmax" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "All viable cells are assumed to divide during exponential growth at the maximum specific growth rate." ] ;
    mkg:page "3" ;
    mkg:quote "\\frac{d[\\mathrm{B1}]}{d t} =Q_{B1}\\cdot X_{V}\\cdot\\left(1-\\frac{\\mu}{\\mu_{\\max}}\\right)\\cdot[B1]" ;
    mkg:status "pending" .

<http://example.org/kg/xing_2010/law/xing_2010_eq7.1> a mkg:Law ;
    rdfs:label "xing_2010 eq 7.1"@en ;
    mkg:computes <http://example.org/kg/xing_2010/law/xing_2010_eq7.1/var/mu> ;
    mkg:equationNumber "7.1" ;
    mkg:hasMetadata <http://example.org/kg/xing_2010/law/xing_2010_eq7.1_meta> ;
    mkg:hasParameter <http://example.org/kg/xing_2010/law/xing_2010_eq7.1/par/KI_amm>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq7.1/par/KI_lac>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq7.1/par/K_glc>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq7.1/par/K_gln>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq7.1/par/mu_max> ;
    mkg:latex "\\mu=\\mu_{\\max} \\frac{[GLC]}{K_{\\mathrm{glc}}+[GLC]}\\cdot\\frac{[GLN]}{K_{\\mathrm{g}\\ln}+[GLN]}\\cdot\\frac{\\mathrm{KI}_{\\mathrm{lac}}}{KI_{\\mathrm{lac}}+[LAC]} \\cdot\\frac{\\mathrm{KI}_{\\mathrm{amm}}}{KI_{\\mathrm{amm}}+[AMM]}" ;
    mkg:uses <http://example.org/kg/xing_2010/law/xing_2010_eq7.1/var/C_AMM>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq7.1/var/C_GLC>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq7.1/var/C_GLN>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq7.1/var/C_LAC> .

<http://example.org/kg/xing_2010/law/xing_2010_eq7.1/var/mu> a mkg:Variable ;
    rdfs:label "\\mu (xing_2010 eq 7.1)"@en ;
    mkg:description "Specific cell growth rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "\\mu" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/xing_2010/law/xing_2010_eq7.1_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Monod-type specific growth rate is limited by glucose and glutamine and inhibited by lactate and ammonia." ;
    mkg:doi "10.1002/btpr.284" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "Therefore, the ammonia or lactate was considered in Eq. 7 only when the concentration exceeded 90% of their threshold value, or 4.6 and 52 mM for ammonia and lactate, respectively." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Ammonia and lactate are considered in the growth-rate equation only above 90% of their thresholds." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/xing_2010/law/xing_2010_eq7.1/var/C_GLN> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/xing_2010/law/xing_2010_eq7.1/var/C_LAC> ;
            mkg:slot "inhibitor" ],
        [ mkg:boundTo <http://example.org/kg/xing_2010/law/xing_2010_eq7.1/par/KI_lac> ;
            mkg:slot "inhibition constant" ],
        [ mkg:boundTo <http://example.org/kg/xing_2010/law/xing_2010_eq7.1/par/K_gln> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/xing_2010/law/xing_2010_eq7.1/par/K_glc> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/xing_2010/law/xing_2010_eq7.1/var/C_GLC> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/xing_2010/law/xing_2010_eq7.1/par/KI_amm> ;
            mkg:slot "inhibition constant" ],
        [ mkg:boundTo <http://example.org/kg/xing_2010/law/xing_2010_eq7.1/par/mu_max> ;
            mkg:slot "maximum rate" ],
        [ mkg:boundTo <http://example.org/kg/xing_2010/law/xing_2010_eq7.1/var/C_AMM> ;
            mkg:slot "inhibitor" ] ;
    mkg:page "3" ;
    mkg:quote "\\mu=\\mu_{\\max} \\frac{[GLC]}{K_{\\mathrm{glc}}+[GLC]}\\cdot\\frac{[GLN]}{K_{\\mathrm{g}\\ln}+[GLN]}\\cdot\\frac{\\mathrm{KI}_{\\mathrm{lac}}}{KI_{\\mathrm{lac}}+[LAC]} \\cdot\\frac{\\mathrm{KI}_{\\mathrm{amm}}}{KI_{\\mathrm{amm}}+[AMM]}" ;
    mkg:status "pending" .

<http://example.org/kg/xing_2010/law/xing_2010_eq7.2> a mkg:Law ;
    rdfs:label "xing_2010 eq 7.2"@en ;
    mkg:computes <http://example.org/kg/xing_2010/law/xing_2010_eq7.2/var/mu_d> ;
    mkg:equationNumber "7.2" ;
    mkg:hasMetadata <http://example.org/kg/xing_2010/law/xing_2010_eq7.2_meta> ;
    mkg:hasParameter <http://example.org/kg/xing_2010/law/xing_2010_eq7.2/par/KD_amm>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq7.2/par/KD_lac>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq7.2/par/k_d> ;
    mkg:latex "\\mu_{d}=k_{d} \\cdot\\frac{[LAC]}{KD_{\\mathrm{lac}}+[LAC]}\\cdot\\frac{[AMM]}{KD_{\\mathrm{amm}}+[AMM]}" ;
    mkg:uses <http://example.org/kg/xing_2010/law/xing_2010_eq7.2/var/C_AMM>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq7.2/var/C_LAC> .

<http://example.org/kg/xing_2010/law/xing_2010_eq7.2/var/mu_d> a mkg:Variable ;
    rdfs:label "\\mu_{d} (xing_2010 eq 7.2)"@en ;
    mkg:description "Specific cell death rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "\\mu_{d}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/xing_2010/law/xing_2010_eq7.2_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Specific cell death rate increases with lactate and ammonia concentrations toward a maximum rate." ;
    mkg:doi "10.1002/btpr.284" ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/xing_2010/law/xing_2010_eq7.2/var/C_AMM> ;
            mkg:slot "inhibitor" ],
        [ mkg:boundTo <http://example.org/kg/xing_2010/law/xing_2010_eq7.2/par/KD_lac> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/xing_2010/law/xing_2010_eq7.2/var/C_LAC> ;
            mkg:slot "inhibitor" ],
        [ mkg:boundTo <http://example.org/kg/xing_2010/law/xing_2010_eq7.2/par/KD_amm> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/xing_2010/law/xing_2010_eq7.2/par/k_d> ;
            mkg:slot "maximum rate" ] ;
    mkg:page "3" ;
    mkg:quote "\\mu_{d}=k_{d} \\cdot\\frac{[LAC]}{KD_{\\mathrm{lac}}+[LAC]}\\cdot\\frac{[AMM]}{KD_{\\mathrm{amm}}+[AMM]}" ;
    mkg:status "pending" .

<http://example.org/kg/xing_2010/law/xing_2010_eq8> a mkg:Law ;
    rdfs:label "xing_2010 eq 8"@en ;
    mkg:computes <http://example.org/kg/xing_2010/law/xing_2010_eq8/var/m_gln> ;
    mkg:equationNumber "8" ;
    mkg:hasMetadata <http://example.org/kg/xing_2010/law/xing_2010_eq8_meta> ;
    mkg:hasParameter <http://example.org/kg/xing_2010/law/xing_2010_eq8/par/a_1>,
        <http://example.org/kg/xing_2010/law/xing_2010_eq8/par/a_2> ;
    mkg:latex "m_{gln}=\\frac{a_{1}[\\mathrm{GLN}]}{a_{2}+[\\mathrm{GLN}]}" ;
    mkg:uses <http://example.org/kg/xing_2010/law/xing_2010_eq8/var/C_GLN> .

<http://example.org/kg/xing_2010/law/xing_2010_eq8/var/m_gln> a mkg:Variable ;
    rdfs:label "m_{gln} (xing_2010 eq 8)"@en ;
    mkg:description "Glutamine maintenance coefficient" ;
    mkg:dimension "[substance] / [cell] / [time]" ;
    mkg:siFactor 2.777778e-19 ;
    mkg:symbol "m_{gln}" ;
    mkg:unit "mmol / cells / h (x1e-12)" ;
    mkg:unitString "10^-12 mmol cell^-1 h^-1" .

<http://example.org/kg/xing_2010/law/xing_2010_eq8_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Glutamine maintenance coefficient computed as a saturating function of glutamine concentration." ;
    mkg:doi "10.1002/btpr.284" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "Since $m_{\\mathrm{glc}}$ and $m_{\\mathrm{gln}}$ are negligible during exponential growth,$^{1,2,11}$ it was assumed $m_{\\mathrm{glc}} = 0$ and $m_{\\mathrm{gln}} = 0$ when $d \\leq 6$." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Glucose and glutamine maintenance terms are zero when d ≤ 6." ],
        [ mkg:quote "It was assumed that $\\mu = 0$ during the cell death phase." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Specific growth rate is zero during the cell death phase." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/xing_2010/law/xing_2010_eq8/par/a_2> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/xing_2010/law/xing_2010_eq8/var/C_GLN> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/xing_2010/law/xing_2010_eq8/par/a_1> ;
            mkg:slot "maximum rate" ] ;
    mkg:page "3" ;
    mkg:quote "m_{gln}=\\frac{a_{1}[\\mathrm{GLN}]}{a_{2}+[\\mathrm{GLN}]}" ;
    mkg:status "pending" .

kg:xing_2010_meta a mkg:Metadata ;
    mkg:completeModel true ;
    mkg:description "The model describes a proprietary Chinese hamster ovary cell line producing the B1 antibody fusion protein in fed-batch bioreactors. It predicts time courses of viable cell density and glucose, glutamine, ammonia, lactate, and B1 concentrations using six coupled dynamic equations with nutrient-limited growth, metabolite inhibition, cell maintenance, and product formation mechanisms. The model represents the daily feed additions by simulating each interval between feeds and was calibrated with MCMC using seven 5,000-L culture runs. It was tested on separate seven-run data sets at 5,000 L and 500 L, including a perturbed culture condition at 500 L. The authors use it to examine culture kinetics and inform medium design and process improvement." ;
    mkg:doi "10.1002/btpr.284" ;
    mkg:form "DAE" ;
    mkg:hasFact [ mkg:basis "inferred" ;
            mkg:text "The model is a lumped culture description rather than a spatially distributed model." ;
            mkg:topic "model" ],
        [ mkg:basis "inferred" ;
            mkg:text "Samples were collected daily before feeding, so the reported measurements were prefeed values." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "An alternative model without the ammonia removal rate (r_amm) was evaluated and resulted in an overestimation for [AMM] values" ;
            mkg:text "Removing ammonia removal from the model caused ammonia concentrations to be overestimated." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "All 84 PSRF-values (12 parameters from seven cell culture runs) fell in the range of 1.00 and 1.06, indicating that the estimates were consistent after 10,000 iterations." ;
            mkg:text "After 10,000 iterations, the 84 convergence statistics across 12 parameters and seven training runs ranged from 1.00 to 1.06." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Concentrations of glucose ([GLC]), glutamine ([GLN]), lactate ([LAC]), and ammonia ([AMM]) were measured using a NOVA Bioprofile 400" ;
            mkg:text "Glucose, glutamine, lactate, and ammonia were measured using a NOVA Bioprofile 400." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "The predicted time profiles agreed with the measured time profiles for the six variables in both validation data sets" ;
            mkg:text "The paper reports agreement between predicted and measured profiles in both validation sets, including the perturbed 500-L cultures." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Data from the 500 L pilot scale bioreactors were necessary because such perturbations were not allowed in the GMP environment of the 5,000-L bioreactors." ;
            mkg:text "The 500-L validation set tested a perturbed culture condition because such perturbations were not permitted in the 5,000-L GMP facility." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The DAEs were used for kinetic modeling of a batch hybridoma cell culture." ;
            mkg:text "The model's differential-equation framework draws on prior hybridoma culture kinetic work by Tatiraju et al. 1999." ;
            mkg:topic "prior models" ],
        [ mkg:basis "stated" ;
            mkg:quote "three MCMC sampling trains were used for each cell culture run." ;
            mkg:text "MCMC estimation used three independent sampling trains per training run, each initialized with a different parameter set." ;
            mkg:topic "estimation" ],
        [ mkg:basis "inferred" ;
            mkg:text "The model predicted the time profiles of all six variables in seven independent 5,000-L runs and seven 500-L runs." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The value of m_gln is a function of glutamine" ;
            mkg:text "The model includes nutrient maintenance consumption, and the glutamine maintenance coefficient varies with glutamine concentration." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "B1 protein titers ([B1]) were measured by affinity chromatography using an internally developed method." ;
            mkg:text "B1 titers were measured by affinity chromatography using an internally developed method." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "Since the titer measurements started after 140 h, there were fewer numbers of measurements for [B1] than for the other variables." ;
            mkg:text "B1 measurements began after approximately 140 h, leaving fewer B1 observations than observations for the other variables." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "a large-scale fed-batch Chinese hamster ovary (CHO) cell culture process" ;
            mkg:text "The model describes a proprietary CHO cell line producing the B1 antibody fusion protein." ;
            mkg:topic "system" ],
        [ mkg:basis "stated" ;
            mkg:quote "The kinetic model consists of six differential equations, which describe dynamics of viable cell density and concentrations of glucose, glutamine, ammonia, lactate, and the antibody fusion protein B1 (B1)." ;
            mkg:text "The model predicts viable cell density and concentrations of glucose, glutamine, ammonia, lactate, and B1 protein." ;
            mkg:topic "system" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper does not state that model code or underlying data are publicly available." ;
            mkg:topic "availability" ],
        [ mkg:basis "inferred" ;
            mkg:text "The authors suggest applicability from 50-L through 5,000-L scales, based partly on reported similarity between 50-L and 500-L profiles." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The [B1] protein mass balance was expressed as an exponential function of [B1] in Eq. 6." ;
            mkg:text "B1 production uses an exponential dependence on B1 concentration and accounts for the estimated fraction of arrested viable cells." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "The Monod equation is based on the availability of limiting nutrients (such as glucose and glutamine) and inhibitors (such as lactate and ammonia) in a concentration-dependent pattern." ;
            mkg:text "Cell growth is described with Monod-type nutrient limitation and inhibition by ammonia and lactate." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "A kinetic model that quantitatively elucidates the effects of limiting nutrients and repressing metabolites on cell growth and protein productivity can be used for simulation, optimization, and process control in cell cultures." ;
            mkg:text "The authors propose the model for simulation, optimization, process control, medium design, and process improvement." ;
            mkg:topic "application" ],
        [ mkg:basis "stated" ;
            mkg:quote "A total of 112 cell culture runs were used to estimate μ_max and k_d." ;
            mkg:text "Maximum growth and cell-death rate constants were derived from 112 historical 5,000-L runs using upper limits at the 95% confidence level." ;
            mkg:topic "parameters" ],
        [ mkg:basis "inferred" ;
            mkg:text "Cultures were inoculated at approximately 0.2 × 10⁶ viable cells mL⁻¹ and started at 37°C." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "approximately 83% of consumed glucose was used for cell maintenance in the late stage of cell culture." ;
            mkg:text "The authors estimate that about 83% of glucose consumed after 200 h was used for cell maintenance, while glutamine maintenance was negligible." ;
            mkg:topic "findings" ],
        [ mkg:basis "stated" ;
            mkg:quote "ammonia and lactate played critical roles on cell growth and cell death." ;
            mkg:text "The model indicates that ammonia and lactate are important factors in cell growth and cell death." ;
            mkg:topic "findings" ],
        [ mkg:basis "stated" ;
            mkg:quote "After completing 10,000 iterations, the outcomes of the first 5,000 iterations were discarded" ;
            mkg:text "Each MCMC train ran for 10,000 iterations, and the first 5,000 iterations were discarded before calculating the parameter estimate." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "the DAEs replaced the hidden layer of an ordinary neural network." ;
            mkg:text "The authors describe the model structure as similar to a neural network but with explicit kinetic equations replacing its hidden layer, in contrast to Marique et al. 2001." ;
            mkg:topic "prior models" ],
        [ mkg:basis "stated" ;
            mkg:quote "The ODE23 function of MATLAB Version 7.5 (Mathwork, Natick, MA) was used to numerically solve Eq. 6 for each time period." ;
            mkg:text "The model treats each interval between successive daily feeds as a batch-culture interval and numerically solves it with MATLAB's ODE23 function." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "The temperature, pH, and dissolved oxygen were controlled with an internally developed process." ;
            mkg:text "Temperature, pH, and dissolved oxygen were controlled using an internally developed process." ;
            mkg:topic "operation" ],
        [ mkg:basis "inferred" ;
            mkg:text "For the training data, all six variables had coefficients of determination above 0.96 and regression slopes between 0.94 and 1.05." ;
            mkg:topic "fit" ],
        [ mkg:basis "stated" ;
            mkg:quote "Viable cell density (X_v) was determined by the average of eight cell counts. Cell counts were performed by trypan blue dye exclusion using a hemocytometer." ;
            mkg:text "Viable cell density was measured by averaging eight trypan-blue-exclusion counts made with a hemocytometer." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "The value of σ_i^(d) was the standard deviation for the corresponding measurement from the 14 cell culture runs in 5,000-L bioreactors used in this study." ;
            mkg:text "The likelihood calculation used measurement standard deviations estimated from 14 5,000-L culture runs." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "the different metabolites profiles and lower viable cell density and B1 protein titer were observed in 5,000-L bioreactors, which was caused by inadequate mixing in 5,000-L bioreactors" ;
            mkg:text "The authors attribute lower viable cell density and B1 titer and different metabolite profiles at 5,000 L than at 500 L to inadequate mixing at 5,000 L." ;
            mkg:topic "scale" ],
        [ mkg:basis "stated" ;
            mkg:quote "The kinetic model has 18 parameters, six of which were calculated from the cell culture data, whereas the other 12 were estimated from a training data set" ;
            mkg:text "The model has 18 parameters, of which six were calculated from culture data and 12 were estimated using MCMC." ;
            mkg:topic "model" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper contrasts its exponential product balance with the linear product-balance formulations of Tatiraju et al. 1999 and Simon and Karim 2002, and notes an exponential formulation by Jang and Barford 2000." ;
            mkg:topic "prior models" ],
        [ mkg:basis "stated" ;
            mkg:quote "the linear function for [B1] protein mass balance underestimated [B1] values" ;
            mkg:text "Replacing the exponential B1 balance with a linear one caused the model to underestimate B1 concentrations." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "the estimated K_glc and K_gln values in this study suggest concentrations of [GLC] and [GLN] of 0.17 and 0.09 mM be used to reduce lactate and ammonia production in the current CHO cell culture process." ;
            mkg:text "The model suggests initial medium concentrations of 0.17 mM glucose and 0.09 mM glutamine to reduce lactate and ammonia production." ;
            mkg:topic "findings" ],
        [ mkg:basis "stated" ;
            mkg:quote "Cell culture runs were carried out in 5,000-L and 500-L bioreactors" ;
            mkg:text "The production process was operated in 5,000-L bioreactors, with scale-down studies in 500-L bioreactors." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The average values of 14 cell culture runs are presented in Table 2." ;
            mkg:text "Yield constants were calculated from the exponential-growth period using data from 14 culture runs." ;
            mkg:topic "parameters" ],
        [ mkg:basis "stated" ;
            mkg:quote "The kinetic model uniquely incorporated the ammonia removal" ;
            mkg:text "The glutamine balance includes first-order glutamine decomposition, and the ammonia balance includes viable-cell-dependent ammonia removal." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "The other 23 cell culture runs were not used for k_d calculation due to earlier harvest." ;
            mkg:text "The cell-death rate constant calculation omitted 23 historical runs because those cultures were harvested earlier." ;
            mkg:topic "parameters" ],
        [ mkg:basis "stated" ;
            mkg:quote "Although 56 measurements were plotted (seven cell culture runs at eight sampling times) for [B1], 91 measurements were plotted (seven cell culture runs at 13 sampling times) for the other five parameters." ;
            mkg:text "The training comparisons included 91 measured-simulated pairs for each of the five non-titer variables and 56 pairs for B1." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "inhibition to cell growth became significant when ammonia and/or lactate reached concentrations of 5.1 and 58 mM, respectively (threshold values)." ;
            mkg:text "The paper identifies 5.1 mM ammonia and 58 mM lactate as concentrations at which growth inhibition becomes significant in this process." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "An unstructured model relies on concentrations of nutrients and metabolites in cultures, and neglects intracellular processes." ;
            mkg:text "The model uses extracellular nutrient and metabolite concentrations and does not explicitly resolve intracellular processes, consistent with an unstructured formulation." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "The 500-L bioreactors were run under the scaled-down strategy with the same bioreactor configuration, the scaled agitation rate, and the same volume per volume per minute of air flow rate." ;
            mkg:text "The 500-L scale-down used the same bioreactor configuration and volumetric air flow rate as the 5,000-L process, with agitation scaled down." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Each data set comprised seven cell culture runs." ;
            mkg:text "The training data comprised seven 5,000-L culture runs, and each of the two validation data sets comprised seven runs." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "This work reports the application of the MCMC method to develop a model that accurately described the kinetics of a large-scale fed-batch Chinese hamster ovary (CHO) cell culture process." ;
            mkg:text "The model is a dynamic, six-equation kinetic model that predicts six culture variables." ;
            mkg:topic "model" ],
        [ mkg:basis "inferred" ;
            mkg:text "The proposal distribution for the parameters was log-normal." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Cell cultures were performed in fed-batch mode with daily feeding from the first day though the end of cultivation period to maintain the proprietary glucose concentration." ;
            mkg:text "The fed-batch cultures received daily feed additions from the first day through the end of cultivation to maintain the proprietary glucose concentration." ;
            mkg:topic "feeding" ] ;
    mkg:status "pending" ;
    rdfs:comment "v0 distinct nodes; built from paddle.json (PaddleOCR-VL pipeline) by extractor/graph.py" .

<http://example.org/kg/xing_2010/law/xing_2010_eq7.1/par/KI_amm> a mkg:Parameter ;
