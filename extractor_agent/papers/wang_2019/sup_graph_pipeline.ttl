        <http://example.org/kg/wang_2019/law/wang_2019_eq14/par/k_ye> ;
    mkg:latex "Y_{\\mathrm{E}}^{c}=Y_{\\mathrm{E}}\\times\\exp(-k_{y e}\\times I_{\\mathrm{a v g\\_{R}}})" ;
    mkg:uses <http://example.org/kg/wang_2019/law/wang_2019_eq14/var/I_avg_R> .

<http://example.org/kg/wang_2019/law/wang_2019_eq14/par/Y_E> a mkg:Parameter ;
    rdfs:label "Y_{E} (wang_2019 eq 14)"@en ;
    mkg:basis "stated" ;
    mkg:description "Carbon yield on light energy" ;
    mkg:dimension "dimensionless" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "we estimated the parameter posterior distributions and quantified the model output uncertainties using the Markov chain Monte Carlo (MCMC) technique with the Delayed Rejection Adaptive Metropolis (DRAM) algorithm." ;
    mkg:page "8" ;
    mkg:quote "Carbon yield on light energy" ;
    mkg:reason "A fitted carbon-yield constant in the photosynthesis law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
