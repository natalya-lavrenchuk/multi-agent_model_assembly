@prefix kg: <http://example.org/kg/wang_2019/> .
@prefix mkg: <http://example.org/mkg#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kg:wang_2019 a mkg:Sup ;
    rdfs:label "wang_2019 · Dynamic Modeling of Microalgae Growth and Lipid Production under Transient Light and Nitrogen Conditions"@en ;
    mkg:hasMetadata kg:wang_2019_meta ;
    mkg:includes <http://example.org/kg/wang_2019/law/wang_2019_eq1>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq10>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq11>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq12>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq13>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq14>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq15>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq16>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq17>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq18>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq2>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq3>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq4>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq5>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq6>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq9> .

<http://example.org/kg/wang_2019/law/wang_2019_eq1> a mkg:Law ;
    rdfs:label "wang_2019 eq 1"@en ;
    mkg:computes <http://example.org/kg/wang_2019/law/wang_2019_eq1/var/X_cd> ;
    mkg:equationNumber "1" ;
    mkg:hasMetadata <http://example.org/kg/wang_2019/law/wang_2019_eq1_meta> ;
    mkg:hasParameter <http://example.org/kg/wang_2019/law/wang_2019_eq1/par/m>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq1/par/q_n> ;
    mkg:latex "\\frac{dX_{cd}}{dt} = \\left(1 - \\frac{q_n}{Q_n}\\right) \\cdot P \\cdot X_{cd}   -m \\cdot X_{cd}" ;
    mkg:uses <http://example.org/kg/wang_2019/law/wang_2019_eq1/var/P>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq1/var/Q_n> .

<http://example.org/kg/wang_2019/law/wang_2019_eq1/par/m> a mkg:Parameter ;
    rdfs:label "m (wang_2019 eq 1)"@en ;
    mkg:basis "inferred" ;
    mkg:description "First-order degradation rate constant for functional biomass." ;
    mkg:dimension "1 / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "we estimated the parameter posterior distributions and quantified the model output uncertainties using the Markov chain Monte Carlo (MCMC) technique" ;
    mkg:reason "A fitted first-order functional-biomass degradation rate constant." ;
    mkg:siFactor 1.157407e-05 ;
    mkg:status "accepted" ;
    mkg:symbol "m" ;
    mkg:unit "1 / d" ;
    mkg:unitString "d^{-1}" ;
    mkg:value 3.1142e+00 ;
    mkg:valueUncertainty "SD: 0.8468" .

<http://example.org/kg/wang_2019/law/wang_2019_eq1/par/q_n> a mkg:Parameter ;
    rdfs:label "q_{n} (wang_2019 eq 1)"@en ;
    mkg:basis "stated" ;
    mkg:description "Quota parameter in the nitrogen-quota-regulated partitioning of fixed carbon." ;
    mkg:dimension "dimensionless" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "we estimated the parameter posterior distributions and quantified the model output uncertainties using the Markov chain Monte Carlo (MCMC) technique" ;
    mkg:reason "A fitted quota constant in the carbon-partitioning law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "q_{n}" ;
    mkg:unit "dimensionless" ;
    mkg:unitNote "N C" ;
    mkg:unitString "mol N (mol C)^{-1}" ;
    mkg:value 1.75e-02 ;
    mkg:valueUncertainty "SD: 0.0035" .

<http://example.org/kg/wang_2019/law/wang_2019_eq1/var/P> a mkg:Variable ;
    rdfs:label "P (wang_2019 eq 1)"@en ;
    mkg:description "Photosynthesis rate normalized to functional biomass" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 1.157407e-05 ;
    mkg:symbol "P" ;
    mkg:unit "1 / d" ;
    mkg:unitNote "C X_{cd}-C" ;
    mkg:unitString "mol C (mol X_{cd}-C)⁻¹ d⁻¹" .

<http://example.org/kg/wang_2019/law/wang_2019_eq1/var/Q_n> a mkg:Variable ;
    rdfs:label "Q_{n} (wang_2019 eq 1)"@en ;
    mkg:description "Total nitrogen-to-carbon quota, calculated as cellular nitrogen divided by total fixed organic carbon." ;
    mkg:dimension "dimensionless" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "Q_{n}" ;
    mkg:unit "dimensionless" ;
    mkg:unitNote "N C" ;
    mkg:unitString "mol N (mol C)^{-1}" .

<http://example.org/kg/wang_2019/law/wang_2019_eq1/var/X_cd> a mkg:Variable ;
    rdfs:label "X_{cd} (wang_2019 eq 1)"@en ;
    mkg:description "Concentration of functional biomass (algal biomass excluding carbohydrates and neutral lipids) as C" ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "X_{cd}" ;
    mkg:unit "mol / m ** 3" ;
    mkg:unitNote "X_{cd}-C" ;
    mkg:unitString "mol X_{cd}-C m^{-3}" .

<http://example.org/kg/wang_2019/law/wang_2019_eq10> a mkg:Law ;
    rdfs:label "wang_2019 eq 10"@en ;
    mkg:computes <http://example.org/kg/wang_2019/law/wang_2019_eq10/var/I_avg> ;
    mkg:equationNumber "10" ;
    mkg:hasMetadata <http://example.org/kg/wang_2019/law/wang_2019_eq10_meta> ;
    mkg:hasParameter <http://example.org/kg/wang_2019/law/wang_2019_eq10/par/z_t> ;
    mkg:latex "I_{\\mathrm{avg}}=\\frac{1}{z_{t}}\\times\\int_{0}^{z_{t}}1.7324(l+d)^{-1.993}\\times\\exp(-A\\times l)\\mathrm{d}l" ;
    mkg:uses <http://example.org/kg/wang_2019/law/wang_2019_eq10/var/A>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq10/var/d> .

<http://example.org/kg/wang_2019/law/wang_2019_eq10/par/z_t> a mkg:Parameter ;
    rdfs:label "z_{t} (wang_2019 eq 10)"@en ;
    mkg:basis "stated" ;
    mkg:description "Thickness of the photobioreactor along the optical path" ;
    mkg:dimension "[length]" ;
    mkg:page "8" ;
    mkg:quote "Thickness of the photobioreactor along the optical path" ;
    mkg:reason "A fixed physical dimension of the photobioreactor." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "z_{t}" ;
    mkg:unit "m" ;
    mkg:unitString "m" .

<http://example.org/kg/wang_2019/law/wang_2019_eq10/var/A> a mkg:Variable ;
    rdfs:label "A (wang_2019 eq 10)"@en ;
    mkg:description "Light absorbance per unit length" ;
    mkg:dimension "1 / [length]" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "A" ;
    mkg:unit "1 / m" ;
    mkg:unitString "m⁻¹" .

<http://example.org/kg/wang_2019/law/wang_2019_eq10/var/I_avg> a mkg:Variable ;
    rdfs:label "I_{avg} (wang_2019 eq 10)"@en ;
    mkg:description "Instantaneous light intensity averaged over the optical path of the reactor" ;
    mkg:dimension "[substance] / [length] ** 2 / [time]" ;
    mkg:siFactor 1.157407e-05 ;
    mkg:symbol "I_{avg}" ;
    mkg:unit "mol / d / m ** 2" ;
    mkg:unitNote "photons" ;
    mkg:unitString "mol photons m⁻² d⁻¹" .

<http://example.org/kg/wang_2019/law/wang_2019_eq10/var/d> a mkg:Variable ;
    rdfs:label "d (wang_2019 eq 10)"@en ;
    mkg:basis "stated" ;
    mkg:description "Distance from the light source to the front of the reactor" ;
    mkg:dimension "[length]" ;
    mkg:page "8" ;
    mkg:quote "Distance from the light source to the front of the reactor" ;
    mkg:reason "The light-source distance is adjusted to control the light condition for a run." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "d" ;
    mkg:unit "m" ;
    mkg:unitString "m" .

<http://example.org/kg/wang_2019/law/wang_2019_eq10_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:description "The instantaneous light intensity is averaged across the reactor’s optical path." ;
    mkg:doi "10.1021/acs.est.9b02908" ;
    mkg:form "algebraic" ;
    mkg:page "3" ;
    mkg:quote "I_{\\mathrm{avg}}=\\frac{1}{z_{t}}\\times\\int_{0}^{z_{t}}1.7324(l+d)^{-1.993}\\times\\exp(-A\\times l)\\mathrm{d}l" ;
    mkg:status "pending" .

<http://example.org/kg/wang_2019/law/wang_2019_eq11> a mkg:Law ;
    rdfs:label "wang_2019 eq 11"@en ;
    mkg:computes <http://example.org/kg/wang_2019/law/wang_2019_eq11/var/I_avg_R> ;
    mkg:equationNumber "11" ;
    mkg:hasMetadata <http://example.org/kg/wang_2019/law/wang_2019_eq11_meta> ;
    mkg:hasParameter <http://example.org/kg/wang_2019/law/wang_2019_eq11/par/z_t> ;
    mkg:latex "I_{\\mathrm{a v g\\_{R}}}=\\frac{1}{z_{t}}\\times\\int_{0}^{z_{t}}1.7324(l+d)^{-1.993}\\mathrm{d}l" ;
    mkg:uses <http://example.org/kg/wang_2019/law/wang_2019_eq11/var/d> .

<http://example.org/kg/wang_2019/law/wang_2019_eq11/par/z_t> a mkg:Parameter ;
    rdfs:label "z_{t} (wang_2019 eq 11)"@en ;
    mkg:basis "stated" ;
    mkg:description "Thickness of the photobioreactor along the optical path" ;
    mkg:dimension "[length]" ;
    mkg:page "8" ;
    mkg:quote "Thickness of the photobioreactor along the optical path" ;
    mkg:reason "A fixed physical dimension of the photobioreactor." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "z_{t}" ;
    mkg:unit "m" ;
    mkg:unitString "m" .

<http://example.org/kg/wang_2019/law/wang_2019_eq11/var/I_avg_R> a mkg:Variable ;
    rdfs:label "I_{avg_R} (wang_2019 eq 11)"@en ;
    mkg:description "Average background light intensity over the reactor optical path" ;
    mkg:dimension "[substance] / [length] ** 2 / [time]" ;
    mkg:siFactor 1.157407e-05 ;
    mkg:symbol "I_{avg_R}" ;
    mkg:unit "mol / d / m ** 2" ;
    mkg:unitNote "photons" ;
    mkg:unitString "mol photons m⁻² d⁻¹" .

<http://example.org/kg/wang_2019/law/wang_2019_eq11/var/d> a mkg:Variable ;
    rdfs:label "d (wang_2019 eq 11)"@en ;
    mkg:basis "stated" ;
    mkg:description "Distance from the light source to the front of the reactor" ;
    mkg:dimension "[length]" ;
    mkg:page "8" ;
    mkg:quote "Distance from the light source to the front of the reactor" ;
    mkg:reason "The light-source distance is adjusted to control the light condition for a run." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "d" ;
    mkg:unit "m" ;
    mkg:unitString "m" .

<http://example.org/kg/wang_2019/law/wang_2019_eq11_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The background light intensity is averaged across the reactor’s optical path." ;
    mkg:doi "10.1021/acs.est.9b02908" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "In contrast, $ I_{\\mathrm{avg\\_R}} $ does not vary in time." ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The average background light intensity is treated as time-invariant." ] ;
    mkg:page "3" ;
    mkg:quote "I_{\\mathrm{a v g\\_{R}}}=\\frac{1}{z_{t}}\\times\\int_{0}^{z_{t}}1.7324(l+d)^{-1.993}\\mathrm{d}l" ;
    mkg:status "pending" .

<http://example.org/kg/wang_2019/law/wang_2019_eq12> a mkg:Law ;
    rdfs:label "wang_2019 eq 12"@en ;
    mkg:computes <http://example.org/kg/wang_2019/law/wang_2019_eq12/var/P> ;
    mkg:equationNumber "12" ;
    mkg:hasMetadata <http://example.org/kg/wang_2019/law/wang_2019_eq12_meta> ;
    mkg:hasParameter <http://example.org/kg/wang_2019/law/wang_2019_eq12/par/P_m> ;
    mkg:latex "P=\\left(\\frac{X_{\\mathrm{C}}}{X_{c d}}\\right)\\times P_{\\mathrm{m}}\\times\\frac{I_{\\mathrm{a v g}}}{I_{\\mathrm{s a t}}}\\times\\exp\\left(1-\\frac{I_{\\mathrm{a v g}}}{I_{\\mathrm{s a t}}}\\right)" ;
    mkg:uses <http://example.org/kg/wang_2019/law/wang_2019_eq12/var/I_avg>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq12/var/I_sat>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq12/var/X_C>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq12/var/X_cd> .

<http://example.org/kg/wang_2019/law/wang_2019_eq12/par/P_m> a mkg:Parameter ;
    rdfs:label "P_{m} (wang_2019 eq 12)"@en ;
    mkg:basis "stated" ;
    mkg:description "Maximum-rate coefficient in the photosynthesis equation" ;
    mkg:dimension "1 / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "we estimated the parameter posterior distributions and quantified the model output uncertainties using the Markov chain Monte Carlo (MCMC) technique with the Delayed Rejection Adaptive Metropolis (DRAM) algorithm." ;
    mkg:reason "A fitted maximum-rate constant in the photosynthesis law." ;
    mkg:siFactor 1.157407e-05 ;
    mkg:status "accepted" ;
    mkg:symbol "P_{m}" ;
    mkg:unit "1 / d" ;
    mkg:unitString "d^{-1}" ;
    mkg:value 4.3054e+00 ;
    mkg:valueUncertainty "0.7197" .

<http://example.org/kg/wang_2019/law/wang_2019_eq12/var/I_avg> a mkg:Variable ;
    rdfs:label "I_{avg} (wang_2019 eq 12)"@en ;
    mkg:description "Instantaneous light intensity averaged over the optical path of the reactor" ;
    mkg:dimension "[substance] / [length] ** 2 / [time]" ;
    mkg:siFactor 1.157407e-05 ;
    mkg:symbol "I_{avg}" ;
    mkg:unit "mol / d / m ** 2" ;
    mkg:unitNote "photons" ;
    mkg:unitString "mol photons m⁻² d⁻¹" .

<http://example.org/kg/wang_2019/law/wang_2019_eq12/var/I_sat> a mkg:Variable ;
    rdfs:label "I_{sat} (wang_2019 eq 12)"@en ;
    mkg:description "Saturated light intensity in the photosynthesis equation" ;
    mkg:dimension "[substance] / [length] ** 2 / [time]" ;
    mkg:siFactor 1.157407e-05 ;
    mkg:symbol "I_{sat}" ;
    mkg:unit "mol / d / m ** 2" ;
    mkg:unitNote "photons" ;
    mkg:unitString "mol photons m^{-2} d^{-1}" .

<http://example.org/kg/wang_2019/law/wang_2019_eq12/var/P> a mkg:Variable ;
    rdfs:label "P (wang_2019 eq 12)"@en ;
    mkg:description "Photosynthesis rate normalized to functional biomass" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 1.157407e-05 ;
    mkg:symbol "P" ;
    mkg:unit "1 / d" ;
    mkg:unitNote "C X_{cd}-C" ;
    mkg:unitString "mol C (mol X_{cd}-C)⁻¹ d⁻¹" .

<http://example.org/kg/wang_2019/law/wang_2019_eq12/var/X_C> a mkg:Variable ;
    rdfs:label "X_{C} (wang_2019 eq 12)"@en ;
    mkg:basis "stated" ;
    mkg:description "Total fixed organic carbon concentration" ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:reason "A concentration of total fixed organic carbon that changes with the model's carbon state quantities." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "X_{C}" ;
    mkg:unit "mol / m ** 3" ;
    mkg:unitNote "C" ;
    mkg:unitString "mol C m⁻³" .

<http://example.org/kg/wang_2019/law/wang_2019_eq12/var/X_cd> a mkg:Variable ;
    rdfs:label "X_{cd} (wang_2019 eq 12)"@en ;
    mkg:description "Concentration of functional biomass (algal biomass excluding carbohydrates and neutral lipids) as C" ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "X_{cd}" ;
    mkg:unit "mol / m ** 3" ;
    mkg:unitNote "X_{cd}-C" ;
    mkg:unitString "mol X_{cd}-C m^{-3}" .

<http://example.org/kg/wang_2019/law/wang_2019_eq12_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The photosynthesis rate per functional biomass follows a modified Steele-type relationship with light intensity, saturation, and inhibition." ;
    mkg:doi "10.1021/acs.est.9b02908" ;
    mkg:form "algebraic" ;
    mkg:page "3" ;
    mkg:quote "P=\\left(\\frac{X_{\\mathrm{C}}}{X_{c d}}\\right)\\times P_{\\mathrm{m}}\\times\\frac{I_{\\mathrm{a v g}}}{I_{\\mathrm{s a t}}}\\times\\exp\\left(1-\\frac{I_{\\mathrm{a v g}}}{I_{\\mathrm{s a t}}}\\right)" ;
    mkg:status "pending" .

<http://example.org/kg/wang_2019/law/wang_2019_eq13> a mkg:Law ;
    rdfs:label "wang_2019 eq 13"@en ;
    mkg:computes <http://example.org/kg/wang_2019/law/wang_2019_eq13/var/I_sat> ;
    mkg:equationNumber "13" ;
    mkg:hasMetadata <http://example.org/kg/wang_2019/law/wang_2019_eq13_meta> ;
    mkg:hasParameter <http://example.org/kg/wang_2019/law/wang_2019_eq13/par/P_m>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq13/par/a> ;
    mkg:latex "I_{\\mathrm{s a t}}=\\frac{P_{\\mathrm{m}}\\times X_{\\mathrm{C}}}{a\\times Y_{\\mathrm{E}}^{c}\\times X_{\\mathrm{c h l}}}" ;
    mkg:uses <http://example.org/kg/wang_2019/law/wang_2019_eq13/var/X_C>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq13/var/X_chl>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq13/var/Y_E_c> .

<http://example.org/kg/wang_2019/law/wang_2019_eq13/par/P_m> a mkg:Parameter ;
    rdfs:label "P_{m} (wang_2019 eq 13)"@en ;
    mkg:basis "stated" ;
    mkg:description "Maximum-rate coefficient in the photosynthesis equation" ;
    mkg:dimension "1 / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "we estimated the parameter posterior distributions and quantified the model output uncertainties using the Markov chain Monte Carlo (MCMC) technique with the Delayed Rejection Adaptive Metropolis (DRAM) algorithm." ;
    mkg:reason "A fitted maximum-rate constant in the photosynthesis law." ;
    mkg:siFactor 1.157407e-05 ;
    mkg:status "accepted" ;
    mkg:symbol "P_{m}" ;
    mkg:unit "1 / d" ;
    mkg:unitString "d^{-1}" ;
    mkg:value 4.3054e+00 ;
    mkg:valueUncertainty "0.7197" .

<http://example.org/kg/wang_2019/law/wang_2019_eq13/par/a> a mkg:Parameter ;
    rdfs:label "a (wang_2019 eq 13)"@en ;
    mkg:basis "stated" ;
    mkg:description "Optical cross section of Chl-a" ;
    mkg:dimension "[length] ** 2 / [substance] / [current] / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "We assumed that  $ a $ and  $ b $ were independent of the cultivation conditions and estimated their values ( $ a = 80.5\\ m^2\\ mol^{-1}\\ X_{chl} $-C and  $ b = 1.4718\\ m^2\\ mol^{-1} $ C) using the  $ I_p $ of different light and nitrogen conditions" ;
    mkg:page "8" ;
    mkg:quote "Optical cross section of Chl-a" ;
    mkg:reason "A calibrated optical cross section, which is a fitted system parameter." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "a" ;
    mkg:unit "m ** 2 / C / mol" ;
    mkg:unitNote "X_{chl-C}" ;
    mkg:unitString "m² (mol X_{chl-C} C)⁻¹" ;
    mkg:value 8.05e+01 .

<http://example.org/kg/wang_2019/law/wang_2019_eq13/var/I_sat> a mkg:Variable ;
    rdfs:label "I_{sat} (wang_2019 eq 13)"@en ;
    mkg:description "Saturated light intensity in the photosynthesis equation" ;
    mkg:dimension "[substance] / [length] ** 2 / [time]" ;
    mkg:siFactor 1.157407e-05 ;
    mkg:symbol "I_{sat}" ;
    mkg:unit "mol / d / m ** 2" ;
    mkg:unitNote "photons" ;
    mkg:unitString "mol photons m^{-2} d^{-1}" .

<http://example.org/kg/wang_2019/law/wang_2019_eq13/var/X_C> a mkg:Variable ;
    rdfs:label "X_{C} (wang_2019 eq 13)"@en ;
    mkg:basis "stated" ;
    mkg:description "Total fixed organic carbon concentration" ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:reason "A concentration of total fixed organic carbon that changes with the model's carbon state quantities." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "X_{C}" ;
    mkg:unit "mol / m ** 3" ;
    mkg:unitNote "C" ;
    mkg:unitString "mol C m⁻³" .

<http://example.org/kg/wang_2019/law/wang_2019_eq13/var/X_chl> a mkg:Variable ;
    rdfs:label "X_{chl} (wang_2019 eq 13)"@en ;
    mkg:description "Concentration of Chl-a as C" ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:measured true ;
    mkg:measuredQuote "Concentrations of the biomass, carbohydrate, neutral lipid, Chlorophyll a (Chl-a), and nitrate were measured daily in triplicate for approximately 10 days." ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "X_{chl}" ;
    mkg:unit "mol / m ** 3" ;
    mkg:unitNote "X_{chl}-C" ;
    mkg:unitString "mol X_{chl}-C m⁻³" .

<http://example.org/kg/wang_2019/law/wang_2019_eq13/var/Y_E_c> a mkg:Variable ;
    rdfs:label "Y_{E}^{c} (wang_2019 eq 13)"@en ;
    mkg:description "Carbon yield on light energy adjusted for background light intensity" ;
    mkg:dimension "dimensionless" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "Y_{E}^{c}" ;
    mkg:unit "dimensionless" ;
    mkg:unitNote "C photons" ;
    mkg:unitString "mol C (mol photons)^{-1}" .

<http://example.org/kg/wang_2019/law/wang_2019_eq13_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The light-saturation intensity is calculated as a function of chlorophyll-a content and the carbon-yield and photosynthesis parameters." ;
    mkg:doi "10.1021/acs.est.9b02908" ;
    mkg:form "algebraic" ;
    mkg:page "3" ;
    mkg:quote "I_{\\mathrm{s a t}}=\\frac{P_{\\mathrm{m}}\\times X_{\\mathrm{C}}}{a\\times Y_{\\mathrm{E}}^{c}\\times X_{\\mathrm{c h l}}}" ;
    mkg:status "pending" .

<http://example.org/kg/wang_2019/law/wang_2019_eq14> a mkg:Law ;
    rdfs:label "wang_2019 eq 14"@en ;
    mkg:computes <http://example.org/kg/wang_2019/law/wang_2019_eq14/var/Y_E_c> ;
    mkg:equationNumber "14" ;
    mkg:hasMetadata <http://example.org/kg/wang_2019/law/wang_2019_eq14_meta> ;
