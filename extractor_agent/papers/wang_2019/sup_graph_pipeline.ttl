    mkg:description "Rate portion of carbon redirection from carbohydrate to lipid accumulation" ;
    mkg:dimension "dimensionless" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "q_{nl}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "unitless" .

<http://example.org/kg/wang_2019/law/wang_2019_eq2_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:description "The carbohydrate balance adds the share of fixed carbon allocated to storage and subtracts basal and growth-related respiration, carbon reused for lipid synthesis, and carbon redirected to lipids under nitrogen deficiency." ;
    mkg:doi "10.1021/acs.est.9b02908" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:reasoned true ;
            mkg:severity "warning" ;
            mkg:text "Background light intensity used for the basal respiration adjustment is treated as time-invariant." ],
        [ mkg:quote "We modeled carbohydrates in the form of glucose and neutral lipids in the form of triacylglycerols." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Carbohydrates are represented as glucose and neutral lipids as triacylglycerols." ] ;
    mkg:page "2" ;
    mkg:quote "\\frac{dX_{carb}}{dt} = \\frac{q_n}{Q_n} \\cdot P \\cdot X_{cd}   -m_c \\cdot \\exp(-k_{mc} \\cdot I_{avg\\_R}) \\cdot X_{carb}   -m_{cN} \\cdot \\nu_N \\cdot X_{cd}   -\\beta \\cdot \\exp(k_{nl} \\cdot I_{avg}) \\cdot \\nu_N \\cdot X_{cd}   -q_{nl} \\cdot \\frac{q_n}{Q_n} \\cdot P \\cdot X_{cd}" ;
    mkg:status "pending" .

<http://example.org/kg/wang_2019/law/wang_2019_eq3> a mkg:Law ;
    rdfs:label "wang_2019 eq 3"@en ;
    mkg:computes <http://example.org/kg/wang_2019/law/wang_2019_eq3/var/X_nl> ;
    mkg:equationNumber "3" ;
    mkg:hasMetadata <http://example.org/kg/wang_2019/law/wang_2019_eq3_meta> ;
    mkg:hasParameter <http://example.org/kg/wang_2019/law/wang_2019_eq3/par/beta>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq3/par/k_nl>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq3/par/q_n> ;
    mkg:latex "\\frac{dX_{nl}}{dt} = \\beta \\cdot \\exp(k_{nl} \\cdot I_{avg}) \\cdot \\nu_N \\cdot X_{cd}   +q_{nl} \\cdot \\frac{q_n}{Q_n} \\cdot P \\cdot X_{cd}" ;
    mkg:uses <http://example.org/kg/wang_2019/law/wang_2019_eq3/var/I_avg>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq3/var/P>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq3/var/Q_n>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq3/var/X_cd>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq3/var/nu_N>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq3/var/q_nl> .

