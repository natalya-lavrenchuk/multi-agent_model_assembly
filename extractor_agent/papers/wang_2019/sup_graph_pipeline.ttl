<http://example.org/kg/wang_2019/law/wang_2019_eq1_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:description "Functional biomass increases by the nitrogen-quota-regulated share of fixed carbon and decreases through degradation associated with respiration." ;
    mkg:doi "10.1021/acs.est.9b02908" ;
    mkg:form "ODE" ;
    mkg:page "2" ;
    mkg:quote "\\frac{dX_{cd}}{dt} = \\left(1 - \\frac{q_n}{Q_n}\\right) \\cdot P \\cdot X_{cd}   -m \\cdot X_{cd}" ;
    mkg:status "pending" .

<http://example.org/kg/wang_2019/law/wang_2019_eq2> a mkg:Law ;
    rdfs:label "wang_2019 eq 2"@en ;
    mkg:computes <http://example.org/kg/wang_2019/law/wang_2019_eq2/var/X_carb> ;
    mkg:equationNumber "2" ;
    mkg:hasMetadata <http://example.org/kg/wang_2019/law/wang_2019_eq2_meta> ;
    mkg:hasParameter <http://example.org/kg/wang_2019/law/wang_2019_eq2/par/beta>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq2/par/k_mc>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq2/par/k_nl>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq2/par/m_c>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq2/par/m_cN>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq2/par/q_n> ;
    mkg:latex "\\frac{dX_{carb}}{dt} = \\frac{q_n}{Q_n} \\cdot P \\cdot X_{cd}   -m_c \\cdot \\exp(-k_{mc} \\cdot I_{avg\\_R}) \\cdot X_{carb}   -m_{cN} \\cdot \\nu_N \\cdot X_{cd}   -\\beta \\cdot \\exp(k_{nl} \\cdot I_{avg}) \\cdot \\nu_N \\cdot X_{cd}   -q_{nl} \\cdot \\frac{q_n}{Q_n} \\cdot P \\cdot X_{cd}" ;
    mkg:uses <http://example.org/kg/wang_2019/law/wang_2019_eq2/var/I_avg>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq2/var/I_avg_R>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq2/var/P>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq2/var/Q_n>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq2/var/X_cd>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq2/var/nu_N>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq2/var/q_nl> .

<http://example.org/kg/wang_2019/law/wang_2019_eq2/par/beta> a mkg:Parameter ;
    rdfs:label "\\beta (wang_2019 eq 2)"@en ;
    mkg:basis "stated" ;
    mkg:description "Coefficient regulating carbon reuse from carbohydrate metabolism for neutral lipid synthesis" ;
    mkg:dimension "dimensionless" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "Our model was systematically calibrated via identifiability analysis, uncertainty quantification, and sensitivity analysis." ;
    mkg:reason "A coefficient in the carbohydrate-to-lipid carbon partitioning law, so it is a parameter." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "\\beta" ;
