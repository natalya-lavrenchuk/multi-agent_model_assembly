        <http://example.org/kg/wang_2019/law/wang_2019_eq4/par/theta> ;
    mkg:latex "\\frac{dX_{chl}}{dt} = \\theta \\cdot \\exp(-k_{chl} \\cdot I_{avg}) \\cdot \\nu_N \\cdot X_{cd} - m_{chl} \\cdot X_{chl}" ;
    mkg:uses <http://example.org/kg/wang_2019/law/wang_2019_eq4/var/I_avg>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq4/var/X_cd>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq4/var/m_chl>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq4/var/nu_N> .

