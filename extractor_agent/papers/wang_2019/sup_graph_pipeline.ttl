<http://example.org/kg/wang_2019/law/wang_2019_eq17> a mkg:Law ;
    rdfs:label "wang_2019 eq 17"@en ;
    mkg:computes <http://example.org/kg/wang_2019/law/wang_2019_eq17/var/nu_N> ;
    mkg:equationNumber "17" ;
    mkg:hasMetadata <http://example.org/kg/wang_2019/law/wang_2019_eq17_meta> ;
    mkg:hasParameter <http://example.org/kg/wang_2019/law/wang_2019_eq17/par/Q_nm>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq17/par/nu_nm>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq17/par/q_n> ;
    mkg:latex "\\nu_{\\mathrm{N}}=\\left(\\frac{Q_{\\mathrm{n m}}-Q_{\\mathrm{n}}}{Q_{\\mathrm{n m}}-q_{\\mathrm{n}}}\\right)\\times\\frac{\\nu_{\\mathrm{n m}}\\times S_{\\mathrm{N O3}}}{S_{\\mathrm{N O3\\_{0}}}}" ;
    mkg:latexCorrected "$$ \\nu_{\\mathrm{N}}=\\frac{\\nu_{\\mathrm{n m}}\\times S_{\\mathrm{N O3}}}{S_{\\mathrm{N O3\\_0}}} $$" ;
    mkg:uses <http://example.org/kg/wang_2019/law/wang_2019_eq17/var/Q_n>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq17/var/S_NO3>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq17/var/S_NO3_0> .

<http://example.org/kg/wang_2019/law/wang_2019_eq17/var/nu_N> a mkg:Variable ;
    rdfs:label "\\nu_{N} (wang_2019 eq 17)"@en ;
    mkg:description "Nitrate uptake rate." ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 1.157407e-05 ;
    mkg:symbol "\\nu_{N}" ;
    mkg:unit "1 / d" ;
    mkg:unitNote "N X_{cd}-C" ;
    mkg:unitString "mol N (mol X_{cd}-C)^{-1} d^{-1}" .

<http://example.org/kg/wang_2019/law/wang_2019_eq17_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:correctionQuote "Therefore, we excluded the term $\\frac{Q_{nm} - Q_n}{Q_{nm} - q_n}$ from the nitrate uptake equation to resolve the nonidentifiability associated with $Q_{nm}$. " ;
    mkg:correctionReason "The quota-dependent factor should be removed from the nitrate uptake equation, as the paper says it was excluded to resolve nonidentifiability." ;
    mkg:correctionStatus "accepted" ;
    mkg:description "Nitrate uptake is calculated from a quota-modulated maximum uptake rate multiplied by extracellular nitrate normalized to its initial concentration." ;
    mkg:doi "10.1021/acs.est.9b02908" ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/wang_2019/law/wang_2019_eq17/par/q_n> ;
            mkg:slot "quota threshold" ],
        [ mkg:boundTo <http://example.org/kg/wang_2019/law/wang_2019_eq17/par/Q_nm> ;
            mkg:slot "quota ceiling" ],
        [ mkg:boundTo <http://example.org/kg/wang_2019/law/wang_2019_eq17/var/Q_n> ;
            mkg:slot "quota state" ],
        [ mkg:boundTo <http://example.org/kg/wang_2019/law/wang_2019_eq17/par/nu_nm> ;
            mkg:slot "maximum rate" ],
        [ mkg:boundTo <http://example.org/kg/wang_2019/law/wang_2019_eq17/var/S_NO3> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/wang_2019/law/wang_2019_eq17/var/S_NO3_0> ;
            mkg:slot "reference concentration" ] ;
    mkg:page "4" ;
    mkg:possibleMisprint "The factor (Q_{nm} - Q_n)/(Q_{nm} - q_n) is printed in eq 17, but the Results state that this term was excluded from the nitrate uptake equation to resolve nonidentifiability." ;
    mkg:quote "\\nu_{\\mathrm{N}}=\\left(\\frac{Q_{\\mathrm{n m}}-Q_{\\mathrm{n}}}{Q_{\\mathrm{n m}}-q_{\\mathrm{n}}}\\right)\\times\\frac{\\nu_{\\mathrm{n m}}\\times S_{\\mathrm{N O3}}}{S_{\\mathrm{N O3\\_{0}}}}" ;
    mkg:reviewOutcome "paper misprint" ;
    mkg:status "pending" .

<http://example.org/kg/wang_2019/law/wang_2019_eq18> a mkg:Law ;
    rdfs:label "wang_2019 eq 18"@en ;
    mkg:computes <http://example.org/kg/wang_2019/law/wang_2019_eq18/var/Q_n> ;
    mkg:equationNumber "18" ;
    mkg:hasMetadata <http://example.org/kg/wang_2019/law/wang_2019_eq18_meta> ;
