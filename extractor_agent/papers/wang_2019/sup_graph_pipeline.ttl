<http://example.org/kg/wang_2019/law/wang_2019_eq4_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:description "The chlorophyll a balance links synthesis to nitrogen uptake with light-dependent regulation and subtracts chlorophyll degradation under stress." ;
    mkg:doi "10.1021/acs.est.9b02908" ;
    mkg:form "ODE" ;
    mkg:page "2" ;
    mkg:quote "\\frac{dX_{chl}}{dt} = \\theta \\cdot \\exp(-k_{chl} \\cdot I_{avg}) \\cdot \\nu_N \\cdot X_{cd} - m_{chl} \\cdot X_{chl}" ;
    mkg:status "pending" .

