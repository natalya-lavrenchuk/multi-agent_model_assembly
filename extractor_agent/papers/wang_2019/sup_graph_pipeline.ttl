    mkg:reason "An initial nitrate concentration supplied for each experimental run, so it is an operating condition." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "S_{NO3_0}" ;
    mkg:unit "mM" ;
    mkg:unitString "mM as N" .

