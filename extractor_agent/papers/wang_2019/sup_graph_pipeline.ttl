kg:wang_2019_meta a mkg:Metadata ;
    mkg:completeModel true ;
    mkg:description "The model represents the growth of Dunaliella viridis and its production of functional biomass, carbohydrates, neutral lipids, and chlorophyll as light and nitrogen conditions change. It predicts how carbon fixation and carbon allocation shift over time, using six dynamic state equations alongside calculations of light attenuation through the reactor. Its main mechanisms include light-limited, saturated, and inhibited photosynthesis; nitrogen-quota effects on carbon allocation; and distinct routes for lipid accumulation when nitrogen is sufficient or depleted. The model was developed and tested using cultures in a bench-scale flat-panel photobioreactor across different light levels and initial nitrate concentrations. The authors calibrated its parameters with experimental measurements, assessed uncertainty and sensitivity, and tested predictions against a separate set of experiments. They use the model to interpret transient algal responses and to inform cultivation strategies for improving biomass and biofuel production." ;
    mkg:doi "10.1021/acs.est.9b02908" ;
    mkg:form "DAE" ;
    mkg:hasAssumption [ mkg:quote "a and b were independent of the cultivation conditions" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Optical cross‑section parameters a and b are taken as constant regardless of cultivation conditions." ],
        [ mkg:quote "algae cells assimilated the nitrate removed from the medium" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Nitrate uptake is assumed to equal the nitrate removed from the medium." ],
        [ mkg:quote "functional biomass is assumed as CH_{1.8}O_{0.5}N_{0.2}" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The composition of functional biomass is fixed to CH1.8O0.5N0.2." ] ;
    mkg:hasFact [ mkg:basis "stated" ;
            mkg:quote "the carbon partitioning strategy proposed in our model may also be applicable to other green algae species and mixed-culture systems." ;
            mkg:text "The authors suggest that the carbon-partitioning strategy may apply to other green algae and mixed-culture systems, but these broader applications were not tested in the reported experiments." ;
            mkg:topic "scope" ],
        [ mkg:basis "stated" ;
            mkg:quote "low light (100PPFD and 4.95N, 100PPFD and 0.62N), moderate light (400PPFD and 4.89N, 300PPFD and 0.66N), and high light (600PPFD and 4.88N, 600PPFD and 0.71N)" ;
            mkg:text "The figure caption identifies low-light examples at 100 PPFD, moderate-light examples at 300 or 400 PPFD, and high-light examples at 600 PPFD." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "our model did not include such a neutral lipid degradation process because the lipid concentration decline was not observed in the calibration experiments." ;
            mkg:text "The model does not include neutral-lipid degradation, which the authors suggest may explain the validation discrepancies." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "We modeled carbohydrates in the form of glucose and neutral lipids in the form of triacylglycerols." ;
            mkg:text "Carbohydrates are represented as glucose and neutral lipids as triacylglycerols." ;
            mkg:topic "system" ],
        [ mkg:basis "stated" ;
            mkg:quote "The light condition in our experiment was controlled by adjusting the light source position (i.e., the distance d in Figure S1)." ;
            mkg:text "The experimental light level was changed by adjusting the distance between the light source and the reactor." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "We randomly selected 2000 parameter sets from the MCMC posterior samples to generate the output medians, 95% credible intervals, and 95% prediction intervals" ;
            mkg:text "The authors used 2,000 posterior parameter sets to generate output medians and 95% credible and prediction intervals." ;
            mkg:topic "calibration" ],
        [ mkg:basis "stated" ;
            mkg:quote "Our model predictions were able to capture the variations in the experimental data and account for the measurement errors." ;
            mkg:text "The calibrated model medians agreed well with experimental observations and captured their variations while accounting for measurement errors." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "As a result, the nitrate uptake rate vN in eq 17 is linearly related to the extracellular nitrate concentration SNO3 and is divided by the initial concentration SNO3 to offset the effect of initial nitrate level." ;
            mkg:text "Nitrate uptake is modeled as proportional to extracellular nitrate relative to its initial concentration, with a maximum uptake-rate parameter." ;
            mkg:topic "nitrogen" ],
        [ mkg:basis "stated" ;
            mkg:quote "The average light intensity Iavg (eq 10) inside the reactor is calculated by averaging the local light intensities Il over the optical path" ;
            mkg:text "The culture states are modeled as bulk concentrations, while light intensity is also estimated along the reactor optical path." ;
            mkg:topic "model" ],
        [ mkg:basis "inferred" ;
            mkg:text "The photosynthesis rate uses a modified simplified Steele relationship to represent light limitation, saturation, and inhibition." ;
            mkg:topic "light" ],
        [ mkg:basis "stated" ;
            mkg:quote "the light intensity Ip at location l = zl was continuously monitored by the light sensor during cultivation" ;
            mkg:text "A light sensor mounted inside the reactor continuously monitored light intensity at its location during cultivation." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "The Supporting Information is available free of charge on the ACS Publications website at DOI: 10.1021/acs.est.9b02908." ;
            mkg:text "The paper states that its supporting-information PDF is freely available through the ACS Publications website and contains details on light estimation, calibration, and validation." ;
            mkg:topic "availability" ],
        [ mkg:basis "stated" ;
            mkg:quote "We thus modified the saturated light intensity Isat as a function of the Chl-a content (eq 13)" ;
            mkg:text "The model represents light adaptation by making the saturated light intensity depend on chlorophyll a content." ;
            mkg:topic "light" ],
        [ mkg:basis "stated" ;
            mkg:quote "We calibrated the values of a (the optical cross section of Chl-a) and b (the optical cross section of non-Chl-a biomass) in eq 9 by minimizing the discrepancy between the experimentally measured light profile Ip and the calculated light profile Izr." ;
            mkg:text "The optical cross sections were estimated by minimizing the discrepancy between measured and calculated light profiles across different light and nitrogen conditions." ;
            mkg:topic "calibration" ],
        [ mkg:basis "stated" ;
            mkg:quote "Concentrations of the biomass, carbohydrate, neutral lipid, Chlorophyll a (Chl-a), and nitrate were measured daily in triplicate for approximately 10 days." ;
            mkg:text "Biomass, carbohydrate, neutral lipid, chlorophyll a, and nitrate concentrations were measured daily in triplicate for approximately 10 days." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "However, the model was still subject to the steady-state and balanced-growth assumption and required two sets of reactions to separately determine the stoichiometric yields for nutrient-available and nutrient-depleted conditions." ;
            mkg:text "The paper notes that Guest et al. 2013 proposed a lumped-pathway metabolic model but says its steady-state assumptions limited its prediction of transient culture behavior." ;
            mkg:topic "prior models" ],
        [ mkg:basis "inferred" ;
            mkg:text "The model predicts a transition from slow carbohydrate-carbon reuse for lipid synthesis under nitrogen sufficiency to faster carbon redirection as nitrogen is depleted." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "We used Iavg_R to adjust the parameter values that only change when the algae are cultivated under different light conditions." ;
            mkg:text "The model calculates reactor-average instantaneous light for cellular processes and uses a separate background-light average for parameters that vary with cultivation light conditions." ;
            mkg:topic "light" ],
        [ mkg:basis "stated" ;
            mkg:quote "The photosynthesis rate equation (eq 12) was formulated by modifying the simplified Steele's equation" ;
            mkg:text "The photosynthesis formulation modifies the simplified Steele approach described by Steele in 1962." ;
            mkg:topic "prior models" ],
        [ mkg:basis "stated" ;
            mkg:quote "The experiments were performed in a bench-scale 3.2 L flat-panel photobioreactor" ;
            mkg:text "The cultures were grown in a bench-scale, 3.2 L flat-panel photobioreactor." ;
            mkg:topic "reactor" ],
        [ mkg:basis "stated" ;
            mkg:quote "We used data from 11 experiments (Table S1) including four light conditions (categorized into low/moderate/high levels) and ten initial nitrate concentrations (categorized into high/low levels)." ;
            mkg:text "The experiments covered four light conditions grouped as low, moderate, or high light and ten initial nitrate concentrations grouped as high or low." ;
            mkg:topic "operation" ],
        [ mkg:basis "inferred" ;
            mkg:text "The carbon allocation to functional biomass is based on the Droop model, cited as Droop 1970." ;
            mkg:topic "prior models" ],
        [ mkg:basis "stated" ;
            mkg:quote "The experimental data was split into two subsets (Table S1): the calibration set (~65% of total data) and the validation set (~35% of total data)." ;
            mkg:text "The authors split the experimental data into a calibration set of about 65% and a validation set of about 35%." ;
            mkg:topic "calibration" ],
        [ mkg:basis "stated" ;
            mkg:quote "We modeled the carbon fixation to the functional biomass (R1) in eq (1) based on the Droop model." ;
            mkg:text "Nitrogen quota regulates how fixed carbon is partitioned between functional biomass and storage molecules through a mechanism based on the Droop model." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "the pH and temperature controlled at 7.6 and 25 °C, respectively." ;
            mkg:text "The reactor pH and temperature were controlled at 7.6 and 25 °C, respectively." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Our model could thus be used to optimize important control process parameters such as light intensities, nitrate concentrations and time durations during the two-stage cultivation." ;
            mkg:text "The model is intended to help optimize light intensity, nitrate concentration, and stage duration in two-stage cultivation." ;
            mkg:topic "use" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper cites Packer et al. 2011 as estimating a chlorophyll optical cross section close to the value obtained here." ;
            mkg:topic "prior models" ],
        [ mkg:basis "inferred" ;
            mkg:text "The posterior-statistics table reports 16 fitted model parameters, and the optical cross sections were calibrated separately using light-profile measurements." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "overestimated the neutral lipid production after prolonged nitrogen depletion for the 300PPFD and 0.43N condition" ;
            mkg:text "In validation, the model overestimated neutral lipid production after prolonged nitrogen depletion at 300 PPFD and 0.43 mM nitrate." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "We further formulated R₇ to direct a portion qnl of the previously fixed carbon from carbohydrates to neutral lipids when nitrogen is depleted." ;
            mkg:text "Under nitrogen deficiency, the model redirects previously fixed carbon from carbohydrates to neutral lipids through a nitrate-triggered process." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "The formulated model was calibrated and validated with experimental data of Dunaliella viridis cultivated in a lab-scale photobioreactor (PBR) under various light (low/moderate/high) and nitrogen (sufficient/limited) conditions." ;
            mkg:text "The model was evaluated across low, moderate, and high light and nitrogen-sufficient and nitrogen-limited conditions." ;
            mkg:topic "scope" ],
        [ mkg:basis "stated" ;
            mkg:quote "we estimated the parameter posterior distributions and quantified the model output uncertainties using the Markov chain Monte Carlo (MCMC) technique with the Delayed Rejection Adaptive Metropolis (DRAM) algorithm." ;
            mkg:text "The authors used profile likelihood for identifiability analysis, MCMC with the DRAM algorithm for parameter uncertainty, and eFAST for global sensitivity analysis." ;
            mkg:topic "calibration" ],
        [ mkg:basis "stated" ;
            mkg:quote "Table 1 summarizes the entire set of ordinary differential equations (ODEs) for the model formulation" ;
            mkg:text "The model is a dynamic kinetic model formulated as six ordinary differential equations for the six culture-state variables." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "We obtained two MCMC sample chains that converged to similar steady ranges after 250 000 iterations" ;
            mkg:text "The MCMC chains reached similar steady ranges after 250,000 iterations." ;
            mkg:topic "calibration" ],
        [ mkg:basis "stated" ;
            mkg:quote "The assimilated carbon that has not been used to produce functional biomass is first stored in carbohydrates as shown in R₃ of eq (2)." ;
            mkg:text "Carbon not allocated to functional biomass is initially stored in carbohydrates, which can also supply carbon for respiration and lipid synthesis." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "R₆ is also coupled with the nitrate uptake rate via the coefficient β to describe that some carbon from carbohydrate metabolism could be reutilized to accumulate neutral lipids during normal algal growth." ;
            mkg:text "Under nitrogen sufficiency, the model represents a light-regulated reuse of carbohydrate carbon for neutral lipid synthesis." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "describe the culture behaviors of Dunaliella viridis cultivated under different light and nitrogen conditions." ;
            mkg:text "The model describes Dunaliella viridis grown under varying light and nitrogen conditions." ;
            mkg:topic "system" ],
        [ mkg:basis "inferred" ;
            mkg:text "Profile-likelihood analysis found the maximum nitrogen quota parameter nonidentifiable, so the authors removed its quota-regulation term from the nitrate-uptake equation." ;
            mkg:topic "nitrogen" ],
        [ mkg:basis "stated" ;
            mkg:quote "The light attenuation due to Chl-a and the remaining biomass (XC - Xchl) is modeled by formulating the light absorbance A (eq 9) based on the Beer–Lambert Law." ;
            mkg:text "Light attenuation is represented using an empirical background-absorption estimate and Beer–Lambert absorbance from chlorophyll and the remaining biomass." ;
            mkg:topic "light" ],
        [ mkg:basis "stated" ;
            mkg:quote "we could first enhance the photosynthetic carbon fixation before nitrogen depletion" ;
            mkg:text "The authors propose increasing photosynthetic carbon fixation before nitrogen depletion and slowing its decline afterward as strategies to improve lipid production." ;
            mkg:topic "use" ],
        [ mkg:basis "stated" ;
            mkg:quote "Our model contains six state variables" ;
            mkg:text "The model tracks functional biomass, carbohydrates, neutral lipids, chlorophyll a, extracellular nitrate, and intracellular nitrogen." ;
            mkg:topic "system" ],
        [ mkg:basis "stated" ;
            mkg:quote "The carbohydrate respiration rate includes two components: a basal-level rate (R₄) and a growth-related rate (R₅)." ;
            mkg:text "Carbohydrate respiration includes a basal component adjusted for background light and a growth-related component coupled to nitrate uptake." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper does not state that model code or a separate experimental-data repository is available." ;
            mkg:topic "availability" ],
        [ mkg:basis "stated" ;
            mkg:quote "The synthesis of Chl-a is dependent on the assimilated nitrogen." ;
            mkg:text "The model represents chlorophyll a synthesis as linked to nitrogen uptake and adjusted for light, and represents its degradation under stress." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "did not predict the decrease in neutral lipid concentration toward the end of the 300PPFD and 3.80N experiment." ;
            mkg:text "In validation, the model failed to predict a late decrease in neutral lipid concentration during the 300 PPFD and 3.80 mM nitrate experiment." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "the carbon yield is smaller when cells are initially exposed to high background light intensity." ;
            mkg:text "The model represents light-inhibition hysteresis by reducing carbon yield on light energy for cells exposed to higher background light." ;
            mkg:topic "light" ] ;
    mkg:status "pending" ;
    rdfs:comment "v0 distinct nodes; built from paddle.json (PaddleOCR-VL pipeline) by extractor/graph.py" .

<http://example.org/kg/wang_2019/law/wang_2019_eq17/par/Q_nm> a mkg:Parameter ;
    rdfs:label "Q_{nm} (wang_2019 eq 17)"@en ;
    mkg:basis "stated" ;
    mkg:description "Quota parameter regulating the nitrate uptake rate." ;
    mkg:dimension "dimensionless" ;
    mkg:page "4" ;
    mkg:quote "$Q_{nm}$ was only used in eq 17 to regulate the nitrate uptake rate." ;
    mkg:reason "A model quota parameter that regulates nitrate uptake, identified as nonidentifiable rather than an operating condition." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "Q_{nm}" ;
    mkg:unit "dimensionless" ;
    mkg:unitNote "N C" ;
    mkg:unitString "mol N (mol C)^{-1}" .

<http://example.org/kg/wang_2019/law/wang_2019_eq17/par/nu_nm> a mkg:Parameter ;
    rdfs:label "\\nu_{nm} (wang_2019 eq 17)"@en ;
    mkg:basis "stated" ;
    mkg:description "Maximum nitrate uptake rate." ;
    mkg:dimension "1 / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "we estimated the parameter posterior distributions and quantified the model output uncertainties using the Markov chain Monte Carlo (MCMC) technique" ;
    mkg:page "4" ;
    mkg:quote "the maximum nitrate uptake rate $v_{nm}$ is regulated by the nitrogen quota to potentially limit the maximum amount of nitrogen that cells can assimilate." ;
    mkg:reason "A fitted maximum-rate constant for nitrate uptake." ;
    mkg:siFactor 1.157407e-05 ;
    mkg:status "accepted" ;
    mkg:symbol "\\nu_{nm}" ;
    mkg:unit "1 / d" ;
    mkg:unitNote "N X_{cd}-C" ;
    mkg:unitString "mol N (mol X_{cd}-C)^{-1} d^{-1}" ;
    mkg:value 1.154e-01 ;
    mkg:valueUncertainty "SD: 0.0039" .

<http://example.org/kg/wang_2019/law/wang_2019_eq17/par/q_n> a mkg:Parameter ;
    rdfs:label "q_{n} (wang_2019 eq 17)"@en ;
    mkg:basis "stated" ;
    mkg:description "Quota parameter in the nitrogen-quota-regulated partitioning of fixed carbon." ;
    mkg:dimension "dimensionless" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "we estimated the parameter posterior distributions and quantified the model output uncertainties using the Markov chain Monte Carlo (MCMC) technique" ;
    mkg:reason "A fitted quota constant in the carbon-partitioning law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "q_{n}" ;
    mkg:unit "dimensionless" ;
    mkg:unitNote "N C" ;
    mkg:unitString "mol N (mol C)^{-1}" ;
    mkg:value 1.75e-02 ;
    mkg:valueUncertainty "SD: 0.0035" .

<http://example.org/kg/wang_2019/law/wang_2019_eq17/var/Q_n> a mkg:Variable ;
    rdfs:label "Q_{n} (wang_2019 eq 17)"@en ;
    mkg:description "Total nitrogen-to-carbon quota, calculated as cellular nitrogen divided by total fixed organic carbon." ;
    mkg:dimension "dimensionless" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "Q_{n}" ;
    mkg:unit "dimensionless" ;
    mkg:unitNote "N C" ;
    mkg:unitString "mol N (mol C)^{-1}" .

<http://example.org/kg/wang_2019/law/wang_2019_eq17/var/S_NO3> a mkg:Variable ;
    rdfs:label "S_{NO3} (wang_2019 eq 17)"@en ;
    mkg:description "Concentration of nitrate as N in the reactor" ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:measured true ;
    mkg:measuredQuote "Concentrations of the biomass, carbohydrate, neutral lipid, Chlorophyll a (Chl-a), and nitrate were measured daily in triplicate for approximately 10 days." ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "S_{NO3}" ;
    mkg:unit "mol / m ** 3" ;
    mkg:unitNote "N" ;
    mkg:unitString "mol N m^{-3}" .

<http://example.org/kg/wang_2019/law/wang_2019_eq17/var/S_NO3_0> a mkg:Variable ;
    rdfs:label "S_{NO3_0} (wang_2019 eq 17)"@en ;
