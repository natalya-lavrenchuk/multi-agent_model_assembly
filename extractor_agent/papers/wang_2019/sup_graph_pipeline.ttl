<http://example.org/kg/wang_2019/law/wang_2019_eq18_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:description "The nitrogen quota is calculated as cellular nitrogen divided by total fixed organic carbon." ;
    mkg:doi "10.1021/acs.est.9b02908" ;
    mkg:form "algebraic" ;
