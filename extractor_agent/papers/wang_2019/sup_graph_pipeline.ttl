<http://example.org/kg/wang_2019/law/wang_2019_eq3_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:description "Neutral lipids accumulate through carbon reused from carbohydrate metabolism during nitrogen-available growth and carbon redirected from carbohydrates under nitrogen deficiency." ;
    mkg:doi "10.1021/acs.est.9b02908" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:reasoned true ;
            mkg:severity "warning" ;
            mkg:text "Carbon contributions to lipid synthesis from functional biomass components are represented within the R₇ carbon-partitioning process." ],
        [ mkg:quote "We modeled carbohydrates in the form of glucose and neutral lipids in the form of triacylglycerols." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Carbohydrates are represented as glucose and neutral lipids as triacylglycerols." ] ;
    mkg:page "2" ;
    mkg:quote "\\frac{dX_{nl}}{dt} = \\beta \\cdot \\exp(k_{nl} \\cdot I_{avg}) \\cdot \\nu_N \\cdot X_{cd}   +q_{nl} \\cdot \\frac{q_n}{Q_n} \\cdot P \\cdot X_{cd}" ;
    mkg:status "pending" .

<http://example.org/kg/wang_2019/law/wang_2019_eq4> a mkg:Law ;
    rdfs:label "wang_2019 eq 4"@en ;
    mkg:computes <http://example.org/kg/wang_2019/law/wang_2019_eq4/var/X_chl> ;
    mkg:equationNumber "4" ;
