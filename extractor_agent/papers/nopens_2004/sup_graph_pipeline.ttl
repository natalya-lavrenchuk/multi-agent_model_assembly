    mkg:reason "An integration coordinate representing floc size in the aggregation and breakage laws, rather than a fitted constant." ;
    mkg:siFactor 1e-06 ;
    mkg:status "accepted" ;
    mkg:symbol "x^{\\prime}" ;
    mkg:unit "cm ** 3" ;
    mkg:unitString "cm³" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq9_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The cumulative oversize number at size x is the number concentration integrated over all larger floc sizes." ;
    mkg:form "algebraic" ;
    mkg:page "3" ;
    mkg:quote "C O N ( x, t ) = \\int _ { x } ^ { \\infty } n ( x ^ { \\prime }, t )   d x ^ { \\prime }" ;
    mkg:status "flagged" .

kg:nopens_2004_meta a mkg:Metadata ;
    mkg:completeModel true ;
    mkg:description "The Aggregation-breakage PBM models how activated sludge flocs change in size during flocculation. It predicts the floc size distribution over time, representing aggregation between flocs and breakage of larger flocs. The model is a one-dimensional population balance that is discretized into size classes and solved using the moving pivot method. It was calibrated using online laser-diffraction measurements from flocculation experiments at two mixing intensities, with several distribution measures tried as fitting targets. The authors recommend fitting the number distribution for applications involving gravitational solid-liquid separation, while concluding that the model needs more flexibility to describe the measurements adequately." ;
    mkg:form "PDE/algebraic" ;
    mkg:hasAssumption [ mkg:quote "Since the model will be used to describe rather short flocculation experiments (max. 4h), it can be assumed that no significant growth occurs ( $ \\dot{X}(x,t)=0 $)." ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "No significant growth occurs during the short flocculation experiments." ],
        [ mkg:quote "When binary breakage is assumed, which was the case in this study, Γ equals 2." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Binary breakage is assumed, so Γ equals 2." ] ;
    mkg:hasFact [ mkg:basis "stated" ;
            mkg:quote "For the application at hand, gravitational solid-liquid separation, it is advised to calibrate the model by means of the number distribution since the smaller size flocs are problematic in wastewater treatment." ;
            mkg:text "The authors recommend fitting the number distribution for gravitational solid-liquid separation because small flocs are problematic in wastewater treatment." ;
            mkg:topic "application" ],
        [ mkg:basis "stated" ;
            mkg:quote "Optimisations were conducted using a weighted least squares (WLS) method" ;
            mkg:text "Parameter estimation used weighted least squares in WEST." ;
            mkg:topic "calibration" ],
        [ mkg:basis "stated" ;
            mkg:quote "Both fits show that the model lacks flexibility and that the structure needs to be improved." ;
            mkg:text "The authors concluded that the model lacks flexibility to describe the measured distributions adequately." ;
            mkg:topic "performance" ],
        [ mkg:basis "stated" ;
            mkg:quote "Based on this assumption, every single measurement of N_i can be assumed to be multinomial distributed" ;
            mkg:text "For weighted-number fitting, measurement variances and weights were calculated using a multinomial counting-error assumption." ;
            mkg:topic "calibration" ],
        [ mkg:basis "stated" ;
            mkg:quote "fitting the log-normal distribution as intermediate step introduced large errors in the number distributions." ;
            mkg:text "The authors found that the earlier log-normal-distribution transformation used by Biggs & Lant 2000 introduced large errors in the resulting number distributions." ;
            mkg:topic "transformation" ],
        [ mkg:basis "stated" ;
            mkg:quote "A cumulative vol% distribution is calculated from the raw distribution and then interpolated at the pivots of the new grid resulting in a cumulative distribution in the new grid." ;
            mkg:text "To transfer the measurements to a model grid, the authors interpolated the cumulative volume distribution at the pivots of the new grid and then calculated the volume fractions." ;
            mkg:topic "transformation" ],
        [ mkg:basis "stated" ;
            mkg:quote "circulated through a Malvern Mastersizer E (Malvern, UK) in order to obtain on-line quantitative information about floc structure and floc size distribution (FSD)" ;
            mkg:text "Floc size distributions were measured online with a Malvern Mastersizer E using laser light diffraction and a flow-through cell." ;
            mkg:topic "equipment" ],
        [ mkg:basis "stated" ;
            mkg:quote "the cumulative vol% distribution matches the raw one and the D[4,3] is preserved" ;
            mkg:text "The new grid-transformation method preserved the mass mean diameter D[4,3] of the original distribution." ;
            mkg:topic "transformation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Since the model will be used to describe rather short flocculation experiments (max. 4h)" ;
            mkg:text "The model is used for relatively short flocculation experiments, with a maximum duration of 4 h." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The description of β(x-x',x) used in this study was taken from Spicer & Pratsinis (1996)" ;
            mkg:text "The collision-frequency description was taken from Spicer & Pratsinis 1996 and relates collisions to floc properties and mixing conditions." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "inferred" ;
            mkg:text "The reported comparisons use the two calibration datasets; the paper does not report an independent validation dataset." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Under predictions by a factor 10-15 occur in the classes with sizes up to 10 μm." ;
            mkg:text "Volume-percent fitting underpredicted the small-size number classes by factors of about 10–15, while D[4,3] fitting underpredicted them by about 15–30." ;
            mkg:topic "performance" ],
        [ mkg:basis "inferred" ;
            mkg:text "In a comparison on the same data, the fixed pivot method predicted a lower zeroth moment and more flocs in larger size classes than the moving pivot method." ;
            mkg:topic "numerics" ],
        [ mkg:basis "stated" ;
            mkg:quote "Both techniques were implemented in the modelling and simulation software platform WEST (Hemmis NV, Belgium)." ;
            mkg:text "The authors recommend the moving pivot discretization, which they implemented alongside the fixed pivot method in WEST." ;
            mkg:topic "numerics" ],
        [ mkg:basis "inferred" ;
            mkg:text "The experimental sludge flocs were sonicated into single cells of about 1 μm and microcolonies of about 10 μm before being allowed to reflocculate." ;
            mkg:topic "system" ],
        [ mkg:basis "stated" ;
            mkg:quote "A flow rate to the flow-through cell of 3ml/s was selected to minimise shear effects and pump pulsation influences (to approximate isokinetic sampling)" ;
            mkg:text "The flow-through cell flow rate was set to 3 ml/s to reduce shear effects and pump-pulsation influences and approximate isokinetic sampling." ;
            mkg:topic "equipment" ],
        [ mkg:basis "stated" ;
            mkg:quote "Under predictions of the lower end size classes range between 2-3.3." ;
            mkg:text "Weighted-number fitting gave small-tail underpredictions of about 2–3.3." ;
            mkg:topic "performance" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper reports point estimates but does not provide confidence intervals or other measures of parameter uncertainty." ;
            mkg:topic "calibration" ],
        [ mkg:basis "stated" ;
            mkg:quote "α was chosen to be a constant between 0 and 1." ;
            mkg:text "Collision efficiency is treated as a constant between zero and one." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "Aggregation models are often based on the Smoluchowski model" ;
            mkg:text "Aggregation is represented with a Smoluchowski population-balance model combining collision frequency and collision efficiency." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "S(x) was taken from Spicer & Pratsinis (1996)" ;
            mkg:text "Breakage is represented by a size-dependent breakage rate from Spicer & Pratsinis 1996, with a breakage-rate coefficient estimated during calibration." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "the aggregation parameter α must be decreased (by 50%), leading to erroneous estimates." ;
            mkg:text "The fixed pivot method led to an aggregation-parameter estimate about 50% lower than the moving pivot method, which the authors regarded as erroneous." ;
            mkg:topic "numerics" ],
        [ mkg:basis "stated" ;
            mkg:quote "Drawbacks are: (1) the assumption of sphericity of particles and (2) the required dilution (< 0.2g/l)." ;
            mkg:text "The laser-diffraction measurements require dilution below 0.2 g/L and assume that the particles are spherical." ;
            mkg:topic "measurement" ],
        [ mkg:basis "inferred" ;
            mkg:text "The moving pivot recommendation follows Kumar & Ramkrishna 1996, whose comparison with an analytical solution found better predictions than the fixed pivot method, including on a coarse grid." ;
            mkg:topic "numerics" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper does not report the number of size classes used, so the total number of distribution states cannot be determined from its description." ;
            mkg:topic "structure" ],
        [ mkg:basis "stated" ;
            mkg:quote "Models describing the time evolution of these property distributions are known as Population Balance Models (PBM)." ;
            mkg:text "The model is dynamic and segregates biomass into a one-dimensional distribution of floc sizes rather than representing it as a single lumped sludge concentration." ;
            mkg:topic "structure" ],
        [ mkg:basis "stated" ;
            mkg:quote "x is the floc size (expressed as volume), n(x,t) the floc size distribution function (#.cm⁻³) (expressed in numbers)" ;
            mkg:text "The size distribution is expressed in numbers of flocs per unit volume, with floc size represented as volume." ;
            mkg:topic "structure" ],
        [ mkg:basis "stated" ;
            mkg:quote "estimating the aggregation and breakage parameters of sludge flocs" ;
            mkg:text "Two aggregation and breakage parameters were estimated: the collision efficiency and the breakage-rate coefficient." ;
            mkg:topic "parameters" ],
        [ mkg:basis "stated" ;
            mkg:quote "The description of β(x-x',x) used in this study was taken from Spicer & Pratsinis (1996)" ;
            mkg:text "The model draws on the Smoluchowski framework described by Ramkrishna 2000 and uses aggregation and breakage descriptions from Spicer & Pratsinis 1996." ;
            mkg:topic "prior work" ],
        [ mkg:basis "stated" ;
            mkg:quote "The measured initial number distribution is used as initial condition for eq. 1." ;
            mkg:text "The initial condition for the population balance is the measured initial number distribution." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "the middle size classes ranging from roughly 35-350 μm." ;
            mkg:text "Fits to volume-based targets described the middle of the volume distribution, roughly 35–350 μm, better than the distribution tails." ;
            mkg:topic "performance" ],
        [ mkg:basis "inferred" ;
            mkg:text "The data came from reflocculation experiments run at average velocity gradients of 19.4 and 37.0 s⁻¹." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Recently, a laser diffraction technique was used to provide the experimental data to which a population balance model (PBM) was fitted by estimating the aggregation and breakage parameters of sludge flocs (Biggs & Lant, 2000; Nopens et al., 2002)." ;
            mkg:text "The calibration methodology extends earlier activated-sludge flocculation PBM work by Nopens et al. 2002 and Biggs & Lant 2000." ;
            mkg:topic "prior work" ],
        [ mkg:basis "stated" ;
            mkg:quote "transforming the integro-differential equation into a set of i ordinary differential equations." ;
            mkg:text "Discretization converts the population balance into a finite set of ordinary differential equations, one for each size class." ;
            mkg:topic "structure" ],
        [ mkg:basis "stated" ;
            mkg:quote "The second step deals with the separation of the purified water and the sludge flocs." ;
            mkg:text "The model represents flocculation of activated sludge, the particle-aggregation process involved in the liquid-solid separation stage of wastewater treatment." ;
            mkg:topic "system" ],
        [ mkg:basis "stated" ;
            mkg:quote "Biggs & Lant (2000) used the discretisation technique of Hounslow et al. (1988)" ;
            mkg:text "The paper compares its discretization approach with Kumar & Ramkrishna 1996 and notes that Biggs & Lant 2000 used the Hounslow et al. 1988 discretization." ;
            mkg:topic "prior work" ],
        [ mkg:basis "stated" ;
            mkg:quote "The new approach was used for the conversion of raw vol% distributions into number distributions (X=3g.L −1, ρ_l=1g.cm−3, ρ_l=1.04g.cm−3, ρ_s=1.7g.cm−3)." ;
            mkg:text "For the volume-to-number conversion calculations, the paper used a biomass concentration of 3 g/L and density values of 1, 1.04, and 1.7 g/cm³." ;
            mkg:topic "transformation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The experimental data used in this study were obtained from Biggs & Lant (2000) who studied the influence of mixing intensity on flocculation kinetics." ;
            mkg:text "The two calibration datasets were obtained from Biggs & Lant 2000, who studied the effect of mixing intensity on flocculation kinetics." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "To convert V_i into N_i, the total floc volume fraction V_f/V_T is needed." ;
            mkg:text "The authors converted volume fractions to number concentrations using an estimate of total floc volume and assuming spherical flocs." ;
            mkg:topic "transformation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Under predictions of the lower end tail now range between 1.5-2.5" ;
            mkg:text "Fitting the number distribution reduced small-tail underprediction to about 1.5–2.5, although the predicted volume distribution was poor." ;
            mkg:topic "performance" ],
        [ mkg:basis "stated" ;
            mkg:quote "The PBM was fitted to 4 different fitting variables: (1) vol% distribution, (2) D[4,3], (3) number distribution and (4) weighted number distribution." ;
            mkg:text "Calibration compared four fitting targets: volume-percent distribution, D[4,3], number distribution, and weighted number distribution." ;
            mkg:topic "calibration" ] ;
    mkg:status "pending" ;
    rdfs:comment "v0 distinct nodes; built from paddle.json (PaddleOCR-VL pipeline) by extractor/graph.py" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq2/par/alpha> a mkg:Parameter ;
    rdfs:label "\\alpha (nopens_2004 eq 2)"@en ;
    mkg:basis "stated" ;
    mkg:description "Collision efficiency." ;
    mkg:dimension "dimensionless" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "Table 1. Parameter estimates using fixed and moving pivot on the same dataset (G=19.4 s^{-1})" ;
    mkg:page "2" ;
    mkg:quote "α (-) is the collision efficiency" ;
    mkg:reason "Collision efficiency is a constant of the aggregation law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "\\alpha" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" ;
    mkg:valuesByCase "{\"Fixed pivot, G=19.4 s⁻¹, D[4,3] fit (Table 1)\": \"0.00648 (unit: -)\", \"Moving pivot, G=19.4 s⁻¹, D[4,3] fit (Table 1)\": \"0.01364 (unit: -)\", \"G=19.4 s⁻¹, Vol% fit (Table 2)\": \"0.0121 (unit: -)\", \"G=19.4 s⁻¹, D[4,3] fit (Table 2)\": \"0.0136 (unit: -)\", \"G=19.4 s⁻¹, N_i fit (Table 2)\": \"0.0073 (unit: -)\", \"G=19.4 s⁻¹, weighted N_i fit (Table 2)\": \"0.0078 (unit: -)\", \"G=37.0 s⁻¹, Vol% fit (Table 2)\": \"0.0083 (unit: -)\", \"G=37.0 s⁻¹, D[4,3] fit (Table 2)\": \"0.0081 (unit: -)\", \"G=37.0 s⁻¹, N_i fit (Table 2)\": \"0.0098 (unit: -)\", \"G=37.0 s⁻¹, weighted N_i fit (Table 2)\": \"0.0078 (unit: -)\"}" .

