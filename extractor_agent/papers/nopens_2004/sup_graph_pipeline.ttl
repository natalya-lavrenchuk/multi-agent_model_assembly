    mkg:valuesByCase "{\"Table 1, fixed pivot, G=19.4 s^-1\": \"201.5 cm⁻³s⁻¹\", \"Table 1, moving pivot, G=19.4 s^-1\": \"195 cm⁻³s⁻¹\", \"Table 2, G=19.4, Vol%\": \"166 cm⁻³s⁻¹\", \"Table 2, G=19.4, D[4,3]\": \"195 cm⁻³s⁻¹\", \"Table 2, G=19.4, N_i\": \"12 cm⁻³s⁻¹\", \"Table 2, G=19.4, weighted N_i\": \"12 cm⁻³s⁻¹\", \"Table 2, G=37.0, Vol%\": \"260 cm⁻³s⁻¹\", \"Table 2, G=37.0, D[4,3]\": \"260 cm⁻³s⁻¹\", \"Table 2, G=37.0, N_i\": \"32 cm⁻³s⁻¹\", \"Table 2, G=37.0, weighted N_i\": \"18 cm⁻³s⁻¹\"}" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq6/par/a> a mkg:Parameter ;
    rdfs:label "a (nopens_2004 eq 6)"@en ;
    mkg:basis "stated" ;
    mkg:description "Constant exponent in the breakage-rate expression." ;
    mkg:dimension "dimensionless" ;
    mkg:estimation "set" ;
