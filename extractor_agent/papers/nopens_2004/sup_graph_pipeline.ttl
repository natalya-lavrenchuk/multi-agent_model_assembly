@prefix kg: <http://example.org/kg/nopens_2004/> .
@prefix mkg: <http://example.org/mkg#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kg:nopens_2004 a mkg:Sup ;
    rdfs:label "nopens_2004 · PBM AND ACTIVATED SLUDGE FLOCCULATION: FROM EXPERIMENTAL DATA TO A CALIBRATED MODEL"@en ;
    mkg:hasMetadata kg:nopens_2004_meta ;
    mkg:includes <http://example.org/kg/nopens_2004/law/nopens_2004_eq1>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq2>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq3>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq4>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq5>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq6>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq7>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq9> .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq1> a mkg:Law ;
    rdfs:label "nopens_2004 eq 1"@en ;
    mkg:computes <http://example.org/kg/nopens_2004/law/nopens_2004_eq1/var/n> ;
    mkg:equationNumber "1" ;
    mkg:hasMetadata <http://example.org/kg/nopens_2004/law/nopens_2004_eq1_meta> ;
    mkg:latex "\\frac{\\partial n(x,t)}{\\partial t}+\\frac{\\partial}{\\partial x}\\left(\\dot{X}(x,t)n(x,t)\\right)=h(x,t)_{agg}+h(x,t)_{break}" ;
    mkg:uses <http://example.org/kg/nopens_2004/law/nopens_2004_eq1/var/dot_X>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq1/var/h_agg>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq1/var/h_break>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq1/var/x> .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq1/var/dot_X> a mkg:Variable ;
    rdfs:label "\\dot{X} (nopens_2004 eq 1)"@en ;
    mkg:description "Growth rate." ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "\\dot{X}" ;
    mkg:unit "1 / s" ;
    mkg:unitString "s⁻¹" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq1/var/h_agg> a mkg:Variable ;
    rdfs:label "h_{agg} (nopens_2004 eq 1)"@en ;
    mkg:description "Net aggregation rate." ;
    mkg:dimension "1 / [length] ** 3 / [time]" ;
    mkg:siFactor 1e+06 ;
    mkg:symbol "h_{agg}" ;
    mkg:unit "1 / cm ** 3 / s" ;
    mkg:unitString "cm⁻³.s⁻¹" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq1/var/h_break> a mkg:Variable ;
    rdfs:label "h_{break} (nopens_2004 eq 1)"@en ;
    mkg:description "Net breakage rate." ;
    mkg:dimension "1 / [length] ** 3 / [time]" ;
    mkg:siFactor 1e+06 ;
    mkg:symbol "h_{break}" ;
    mkg:unit "1 / cm ** 3 / s" ;
    mkg:unitString "cm⁻³.s⁻¹" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq1/var/n> a mkg:Variable ;
    rdfs:label "n (nopens_2004 eq 1)"@en ;
    mkg:description "Floc size distribution function expressed in numbers." ;
    mkg:dimension "1 / [length] ** 3" ;
    mkg:measured true ;
    mkg:measuredQuote "The measured initial number distribution is used as initial condition for eq. 1." ;
    mkg:siFactor 1e+06 ;
    mkg:symbol "n" ;
    mkg:unit "number / cm ** 3" ;
    mkg:unitString "#.cm⁻³" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq1/var/x> a mkg:Variable ;
    rdfs:label "x (nopens_2004 eq 1)"@en ;
    mkg:description "Floc size, expressed as volume." ;
    mkg:dimension "[length] ** 3" ;
    mkg:siFactor 1e-06 ;
    mkg:symbol "x" ;
    mkg:unit "cm ** 3" ;
    mkg:unitString "cm³" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq1_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The population balance computes how the floc size distribution changes over time through growth and net aggregation and breakage." ;
    mkg:form "PDE" ;
    mkg:page "2" ;
    mkg:quote "\\frac{\\partial n(x,t)}{\\partial t}+\\frac{\\partial}{\\partial x}\\left(\\dot{X}(x,t)n(x,t)\\right)=h(x,t)_{agg}+h(x,t)_{break}" ;
    mkg:status "flagged" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq2> a mkg:Law ;
    rdfs:label "nopens_2004 eq 2"@en ;
    mkg:computes <http://example.org/kg/nopens_2004/law/nopens_2004_eq2/var/h_agg> ;
    mkg:equationNumber "2" ;
    mkg:hasMetadata <http://example.org/kg/nopens_2004/law/nopens_2004_eq2_meta> ;
    mkg:hasParameter <http://example.org/kg/nopens_2004/law/nopens_2004_eq2/par/alpha> ;
    mkg:latex "\\begin{aligned}h(x,t)_{agg}=&\\frac{1}{2}\\int\\limits_{0}^{x}\\alpha\\beta(x-x^{\\prime},x^{\\prime})n(x-x^{\\prime},t)n(x^{\\prime},t)dx\\\\&-n(x,t)\\int\\limits_{0}^{\\infty}\\alpha\\beta(x,x^{\\prime})n(x^{\\prime},t)dx\\end{aligned}" ;
    mkg:latexCorrected "$$ \\begin{aligned}h(x,t)_{agg}=&\\frac{1}{2}\\int\\limits_{0}^{x}\\alpha\\beta(x-x^{\\prime},x^{\\prime})n(x-x^{\\prime},t)n(x^{\\prime},t)dx^{\\prime}\\\\&-n(x,t)\\int\\limits_{0}^{\\infty}\\alpha\\beta(x,x^{\\prime})n(x^{\\prime},t)dx^{\\prime}\\end{aligned} $$" ;
    mkg:uses <http://example.org/kg/nopens_2004/law/nopens_2004_eq2/var/beta>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq2/var/d>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq2/var/n>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq2/var/x_prime> .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq2/var/d> a mkg:Variable ;
    rdfs:label "d (nopens_2004 eq 2)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Diameter of a particle in a size class." ;
    mkg:reason "A particle-size quantity used in the volume-to-number conversion, rather than a fitted constant." ;
    mkg:status "accepted" ;
    mkg:symbol "d" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq2/var/h_agg> a mkg:Variable ;
    rdfs:label "h_{agg} (nopens_2004 eq 2)"@en ;
    mkg:description "Net aggregation rate." ;
    mkg:dimension "1 / [length] ** 3 / [time]" ;
    mkg:siFactor 1e+06 ;
    mkg:symbol "h_{agg}" ;
    mkg:unit "1 / cm ** 3 / s" ;
    mkg:unitString "cm⁻³.s⁻¹" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq2/var/x_prime> a mkg:Variable ;
    rdfs:label "x^{\\prime} (nopens_2004 eq 2)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Floc-volume size coordinate of a particle in the aggregation and breakage integrals." ;
    mkg:dimension "[length] ** 3" ;
    mkg:reason "An integration coordinate representing floc size in the aggregation and breakage laws, rather than a fitted constant." ;
    mkg:siFactor 1e-06 ;
    mkg:status "accepted" ;
    mkg:symbol "x^{\\prime}" ;
    mkg:unit "cm ** 3" ;
    mkg:unitString "cm³" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq2_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:correctionReason "Both integrals are over x′, so the printed dx in each is a differential-variable typo and must be dx′." ;
    mkg:correctionStatus "accepted" ;
    mkg:description "The net aggregation rate is the collision-driven formation of flocs of size x minus their loss through further collisions." ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "α was chosen to be a constant between 0 and 1." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The collision efficiency α is taken as a constant between 0 and 1." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/nopens_2004/law/nopens_2004_eq2/var/beta> ;
            mkg:slot "collision frequency" ],
        [ mkg:boundTo <http://example.org/kg/nopens_2004/law/nopens_2004_eq2/var/n> ;
            mkg:slot "floc size distribution" ],
        [ mkg:boundTo <http://example.org/kg/nopens_2004/law/nopens_2004_eq2/par/alpha> ;
            mkg:slot "collision efficiency" ] ;
    mkg:page "2" ;
    mkg:possibleMisprint "The aggregation-birth integral uses dx although its integrand and limits are in x′; the differential should be dx′." ;
    mkg:quote "\\begin{aligned}h(x,t)_{agg}=&\\frac{1}{2}\\int\\limits_{0}^{x}\\alpha\\beta(x-x^{\\prime},x^{\\prime})n(x-x^{\\prime},t)n(x^{\\prime},t)dx\\\\&-n(x,t)\\int\\limits_{0}^{\\infty}\\alpha\\beta(x,x^{\\prime})n(x^{\\prime},t)dx\\end{aligned}" ;
    mkg:reviewOutcome "paper misprint" ;
    mkg:status "flagged" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq3> a mkg:Law ;
    rdfs:label "nopens_2004 eq 3"@en ;
    mkg:computes <http://example.org/kg/nopens_2004/law/nopens_2004_eq3/var/beta> ;
    mkg:equationNumber "3" ;
    mkg:hasMetadata <http://example.org/kg/nopens_2004/law/nopens_2004_eq3_meta> ;
    mkg:latex "$$ \\beta(x-x^{\\prime},x)=0.31\\overline{G}\\left({x^{\\prime}}^{1/3}+(x-x^{\\prime})^{1/3}\\right)^{3} $$" ;
    mkg:uses <http://example.org/kg/nopens_2004/law/nopens_2004_eq3/var/overline_G>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq3/var/x_prime> .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq3_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The collision frequency is calculated from the mean velocity gradient and the cube-root size contributions of the colliding flocs." ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/nopens_2004/law/nopens_2004_eq3/var/x_prime> ;
            mkg:slot "particle volume" ],
        [ mkg:boundTo <http://example.org/kg/nopens_2004/law/nopens_2004_eq3/var/overline_G> ;
            mkg:slot "velocity gradient" ],
        [ mkg:boundTo <http://example.org/kg/nopens_2004/law/nopens_2004_eq3/var/beta> ;
            mkg:slot "collision frequency" ] ;
    mkg:ocrFixNote "The OCR read the 1/3 exponents as primes." ;
    mkg:page "2" ;
    mkg:possibleMisprint "The terms x^{′/3} and (x−x′)^{′/3} put a prime in the exponent instead of specifying cube-root powers x′^{1/3} and (x−x′)^{1/3}." ;
    mkg:quote "\\beta(x-x^{\\prime},x)=0.31\\overline{G}\\left({x^{\\prime}}^{1/3}+(x-x^{\\prime})^{1/3}\\right)^{3}" ;
    mkg:reviewOutcome "reading corrected" ;
    mkg:status "pending" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq4> a mkg:Law ;
    rdfs:label "nopens_2004 eq 4"@en ;
    mkg:computes <http://example.org/kg/nopens_2004/law/nopens_2004_eq4/var/overline_G> ;
    mkg:equationNumber "4" ;
    mkg:hasMetadata <http://example.org/kg/nopens_2004/law/nopens_2004_eq4_meta> ;
    mkg:hasParameter <http://example.org/kg/nopens_2004/law/nopens_2004_eq4/par/nu> ;
    mkg:latex "\\overline{G}=\\sqrt{\\frac{\\varepsilon}{\\nu}}" ;
    mkg:uses <http://example.org/kg/nopens_2004/law/nopens_2004_eq4/var/varepsilon> .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq4/var/overline_G> a mkg:Variable ;
    rdfs:label "\\overline{G} (nopens_2004 eq 4)"@en ;
    mkg:description "Average velocity gradient." ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "\\overline{G}" ;
    mkg:unit "1 / s" ;
    mkg:unitString "s⁻¹" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq4_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The average velocity gradient is calculated from turbulent energy dissipation and kinematic viscosity." ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/nopens_2004/law/nopens_2004_eq4/par/nu> ;
            mkg:slot "kinematic viscosity" ],
        [ mkg:boundTo <http://example.org/kg/nopens_2004/law/nopens_2004_eq4/var/varepsilon> ;
            mkg:slot "turbulent energy dissipation rate" ] ;
    mkg:page "2" ;
    mkg:quote "\\overline{G}=\\sqrt{\\frac{\\varepsilon}{\\nu}}" ;
    mkg:status "pending" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq5> a mkg:Law ;
    rdfs:label "nopens_2004 eq 5"@en ;
    mkg:computes <http://example.org/kg/nopens_2004/law/nopens_2004_eq5/var/h_break> ;
    mkg:equationNumber "5" ;
    mkg:hasMetadata <http://example.org/kg/nopens_2004/law/nopens_2004_eq5_meta> ;
    mkg:hasParameter <http://example.org/kg/nopens_2004/law/nopens_2004_eq5/par/Gamma> ;
    mkg:latex "\\begin{aligned}h(x,t)_{break}&=\\int\\limits_{x}^{\\infty}n(x^{\\prime},t)S(x^{\\prime})\\Gamma(x^{\\prime}-x,x)dx^{\\prime}\\\\&-n(x,t)S(x)\\Gamma(x,x^{\\prime})\\end{aligned}" ;
    mkg:latexCorrected "$$ \\begin{aligned}h(x,t)_{break}&=\\int\\limits_{x}^{\\infty}n(x^{\\prime},t)S(x^{\\prime})\\Gamma(x^{\\prime}-x,x)dx^{\\prime}\\\\&-n(x,t)S(x)\\end{aligned} $$" ;
    mkg:uses <http://example.org/kg/nopens_2004/law/nopens_2004_eq5/var/S>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq5/var/d>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq5/var/n>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq5/var/x_prime> .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq5/var/d> a mkg:Variable ;
    rdfs:label "d (nopens_2004 eq 5)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Diameter of a particle in a size class." ;
    mkg:reason "A particle-size quantity used in the volume-to-number conversion, rather than a fitted constant." ;
    mkg:status "accepted" ;
    mkg:symbol "d" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq5/var/h_break> a mkg:Variable ;
    rdfs:label "h_{break} (nopens_2004 eq 5)"@en ;
    mkg:description "Net breakage rate." ;
    mkg:dimension "1 / [length] ** 3 / [time]" ;
    mkg:siFactor 1e+06 ;
    mkg:symbol "h_{break}" ;
    mkg:unit "1 / cm ** 3 / s" ;
    mkg:unitString "cm⁻³.s⁻¹" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq5/var/x_prime> a mkg:Variable ;
    rdfs:label "x^{\\prime} (nopens_2004 eq 5)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Floc-volume size coordinate of a particle in the aggregation and breakage integrals." ;
    mkg:dimension "[length] ** 3" ;
    mkg:reason "An integration coordinate representing floc size in the aggregation and breakage laws, rather than a fitted constant." ;
    mkg:siFactor 1e-06 ;
    mkg:status "accepted" ;
    mkg:symbol "x^{\\prime}" ;
    mkg:unit "cm ** 3" ;
    mkg:unitString "cm³" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq5_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:correctionReason "The loss term is the disappearance of a parent floc at rate n(x,t)S(x), so the daughter-distribution factor Γ does not belong there." ;
    mkg:correctionStatus "accepted" ;
    mkg:description "The net breakage rate combines the production of size-x flocs from larger flocs with the loss of size-x flocs when they break." ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/nopens_2004/law/nopens_2004_eq5/par/Gamma> ;
            mkg:slot "daughter distribution" ],
        [ mkg:boundTo <http://example.org/kg/nopens_2004/law/nopens_2004_eq5/var/S> ;
            mkg:slot "breakage rate" ],
        [ mkg:boundTo <http://example.org/kg/nopens_2004/law/nopens_2004_eq5/var/n> ;
            mkg:slot "floc size distribution" ] ;
    mkg:page "2" ;
    mkg:possibleMisprint "The loss term −n(x,t)S(x)Γ(x,x′) contains an unintegrated x′ and applies the daughter distribution to parent disappearance; parent loss should be −n(x,t)S(x)." ;
    mkg:quote "\\begin{aligned}h(x,t)_{break}&=\\int\\limits_{x}^{\\infty}n(x^{\\prime},t)S(x^{\\prime})\\Gamma(x^{\\prime}-x,x)dx^{\\prime}\\\\&-n(x,t)S(x)\\Gamma(x,x^{\\prime})\\end{aligned}" ;
    mkg:reviewOutcome "paper misprint" ;
    mkg:status "flagged" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq6> a mkg:Law ;
    rdfs:label "nopens_2004 eq 6"@en ;
    mkg:computes <http://example.org/kg/nopens_2004/law/nopens_2004_eq6/var/S> ;
    mkg:equationNumber "6" ;
    mkg:hasMetadata <http://example.org/kg/nopens_2004/law/nopens_2004_eq6_meta> ;
    mkg:hasParameter <http://example.org/kg/nopens_2004/law/nopens_2004_eq6/par/A>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq6/par/a> ;
    mkg:latex "S(x)=Ax^{a}" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq6/var/S> a mkg:Variable ;
    rdfs:label "S (nopens_2004 eq 6)"@en ;
    mkg:description "Breakage rate of particles of size x." ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "S" ;
    mkg:unit "1 / s" ;
    mkg:unitString "s^-1" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq6_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The breakage rate increases with floc size according to a power law with coefficient A and exponent a." ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "a is a constant (=1/3)" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The breakage exponent a is fixed at 1/3." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/nopens_2004/law/nopens_2004_eq6/par/A> ;
            mkg:slot "rate constant" ],
        [ mkg:boundTo <http://example.org/kg/nopens_2004/law/nopens_2004_eq6/par/a> ;
            mkg:slot "exponent" ] ;
    mkg:page "2" ;
    mkg:possibleMisprint "Given x is a volume in cm³ and a=1/3, A must have units cm⁻¹s⁻¹ for S to have units s⁻¹, not the stated cm⁻³s⁻¹." ;
    mkg:quote "S(x)=Ax^{a}" ;
    mkg:reviewOutcome "false alarm" ;
    mkg:status "pending" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq7> a mkg:Law ;
    rdfs:label "nopens_2004 eq 7"@en ;
    mkg:equationNumber "7" ;
    mkg:hasMetadata <http://example.org/kg/nopens_2004/law/nopens_2004_eq7_meta> ;
    mkg:hasParameter <http://example.org/kg/nopens_2004/law/nopens_2004_eq7/par/x_i> ;
    mkg:latex "$$ D[4,3]=\\frac{\\sum_{i=1}^{n}\\Delta F_{N}(x_{i})x_{i}^{4}}{\\sum_{i=1}^{n}\\Delta F_{N}(x_{i})x_{i}^{3}} $$" ;
    mkg:uses <http://example.org/kg/nopens_2004/law/nopens_2004_eq7/var/C_4_3>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq7/var/D>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq7/var/Delta_F_N> .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq7/par/x_i> a mkg:Parameter ;
    rdfs:label "x_{i} (nopens_2004 eq 7)"@en ;
    mkg:basis "stated" ;
    mkg:description "Diameter of size class i." ;
    mkg:dimension "[length]" ;
    mkg:page "3" ;
    mkg:quote "x_i represents the diameter of size class i" ;
    mkg:reason "It is the fixed diameter assigned to size class i in the discretized model grid, rather than a run condition." ;
    mkg:siFactor 1e-06 ;
    mkg:status "accepted" ;
    mkg:symbol "x_{i}" ;
    mkg:unit "µm" ;
    mkg:unitString "μm" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq7/var/C_4_3> a mkg:Variable ;
    rdfs:label "[4,3] (nopens_2004 eq 7)"@en ;
    mkg:description "Moment-order indices identifying the D[4,3] statistic." ;
    mkg:dimension "dimensionless" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "[4,3]" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq7/var/D> a mkg:Variable ;
    rdfs:label "D (nopens_2004 eq 7)"@en ;
    mkg:description "Mass mean diameter, or D[4,3]." ;
    mkg:dimension "[length]" ;
    mkg:measured true ;
    mkg:measuredQuote "one of the experimental D[4,3] data sets of Biggs & Lant (2000)" ;
    mkg:siFactor 1e-06 ;
    mkg:symbol "D" ;
    mkg:unit "µm" ;
    mkg:unitString "μm" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq7/var/Delta_F_N> a mkg:Variable ;
    rdfs:label "\\Delta F_{N} (nopens_2004 eq 7)"@en ;
    mkg:basis "stated" ;
    mkg:description "Number fraction in size class i." ;
    mkg:dimension "dimensionless" ;
    mkg:page "3" ;
    mkg:quote "the number fraction in size class i" ;
    mkg:reason "It is a size-class number fraction in the population distribution, which varies across classes and over the process." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "\\Delta F_{N}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq7_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The mass mean diameter is calculated as the ratio of the fourth and third moments of the number distribution." ;
    mkg:form "algebraic" ;
    mkg:ocrFixNote "The OCR turned ΔF_N(x_i)·x_i^4 into a function with two arguments." ;
    mkg:page "3" ;
    mkg:possibleMisprint "The numerator and denominator print ΔF_N with two arguments, although it is defined as the number fraction for a class; the moment formula requires multiplying that fraction by x_i⁴ and x_i³, respectively." ;
    mkg:quote "D[4,3]=\\frac{\\sum_{i=1}^{n}\\Delta F_{N}(x_{i})x_{i}^{4}}{\\sum_{i=1}^{n}\\Delta F_{N}(x_{i})x_{i}^{3}}" ;
    mkg:reviewOutcome "reading corrected" ;
    mkg:status "flagged" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq9> a mkg:Law ;
    rdfs:label "nopens_2004 eq 9"@en ;
    mkg:computes <http://example.org/kg/nopens_2004/law/nopens_2004_eq9/var/CON> ;
    mkg:equationNumber "9" ;
    mkg:hasMetadata <http://example.org/kg/nopens_2004/law/nopens_2004_eq9_meta> ;
    mkg:latex "C O N ( x, t ) = \\int _ { x } ^ { \\infty } n ( x ^ { \\prime }, t )   d x ^ { \\prime }" ;
    mkg:uses <http://example.org/kg/nopens_2004/law/nopens_2004_eq9/var/d>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq9/var/n>,
        <http://example.org/kg/nopens_2004/law/nopens_2004_eq9/var/x_prime> .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq9/var/CON> a mkg:Variable ;
    rdfs:label "CON (nopens_2004 eq 9)"@en ;
    mkg:description "cumulative oversize numbers" ;
    mkg:symbol "CON" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq9/var/d> a mkg:Variable ;
    rdfs:label "d (nopens_2004 eq 9)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Diameter of a particle in a size class." ;
    mkg:reason "A particle-size quantity used in the volume-to-number conversion, rather than a fitted constant." ;
    mkg:status "accepted" ;
    mkg:symbol "d" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq9/var/n> a mkg:Variable ;
    rdfs:label "n (nopens_2004 eq 9)"@en ;
    mkg:description "Floc size distribution function expressed in numbers." ;
    mkg:dimension "1 / [length] ** 3" ;
    mkg:measured true ;
    mkg:measuredQuote "The measured initial number distribution is used as initial condition for eq. 1." ;
    mkg:siFactor 1e+06 ;
    mkg:symbol "n" ;
    mkg:unit "number / cm ** 3" ;
    mkg:unitString "#.cm⁻³" .

<http://example.org/kg/nopens_2004/law/nopens_2004_eq9/var/x_prime> a mkg:Variable ;
    rdfs:label "x^{\\prime} (nopens_2004 eq 9)"@en ;
