<http://example.org/kg/bolton_2006_complete_standard_blocking/law/bolton_2006_eq31_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Calculates normalized pressure over time for constant-flow filtration combining complete blocking and standard blocking." ;
    mkg:doi "10.1016/j.memsci.2004.12.053" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "When the flux rate is kept constant" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The filtration is operated at constant flow rate." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/bolton_2006_complete_standard_blocking/law/bolton_2006_eq31/par/K_s> ;
            mkg:slot "standard blocking constant" ],
        [ mkg:boundTo <http://example.org/kg/bolton_2006_complete_standard_blocking/law/bolton_2006_eq31/par/K_b> ;
            mkg:slot "complete blocking constant" ] ;
    mkg:page "6" ;
    mkg:quote "\\frac{P}{P_{0}}=\\frac{1}{(1-K_{\\mathrm{b}}t)\\Big(1+\\frac{K_{\\mathrm{s}}J_{0}}{2K_{\\mathrm{b}}}\\ln(1-K_{\\mathrm{b}}t)\\Big)^{2}}" ;
    mkg:status "flagged" .

kg:bolton_2006_intermediate_standard_blocking_meta a mkg:Metadata ;
    mkg:completeModel true ;
    mkg:description "The Intermediate-standard blocking model represents protein fouling of microporous membranes by combining intermediate blocking, which reduces the available pore area, with standard blocking, which constricts pores and raises filtration resistance. Based on Darcy’s law, it predicts filtrate volume over time during constant-pressure filtration and pressure rise over time during constant-flow filtration using two fitted parameters. The paper tested it on human IgG filtration through a 0.22 μm PVDF membrane and BSA filtration through a virus-retention membrane, including constant-pressure and constant-flow runs. Model curves were fitted to measured filtration profiles by minimizing the sum of squared residuals. In the tested cases, this combined model did not improve on the relevant individual blocking model, and the authors describe it as applicable when the combined mechanisms match observed fouling." ;
    mkg:doi "10.1016/j.memsci.2004.12.053" ;
    mkg:form "algebraic" ;
    mkg:hasFact [ mkg:basis "stated" ;
            mkg:quote "The data and model predictions for one of the samples are shown in Figs. 4 and 5. The data from the other two experiments were similar." ;
            mkg:text "For constant-pressure IgG, the paper fitted one of the three experimental data sets and reported that the other two were similar." ;
            mkg:topic "fitting" ],
        [ mkg:basis "stated" ;
            mkg:quote "An electronic balance aperture and a collection vessel were used to collect and measure the filtrate weight. The electronic balance consisted of a load cell (1042-3-I, Tedea Huntleigh, Covina, CA) that interfaced with a computer through a data acquisition board." ;
            mkg:text "Filtrate mass was collected on an electronic balance with a load cell connected to a computer data-acquisition board." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "The combined cake-standard and cake-intermediate models also provided good data fits and may be applicable to systems where these models are consistent with the experimentally observed fouling mechanisms." ;
            mkg:text "The authors position intermediate-standard blocking as a candidate for describing fouling when the combined mechanisms agree with experimental observations, rather than as a broadly useful general-purpose fit." ;
            mkg:topic "use" ],
        [ mkg:basis "stated" ;
            mkg:quote "Data was collected every second for 1 h." ;
            mkg:text "The constant-pressure setup recorded data every second for one hour." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "The best fit was determined by minimizing the sum of squared residuals (SSR) where the residual was equal to the difference between a data point and the model prediction." ;
            mkg:text "Model fits were compared by minimizing the sum of squared residuals between measured data and model predictions." ;
            mkg:topic "fitting" ],
        [ mkg:basis "stated" ;
            mkg:quote "It is also possible to use a similar technique to create models that combine the standard blocking model with either the complete or intermediate blocking model." ;
            mkg:text "Intermediate-standard blocking is one of the five combined fouling models developed in the paper." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "The fit the intermediate blocking model was as good as the fit of the intermediate model combined with the standard model, Eq. (32)." ;
            mkg:text "For constant-flow IgG, the intermediate-standard model fitted as well as the intermediate-blocking model alone." ;
            mkg:topic "results" ],
        [ mkg:basis "stated" ;
            mkg:quote "The equations reduce to their respective component models at the limits where one fouling mode dominates." ;
            mkg:text "The combined model reduces to its component individual models when one mechanism dominates." ;
            mkg:topic "formulation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The equations however will not fit as wide a range of data as the combined cake-complete model and are therefore not as useful in general." ;
            mkg:text "The authors say the combined models involving standard blocking do not cover as broad a range of flux-decline behavior as the cake-complete model." ;
            mkg:topic "scope" ],
        [ mkg:basis "stated" ;
            mkg:quote "The model used three fitted parameters and an approximate solution was provided that allowed calculation of flux as a function of time without integrating. Plots of volume versus time during constant pressure operation or pressure versus time during constant flow operation were obtained by numerical integration of the relevant equations." ;
            mkg:text "The earlier Ho and Zydney (2000) model used three fitted parameters and required numerical integration for volume- or pressure-time predictions." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "Intermediate blocking is similar to complete blocking but assumes that a portion of the particles seal off pores and the rest accumulate on top of other deposited particles." ;
            mkg:text "Intermediate blocking represents some particles sealing pores while other deposited particles accumulate on top of them." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "Viresolve 180, a PVDF composite membrane composed of a thin ultraporous layer on top of a thicker microporous layer" ;
            mkg:text "The BSA virus-filtration tests used Viresolve 180, a PVDF composite with a thin ultraporous layer over a thicker microporous layer." ;
            mkg:topic "membrane" ],
        [ mkg:basis "stated" ;
            mkg:quote "The standard blocking equation for resistance as a function of time, Eq. (3) is valid in this case." ;
            mkg:text "In the combined model, intermediate blocking reduces available membrane area while standard blocking increases filtration resistance." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "The data was similar for the five experiments. The average and standard deviation was calculated at each time point." ;
            mkg:text "The BSA filtration results were averaged across five runs, with standard deviations calculated at each time point." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "The solutions were filtered at constant pressure in 13 or 47 mm stainless steel holders" ;
            mkg:text "Constant-pressure filtration was performed in 13 or 47 mm stainless-steel membrane holders supplied from pressure vessels." ;
            mkg:topic "equipment" ],
        [ mkg:basis "stated" ;
            mkg:quote "Three experiments were performed using the 13 mm membrane holders. The permeate volume was measured as a function of time until the flux had declined 95% from its initial value of $1.13 \\times 10^{-3}$ m/s." ;
            mkg:text "Three constant-pressure IgG experiments used 13 mm holders and continued until flux fell 95% from its initial value of 1.13 × 10⁻³ m/s." ;
            mkg:topic "experiments" ],
        [ mkg:basis "stated" ;
            mkg:quote "The fits of the standard model alone were as good as the fits of the standard model combined with the complete blocking model, Eq. (18), the intermediate blocking model, Eq. (19), or the cake filtration model, Eq. (23)." ;
            mkg:text "For constant-pressure IgG, the intermediate-standard model fitted no better than the standard-blocking model alone." ;
            mkg:topic "results" ],
        [ mkg:basis "stated" ;
            mkg:quote "Eqs. (17)–(19) will be applicable to the cases where the fouling is observed to occur by a specific combination of mechanisms." ;
            mkg:text "The paper presents the combined standard-and-intermediate equations as applicable when fouling is observed to involve that specific combination of mechanisms." ;
            mkg:topic "scope" ],
        [ mkg:basis "inferred" ;
            mkg:text "The model is expressed through algebraic time relationships rather than a state-based dynamic system." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "Explicit equations were derived that related pressure to time during constant flow operation, and volume to time during constant pressure operation." ;
            mkg:text "The model predicts permeate volume over time for constant-pressure operation and pressure over time for constant-flow operation." ;
            mkg:topic "prediction" ],
        [ mkg:basis "stated" ;
            mkg:quote "Five new fouling models that accounted for the combined effects of the different individual fouling mechanisms were derived from Darcy's law." ;
            mkg:text "The combined fouling models were derived from Darcy’s law." ;
            mkg:topic "formulation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The standard model combined with the intermediate model, Eq. (19), provided the same fit as the intermediate model alone and is not shown in Fig. 9." ;
            mkg:text "For constant-pressure BSA, the intermediate-standard model produced the same fit as the intermediate-blocking model alone." ;
            mkg:topic "results" ],
        [ mkg:basis "stated" ;
            mkg:quote "Fitted parameters: $K_i (m^{-1})$, $K_s (m^{-1})$" ;
            mkg:text "The model uses two fitted parameters, the intermediate-blocking constant and the standard-blocking constant." ;
            mkg:topic "parameters" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper cites Grace (1956) for standard-blocking background and Hermia (1982) for standard, complete, and intermediate blocking laws." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "Human plasma IgG (Seracare, Oceanside, CA) was prepared in pH 7.2 PBS at a concentration of 10.0 mg/mL." ;
            mkg:text "The human plasma IgG feed was prepared at 10.0 mg/mL in pH 7.2 PBS." ;
            mkg:topic "feed" ],
        [ mkg:basis "stated" ;
            mkg:quote "Durapore PVDF based membrane with a nominal pore size rating of 0.22 μm" ;
            mkg:text "The IgG sterile-filtration tests used 0.22 μm nominal-pore-size Durapore PVDF membranes." ;
            mkg:topic "membrane" ],
        [ mkg:basis "stated" ;
            mkg:quote "Bovine serum albumin (BSA, Sigma, St. Louis, MO) was prepared at 2.5 mg/mL concentration in pH 7.2 PBS buffer" ;
            mkg:text "The BSA feed was prepared at 2.5 mg/mL in pH 7.2 PBS." ;
            mkg:topic "feed" ],
        [ mkg:basis "stated" ;
            mkg:quote "In the standard model, membranes have straight cylindrical pores that decline in radius as solid matter accumulates on the pore walls" ;
            mkg:text "Standard blocking represents deposits constricting straight cylindrical membrane pores." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper reports fitting the model to experimental profiles but does not describe a separate held-out validation data set." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The BSA solution was filtered at a constant pressure through five samples of Viresolve 180 membrane in the 47 mm membrane holders. The permeate volume was measured as a function of time until the flux had declined 98% from its initial value of $3.58 \\times 10^{-4}$ m/s." ;
            mkg:text "Five constant-pressure BSA runs used Viresolve 180 in 47 mm holders and continued until flux fell 98% from its initial value of 3.58 × 10⁻⁴ m/s." ;
            mkg:topic "experiments" ],
        [ mkg:basis "inferred" ;
            mkg:text "The constant-flow IgG experiments used a flux of 579 L/m² h through 47 mm Durapore membrane samples." ;
            mkg:topic "experiments" ],
        [ mkg:basis "stated" ;
            mkg:quote "Durapore PVDF based membrane with a nominal pore size rating of 0.22 μm was run at 10 psi during constant pressure tests. Viresolve 180, a PVDF composite membrane composed of a thin ultraporous layer on top of a thicker microporous layer, was run at 30 psi during constant pressure tests of virus filtration membranes." ;
            mkg:text "Constant-pressure tests used 10 psi for Durapore membranes and 30 psi for Viresolve 180 membranes." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The models derived in this study are less physically detailed than the model of Ho and Zydney and will therefore be less useful for estimation of physical parameters. The new combined models, however, are more numerically simple to implement." ;
            mkg:text "The paper compares its combined models with the more physically detailed combined blockage-and-cake model of Ho and Zydney (2000), noting that the new models are simpler to implement." ;
            mkg:topic "comparison" ] ;
    mkg:status "pending" ;
    rdfs:comment "v0 distinct nodes; built from paddle.json (PaddleOCR-VL pipeline) by extractor/graph.py" .

<http://example.org/kg/bolton_2006_intermediate_standard_blocking/law/bolton_2006_eq19> a mkg:Law ;
