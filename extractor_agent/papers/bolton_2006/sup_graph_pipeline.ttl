    mkg:doi "10.1016/j.memsci.2004.12.053" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "Constant pressure" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
