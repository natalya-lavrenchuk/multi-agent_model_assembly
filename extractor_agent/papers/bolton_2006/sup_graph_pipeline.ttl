        [ mkg:basis "stated" ;
            mkg:quote "indicating that caking was a major component of each of the combined models." ;
            mkg:text "For the constant-flow IgG and constant-pressure BSA fits, the authors found caking to be a major component of the cake-standard model’s fitted behavior." ;
            mkg:topic "performance" ],
        [ mkg:basis "stated" ;
            mkg:quote "Explicit equations were derived from Darcy's law that related pressure to time during constant flow operation, and volume to time during constant pressure operation." ;
            mkg:text "The supplied model specification has no dynamic state variables; the paper presents time-dependent outputs through algebraic model equations." ;
            mkg:topic "formulation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The models used two parameters and reduced to the equations for the individual models in the absence of the second fouling mechanism." ;
            mkg:text "The model uses two fitted parameters." ;
            mkg:topic "formulation" ] ;
