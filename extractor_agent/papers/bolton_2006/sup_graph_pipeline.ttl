    mkg:description "Initial pressure used to normalize pressure in the equations" ;
    mkg:dimension "[mass] / [length] / [time] ** 2" ;
    mkg:reason "It is the initial pressure for the constant-flow filtration run, a measured operating quantity." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "P_{0}" ;
    mkg:unit "kg / m / s ** 2" ;
    mkg:unitString "kg/ms^2" .

<http://example.org/kg/bolton_2006_intermediate_standard_blocking/law/bolton_2006_eq32/var/t> a mkg:Variable ;
    rdfs:label "t (bolton_2006 eq 32)"@en ;
    mkg:basis "stated" ;
    mkg:description "Time" ;
    mkg:dimension "[time]" ;
    mkg:reason "It is the time coordinate that changes during the filtration run." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "t" ;
    mkg:unit "s" ;
    mkg:unitString "s" .

<http://example.org/kg/bolton_2006_intermediate_standard_blocking/law/bolton_2006_eq32_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Calculates normalized pressure over time for constant-flow filtration combining intermediate blocking and standard blocking." ;
    mkg:doi "10.1016/j.memsci.2004.12.053" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "When the flux rate is kept constant" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The filtration is operated at constant flow rate." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/bolton_2006_intermediate_standard_blocking/law/bolton_2006_eq32/par/K_i> ;
            mkg:slot "intermediate blocking constant" ],
        [ mkg:boundTo <http://example.org/kg/bolton_2006_intermediate_standard_blocking/law/bolton_2006_eq32/par/K_s> ;
            mkg:slot "standard blocking constant" ] ;
    mkg:page "6" ;
    mkg:quote "\\frac{P}{P_{0}}=\\frac{\\exp(K_{\\mathrm{i}}J_{0}t)}{\\left(1-\\frac{K_{\\mathrm{s}}}{2K_{\\mathrm{i}}}(\\exp(K_{\\mathrm{i}}J_{0}t)-1)\\right)^{2}}" ;
    mkg:status "flagged" .

<http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq15/par/K_b> a mkg:Parameter ;
    rdfs:label "K_{b} (bolton_2006 eq 15)"@en ;
    mkg:basis "stated" ;
    mkg:description "complete blocking constant" ;
    mkg:dimension "1 / [time]" ;
    mkg:reason "a complete blocking constant in the area-loss law" ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{b}" ;
    mkg:unit "1 / s" ;
    mkg:unitString "s^-1" ;
    mkg:valuesByCase "{\"Cake-complete blocking, IgG, constant pressure\": \"2.56 \\\\times 10^{-3} s^{-1}\", \"Cake-complete blocking, IgG, constant flow\": \"5.73 \\\\times 10^{-5} s^{-1}\", \"Cake-complete blocking, BSA, constant pressure\": \"1.38 \\\\times 10^{-3} s^{-1}\"}" .

