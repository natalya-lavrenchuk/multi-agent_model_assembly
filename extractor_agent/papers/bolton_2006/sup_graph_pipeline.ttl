<http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq29_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:description "Normalized pressure over time for constant-flow filtration combining standard blocking and cake filtration." ;
    mkg:doi "10.1016/j.memsci.2004.12.053" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "The combined cake-standard model assumes that the two fouling mechanisms are independent and will occur throughout the run." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Standard blocking and cake filtration are treated as independent mechanisms that occur throughout the run." ],
        [ mkg:quote "When the flux rate is kept constant" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The filtration is operated at constant flow rate." ],
        [ mkg:quote "The small particles must not be retained by the cake above the membrane." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The small particles causing pore constriction are not retained by the cake." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq29/par/K_s> ;
            mkg:slot "standard blocking constant" ],
        [ mkg:boundTo <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq29/par/K_c> ;
            mkg:slot "cake filtration constant" ] ;
    mkg:page "5" ;
    mkg:quote "\\frac{P}{P_{0}}=\\left(\\left(1-\\frac{K_{\\mathrm{s}}J_{0}t}{2}\\right)^{-2}+K_{\\mathrm{c}}J_{0}^{2}t\\right)" ;
    mkg:status "flagged" .

<http://example.org/kg/bolton_2006_complete_standard_blocking/bolton_2006_complete_standard_blocking_meta> a mkg:Metadata ;
    mkg:completeModel true ;
    mkg:description "The Complete-standard blocking model describes fouling during filtration of biological fluids through microporous membranes by combining complete pore blockage with standard blocking, in which deposits constrict pores. It predicts permeate volume over time at constant pressure and pressure over time at constant flow, using explicit relationships derived from Darcy’s law. The model has two fitted fouling parameters and is intended for cases where both mechanisms are relevant; it reduces to the corresponding single-mechanism model when one mechanism dominates. The paper compares its fits with individual fouling models using sterile filtration data for human plasma IgG and virus-filtration data for BSA, collected in small membrane holders. Across the reported comparisons, the combined model fit about as well as standard blocking alone, while other combined models performed better for some data sets. The authors present the combined models as tools for fitting fouling curves and assessing membrane sizing, while noting that a good fit does not establish the physical mechanism." ;
    mkg:doi "10.1016/j.memsci.2004.12.053" ;
    mkg:form "algebraic" ;
    mkg:hasFact [ mkg:basis "stated" ;
            mkg:quote "The models all used two fitted parameters" ;
            mkg:text "The model uses two fitted parameters, one for complete blocking and one for standard blocking." ;
            mkg:topic "model size" ],
        [ mkg:basis "stated" ;
            mkg:quote "Though providing a good data fit does not prove that fouling occurs by the simultaneous effects of pore blockage and cake formation" ;
            mkg:text "A good fit from a combined model is not proof that both represented fouling mechanisms actually occurred." ;
            mkg:topic "limitations" ],
        [ mkg:basis "stated" ;
            mkg:quote "The constant K_b has units of s^{-1}, and K_i has units of m^{-1}." ;
            mkg:text "The complete-blocking parameter has units of s⁻¹, and the standard-blocking parameter has units of m⁻¹." ;
            mkg:topic "model size" ],
        [ mkg:basis "stated" ;
            mkg:quote "Human plasma IgG (Seracare, Oceanside, CA) was prepared in pH 7.2 PBS at a concentration of 10.0 mg/mL." ;
            mkg:text "The IgG feed was human plasma IgG at 10.0 mg/mL in pH 7.2 PBS." ;
            mkg:topic "feeds" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper does not state whether model code or experimental data are publicly available." ;
            mkg:topic "availability" ],
        [ mkg:basis "stated" ;
            mkg:quote "During constant flow tests, a peristaltic pump (L/S Precision #WF77911-20, Cole Parmer, Vernon Hills, IL) with 16 gauge tubing (06409-16, Cole Parmer) was used to pump 10 mg/mL IgG through the Durapore membrane in the 47 mm holders at 579 L/m^{2} h." ;
            mkg:text "The constant-flow IgG tests used 47 mm holders and a flow rate of 579 L m⁻² h⁻¹ through Durapore membranes." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Durapore PVDF based membrane with a nominal pore size rating of 0.22 μm was run at 10 psi during constant pressure tests." ;
            mkg:text "The constant-pressure IgG tests used 0.22 μm Durapore PVDF membranes at 10 psi in 13 mm holders." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The BSA solution was filtered at a constant pressure through five samples of Viresolve 180 membrane in the 47 mm membrane holders. The permeate volume was measured as a function of time until the flux had declined 98% from its initial value of 3.58 × 10^{-4} m/s." ;
            mkg:text "Five constant-pressure BSA runs were conducted, and volume was measured until flux had fallen 98% from an initial 3.58 × 10⁻⁴ m/s." ;
            mkg:topic "bsa data" ],
        [ mkg:basis "stated" ;
            mkg:quote "There are four mechanistic models that are typically used to describe fouling." ;
            mkg:text "The model combines classical complete- and standard-blocking laws associated in the paper with Grace (1956) and Hermia (1982)." ;
            mkg:topic "prior work" ],
        [ mkg:basis "stated" ;
            mkg:quote "Data was collected every second for 1 h." ;
            mkg:text "The constant-pressure system recorded data every second for one hour." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "The pressure versus time data was fit to one of the experimental data sets using the combined models and all other typical fouling models. The data from the other two experiments were similar." ;
            mkg:text "The constant-flow IgG model comparison was fitted to one experiment's data, with the other two experiments described as similar." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Typically the best fits occur when one of the two mechanisms dominates, in which case the combined equations do not offer much benefit over the individual models." ;
            mkg:text "The paper says the combined complete-standard model is most applicable when a particular combination of mechanisms is observed and is not generally more useful than the individual models when one mechanism dominates." ;
            mkg:topic "limitations" ],
        [ mkg:basis "inferred" ;
            mkg:text "The combined formulation is expressed through aggregate membrane area, resistance, volume, pressure, and time relationships rather than spatially resolved fields." ;
            mkg:topic "model form" ],
        [ mkg:basis "stated" ;
            mkg:quote "An electronic balance aperture and a collection vessel were used to collect and measure the filtrate weight." ;
            mkg:text "Constant-pressure filtrate weight was collected on an electronic balance connected to a computer through a data-acquisition board." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "The ability of the combined cake-complete model to provide the best fits of both the sterile filtration data and nearly the best fit of the virus filtration data indicates it will be useful for fitting data from a wide range of solutions and membrane types and be useful for membrane area sizing." ;
            mkg:text "The combined models are presented as simpler equations for calculating filtration output over time and supporting membrane-area sizing." ;
            mkg:topic "use" ],
        [ mkg:basis "stated" ;
            mkg:quote "five new fouling models that accounted for the combined effects of the different individual fouling mechanisms were generated." ;
            mkg:text "The model represents membrane fouling caused by complete blockage and standard blocking during filtration of biological fluids." ;
            mkg:topic "system" ],
        [ mkg:basis "inferred" ;
            mkg:text "The supplied model specification has no ODE state variables; it calculates time-dependent filtration outputs from explicit relationships." ;
            mkg:topic "model size" ],
        [ mkg:basis "stated" ;
            mkg:quote "Bovine serum albumin (BSA, Sigma, St. Louis, MO) was prepared at 2.5 mg/mL concentration in pH 7.2 PBS buffer" ;
            mkg:text "The BSA feed was bovine serum albumin at 2.5 mg/mL in pH 7.2 PBS." ;
            mkg:topic "feeds" ],
        [ mkg:basis "stated" ;
            mkg:quote "Viresolve 180, a PVDF composite membrane composed of a thin ultraporous layer on top of a thicker microporous layer, was run at 30 psi during constant pressure tests of virus filtration membranes." ;
            mkg:text "The BSA virus-filtration tests used Viresolve 180 PVDF composite membranes at 30 psi in 47 mm holders." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The fit of the standard model was as good as the fits of the standard model combined with the complete blocking model, Eq. (31)." ;
            mkg:text "For constant-flow IgG filtration, the standard-model fit was as good as the complete-standard model fit." ;
            mkg:topic "fit results" ],
        [ mkg:basis "stated" ;
            mkg:quote "Complete blocking assumes that particles seal off pore entrances and prevent flow." ;
            mkg:text "Complete blocking represents particles sealing pore entrances so that those pores no longer carry flow." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "The best fit was determined by minimizing the sum of squared residuals (SSR) where the residual was equal to the difference between a data point and the model prediction." ;
            mkg:text "Model parameters were fitted by minimizing the sum of squared residuals between observations and model predictions." ;
            mkg:topic "fitting" ],
        [ mkg:basis "stated" ;
            mkg:quote "The fits of the standard model alone were as good as the fits of the standard model combined with the complete blocking model, Eq. (18)" ;
            mkg:text "For constant-pressure IgG filtration, the complete-standard model fit about as well as the standard model alone." ;
            mkg:topic "fit results" ],
        [ mkg:basis "inferred" ;
            mkg:text "Three constant-flow IgG experiments measured pressure over time while the feed was pumped at 579 L m⁻² h⁻¹." ;
            mkg:topic "igg data" ],
        [ mkg:basis "inferred" ;
            mkg:text "The model calculations use initial flux and time, with initial membrane area and initial pressure used in the filtration relationships and pressure normalization." ;
            mkg:topic "inputs" ],
        [ mkg:basis "stated" ;
            mkg:quote "The data was similar for the five experiments. The average and standard deviation was calculated at each time point." ;
            mkg:text "The BSA results were summarized as the average and standard deviation across the five runs at each time point." ;
            mkg:topic "bsa data" ],
        [ mkg:basis "stated" ;
            mkg:quote "It is also possible to use a similar technique to create models that combine the standard blocking model with either the complete or intermediate blocking model." ;
            mkg:text "The combined model represents loss of available membrane area from complete blocking together with increased resistance from standard blocking." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "The standard model combined the complete blocking model, Eq. (18), provided the same fit as the standard model alone and is not shown in Fig. 9." ;
            mkg:text "For constant-pressure BSA filtration, the standard model combined with complete blocking gave the same fit as standard blocking alone." ;
            mkg:topic "fit results" ],
        [ mkg:basis "stated" ;
            mkg:quote "Standard blocking assumes that particles accumulate inside membranes on the walls of straight cylindrical pores." ;
            mkg:text "Standard blocking represents particles depositing on the walls of straight cylindrical pores and constricting them." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "The data and model predictions for one of the samples are shown in Figs. 4 and 5. The data from the other two experiments were similar." ;
            mkg:text "The constant-pressure IgG plots show one sample, while the paper reports that the other two experiments were similar." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Three experiments were performed using the 13 mm membrane holders. The permeate volume was measured as a function of time until the flux had declined 95% from its initial value of 1.13 × 10^{-3} m/s." ;
            mkg:text "Three constant-pressure IgG experiments were run in 13 mm holders, and filtration continued until flux had fallen 95% from an initial 1.13 × 10⁻³ m/s." ;
            mkg:topic "igg data" ],
        [ mkg:basis "stated" ;
            mkg:quote "The models derived in this study are less physically detailed than the model of Ho and Zydney and will therefore be less useful for estimation of physical parameters." ;
            mkg:text "The paper contrasts its combined models with Ho and Zydney (2000), describing their model as more physically detailed but numerically more complex." ;
            mkg:topic "prior work" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper does not identify optimization software or report uncertainty intervals for the fitted parameters." ;
            mkg:topic "fitting" ],
        [ mkg:basis "stated" ;
            mkg:quote "Explicit equations were derived that related pressure to time during constant flow operation, and volume to time during constant pressure operation." ;
            mkg:text "The paper gives an explicit permeate-volume-versus-time relation for constant-pressure operation and a pressure-versus-time relation for constant-flow operation." ;
            mkg:topic "model form" ] ;
    mkg:status "pending" ;
    rdfs:comment "v0 distinct nodes; built from paddle.json (PaddleOCR-VL pipeline) by extractor/graph.py" .

<http://example.org/kg/bolton_2006_complete_standard_blocking/law/bolton_2006_eq18> a mkg:Law ;
    rdfs:label "bolton_2006 eq 18"@en ;
    mkg:computes <http://example.org/kg/bolton_2006_complete_standard_blocking/law/bolton_2006_eq18/var/V> ;
