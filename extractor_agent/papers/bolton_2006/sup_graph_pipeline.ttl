<http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq21> a mkg:Law ;
    rdfs:label "bolton_2006 eq 21"@en ;
    mkg:computes <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq21/var/J> ;
    mkg:equationNumber "21" ;
    mkg:hasMetadata <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq21_meta> ;
    mkg:hasParameter <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq21/par/K_c>,
        <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq21/par/K_s> ;
    mkg:latex "\\frac{J}{J_{0}}=\\left(\\left(1-\\frac{K_{\\mathrm{s}}V}{2}\\right)^{-2}+K_{\\mathrm{c}}J_{0}V\\right)^{-1}" ;
    mkg:uses <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq21/var/J_0>,
        <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq21/var/V> .

