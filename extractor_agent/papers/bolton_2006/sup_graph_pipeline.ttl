        <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq29/par/K_s> ;
    mkg:latex "\\frac{P}{P_{0}}=\\left(\\left(1-\\frac{K_{\\mathrm{s}}J_{0}t}{2}\\right)^{-2}+K_{\\mathrm{c}}J_{0}^{2}t\\right)" ;
    mkg:uses <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq29/var/J_0>,
        <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq29/var/P_0>,
        <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq29/var/t> .

