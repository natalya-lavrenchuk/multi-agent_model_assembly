<http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq22_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The equation gives elapsed time as a function of filtered volume for combined cake filtration and standard blocking." ;
    mkg:doi "10.1016/j.memsci.2004.12.053" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "Constant pressure" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "Filtration is operated at constant pressure." ],
        [ mkg:quote "The small particles must not be retained by the cake above the membrane." ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "Small particles that cause pore constriction are not retained by the cake." ],
        [ mkg:reasoned true ;
            mkg:severity "warning" ;
            mkg:text "The extent of both fouling contributions is taken to depend on the volume processed, so the volume-based resistance relations are used." ],
        [ mkg:quote "The combined cake-standard model assumes that the two fouling mechanisms are independent and will occur throughout the run." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The model treats cake filtration and standard blocking as independent effects that operate throughout the run." ],
        [ mkg:quote "In this case the available membrane area will not decline over the course of the run." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The available membrane area remains constant over the run." ] ;
    mkg:page "5" ;
    mkg:quote "t=\\frac{1}{(K_{\\mathrm{s}}V-2)}\\left(\\frac{K_{\\mathrm{s}}K_{\\mathrm{c}}V^{3}}{2}-K_{\\mathrm{c}}V^{2}-\\frac{2V}{J_{0}}\\right)" ;
    mkg:status "pending" .

<http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq29> a mkg:Law ;
    rdfs:label "bolton_2006 eq 29"@en ;
    mkg:computes <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq29/var/P> ;
    mkg:equationNumber "29" ;
    mkg:hasMetadata <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq29_meta> ;
