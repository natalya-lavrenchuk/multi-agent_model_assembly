<http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq16/var/t> a mkg:Variable ;
    rdfs:label "t (bolton_2006 eq 16)"@en ;
    mkg:basis "stated" ;
    mkg:description "Time" ;
    mkg:dimension "[time]" ;
    mkg:reason "It is the time coordinate that changes during the filtration run." ;
    mkg:siFactor 1e+00 ;
