<http://example.org/kg/bolton_2006_cake_intermediate_blocking/bolton_2006_cake_intermediate_blocking_meta> a mkg:Metadata ;
    mkg:completeModel true ;
    mkg:description "The cake-intermediate blocking model describes fouling during filtration of biological fluids through microporous or virus-retention membranes. It predicts permeate volume over time during constant-pressure operation and pressure rise over time during constant-flow operation. The model combines loss of available membrane area through intermediate blocking with increasing flow resistance from cake formation, using Darcy’s law to derive explicit time-dependent equations. The authors evaluated it with human plasma IgG filtered through Durapore PVDF membranes and BSA filtered through Viresolve 180 membranes, under both constant-pressure and constant-flow conditions. They fitted two parameters by minimizing squared residuals and compared its predictions with individual and other combined fouling models." ;
    mkg:doi "10.1016/j.memsci.2004.12.053" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "The deposited aggregates were assumed to be permeable." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Deposited aggregates are permeable." ] ;
    mkg:hasFact [ mkg:basis "stated" ;
            mkg:quote "The fit of the cake-intermediate model was slightly better than that of the cake-complete model, as shown in Table 5, though the fits of the two models were within the standard deviation of most data points." ;
            mkg:text "For constant-pressure BSA, the cake-intermediate and cake-complete fits were within the standard deviation of most data points." ;
            mkg:topic "results" ],
        [ mkg:basis "stated" ;
            mkg:quote "The models derived in this study are less physically detailed than the model of Ho and Zydney and will therefore be less useful for estimation of physical parameters. The new combined models, however, are more numerically simple to implement." ;
            mkg:text "The authors describe their combined models as less physically detailed but simpler to implement than the Ho and Zydney model, which used three fitted parameters." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "Model: Cake-intermediate (Eq. (30)) | Model fit error, SSR: 0.58" ;
            mkg:text "For constant-flow IgG, the cake-intermediate model had an SSR of 0.58, lower than the cake-complete model’s 1.36 and the cake-standard model’s 13.5." ;
            mkg:topic "results" ],
        [ mkg:basis "stated" ;
            mkg:quote "The average and standard deviation was calculated at each time point." ;
            mkg:text "Five constant-pressure BSA runs were performed, and the reported curve and error bars show the average and one standard deviation across runs." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "The solutions were filtered at constant pressure in 13 or 47 mm stainless steel holders" ;
            mkg:text "Constant-pressure filtration used 13 or 47 mm stainless-steel membrane holders." ;
            mkg:topic "equipment" ],
        [ mkg:basis "stated" ;
            mkg:quote "Explicit equations were derived from Darcy's law that related pressure to time during constant flow operation, and volume to time during constant pressure operation." ;
            mkg:text "The model is built from Darcy’s law and gives explicit time-dependent predictions for both constant-pressure and constant-flow operation." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "An electronic balance aperture and a collection vessel were used to collect and measure the filtrate weight." ;
            mkg:text "Filtrate weight was collected and measured using a collection vessel and an electronic balance." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "Viresolve 180, a PVDF composite membrane composed of a thin ultraporous layer on top of a thicker microporous layer, was run at 30 psi during constant pressure tests of virus filtration membranes." ;
            mkg:text "Constant-pressure BSA tests were run at 30 psi." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "They only provide improved fits of data that falls between the curves of their respective individual component models." ;
            mkg:text "The paper says the cake-intermediate model improves fits for data between the predictions of its two component models." ;
            mkg:topic "scope" ],
        [ mkg:basis "inferred" ;
            mkg:text "In the intermediate-blocking law, available membrane area decreases exponentially with processed permeate volume." ;
            mkg:topic "mechanism" ],
        [ mkg:basis "stated" ;
            mkg:quote "To account for the combined effects of filtration area loss and caking" ;
            mkg:text "The model represents fouling as a reduction in available filtration area together with an increase in filtration resistance." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "Data was collected every second for 1 h." ;
            mkg:text "The constant-pressure data-acquisition system recorded measurements every second for one hour." ;
            mkg:topic "measurement" ],
        [ mkg:basis "inferred" ;
            mkg:text "The authors’ parameter-based comparison indicated that caking was a major component of the cake-intermediate fit for constant-flow IgG." ;
            mkg:topic "results" ],
        [ mkg:basis "inferred" ;
            mkg:text "Three constant-flow IgG experiments measured pressure over time in 47 mm holders." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "The combined cake-standard and cake-intermediate models also provided good data fits and may be applicable to systems where these models are consistent with the experimentally observed fouling mechanisms." ;
            mkg:text "The paper says the cake-intermediate model is most applicable when its combined mechanisms agree with the mechanisms observed experimentally." ;
            mkg:topic "scope" ],
        [ mkg:basis "stated" ;
            mkg:quote "Bovine serum albumin (BSA, Sigma, St. Louis, MO) was prepared at 2.5 mg/mL concentration in pH 7.2 PBS buffer" ;
            mkg:text "The BSA feed was bovine serum albumin at 2.5 mg/mL in pH 7.2 PBS buffer." ;
            mkg:topic "materials" ],
        [ mkg:basis "stated" ;
            mkg:quote "The models used two fitted parameters" ;
            mkg:text "The combined model uses two fitted parameters." ;
            mkg:topic "parameters" ],
        [ mkg:basis "stated" ;
            mkg:quote "The pressure versus time data was fit to one of the experimental data sets using the combined models and all other typical fouling models. The data from the other two experiments were similar." ;
            mkg:text "For constant-flow IgG, the authors fitted the models to one experiment and reported that the other two experiments were similar." ;
            mkg:topic "fitting" ],
        [ mkg:basis "stated" ;
            mkg:quote "Human plasma IgG (Seracare, Oceanside, CA) was prepared in pH 7.2 PBS at a concentration of 10.0 mg/mL." ;
            mkg:text "The IgG feed was human plasma IgG at 10.0 mg/mL in pH 7.2 PBS buffer." ;
            mkg:topic "materials" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper does not state whether the model code or experimental data are publicly available." ;
            mkg:topic "availability" ],
        [ mkg:basis "stated" ;
            mkg:quote "Model: Cake-intermediate (Eq. (17)) | Model fit error, SSR: 9.59 × 10²" ;
            mkg:text "For constant-pressure BSA, the cake-intermediate model had an SSR of 9.59 × 10², slightly lower than the cake-complete model’s 1.62 × 10³." ;
            mkg:topic "results" ],
        [ mkg:basis "stated" ;
            mkg:quote "Three experiments were performed using the 13 mm membrane holders. The permeate volume was measured as a function of time until the flux had declined 95% from its initial value" ;
            mkg:text "Three constant-pressure IgG experiments were performed in 13 mm holders, and measurements continued until flux had fallen 95% from its initial value." ;
            mkg:topic "data" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper reports fitted parameter estimates but does not report parameter confidence intervals or other uncertainty estimates." ;
            mkg:topic "parameters" ],
        [ mkg:basis "stated" ;
            mkg:quote "Explicit equations were derived that related pressure to time during constant flow operation, and volume to time during constant pressure operation." ;
            mkg:text "The paper presents algebraic time-dependent equations rather than a spatially resolved description of the membrane." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "Durapore PVDF based membrane with a nominal pore size rating of 0.22 μm was run at 10 psi during constant pressure tests." ;
            mkg:text "The IgG tests used Durapore PVDF membranes with a nominal pore-size rating of 0.22 μm." ;
            mkg:topic "membrane" ],
        [ mkg:basis "stated" ;
            mkg:quote "Eq. (17) can be used to calculate volume as a function of time" ;
            mkg:text "At constant pressure, the model predicts permeate volume as a function of time." ;
            mkg:topic "equations" ],
        [ mkg:basis "stated" ;
            mkg:quote "Recently a model was developed that used a two-stage mechanism to describe membrane fouling." ;
            mkg:text "The combined-model development extends the earlier pore-blockage and cake-filtration model of Ho and Zydney (2000)." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "Durapore PVDF based membrane with a nominal pore size rating of 0.22 μm was run at 10 psi during constant pressure tests." ;
            mkg:text "Constant-pressure IgG tests were run at 10 psi." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The applicability of the models to data for the sterile filtration of IgG and the viral filtration of BSA was tested." ;
            mkg:text "The paper reports evaluation of the cake-intermediate model with IgG and BSA filtration, not with other feed species or membrane types." ;
            mkg:topic "scope" ],
        [ mkg:basis "stated" ;
            mkg:quote "There are four mechanistic models that are typically used to describe fouling." ;
            mkg:text "The model’s individual blocking and cake-filtration components follow the established blocking-filtration and cake-filtration laws discussed by Grace (1956) and Hermia (1982)." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "The fit of the intermediate model was as good as the fit of the combined intermediate blocking-cake filtration model." ;
            mkg:text "For constant-pressure IgG, the individual intermediate-blocking model fit about as well as the combined cake-intermediate model." ;
            mkg:topic "results" ],
        [ mkg:basis "stated" ;
            mkg:quote "Eq. (30) allows calculation of pressure as a function of time using the combined intermediate blocking-cake filtration model" ;
            mkg:text "At constant flow, the model predicts pressure as a function of time." ;
            mkg:topic "equations" ],
        [ mkg:basis "stated" ;
            mkg:quote "Cake filtration occurs when particles accumulate on the surface of a membrane in a permeable cake of increasing thickness that adds resistance to flow." ;
            mkg:text "Cake filtration represents particles accumulating on the membrane surface in a growing permeable layer that adds flow resistance." ;
            mkg:topic "mechanism" ],
        [ mkg:basis "stated" ;
            mkg:quote "Viresolve 180, a PVDF composite membrane composed of a thin ultraporous layer on top of a thicker microporous layer" ;
            mkg:text "The BSA tests used Viresolve 180, a PVDF composite membrane with a thin ultraporous layer over a thicker microporous layer." ;
            mkg:topic "membrane" ],
        [ mkg:basis "stated" ;
            mkg:quote "The ability of the combined cake-complete model to provide the best fits of both the sterile filtration data and nearly the best fit of the virus filtration data indicates it will be useful for fitting data from a wide range of solutions and membrane types and be useful for membrane area sizing." ;
            mkg:text "The authors present the combined models as tools for describing filtration fouling and supporting membrane-area sizing." ;
            mkg:topic "use" ],
        [ mkg:basis "inferred" ;
            mkg:text "Constant-flow IgG tests used a flux of 579 L/m² h." ;
            mkg:topic "operation" ],
        [ mkg:basis "inferred" ;
            mkg:text "The reported assessments compare fitted curves with filtration data; the paper does not report an independent holdout validation set." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Cake filtration, intermediate blocking" ;
            mkg:text "The cake-intermediate blocking model combines intermediate blocking with cake filtration." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "The permeate volume was measured as a function of time until the flux had declined 98% from its initial value" ;
            mkg:text "The BSA filtration measurements continued until flux had fallen 98% from its initial value." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "The best fit was determined by minimizing the sum of squared residuals (SSR) where the residual was equal to the difference between a data point and the model prediction." ;
            mkg:text "Model fits were assessed by minimizing the sum of squared residuals between observations and model predictions." ;
            mkg:topic "fitting" ],
        [ mkg:basis "stated" ;
            mkg:quote "The resistance to flow is increased by the presence of a cake layer on the membrane surface." ;
            mkg:text "The cake-filtration law represents increasing resistance as processed volume increases." ;
            mkg:topic "mechanism" ],
        [ mkg:basis "stated" ;
            mkg:quote "Intermediate blocking is similar to complete blocking but assumes that a portion of the particles seal off pores and the rest accumulate on top of other deposited particles." ;
            mkg:text "Intermediate blocking represents particles sealing some pores while other particles accumulate on previously deposited particles." ;
            mkg:topic "mechanism" ],
        [ mkg:basis "stated" ;
            mkg:quote "The system was pressurized with air and a digital pressure gauge was used" ;
            mkg:text "The constant-pressure system used a pressurized vessel, an electronic balance with a load cell, and a digital pressure gauge." ;
            mkg:topic "equipment" ],
        [ mkg:basis "stated" ;
            mkg:quote "The three combined models provided far better fits than the typical models." ;
            mkg:text "For constant-flow IgG, the three combined models fit substantially better than the individual fouling models." ;
            mkg:topic "results" ] ;
    mkg:status "pending" ;
