<http://example.org/kg/bolton_2006_cake_complete_blocking/bolton_2006_cake_complete_blocking_meta> a mkg:Metadata ;
    mkg:completeModel true ;
    mkg:description "The paper develops five combined fouling models for membrane filtration, including a cake-complete model for protein solutions filtered through microporous membranes. The model represents fouling through both growth of a cake layer and loss of open membrane area, and predicts permeate volume over time at constant pressure or pressure over time at constant flow. It uses Darcy’s law and two fitted parameters, and approaches the individual cake or complete-blocking models when one mechanism dominates. The authors tested it using sterile filtration of human plasma IgG and virus filtration of BSA, as well as constant-flow IgG tests, in bench-scale membrane holders. They compared its fits with individual and other combined fouling models and considered its use for membrane-area sizing." ;
    mkg:doi "10.1016/j.memsci.2004.12.053" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "The deposited aggregates were assumed to be permeable." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Deposited aggregates are permeable." ] ;
    mkg:hasFact [ mkg:basis "stated" ;
            mkg:quote "Explicit equations were derived that related pressure to time during constant flow operation, and volume to time during constant pressure operation." ;
            mkg:text "At constant flow, the model predicts pressure as a function of time." ;
            mkg:topic "outputs" ],
        [ mkg:basis "inferred" ;
            mkg:text "The model uses two fitted parameters, one for cake filtration and one for complete blocking." ;
            mkg:topic "structure" ],
        [ mkg:basis "inferred" ;
            mkg:text "The supplied formulation has eight algebraic laws and no state variables, so its time-dependent predictions are calculated from relations rather than state ODEs." ;
            mkg:topic "structure" ],
        [ mkg:basis "stated" ;
            mkg:quote "The best fit of the data occurred with the combined cake-intermediate model, which had and SSR value slightly lower than the cake-complete model, as shown in Table 4." ;
            mkg:text "For constant-flow IgG filtration, the cake-intermediate model had the lowest SSR at 0.58, while the cake-complete model had an SSR of 1.36." ;
            mkg:topic "results" ],
        [ mkg:basis "inferred" ;
            mkg:text "Five constant-pressure BSA runs used 47 mm holders, and permeate volume was measured until flux had fallen 98% from an initial 3.58 × 10⁻⁴ m/s." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "In this study only the parameter Ks was fit to the data." ;
            mkg:text "For the standard-model comparison in the constant-pressure IgG analysis, only the standard-blocking constant was fitted to avoid refitting the initial flux for each experiment." ;
            mkg:topic "fitting" ],
        [ mkg:basis "stated" ;
            mkg:quote "The ability of the combined cake-complete model to provide the best fits of both the sterile filtration data and nearly the best fit of the virus filtration data indicates it will be useful for fitting data from a wide range of solutions and membrane types and be useful for membrane area sizing." ;
            mkg:text "The authors propose the cake-complete model as useful for membrane-area sizing." ;
            mkg:topic "use" ],
        [ mkg:basis "stated" ;
            mkg:quote "To determine the filtrate volume as a function of percent flux decline – for example, the volume after the flux has declined 75% from its initial value – it is necessary to solve Eq. (15) numerically." ;
            mkg:text "The model does not provide a direct formula for permeate volume at a specified flux decline, so that quantity must be found numerically." ;
            mkg:topic "scope" ],
        [ mkg:basis "stated" ;
            mkg:quote "The combined cake-complete model idealizes fouling as occurring by the independent effect of complete blocking and caking." ;
            mkg:text "The cake-complete model idealizes caking and complete blocking as independent effects, although the paper notes that they may interact in real filtration." ;
            mkg:topic "mechanism" ],
        [ mkg:basis "stated" ;
            mkg:quote "Bovine serum albumin (BSA, Sigma, St. Louis, MO) was prepared at 2.5 mg/mL concentration in pH 7.2 PBS buffer" ;
            mkg:text "BSA was prepared at 2.5 mg/mL in pH 7.2 PBS, and human plasma IgG was prepared at 10.0 mg/mL in pH 7.2 PBS." ;
            mkg:topic "materials" ],
        [ mkg:basis "stated" ;
            mkg:quote "The combined models were assessed through testing under constant pressure and constant flow modes with solutions of bovine serum albumin and human IgG." ;
            mkg:text "The model describes fouling during filtration of protein solutions through microporous membranes." ;
            mkg:topic "system" ],
        [ mkg:basis "stated" ;
            mkg:quote "Five new fouling models that accounted for the combined effects of the different individual fouling mechanisms were derived from Darcy's law." ;
            mkg:text "The combined fouling relations were derived using Darcy’s law." ;
            mkg:topic "structure" ],
        [ mkg:basis "stated" ;
            mkg:quote "The combined cake-complete model in effect provides complete blocking and cake filtration parameters that are average values for the length of the run." ;
            mkg:text "Because the mechanisms may be coupled, the fitted cake and blocking parameters can represent average values over the filtration run." ;
            mkg:topic "interpretation" ],
        [ mkg:basis "stated" ;
            mkg:quote "This is demonstrated in Fig. 10 where the combined cake-complete model is fit to predictions of each of the typical blocking models from Fig. 8." ;
            mkg:text "The cake-complete model could closely reproduce predictions from each of the four individual fouling models." ;
            mkg:topic "results" ],
        [ mkg:basis "stated" ;
            mkg:quote "The combined cake-standard and cake-intermediate models also provided good data fits and may be applicable to systems where these models are consistent with the experimentally observed fouling mechanisms." ;
            mkg:text "The cake-standard and cake-intermediate models are intended for cases where those combinations agree with experimentally observed fouling mechanisms." ;
            mkg:topic "scope" ],
        [ mkg:basis "stated" ;
            mkg:quote "Data was collected every second for 1 h." ;
            mkg:text "The experimental system collected filtration data every second for one hour." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "Viresolve 180, a PVDF composite membrane composed of a thin ultraporous layer on top of a thicker microporous layer, was run at 30 psi during constant pressure tests of virus filtration membranes." ;
            mkg:text "The BSA virus-filtration tests used Viresolve 180, a composite PVDF membrane, at 30 psi." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The data was similar for the five experiments. The average and standard deviation was calculated at each time point." ;
            mkg:text "The BSA results were averaged across the five runs, with standard deviation calculated at each time point." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "Durapore PVDF based membrane with a nominal pore size rating of 0.22 μm was run at 10 psi during constant pressure tests." ;
            mkg:text "The IgG sterile-filtration tests used a nominal 0.22 μm Durapore PVDF membrane at 10 psi." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The models derived in this study are less physically detailed than the model of Ho and Zydney and will therefore be less useful for estimation of physical parameters. The new combined models, however, are more numerically simple to implement." ;
            mkg:text "The authors describe their combined models as less physically detailed than Ho and Zydney et al. (2000), but simpler to implement numerically." ;
            mkg:topic "comparison" ],
        [ mkg:basis "inferred" ;
            mkg:text "Three constant-flow IgG experiments measured pressure over time while solution was pumped through 47 mm holders at 579 L m⁻² h⁻¹." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "The best fit of the data occurred with the combined cake-complete model, which had and SSR value slightly lower than the standard model, as shown in Table 3." ;
            mkg:text "For constant-pressure IgG filtration, the cake-complete model had an SSR of 11.2, slightly lower than the standard model’s 13.9." ;
            mkg:topic "results" ],
        [ mkg:basis "inferred" ;
            mkg:text "Three constant-pressure IgG experiments used 13 mm holders, and permeate volume was measured until flux had fallen 95% from an initial 1.13 × 10⁻³ m/s." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "There are four mechanistic models that are typically used to describe fouling." ;
            mkg:text "The four individual fouling mechanisms used as components are the classical mechanisms cited to Grace (1956) and Hermia (1982)." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "Complete blocking assumes that particles seal off pore entrances and prevent flow." ;
            mkg:text "Complete blocking represents particles sealing pore entrances so those pores no longer carry flow." ;
            mkg:topic "mechanism" ],
        [ mkg:basis "stated" ;
            mkg:quote "The best fit was determined by minimizing the sum of squared residuals (SSR) where the residual was equal to the difference between a data point and the model prediction." ;
            mkg:text "Model fits were assessed by minimizing the sum of squared residuals between measured points and model predictions." ;
            mkg:topic "fitting" ],
        [ mkg:basis "stated" ;
            mkg:quote "Explicit equations were derived that related pressure to time during constant flow operation, and volume to time during constant pressure operation." ;
            mkg:text "At constant pressure, the model predicts permeate volume as a function of time." ;
            mkg:topic "outputs" ],
        [ mkg:basis "stated" ;
            mkg:quote "The model used three fitted parameters and an approximate solution was provided that allowed calculation of flux as a function of time without integrating." ;
            mkg:text "The paper compares the combined models with the earlier pore-blockage and cake-filtration model of Ho and Zydney et al. (2000), which used three fitted parameters." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "This equation reduces to the equation for complete blocking when Kc is small and reduces to the equation for cake filtration when Kb is small." ;
            mkg:text "When one mechanism contributes little, the combined model reduces to the corresponding individual cake-filtration or complete-blocking model." ;
            mkg:topic "outputs" ],
        [ mkg:basis "stated" ;
            mkg:quote "The cake-complete model will provide good fits of a broad range of curves where the flux declines in a manner between the extremes of cake filtration and complete blocking." ;
            mkg:text "The authors present the cake-complete model as useful for curves whose flux decline lies between the cake-filtration and complete-blocking extremes." ;
            mkg:topic "scope" ],
        [ mkg:basis "stated" ;
            mkg:quote "Though providing a good data fit does not prove that fouling occurs by the simultaneous effects of pore blockage and cake formation, the cake-complete model can be viewed as a useful phenomenological equation." ;
            mkg:text "A good fit from the cake-complete model does not establish that pore blockage and cake formation actually occurred simultaneously." ;
            mkg:topic "interpretation" ],
        [ mkg:basis "inferred" ;
            mkg:text "The formulation takes initial flux, initial membrane area, elapsed time, and initial pressure as inputs, and has no state variables." ;
            mkg:topic "inputs" ],
        [ mkg:basis "stated" ;
            mkg:quote "Four 600 mL chambers were connected to the pressure source." ;
            mkg:text "The constant-pressure equipment used 13 or 47 mm stainless-steel holders and four 600 mL chambers connected to the pressure source." ;
            mkg:topic "operation" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper reports fitted point estimates and fit errors but does not report parameter confidence intervals or other parameter-uncertainty estimates." ;
            mkg:topic "fitting" ],
        [ mkg:basis "stated" ;
            mkg:quote "The fit of the cake-intermediate model was slightly better than that of the cake-complete model, as shown in Table 5, though the fits of the two models were within the standard deviation of most data points." ;
            mkg:text "For constant-pressure BSA filtration, the cake-intermediate model fit best with an SSR of 959, compared with 1,620 for the cake-complete model, and the two fits were within the standard deviation of most data points." ;
            mkg:topic "results" ],
        [ mkg:basis "stated" ;
            mkg:quote "Cake forms on the membrane area that is not blocked. Complete blockage can occur on portions of the membrane area where a cake has formed. There is no flux through blocked membrane area." ;
            mkg:text "In the cake-complete model, cake forms on the area that remains unblocked, and blockage removes membrane area from flow." ;
            mkg:topic "mechanism" ],
        [ mkg:basis "stated" ;
            mkg:quote "Bovine serum albumin was filtered through virus retention membranes and human IgG was filtered through sterilizing grade microporous membranes." ;
            mkg:text "The experimental streams were BSA for virus filtration and human plasma IgG for sterile filtration." ;
            mkg:topic "system" ],
        [ mkg:basis "stated" ;
            mkg:quote "Cake filtration occurs when particles accumulate on the surface of a membrane in a permeable cake of increasing thickness that adds resistance to flow." ;
            mkg:text "Cake filtration represents particles accumulating on the membrane surface in a permeable layer that adds flow resistance." ;
            mkg:topic "mechanism" ],
        [ mkg:basis "stated" ;
            mkg:quote "The fouling solution was contained in a pressure vessel (XX1100000, Millipore, Bedford, MA)." ;
            mkg:text "Constant-pressure tests used a pressure vessel, stainless-steel membrane holders, an electronic balance, and a digital pressure gauge." ;
            mkg:topic "equipment" ] ;
    mkg:status "pending" ;
    rdfs:comment "v0 distinct nodes; built from paddle.json (PaddleOCR-VL pipeline) by extractor/graph.py" .

<http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq15> a mkg:Law ;
    rdfs:label "bolton_2006 eq 15"@en ;
    mkg:computes <http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq15/var/J> ;
    mkg:equationNumber "15" ;
    mkg:hasMetadata <http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq15_meta> ;
    mkg:hasParameter <http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq15/par/K_b>,
        <http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq15/par/K_c> ;
    mkg:latex "\\frac{J}{J_{0}}=\\left(1-\\frac{K_{\\mathrm{b}}V}{J_{0}}\\right)\\left(1+2K_{\\mathrm{c}}J_{0}^{2}t\\right)^{-1/2}" ;
    mkg:uses <http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq15/var/J_0>,
        <http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq15/var/V>,
        <http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq15/var/t> .

<http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq15/var/V> a mkg:Variable ;
    rdfs:label "V (bolton_2006 eq 15)"@en ;
    mkg:description "volume filtered" ;
    mkg:dimension "[length]" ;
    mkg:measured true ;
    mkg:measuredQuote "The permeate volume was measured as a function of time until the flux had declined 95% from its initial value of $ 1.13 \\times 10^{-3} $ m/s." ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "V" ;
    mkg:unit "m" ;
    mkg:unitString "m^3/m^2" .

<http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq15/var/t> a mkg:Variable ;
    rdfs:label "t (bolton_2006 eq 15)"@en ;
    mkg:basis "stated" ;
    mkg:description "Time" ;
    mkg:dimension "[time]" ;
    mkg:reason "It is the time coordinate that changes during the filtration run." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "t" ;
    mkg:unit "s" ;
    mkg:unitString "s" .

<http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq15_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The flux relation combines complete pore blockage, which reduces available filtration area, with cake buildup, which increases resistance." ;
    mkg:doi "10.1016/j.memsci.2004.12.053" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "Constant pressure" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "Filtration is operated at constant pressure." ],
        [ mkg:quote "The equation for complete blocking as a function of permeate volume, Eq. (5), will be valid in the presence of the cake." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The complete-blocking area relation as a function of permeate volume remains valid when cake is present." ],
        [ mkg:reasoned true ;
            mkg:severity "warning" ;
            mkg:text "The time-based cake-resistance relation applies to the area that remains available, with cake accumulating there at the same rate regardless of whether adjacent pores are blocked." ],
        [ mkg:quote "The combined cake-complete model idealizes fouling as occurring by the independent effect of complete blocking and caking." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The model treats cake formation and complete blocking as independent effects." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq15/var/J> ;
            mkg:slot "flux" ],
        [ mkg:boundTo <http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq15/var/J_0> ;
            mkg:slot "initial flux" ],
        [ mkg:boundTo <http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq15/par/K_c> ;
            mkg:slot "cake filtration constant" ],
        [ mkg:boundTo <http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq15/par/K_b> ;
            mkg:slot "complete blocking constant" ] ;
    mkg:page "3" ;
    mkg:quote "\\frac{J}{J_{0}}=\\left(1-\\frac{K_{\\mathrm{b}}V}{J_{0}}\\right)\\left(1+2K_{\\mathrm{c}}J_{0}^{2}t\\right)^{-1/2}" ;
    mkg:status "flagged" .

<http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq16> a mkg:Law ;
    rdfs:label "bolton_2006 eq 16"@en ;
    mkg:computes <http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq16/var/V> ;
    mkg:equationNumber "16" ;
    mkg:hasMetadata <http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq16_meta> ;
    mkg:hasParameter <http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq16/par/K_b>,
        <http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq16/par/K_c> ;
    mkg:latex "V=\\frac{J_{0}}{K_{\\mathrm{b}}}\\left(1-\\exp\\left(\\frac{-K_{\\mathrm{b}}}{K_{\\mathrm{c}}J_{0}^{2}}\\left(\\sqrt{1+2K_{\\mathrm{c}}J_{0}^{2}t}-1\\right)\\right)\\right)" ;
    mkg:uses <http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq16/var/J_0>,
        <http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq16/var/t> .

<http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq16/par/K_b> a mkg:Parameter ;
    rdfs:label "K_{b} (bolton_2006 eq 16)"@en ;
    mkg:basis "stated" ;
    mkg:description "complete blocking constant" ;
    mkg:dimension "1 / [time]" ;
    mkg:reason "a complete blocking constant in the area-loss law" ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{b}" ;
    mkg:unit "1 / s" ;
    mkg:unitString "s^-1" ;
    mkg:valuesByCase "{\"Cake-complete blocking, IgG, constant pressure\": \"2.56 \\\\times 10^{-3} s^{-1}\", \"Cake-complete blocking, IgG, constant flow\": \"5.73 \\\\times 10^{-5} s^{-1}\", \"Cake-complete blocking, BSA, constant pressure\": \"1.38 \\\\times 10^{-3} s^{-1}\"}" .

<http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq16/par/K_c> a mkg:Parameter ;
    rdfs:label "K_{c} (bolton_2006 eq 16)"@en ;
    mkg:basis "stated" ;
    mkg:description "Cake filtration constant" ;
    mkg:dimension "[time] / [length] ** 2" ;
    mkg:page "10" ;
    mkg:quote "cake filtration constant" ;
    mkg:reason "It is a fitted cake filtration constant of the fouling law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{c}" ;
    mkg:unit "s / m ** 2" ;
    mkg:unitString "s/m^2" ;
    mkg:valuesByCase "{\"Cake-complete, human plasma IgG, constant pressure\": \"1.30 × 10^3 s/m^2\", \"Cake-intermediate, human plasma IgG, constant flow\": \"4.93 × 10^4 s/m^2\", \"Cake-complete, human plasma IgG, constant flow\": \"5.74 × 10^4 s/m^2\", \"Cake-standard, human plasma IgG, constant flow\": \"7.82 × 10^4 s/m^2\", \"Cake-intermediate, BSA, constant pressure\": \"2.26 × 10^5 s/m^2\", \"Cake-complete, BSA, constant pressure\": \"3.05 × 10^5 s/m^2\", \"Cake-standard, BSA, constant pressure\": \"4.81 × 10^5 s/m^2\"}" .

<http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq16/var/J_0> a mkg:Variable ;
    rdfs:label "J_{0} (bolton_2006 eq 16)"@en ;
    mkg:basis "stated" ;
    mkg:description "initial flux" ;
    mkg:dimension "[length] / [time]" ;
    mkg:page "2" ;
    mkg:quote "$ J_{0} $ is the initial flux" ;
