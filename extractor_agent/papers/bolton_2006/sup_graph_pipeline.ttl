    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "J_{0}" ;
    mkg:unit "m / s" ;
    mkg:unitString "m/s" .

<http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq16/var/V> a mkg:Variable ;
    rdfs:label "V (bolton_2006 eq 16)"@en ;
    mkg:description "volume filtered" ;
