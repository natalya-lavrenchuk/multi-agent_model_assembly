<http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq21_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The flux relation combines the resistance contributions from cake filtration and standard pore blocking." ;
    mkg:doi "10.1016/j.memsci.2004.12.053" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "The small particles must not be retained by the cake above the membrane." ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "Small particles that cause pore constriction are not retained by the cake." ],
        [ mkg:quote "In this case the available membrane area will not decline over the course of the run." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The available membrane area remains constant over the run." ],
        [ mkg:quote "Constant pressure" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "Filtration is operated at constant pressure." ],
        [ mkg:quote "The combined cake-standard model assumes that the two fouling mechanisms are independent and will occur throughout the run." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The model treats cake filtration and standard blocking as independent effects that operate throughout the run." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq21/par/K_s> ;
            mkg:slot "standard blocking constant" ],
        [ mkg:boundTo <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq21/par/K_c> ;
            mkg:slot "cake filtration constant" ],
        [ mkg:boundTo <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq21/var/J> ;
            mkg:slot "flux" ],
        [ mkg:boundTo <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq21/var/J_0> ;
            mkg:slot "initial flux" ] ;
    mkg:page "5" ;
    mkg:quote "\\frac{J}{J_{0}}=\\left(\\left(1-\\frac{K_{\\mathrm{s}}V}{2}\\right)^{-2}+K_{\\mathrm{c}}J_{0}V\\right)^{-1}" ;
    mkg:status "flagged" .

<http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq22> a mkg:Law ;
    rdfs:label "bolton_2006 eq 22"@en ;
    mkg:computes <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq22/var/t> ;
    mkg:equationNumber "22" ;
    mkg:hasMetadata <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq22_meta> ;
    mkg:hasParameter <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq22/par/K_c>,
        <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq22/par/K_s> ;
    mkg:latex "t=\\frac{1}{(K_{\\mathrm{s}}V-2)}\\left(\\frac{K_{\\mathrm{s}}K_{\\mathrm{c}}V^{3}}{2}-K_{\\mathrm{c}}V^{2}-\\frac{2V}{J_{0}}\\right)" ;
    mkg:uses <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq22/var/J_0>,
        <http://example.org/kg/bolton_2006_cake_standard_blocking/law/bolton_2006_eq22/var/V> .

