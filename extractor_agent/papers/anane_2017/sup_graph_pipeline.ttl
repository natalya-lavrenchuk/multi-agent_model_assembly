    mkg:basis "stated" ;
    mkg:description "The dissolved-oxygen balance computes actual DOT from transfer toward saturation minus cellular oxygen uptake." ;
    mkg:doi "10.1016/j.bej.2017.05.013" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "with the assumption that the feed solution in the fed-batch phase is fully saturated with dissolved oxygen." ;
