        <http://example.org/kg/anane_2017/law/anane_2017_eq23/par/q_m> ;
    mkg:latex "q_{o}=\\left(q_{s o x}-q_{m}\\right)Y_{o s}+q_{s A}Y_{o a}" ;
    mkg:uses <http://example.org/kg/anane_2017/law/anane_2017_eq23/var/q_sA>,
