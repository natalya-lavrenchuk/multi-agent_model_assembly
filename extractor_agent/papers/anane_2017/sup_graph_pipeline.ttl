            mkg:severity "blocking" ;
            mkg:text "The feed solution in the fed-batch phase is fully saturated with dissolved oxygen." ] ;
    mkg:page "4" ;
    mkg:quote "\\frac{d D O T_{a}}{d t}=K_{L a}\\left(D O T^{*}-D O T_{a}\\right)-q_{o}X H" ;
    mkg:status "pending" .

<http://example.org/kg/anane_2017/law/anane_2017_eq23> a mkg:Law ;
    rdfs:label "anane_2017 eq 23"@en ;
    mkg:computes <http://example.org/kg/anane_2017/law/anane_2017_eq23/var/q_o> ;
    mkg:equationNumber "23" ;
    mkg:hasMetadata <http://example.org/kg/anane_2017/law/anane_2017_eq23_meta> ;
    mkg:hasParameter <http://example.org/kg/anane_2017/law/anane_2017_eq23/par/Y_oa>,
