    mkg:hasMetadata <http://example.org/kg/anane_2017/law/anane_2017_eq14_meta> ;
    mkg:latex "\\frac{dS}{dt}=\\frac{F}{V}\\left(S_{i}-S\\right)-q_{s}X" ;
    mkg:uses <http://example.org/kg/anane_2017/law/anane_2017_eq14/var/F>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq14/var/S_i>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq14/var/V>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq14/var/X>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq14/var/q_s> .

<http://example.org/kg/anane_2017/law/anane_2017_eq14/var/F> a mkg:Variable ;
    rdfs:label "F (anane_2017 eq 14)"@en ;
    mkg:basis "stated" ;
    mkg:description "Flow rate" ;
    mkg:dimension "[length] ** 3 / [time]" ;
    mkg:page "2" ;
    mkg:quote "Flow rate (L/h)" ;
    mkg:reason "It is the feed flow rate, an operating input calculated for the exponential feed and then switched to a constant feed." ;
    mkg:siFactor 2.777778e-07 ;
    mkg:status "accepted" ;
    mkg:symbol "F" ;
    mkg:unit "l / h" ;
    mkg:unitString "L/h" .

<http://example.org/kg/anane_2017/law/anane_2017_eq14/var/S> a mkg:Variable ;
    rdfs:label "S (anane_2017 eq 14)"@en ;
    mkg:description "Substrate (glucose)." ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:initialQuote "with 5 g/L glucose in the batch phase." ;
    mkg:initialValue "5 g/L" ;
    mkg:measured true ;
    mkg:measuredQuote "glucose (S)" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "S" ;
