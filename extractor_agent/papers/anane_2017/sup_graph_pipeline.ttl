kg:anane_2017_meta a mkg:Metadata ;
    mkg:description "Anane_2017 models a fed-batch culture of non-recombinant Escherichia coli W3110M and predicts biomass, glucose, acetate, and dissolved-oxygen profiles. It is a continuous, macro-kinetic model that represents glucose partitioning and acetate cycling, with oxygen transfer and the dissolved-oxygen probe response also included. The culture is run through batch and fed-batch phases, including exponential and constant feeding and glucose pulses. The authors fitted the model to data from a 2-L culture, using hourly samples for biomass, glucose, and acetate and online dissolved-oxygen measurements. They propose it for fermentation process development, optimization, control, and gradient-based simulations." ;
    mkg:doi "10.1016/j.bej.2017.05.013" ;
    mkg:form "DAE" ;
    mkg:hasFact [ mkg:basis "stated" ;
            mkg:quote "A set of auxiliary algebraic equations describing intracellular interactions relating substrate (glucose), oxygen and acetate consumption as well as biomass formation are coupled to the ODEs to form the kinetic model." ;
            mkg:text "The model couples differential balances with auxiliary algebraic equations for intracellular substrate, oxygen, acetate, and biomass relations." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "The data for model calibration was obtained from a fed-batch culture of non-recombinant E. coli W3110M." ;
            mkg:text "The model concerns acetate overflow metabolism and acetate accumulation during cultivation of non-recombinant E. coli W3110M." ;
            mkg:topic "system" ],
        [ mkg:basis "stated" ;
            mkg:quote "To start the batch phase, 2 L of medium was inoculated wit E. coli W3110 to OD₆₀₀ of 0.1." ;
            mkg:text "The batch was started with 2 L of medium containing 5 g/L glucose and inoculated to an optical density at 600 nm of 0.1." ;
            mkg:topic "equipment" ],
        [ mkg:basis "stated" ;
            mkg:quote "At the calculated q0 values for the current E. coli strain, when the probe response time is greater than 8 s, it is important to include it in the dynamics of the oxygen profile." ;
            mkg:text "The paper says probe response dynamics are important for the strain when the probe response time exceeds 8 seconds." ;
            mkg:topic "transport" ],
        [ mkg:basis "stated" ;
            mkg:quote "The E. coli model in Section 3 was solved using Matlab R2015a® with the CVODE integrator from SUNDIALS TB [21]." ;
            mkg:text "The model was solved in Matlab R2015a using the CVODE integrator from SUNDIALS." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The formulation is an advanced version of a similar representation of overflow metabolism in Saccharomyces cerevisiae, as presented by Pham and co-workers [14]." ;
            mkg:text "The paper describes its glucose-partitioning formulation as an advanced version of the overflow-metabolism representation by Pham et al. 1998 for Saccharomyces cerevisiae." ;
            mkg:topic "prior work" ],
        [ mkg:basis "inferred" ;
            mkg:text "The reported calibration and validation use fed-batch data from W3110M, and the paper does not describe a separate independent validation dataset." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "A= start of exponential feed fed-batch phase at m_set=0.25 h−1" ;
            mkg:text "The Fig. 2 caption gives 0.25 h⁻¹ for the start of exponential feeding, differing from the methods section's 0.22 h⁻¹ set point." ;
            mkg:topic "feeding" ],
        [ mkg:basis "stated" ;
            mkg:quote "This formulation of acetate profiles and overflow metabolism is closer to reality since E. coli does not have clear cut switching points in its metabolic routes on the onset of overflow, but rather slow or gradual switching systems from oxidative to overflow metabolism" ;
            mkg:text "The equations represent acetate production and re-assimilation as continuous processes rather than switching between discrete metabolic phases." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "A maximum specific growth rate (mmax) of 0.31 h−1 was recorded during the batch phase, in the presence of excess glucose. Growth at mmax was associated with a steady increase in extracellular acetate concentration." ;
            mkg:text "The authors report a maximum specific growth rate of 0.31 h⁻¹ in the glucose-excess batch phase, during which extracellular acetate increased." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Thus, acetate excretion into the extracellular medium only results from an offset of the equilibrium between its production and re-assimilation" ;
            mkg:text "The model treats acetate excretion as the result of an imbalance between its ongoing intracellular production and re-assimilation." ;
            mkg:topic "mechanism" ],
        [ mkg:basis "inferred" ;
            mkg:text "The methods specify an exponential-feed growth-rate set point of 0.22 h⁻¹, followed after 3 h by constant feeding at an initial specific growth rate of 0.11 h⁻¹ for 17 h." ;
            mkg:topic "feeding" ],
        [ mkg:basis "stated" ;
            mkg:quote "There was an adequate fit between the model and the experimental data." ;
            mkg:text "The paper describes the fit between model predictions and experimental data as adequate." ;
            mkg:topic "performance" ],
        [ mkg:basis "inferred" ;
            mkg:text "The authors interpret the rapid modeled response to glucose pulses and lack of a diauxic delay as evidence of continuous acetate re-assimilation alongside glucose use." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "The large set of metabolic routes are approximated by lumped kinetic parameters" ;
            mkg:text "The model is formulated at macro-kinetic scale, with the many metabolic routes represented by lumped kinetic parameters." ;
            mkg:topic "mechanism" ],
        [ mkg:basis "stated" ;
            mkg:quote "To determine the concentration of residual glucose and acetate, hourly samples were analysed on an Agilent 1200 HPLC system, equipped with a HyperRez™ XP Carbohydrate H+ column (Fisher Scientific, Schwerte, Germany) and a refractive index detector." ;
            mkg:text "Residual glucose and acetate were measured by hourly HPLC sampling using a refractive-index detector." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "The specific substrate uptake rate is therefore modelled with Mono-type kinetics with non-competitive inhibition:" ;
            mkg:text "Glucose uptake uses Monod-type kinetics with non-competitive inhibition by extracellular acetate." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "The 95% confidence intervals were estimated using σθi and a Student t-distribution." ;
            mkg:text "Parameter uncertainty was assessed by Monte Carlo resampling, with 95% confidence intervals calculated using parameter standard deviations and a Student t-distribution." ;
            mkg:topic "uncertainty" ],
        [ mkg:basis "inferred" ;
            mkg:text "Cultivation was carried out at 37 °C and pH 7.0 in a 3.7-L bench-top bioreactor fitted with a polarographic dissolved-oxygen probe." ;
            mkg:topic "equipment" ],
        [ mkg:basis "stated" ;
            mkg:quote "The Matlab code and fermentation data can be found at https://gitlab.tubit.tu-berlin.de/nicolas.cruz/E_coli_fed-batch/tree/master/Anane_2017_BEJ." ;
            mkg:text "The paper makes the Matlab code and fermentation data available through a GitLab repository." ;
            mkg:topic "availability" ],
        [ mkg:basis "stated" ;
            mkg:quote "Cellular growth was monitored by measuring the optical density of samples at 600 nm in a UV–vis spectrophotometer (Novaspec III, Amersham Biosciences, Amersham, UK)." ;
            mkg:text "Biomass growth was monitored by measuring sample optical density at 600 nm with a UV–vis spectrophotometer, then converting optical density to cell dry weight using a conversion factor." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "the overall growth of the culture results from usage of glucose through the oxidative (qsox), acetate uptake (qSA) and re-use of other products from the overflow route (qsof), which all contribute energy equivalents for cell growth" ;
            mkg:text "Glucose use is partitioned among oxidative metabolism, overflow metabolism, acetate uptake, and maintenance, with these routes contributing to growth." ;
            mkg:topic "mechanism" ],
        [ mkg:basis "stated" ;
            mkg:quote "During the constant feed phase the specific growth rate decreased to values below 0.05 h−1, when the glucose supply fell to values below 0.1 gglu gx−1 h−1" ;
            mkg:text "During constant feeding, specific growth fell below 0.05 h⁻¹ when glucose supply fell below 0.1 g glucose per g biomass per hour." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The model comprises a set of ordinary differential equations (ODEs) describing six state variables, namely biomass X and extracellular concentrations of substrate S, acetate A, dissolved oxygen DOTa and DOT, and the feed F (which can be constant or a function of time)." ;
            mkg:text "The paper describes six state variables: biomass, glucose, acetate, actual and measured dissolved oxygen, and feed rate." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "The difference between the two dissolved oxygen profiles DOTa and DOT is due to the response lag of the sensor, which is approximated by first order response kinetics for the DO-probe" ;
            mkg:text "The model represents measured dissolved oxygen as a first-order response to actual dissolved oxygen to account for probe lag." ;
            mkg:topic "transport" ],
        [ mkg:basis "stated" ;
            mkg:quote "The initial parameter values for PE were based on literature [4,5,17]. The initial values for the search in the parameter space were generated using the Minimum bias Latin hypercube design (MBLHD) [22]." ;
            mkg:text "Initial parameter values came from literature, and initial search points were generated with a minimum-bias Latin hypercube design." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "In the constant, slow feeding phase, acetate consumption was greater than its production, which represented a shift in the cycling equilibrium that favoured the consumption of extracellular acetate" ;
            mkg:text "The authors report that acetate consumption exceeded production during slow constant feeding." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "From an excess substrate (glucose) environment in the batch phase to chronic starvation conditions at the end, the acetate profile evolved according to predictable kinetics (Fig. 2)." ;
            mkg:text "The experiment was intended to cover growth regimes from excess glucose in batch to chronic starvation at the end of cultivation." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Due to its continuous characteristics, this model is suitable for simulations that require higher order gradient calculation such as Computational Fluid Dynamics (CFD) models, as well as in complex optimization problems involving the E. coli expression system." ;
            mkg:text "The authors propose the differentiable model for simulations requiring higher-order gradients, including computational fluid dynamics, and for complex optimization problems." ;
            mkg:topic "use" ],
        [ mkg:basis "stated" ;
            mkg:quote "twelve (12) out of the sixteen (16) parameters were exclusively identified with relative standard deviation less than 10%." ;
            mkg:text "Twelve of the 16 estimated parameters had relative standard deviations below 10%." ;
            mkg:topic "uncertainty" ],
        [ mkg:basis "stated" ;
            mkg:quote "The medium consisted of mineral salts and trace elements, as described by Glazyrina et al. [20], with 5 g/L glucose in the batch phase." ;
            mkg:text "The medium contained mineral salts and trace elements, and the batch phase began with 5 g/L glucose." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The fed-batch phase was initiated with a 300 g/L glucose feed at the exhaustion of the batch phase glucose, signalled by a sudden rise in dissolved oxygen tension." ;
            mkg:text "Fed-batch feeding began at batch glucose exhaustion, indicated by a sudden rise in dissolved-oxygen tension, using a 300 g/L glucose feed." ;
            mkg:topic "feeding" ],
        [ mkg:basis "inferred" ;
            mkg:text "The dataset contained 19 measurements each for biomass, glucose, and acetate, and 11,336 online dissolved-oxygen readings." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "To test the robustness of the acetate equations, intermittent glucose pulses were given in the constant feeding phase, and the corresponding response in all profiles were modelled." ;
            mkg:text "Intermittent glucose pulses were added during constant feeding to test the acetate equations' response." ;
            mkg:topic "feeding" ],
        [ mkg:basis "stated" ;
            mkg:quote "The parameter estimates (PE) were computed using lsqnonlin with the trust region reflective algorithm." ;
            mkg:text "Parameters were estimated with lsqnonlin using a trust-region-reflective algorithm." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The uptake of acetate, however, is inhibited in a non-competitive way by the presence of glucose in the medium due to E. coli's higher preference for glucose over acetate" ;
            mkg:text "Acetate uptake depends on extracellular acetate availability and is inhibited non-competitively by glucose." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "The mechanistic models of Xu [4], Lin [5] and Neubauer [8] are among the most widely used macro-kinetic models for description of E. coli fermentations." ;
            mkg:text "The model is presented as a continuous reformulation and improvement of macro-kinetic models by Xu et al. 1999, Lin et al. 2001, and Neubauer et al. 2003." ;
            mkg:topic "prior work" ],
        [ mkg:basis "stated" ;
            mkg:quote "twelve (12) out of the sixteen (16) parameters were exclusively identified with relative standard deviation less than 10%." ;
            mkg:text "The parameter table reports estimates for 16 model parameters." ;
            mkg:topic "model" ] ;
    mkg:status "pending" ;
    rdfs:comment "v0 distinct nodes; built from paddle.json (PaddleOCR-VL pipeline) by extractor/graph.py" .

<http://example.org/kg/anane_2017/law/anane_2017_eq12> a mkg:Law ;
    rdfs:label "anane_2017 eq 12"@en ;
    mkg:computes <http://example.org/kg/anane_2017/law/anane_2017_eq12/var/X> ;
    mkg:equationNumber "12" ;
    mkg:hasMetadata <http://example.org/kg/anane_2017/law/anane_2017_eq12_meta> ;
    mkg:latex "\\frac{dX}{dt}=\\frac{F}{V}\\left(0-X\\right)+\\mu X" ;
    mkg:uses <http://example.org/kg/anane_2017/law/anane_2017_eq12/var/F>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq12/var/V>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq12/var/mu> .

<http://example.org/kg/anane_2017/law/anane_2017_eq12/var/F> a mkg:Variable ;
    rdfs:label "F (anane_2017 eq 12)"@en ;
    mkg:basis "stated" ;
    mkg:description "Flow rate" ;
    mkg:dimension "[length] ** 3 / [time]" ;
    mkg:page "2" ;
    mkg:quote "Flow rate (L/h)" ;
    mkg:reason "It is the feed flow rate, an operating input calculated for the exponential feed and then switched to a constant feed." ;
    mkg:siFactor 2.777778e-07 ;
    mkg:status "accepted" ;
    mkg:symbol "F" ;
    mkg:unit "l / h" ;
    mkg:unitString "L/h" .

<http://example.org/kg/anane_2017/law/anane_2017_eq12/var/V> a mkg:Variable ;
    rdfs:label "V (anane_2017 eq 12)"@en ;
    mkg:basis "stated" ;
    mkg:description "Broth volume" ;
    mkg:dimension "[length] ** 3" ;
    mkg:initialQuote "To start the batch phase, 2 L of medium was inoculated wit E. coli W3110 to OD₆₀₀ of 0.1." ;
    mkg:initialValue "2 L" ;
    mkg:page "3" ;
    mkg:quote "broth volume (V, L)" ;
    mkg:reason "It is the broth volume, a process quantity that changes during fed-batch operation." ;
    mkg:siFactor 1e-03 ;
    mkg:status "accepted" ;
    mkg:symbol "V" ;
    mkg:unit "l" ;
    mkg:unitString "L" .

<http://example.org/kg/anane_2017/law/anane_2017_eq12/var/X> a mkg:Variable ;
    rdfs:label "X (anane_2017 eq 12)"@en ;
    mkg:description "Biomass (cell dry weight) concentration" ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:measured true ;
    mkg:measuredQuote "Cellular growth was monitored by measuring the optical density of samples at 600 nm in a UV–vis spectrophotometer (Novaspec III, Amersham Biosciences, Amersham, UK)." ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "X" ;
    mkg:unit "g / l" ;
    mkg:unitString "g/l" .

<http://example.org/kg/anane_2017/law/anane_2017_eq12/var/mu> a mkg:Variable ;
    rdfs:label "\\mu (anane_2017 eq 12)"@en ;
    mkg:description "Non-inhibited Monod-type specific growth rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "\\mu" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/anane_2017/law/anane_2017_eq12_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Biomass balance in the fed-batch culture, including dilution by sterile feed and growth." ;
    mkg:doi "10.1016/j.bej.2017.05.013" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "Considering that inlet concentration of biomass is zero (sterile feed)" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The feed contains no biomass." ] ;
    mkg:page "4" ;
    mkg:quote "\\frac{dX}{dt}=\\frac{F}{V}\\left(0-X\\right)+\\mu X" ;
    mkg:status "pending" .

<http://example.org/kg/anane_2017/law/anane_2017_eq13> a mkg:Law ;
    rdfs:label "anane_2017 eq 13"@en ;
    mkg:computes <http://example.org/kg/anane_2017/law/anane_2017_eq13/var/mu> ;
    mkg:equationNumber "13" ;
    mkg:hasMetadata <http://example.org/kg/anane_2017/law/anane_2017_eq13_meta> ;
    mkg:hasParameter <http://example.org/kg/anane_2017/law/anane_2017_eq13/par/Y_em>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq13/par/Y_xa>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq13/par/Y_xsof>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq13/par/q_m> ;
    mkg:latex "\\mu=\\left(q_{s o x}-q_{m}\\right)Y_{e m}+q_{s o f}Y_{x s o f}+q_{s A}Y_{x a}" ;
    mkg:uses <http://example.org/kg/anane_2017/law/anane_2017_eq13/var/q_sA>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq13/var/q_sof>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq13/var/q_sox> .

<http://example.org/kg/anane_2017/law/anane_2017_eq13/par/q_m> a mkg:Parameter ;
    rdfs:label "q_{m} (anane_2017 eq 13)"@en ;
    mkg:basis "stated" ;
    mkg:description "Specific maintenance coefficient" ;
    mkg:dimension "1 / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "Summary of results of parameter estimation and quantification of the uncertainty associated with the parameter estimators." ;
    mkg:page "2" ;
    mkg:quote "Specific maintenance coefficient" ;
    mkg:reason "It is a specific maintenance coefficient, a constant model coefficient estimated for the culture." ;
    mkg:siFactor 2.777778e-04 ;
    mkg:status "accepted" ;
    mkg:symbol "q_{m}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "g g^-1 h^-1" ;
    mkg:value 1.29e-02 ;
    mkg:valueUncertainty "7.0 %; 95% CI 0.0111–0.0147" .

<http://example.org/kg/anane_2017/law/anane_2017_eq13/var/mu> a mkg:Variable ;
    rdfs:label "\\mu (anane_2017 eq 13)"@en ;
    mkg:description "Non-inhibited Monod-type specific growth rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "\\mu" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/anane_2017/law/anane_2017_eq13/var/q_sA> a mkg:Variable ;
    rdfs:label "q_{sA} (anane_2017 eq 13)"@en ;
    mkg:description "Acetate consumption rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "q_{sA}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "g g^-1 h^-1" .

<http://example.org/kg/anane_2017/law/anane_2017_eq13/var/q_sof> a mkg:Variable ;
    rdfs:label "q_{sof} (anane_2017 eq 13)"@en ;
    mkg:description "Substrate metabolized through the overflow route" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "q_{sof}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "g g^-1 h^-1" .

<http://example.org/kg/anane_2017/law/anane_2017_eq13/var/q_sox> a mkg:Variable ;
    rdfs:label "q_{sox} (anane_2017 eq 13)"@en ;
    mkg:description "Substrate uptake rate for oxidation" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "q_{sox}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "g g^-1 h^-1" .

<http://example.org/kg/anane_2017/law/anane_2017_eq13_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Specific growth rate from oxidative substrate use after maintenance, overflow-route products, and acetate uptake." ;
    mkg:doi "10.1016/j.bej.2017.05.013" ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/anane_2017/law/anane_2017_eq13/par/Y_xsof> ;
            mkg:slot "yield" ],
        [ mkg:boundTo <http://example.org/kg/anane_2017/law/anane_2017_eq13/par/Y_xa> ;
            mkg:slot "yield" ],
        [ mkg:boundTo <http://example.org/kg/anane_2017/law/anane_2017_eq13/par/Y_em> ;
            mkg:slot "yield" ] ;
    mkg:page "4" ;
    mkg:quote "\\mu=\\left(q_{s o x}-q_{m}\\right)Y_{e m}+q_{s o f}Y_{x s o f}+q_{s A}Y_{x a}" ;
    mkg:status "pending" .

<http://example.org/kg/anane_2017/law/anane_2017_eq14> a mkg:Law ;
    rdfs:label "anane_2017 eq 14"@en ;
    mkg:computes <http://example.org/kg/anane_2017/law/anane_2017_eq14/var/S> ;
