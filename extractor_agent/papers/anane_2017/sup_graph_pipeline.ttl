<http://example.org/kg/anane_2017/law/anane_2017_eq21_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:correctionReason "The inhibition term should use glucose concentration \\(S\\), not glucose uptake rate \\(q_s\\), consistent with the paper’s description of glucose inhibition and the concentration units for \\(K_{is}\\)." ;
    mkg:correctionStatus "accepted" ;
    mkg:description "The specific acetate consumption rate is calculated from acetate availability and glucose-dependent inhibition." ;
    mkg:doi "10.1016/j.bej.2017.05.013" ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/anane_2017/law/anane_2017_eq21/par/q_Amax> ;
            mkg:slot "maximum rate" ],
        [ mkg:boundTo <http://example.org/kg/anane_2017/law/anane_2017_eq21/var/A> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/anane_2017/law/anane_2017_eq21/var/q_s> ;
            mkg:slot "inhibitor" ],
        [ mkg:boundTo <http://example.org/kg/anane_2017/law/anane_2017_eq21/par/K_sa> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/anane_2017/law/anane_2017_eq21/par/K_is> ;
            mkg:slot "inhibition constant" ] ;
    mkg:page "4" ;
    mkg:possibleMisprint "The inhibition term uses q_s, a specific glucose-uptake rate with units g/(g·h), divided by K_is in g/L; the text and units indicate that glucose concentration S, not q_s, is intended." ;
    mkg:quote "q_{sA}=\\frac{q_{Amax}}{1+\\frac{q_{s}}{K_{is}}}\\cdot\\frac{A}{A+K_{sa}}" ;
    mkg:reviewOutcome "paper misprint" ;
    mkg:status "pending" .

<http://example.org/kg/anane_2017/law/anane_2017_eq22> a mkg:Law ;
    rdfs:label "anane_2017 eq 22"@en ;
    mkg:computes <http://example.org/kg/anane_2017/law/anane_2017_eq22/var/DOT_a> ;
    mkg:equationNumber "22" ;
    mkg:hasMetadata <http://example.org/kg/anane_2017/law/anane_2017_eq22_meta> ;
    mkg:hasParameter <http://example.org/kg/anane_2017/law/anane_2017_eq22/par/DOT_star>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq22/par/H>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq22/par/K_La> ;
    mkg:latex "\\frac{d D O T_{a}}{d t}=K_{L a}\\left(D O T^{*}-D O T_{a}\\right)-q_{o}X H" ;
    mkg:uses <http://example.org/kg/anane_2017/law/anane_2017_eq22/var/X>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq22/var/q_o> .

<http://example.org/kg/anane_2017/law/anane_2017_eq22/par/DOT_star> a mkg:Parameter ;
    rdfs:label "DOT^{*} (anane_2017 eq 22)"@en ;
    mkg:basis "stated" ;
    mkg:description "Saturating value of DOT in the broth at the given operating conditions." ;
    mkg:dimension "dimensionless" ;
    mkg:page "2" ;
    mkg:quote "represents saturating value of DOT in the broth at the given operating conditions" ;
    mkg:reason "It is the saturation value of dissolved oxygen in the broth, a saturation property of the system." ;
    mkg:siFactor 1e-02 ;
    mkg:status "accepted" ;
    mkg:symbol "DOT^{*}" ;
    mkg:unit "%" ;
    mkg:unitString "%" .

<http://example.org/kg/anane_2017/law/anane_2017_eq22/par/H> a mkg:Parameter ;
    rdfs:label "H (anane_2017 eq 22)"@en ;
    mkg:basis "stated" ;
    mkg:description "Henry equilibrium constant." ;
    mkg:dimension "[length] ** 3 / [mass]" ;
    mkg:page "4" ;
    mkg:quote "H the Henry equilibrium constant" ;
    mkg:reason "It is a physical property, the Henry equilibrium constant in the oxygen balance." ;
    mkg:siFactor 1e-02 ;
    mkg:status "accepted" ;
    mkg:symbol "H" ;
    mkg:unit "l * % / g" ;
    mkg:unitString "% L g^-1" .

