        <http://example.org/kg/anane_2017/law/anane_2017_eq16>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq17>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq18>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq19>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq20>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq21>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq22>,
        <http://example.org/kg/anane_2017/law/anane_2017_eq23>,
