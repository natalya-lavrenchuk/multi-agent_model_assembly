            mkg:slot "yield" ],
        [ mkg:boundTo <http://example.org/kg/anane_2017/law/anane_2017_eq23/par/Y_oa> ;
            mkg:slot "yield" ] ;
    mkg:page "4" ;
    mkg:quote "q_{o}=\\left(q_{s o x}-q_{m}\\right)Y_{o s}+q_{s A}Y_{o a}" ;
    mkg:status "pending" .

<http://example.org/kg/anane_2017/law/anane_2017_eq24> a mkg:Law ;
