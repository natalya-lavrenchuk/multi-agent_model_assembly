kg:anane_2017 a mkg:Sup ;
    rdfs:label "anane_2017 · Anane et al. (2017) E. coli overflow metabolism by acetate cycling, fed-batch model"@en ;
    mkg:hasMetadata kg:anane_2017_meta ;
    mkg:includes <http://example.org/kg/anane_2017/law/anane_2017_eq12>,
