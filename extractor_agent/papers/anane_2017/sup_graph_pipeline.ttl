    mkg:basis "stated" ;
    mkg:description "Cellular oxygen uptake is calculated from substrate oxidation net of maintenance and acetate consumption, weighted by their oxygen yields." ;
    mkg:doi "10.1016/j.bej.2017.05.013" ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/anane_2017/law/anane_2017_eq23/var/q_sA> ;
