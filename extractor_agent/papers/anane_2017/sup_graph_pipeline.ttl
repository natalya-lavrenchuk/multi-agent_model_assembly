<http://example.org/kg/anane_2017/law/anane_2017_eq18_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:correctionQuote "The equilibrium qsA = 0 is reached when the acetate produced through the overflow route pA is equal to the acetate consumed qsA." ;
    mkg:correctionReason "The paper uses $q_{sA}$ for two quantities. In eq 18 and the sentence after it, $q_{sA}$ is the net acetate rate, which eq 19 names $q_{A}$ (production minus uptake). Everywhere else (eqs 13, 21, 23) $q_{sA}$ is the uptake rate only. Taken as printed, the balance would link to the uptake rate and acetate would rise whenever cells consume it." ;
    mkg:correctionStatus "accepted" ;
    mkg:description "Extracellular acetate balance in the fed-batch culture, with no acetate entering in the feed." ;
    mkg:doi "10.1016/j.bej.2017.05.013" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "considering no addition of acetate in the feed" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The feed contains no acetate." ] ;
    mkg:ocrFixNote "The OCR read q_sA·X as q_s·A·X (bold font)." ;
    mkg:page "4" ;
    mkg:possibleMisprint "The printed q_{s} A X term does not represent the net specific acetate rate; given Eq. (19), the balance should use q_{A}X." ;
    mkg:quote "\\frac{d\\boldsymbol{A}}{dt}=\\frac{\\boldsymbol{F}}{V}\\left(\\mathbf{0}-\\boldsymbol{A}\\right)+q_{sA}X" ;
    mkg:reviewOutcome "paper misprint",
        "reading corrected" ;
    mkg:status "pending" .

