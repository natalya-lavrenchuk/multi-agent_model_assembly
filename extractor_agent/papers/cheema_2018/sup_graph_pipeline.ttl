    mkg:basis "stated" ;
    mkg:description "Equilibrium constant of reaction." ;
    mkg:dimension "[length] ** 2 * [time] ** 4 / [mass] ** 2" ;
    mkg:page "4" ;
    mkg:quote "equilibrium constant of reaction" ;
