<http://example.org/kg/cheema_2018/law/cheema_2018_eq6_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:correctionQuote "“X is fractional conversion of reactant”" ;
    mkg:correctionReason "The printed product of bed-out conversions should be the corresponding bed’s fractional conversion paired with each bed inlet flow, as the paper defines X as reactant conversion." ;
    mkg:correctionStatus "proposed" ;
    mkg:description "The mixer material balance computes reactant conversion after combining the catalyst-bed effluent and quench streams." ;
    mkg:doi "10.1039/c8ra06821f" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "The mixing of gases in the mixer is assumed to be ideal and instantaneous." ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "Gas mixing in the mixer is ideal and instantaneous." ] ;
    mkg:page "5" ;
    mkg:possibleMisprint "The numerator multiplies inlet flow rates by the product of all bed-out conversions; with per-bed fractional conversions, each inlet flow should instead be paired with its corresponding bed conversion." ;
    mkg:quote "X_{\\mathrm{r},m_{\\mathrm{out}}}=\\frac{\\sum\\limits_{b=1}^{m-1}\\left(\\dot{n}_{\\mathrm{r},b_{\\mathrm{in}}}\\prod_{b=1}^{m-1}X_{\\mathrm{r},b_{\\mathrm{out}}}\\right)}{\\sum\\limits_{b=1}^{m-1}\\left(\\dot{n}_{\\mathrm{r},b_{\\mathrm{in}}}\\prod_{b=1}^{m-1}X_{\\mathrm{r},b_{\\mathrm{out}}}\\right)+\\left(\\dot{n}_{\\mathrm{r},b_{\\mathrm{out}}}+\\dot{n}_{\\mathrm{r},q_{\\mathrm{in}}}\\right)}" ;
    mkg:status "flagged" .

<http://example.org/kg/cheema_2018/law/cheema_2018_eq7> a mkg:Law ;
    rdfs:label "cheema_2018 eq 7"@en ;
    mkg:computes <http://example.org/kg/cheema_2018/law/cheema_2018_eq7/var/T_m_out> ;
    mkg:equationNumber "7" ;
    mkg:hasMetadata <http://example.org/kg/cheema_2018/law/cheema_2018_eq7_meta> ;
    mkg:hasParameter <http://example.org/kg/cheema_2018/law/cheema_2018_eq7/par/C_p_b_out>,
        <http://example.org/kg/cheema_2018/law/cheema_2018_eq7/par/C_p_m_out>,
        <http://example.org/kg/cheema_2018/law/cheema_2018_eq7/par/C_p_q_in> ;
    mkg:latex "$$ T_{m_{out}}=\\frac{\\dot{m}_{b_{out}}C_{p_{b_{out}}}T_{b_{out}}+\\dot{m}_{q_{in}}C_{p_{q_{in}}}T_{q_{in}}}{\\left(\\dot{m}_{b_{out}}+\\dot{m}_{q_{in}}\\right)C_{p_{m_{out}}}} $$" ;
    mkg:uses <http://example.org/kg/cheema_2018/law/cheema_2018_eq7/var/T_b_out>,
        <http://example.org/kg/cheema_2018/law/cheema_2018_eq7/var/T_q_in>,
        <http://example.org/kg/cheema_2018/law/cheema_2018_eq7/var/dot_m_b_out>,
        <http://example.org/kg/cheema_2018/law/cheema_2018_eq7/var/dot_m_q_in> .

