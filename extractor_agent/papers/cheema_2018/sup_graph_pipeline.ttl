<http://example.org/kg/cheema_2018/law/cheema_2018_eq7_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The mixer energy balance computes the mixed-stream outlet temperature after the catalyst-bed effluent and quench streams are combined." ;
    mkg:doi "10.1039/c8ra06821f" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "The heat of mixing is neglected, as components do not interact strongly with each other." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Heat of mixing is neglected because the components are assumed not to interact strongly." ] ;
    mkg:ocrFixNote "The OCR could not read the fraction (the paper typesets it unusually); rewritten from the PDF." ;
    mkg:page "5" ;
    mkg:possibleMisprint "The equation combines mass flow rates in kg h⁻¹ with specific heat capacities listed in kJ kmol⁻¹ K⁻¹, so the units do not form a consistent energy balance." ;
    mkg:quote "T_{m_{out}}=\\frac{\\dot{m}_{b_{out}}C_{p_{b_{out}}}T_{b_{out}}+\\dot{m}_{q_{in}}C_{p_{q_{in}}}T_{q_{in}}}{\\left(\\dot{m}_{b_{out}}+\\dot{m}_{q_{in}}\\right)C_{p_{m_{out}}}}" ;
    mkg:reviewOutcome "reading corrected" ;
    mkg:status "pending" .

<http://example.org/kg/cheema_2018/law/cheema_2018_eq5/par/K> a mkg:Parameter ;
