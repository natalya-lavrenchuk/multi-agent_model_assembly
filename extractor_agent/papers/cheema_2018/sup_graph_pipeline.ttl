<http://example.org/kg/cheema_2018/law/cheema_2018_eq4_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The catalyst-bed energy balance computes the reacting-mixture temperature change along bed volume from reaction heat and the heat-capacity flow." ;
    mkg:doi "10.1039/c8ra06821f" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "heat transfer resistance between pellet and gas is also neglected" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Heat-transfer resistance between the catalyst pellet and gas is neglected." ],
        [ mkg:quote "with consideration only for convective driving forces for transport of mass and heat between the flowing gases and catalyst" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Heat transport between the flowing gas and catalyst is represented using only convective driving forces." ],
        [ mkg:quote "We consider a radial flow catalyst bed" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The catalyst bed is radial-flow." ],
        [ mkg:quote "the rate of formation for ammonia can be taken without correction factors such as effectiveness factor" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The heat balance uses no correction factor such as an effectiveness factor." ],
        [ mkg:reasoned true ;
            mkg:severity "warning" ;
            mkg:text "A high-thermal-conductivity magnetite catalyst is assumed." ],
        [ mkg:quote "For fine catalyst particles of size 1.5 to 3 mm" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "Catalyst particles are 1.5 to 3 mm in size." ] ;
    mkg:page "4" ;
    mkg:possibleMisprint "The denominator combines mass flow in kg h⁻¹ with specific heat capacity listed in kJ kmol⁻¹ K⁻¹, so the units do not form the stated energy balance." ;
    mkg:quote "\\frac{\\mathrm{d}T_{b}}{\\mathrm{d}V_{b}}=\\frac{(-\\Delta H_{b})R_{\\mathrm{N H}_{3},b}}{\\dot{m}_{b_{\\mathrm{i n}}}c_{\\mathrm{p}_{b}}}" ;
    mkg:reviewOutcome "false alarm" ;
    mkg:status "pending" .

<http://example.org/kg/cheema_2018/law/cheema_2018_eq5> a mkg:Law ;
    rdfs:label "cheema_2018 eq 5"@en ;
    mkg:computes <http://example.org/kg/cheema_2018/law/cheema_2018_eq5/var/R_NH_3> ;
    mkg:equationNumber "5" ;
    mkg:hasMetadata <http://example.org/kg/cheema_2018/law/cheema_2018_eq5_meta> ;
    mkg:hasParameter <http://example.org/kg/cheema_2018/law/cheema_2018_eq5/par/K>,
        <http://example.org/kg/cheema_2018/law/cheema_2018_eq5/par/alpha>,
        <http://example.org/kg/cheema_2018/law/cheema_2018_eq5/par/k_2> ;
    mkg:latex "R_{\\mathrm{N H}_{3}}=k_{2}\\left(K^{2}a_{\\mathrm{N}_{2}}\\left(\\frac{a_{\\mathrm{H}_{2}}^{3}}{a_{\\mathrm{N H}_{3}}^{2}}\\right)^{\\alpha}-\\left(\\frac{a_{\\mathrm{N H}_{3}}^{2}}{a_{\\mathrm{H}_{2}}^{3}}\\right)^{1-\\alpha}\\right)" ;
    mkg:uses <http://example.org/kg/cheema_2018/law/cheema_2018_eq5/var/a_H_2>,
        <http://example.org/kg/cheema_2018/law/cheema_2018_eq5/var/a_NH_3>,
        <http://example.org/kg/cheema_2018/law/cheema_2018_eq5/var/a_N_2> .

<http://example.org/kg/cheema_2018/law/cheema_2018_eq5/par/alpha> a mkg:Parameter ;
    rdfs:label "\\alpha (cheema_2018 eq 5)"@en ;
    mkg:basis "stated" ;
    mkg:description "Exponent in the modified Temkin reaction-rate law." ;
    mkg:dimension "dimensionless" ;
    mkg:reason "It is a constant exponent in the reaction-rate law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "\\alpha" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" ;
    mkg:value 5e-01 .

<http://example.org/kg/cheema_2018/law/cheema_2018_eq5/var/R_NH_3> a mkg:Variable ;
    rdfs:label "R_{NH_3} (cheema_2018 eq 5)"@en ;
    mkg:description "Rate of reaction." ;
    mkg:dimension "[substance] / [length] ** 3 / [time]" ;
    mkg:sameQuantityAs "R_{NH_3,b}" ;
    mkg:siFactor 2.777778e-01 ;
    mkg:symbol "R_{NH_3}" ;
    mkg:unit "kmol / h / m ** 3" ;
    mkg:unitString "kmol m^-3 h^-1" .

<http://example.org/kg/cheema_2018/law/cheema_2018_eq5_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "A modified Temkin rate law computes the ammonia synthesis rate from nitrogen, hydrogen and ammonia activities and the reaction constants." ;
    mkg:doi "10.1039/c8ra06821f" ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/cheema_2018/law/cheema_2018_eq5/var/a_N_2> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/cheema_2018/law/cheema_2018_eq5/var/a_NH_3> ;
            mkg:slot "product" ],
        [ mkg:boundTo <http://example.org/kg/cheema_2018/law/cheema_2018_eq5/par/K> ;
            mkg:slot "equilibrium constant" ],
        [ mkg:boundTo <http://example.org/kg/cheema_2018/law/cheema_2018_eq5/par/k_2> ;
            mkg:slot "rate constant" ],
        [ mkg:boundTo <http://example.org/kg/cheema_2018/law/cheema_2018_eq5/var/a_H_2> ;
            mkg:slot "substrate" ] ;
    mkg:page "4" ;
    mkg:quote "R_{\\mathrm{N H}_{3}}=k_{2}\\left(K^{2}a_{\\mathrm{N}_{2}}\\left(\\frac{a_{\\mathrm{H}_{2}}^{3}}{a_{\\mathrm{N H}_{3}}^{2}}\\right)^{\\alpha}-\\left(\\frac{a_{\\mathrm{N H}_{3}}^{2}}{a_{\\mathrm{H}_{2}}^{3}}\\right)^{1-\\alpha}\\right)" ;
    mkg:status "pending" .

<http://example.org/kg/cheema_2018/law/cheema_2018_eq6> a mkg:Law ;
    rdfs:label "cheema_2018 eq 6"@en ;
    mkg:computes <http://example.org/kg/cheema_2018/law/cheema_2018_eq6/var/X_r_m_out> ;
    mkg:equationNumber "6" ;
    mkg:hasMetadata <http://example.org/kg/cheema_2018/law/cheema_2018_eq6_meta> ;
    mkg:latex "X_{\\mathrm{r},m_{\\mathrm{out}}}=\\frac{\\sum\\limits_{b=1}^{m-1}\\left(\\dot{n}_{\\mathrm{r},b_{\\mathrm{in}}}\\prod_{b=1}^{m-1}X_{\\mathrm{r},b_{\\mathrm{out}}}\\right)}{\\sum\\limits_{b=1}^{m-1}\\left(\\dot{n}_{\\mathrm{r},b_{\\mathrm{in}}}\\prod_{b=1}^{m-1}X_{\\mathrm{r},b_{\\mathrm{out}}}\\right)+\\left(\\dot{n}_{\\mathrm{r},b_{\\mathrm{out}}}+\\dot{n}_{\\mathrm{r},q_{\\mathrm{in}}}\\right)}" ;
    mkg:latexCorrected "$$ X_{\\mathrm{r},m_{\\mathrm{out}}}=\\frac{\\sum\\limits_{b=1}^{m-1}\\left(\\dot{n}_{\\mathrm{r},b_{\\mathrm{in}}}X_{\\mathrm{r},b_{\\mathrm{out}}}\\right)}{\\sum\\limits_{b=1}^{m-1}\\left(\\dot{n}_{\\mathrm{r},b_{\\mathrm{in}}}X_{\\mathrm{r},b_{\\mathrm{out}}}\\right)+\\left(\\dot{n}_{\\mathrm{r},b_{\\mathrm{out}}}+\\dot{n}_{\\mathrm{r},q_{\\mathrm{in}}}\\right)} $$" ;
    mkg:uses <http://example.org/kg/cheema_2018/law/cheema_2018_eq6/var/X_r_b_out>,
        <http://example.org/kg/cheema_2018/law/cheema_2018_eq6/var/dot_n_r_b_in>,
        <http://example.org/kg/cheema_2018/law/cheema_2018_eq6/var/dot_n_r_b_out>,
        <http://example.org/kg/cheema_2018/law/cheema_2018_eq6/var/dot_n_r_q_in> .

<http://example.org/kg/cheema_2018/law/cheema_2018_eq6/var/X_r_b_out> a mkg:Variable ;
