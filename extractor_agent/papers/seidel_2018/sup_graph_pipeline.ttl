<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/seidel_2018_simplified_kinetic_model_steady_state_meta> a mkg:Metadata ;
    mkg:completeModel false ;
    mkg:description "The simplified steady-state-φ model describes methanol synthesis from hydrogen and CO and/or CO₂ over a Cu/ZnO/Al₂O₃ catalyst, predicting reaction rates and gas composition. It uses lumped Langmuir–Hinshelwood kinetics and distinguishes oxidized and reduced catalyst surface centers, with their relative amounts calculated from an equilibrium morphology relation. The authors fitted its kinetic parameters to 140 steady-state experiments in a differential Micro-Berty reactor, spanning feeds from pure CO to pure CO₂. Dynamic feed-switching experiments were also used to assess the quasi-static surface-center calculation, although the model variant with dynamic surface-center changes described those transients better. The authors propose the models for methanol production under changing feed compositions, including chemical energy storage using renewable resources." ;
    mkg:doi "10.1016/j.ces.2017.09.043" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "The other steps are assumed to be much faster such that equilibrium can be assumed for them." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Fast steps are at quasi‑equilibrium." ],
        [ mkg:quote "The catalyst deactivation is neglected and no side reactions beyond Eqs. (1)–(3) are considered." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Catalyst deactivation neglected; only reactions (1)-(3) considered." ],
        [ mkg:quote "The simplified Langmuir-Hinshelwood kinetics is not based on elementary reaction steps but on lumped reaction kinetics for reactions Eqs. (1)–(3) of the methanol synthesis." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Lumped kinetics for reactions (1)-(3)." ] ;
    mkg:hasFact [ mkg:basis "stated" ;
            mkg:quote "Since local optimization methods do not give satisfying results due to multiple local minima, deterministic global optimization with BARON. Tawarmalani and Sahinidis (2005) in GAMS (GAMS, 2013) is applied." ;
            mkg:text "The authors used deterministic global optimization with BARON in GAMS because local methods gave unsatisfactory results in the presence of multiple local minima." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "with reference temperature Tref = 523.15 K" ;
            mkg:text "The reaction-rate temperature dependence uses a reparameterized Arrhenius expression referenced to 523.15 K." ;
            mkg:topic "parameters" ],
        [ mkg:basis "stated" ;
            mkg:quote "The Modeling is based on the Langmuir-Hinshelwood mechanism and consists of three main steps: first adsorption at the surface, reaction at the surface and desorption from the surface." ;
            mkg:text "The model uses Langmuir–Hinshelwood kinetics with adsorption, surface reaction, and desorption represented in its rate and coverage expressions." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "Order to reduce the influence of measurement uncertainties, a balancing of the analytical results was performed prior to the parameter estimation." ;
            mkg:text "The analytical results were balanced before parameter estimation to reduce the influence of measurement uncertainty." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "new detailed kinetic model for the methanol synthesis from H2, CO2 and/or CO using a Cu/ZnO/Al2O3 catalyst is proposed." ;
            mkg:text "The model describes methanol synthesis from H₂, CO, and/or CO₂ over a Cu/ZnO/Al₂O₃ catalyst." ;
            mkg:topic "system" ],
        [ mkg:basis "stated" ;
            mkg:quote "A maximum coverage of 90% of reduced surface centers is assumed and ensured with a correction factor of -0.1 in Eq. (22) Seidel et al., (2018)." ;
            mkg:text "The corrigendum specifies that the steady-state model limits the reduced surface-center fraction to 90%." ;
            mkg:topic "morphology" ],
        [ mkg:basis "stated" ;
            mkg:quote "the prefactor of the reverse water–gas shift reaction (RWGS), Eq. (13), which is φ(1−φ)−1 and not φ(1−φ)." ;
            mkg:text "The corrected RWGS rate uses a reduced-to-oxidized center ratio as its prefactor, rather than the product of the two fractions." ;
            mkg:topic "morphology" ],
        [ mkg:basis "inferred" ;
            mkg:text "The authors relate reducing conditions to a flatter, more active-for-CO-hydrogenation catalyst surface and oxidizing conditions to a more spherical, more active-for-CO₂-hydrogenation surface." ;
            mkg:topic "morphology" ],
        [ mkg:basis "stated" ;
            mkg:quote "as active surface centers for heterolytic decomposition of hydrogen." ;
            mkg:text "A separate type of surface center is included for hydrogen activation." ;
            mkg:topic "mechanism" ],
        [ mkg:basis "stated" ;
            mkg:quote "The simplified Langmuir-Hinshelwood kinetics is not based on elementary reaction steps but on lumped reaction kinetics for reactions Eqs. (1)–(3) of the methanol synthesis." ;
            mkg:text "The simplified model uses lumped reaction kinetics rather than a sequence of elementary reaction steps." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "As a starting point the kinetic model suggested by Vollbrecht (2007) is considered." ;
            mkg:text "The detailed kinetics on which the study builds are attributed to Vollbrecht (2007)." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "They are therefore suitable for methanol production under changing feed conditions employed for example in novel applications for chemical energy storage." ;
            mkg:text "The authors propose the kinetic models for methanol production under changing feed compositions, including chemical energy storage with fluctuating renewable resources." ;
            mkg:topic "application" ],
        [ mkg:basis "stated" ;
            mkg:quote "For the parameter estimation, 140 stationary experiments reported in Vollbrecht (2007) were used." ;
            mkg:text "The steady-state parameter fit used 140 experiments reported in Vollbrecht (2007)." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "In a first separate step, ΔG1 and ΔG2 are fitted to the experimental data using Eqs. (20)–(23)" ;
            mkg:text "The two Gibbs free-energy parameters used for the surface-center equilibrium were fitted separately from the remaining kinetic parameters." ;
            mkg:topic "size" ],
        [ mkg:basis "inferred" ;
            mkg:text "The reaction network includes CO hydrogenation, CO₂ hydrogenation, and the reverse water-gas shift reaction." ;
            mkg:topic "reactions" ],
        [ mkg:basis "inferred" ;
            mkg:text "For the steady-state experiments, the authors estimated CO hydrogenation from CO-only feeds, CO₂ hydrogenation from mixed feeds, and the remaining RWGS parameter from CO₂-only feeds." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "The assumption that the total number of oxidized and reduced surface centers is constant is relaxed and replaced by the more general assumption that the sum of all oxidized and reduced surface centers is constant" ;
            mkg:text "The model lets the relative amounts of oxidized and reduced centers vary with gas composition instead of holding each amount fixed." ;
            mkg:topic "morphology" ],
        [ mkg:basis "stated" ;
            mkg:quote "It is concluded that the simple model fits the experimental results almost equally well compared to the detailed model." ;
            mkg:text "The simplified model fitted the steady-state experimental results almost as well as the detailed model." ;
            mkg:topic "performance" ],
        [ mkg:basis "stated" ;
            mkg:quote "Since CO-hydrogenation is neglected in this model, experiments 80–140 with pure CO feed can not be reproduced. Further, larger deviations are also observed in the other experiments." ;
            mkg:text "The Bussche and Froment (1996) model could not reproduce the pure-CO experiments because it neglects CO hydrogenation, and it showed larger deviations on other experiments." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "The experimental setup is based on a modified, differential CSTR of a Micro-Berty Reactor type" ;
            mkg:text "The steady-state data came from a modified differential CSTR of the Micro-Berty reactor type." ;
            mkg:topic "reactor" ],
        [ mkg:basis "stated" ;
            mkg:quote "A commercial synthesis catalyst (BASF S3-86) was used in a crushed form to overcome mass transfer limitations." ;
            mkg:text "The commercial BASF S3-86 catalyst was crushed to reduce mass-transfer limitations." ;
            mkg:topic "reactor" ],
        [ mkg:basis "stated" ;
            mkg:quote "The temperature dependency of the adsorption equilibrium constants is much weaker compared to the reaction rate constants and is therefore neglected" ;
            mkg:text "The temperature dependence of the adsorption equilibrium constants was neglected because it was considered weaker than that of the rate constants." ;
            mkg:topic "parameters" ],
        [ mkg:basis "stated" ;
            mkg:quote "For the interested reader, all stationary experimental conditions and results are summarized in the supplementary material of the paper." ;
            mkg:text "The paper states that supplementary material containing stationary experimental conditions and results is available online." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "In the remainder, this paper focuses on methanol synthesis from H2, CO, and CO2 over industrial Cu/ZnO/Al2O3 catalysts with pressure between 50–100 bar and temperatures between 473.15 and 573.15 K" ;
            mkg:text "The paper describes the intended kinetics as covering 50–100 bar and 473.15–573.15 K." ;
            mkg:topic "conditions" ],
        [ mkg:basis "stated" ;
            mkg:quote "The highest accuracy for the analytical determination of the composition has been reached by the use of a Flame Ionization Detector (FID) for the carbon-containing components. For this reason, only carbon-containing component balances (RCO, RCO2 and RCH3OH) were used." ;
            mkg:text "The parameter identification used carbon-containing component balances because the flame ionization detector provided the highest accuracy for those analyses." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "This reduces the problem to a total number of 14 unknown parameters, which are 6 unknown parameters for the reaction rate constants according to Eq. (10) and another 8 unknown adsorption constants." ;
            mkg:text "The simplified kinetic expressions have 14 unknown parameters: six for reaction-rate constants and eight for adsorption constants." ;
            mkg:topic "size" ],
        [ mkg:basis "stated" ;
            mkg:quote "The temperature was varied in the range from 503.15 to 533.15 K and the pressure in the range from 30 to 60 bar." ;
            mkg:text "The 140 steady-state experiments used temperatures of 503.15–533.15 K and pressures of 30–60 bar." ;
            mkg:topic "conditions" ],
        [ mkg:basis "stated" ;
            mkg:quote "The chemical analysis of feed gases and product gases was performed by a gas chromatographic setup." ;
            mkg:text "Feed and product compositions were measured by gas chromatography." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "The results for the detailed kinetics are shown in Fig. 3 in terms of mole fractions of the different components." ;
            mkg:text "The model calculates rates for CO hydrogenation, CO₂ hydrogenation, and reverse water-gas shift, and the paper compares predicted and measured gas mole fractions." ;
            mkg:topic "outputs" ],
        [ mkg:basis "inferred" ;
            mkg:text "The model assigns CO hydrogenation to oxidized surface centers and CO₂ hydrogenation to reduced surface centers." ;
            mkg:topic "mechanism" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper assesses the stationary fit against the same experiments used for parameter estimation and does not report an independent validation dataset." ;
            mkg:topic "performance" ],
        [ mkg:basis "inferred" ;
            mkg:text "This steady-state-φ variant has no differential states; its catalyst surface-center fraction is calculated algebraically from the equilibrium morphology relation." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "the ratio of CO to CO2 was varied over the full range from pure CO to pure CO2." ;
            mkg:text "The steady-state feed ratio covered the full range from pure CO to pure CO₂." ;
            mkg:topic "conditions" ],
        [ mkg:basis "stated" ;
            mkg:quote "A very popular and widely known kinetic model was proposed by Graaf et al. (1986, 1988) in the 1980s assuming hydrogenation of CO as dominant path to synthesize methanol." ;
            mkg:text "The authors note that the Graaf et al. (1986, 1988) model treats CO hydrogenation as the dominant methanol-synthesis route." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "Only parameters β9 and β10 show flat optima. Nevertheless, all optimization runs converged within the given time and tolerances to global optimality." ;
            mkg:text "Profile-likelihood analysis found two parameters in the simplified model with flat optima, while the other optimization runs converged to global optimality within the stated time and tolerances." ;
            mkg:topic "identifiability" ],
        [ mkg:basis "stated" ;
            mkg:quote "Through fitting to experimental data using global optimization it was found that parameters β8, β12 and β14 in these general expressions are zero for the conditions considered in Seidel et al., (2018)." ;
            mkg:text "The corrigendum reports that three parameters in the general rate and coverage expressions were fitted to zero under the conditions of the original study." ;
            mkg:topic "morphology" ],
        [ mkg:basis "inferred" ;
            mkg:text "The dynamic feed-switching experiment used CO and CO₂ feeds at 523.15 K, 50 bar, and a space velocity of 240 mlᴺ/min." ;
            mkg:topic "transients" ],
        [ mkg:basis "stated" ;
            mkg:quote "In the first 140 min in Fig. 6 steady state is established with a pure CO feed." ;
            mkg:text "The dynamic experiment held a pure-CO feed for 140 minutes, then switched feeds at 70-minute intervals." ;
            mkg:topic "transients" ],
        [ mkg:basis "stated" ;
            mkg:quote "the simplified model with dynamic φ from Eq. (28) is able to reproduce the experiments quite well, whereas the simplified model with a quasistatic φ from Eq. (28) neglects the lag of the catalyst and is therefore not suitable to describe the transient behavior." ;
            mkg:text "The quasi-static surface-center calculation did not reproduce the catalyst lag in the switching experiment, whereas the dynamic-φ version did." ;
            mkg:topic "transients" ] ;
    mkg:status "pending" ;
