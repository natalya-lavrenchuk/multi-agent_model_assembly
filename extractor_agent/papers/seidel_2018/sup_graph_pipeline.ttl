<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq22_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The equilibrium relation calculates the reduced fraction of surface centers from the relative surface-contact free-energy term." ;
    mkg:doi "10.1016/j.ces.2017.09.043" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "A maximum coverage of 90% of reduced surface centers is assumed and ensured with a correction factor of -0.1 in Eq. (22) Seidel et al., (2018)." ;
            mkg:reasoned false ;
