<http://example.org/kg/seidel_2018_detailed_kinetic_model/seidel_2018_detailed_kinetic_model_meta> a mkg:Metadata ;
    mkg:completeModel false ;
    mkg:description "The detailed kinetic model describes methanol synthesis from hydrogen, carbon monoxide, and carbon dioxide over a commercial copper/zinc oxide/alumina catalyst. It predicts the rates of CO hydrogenation, CO₂ hydrogenation, and the reverse water-gas shift reaction from gas partial pressures and temperature. It uses a Langmuir–Hinshelwood framework built from elementary surface steps, with fast steps treated as quasi-equilibrated. The detailed kinetic formulation is steady-state and algebraic, rather than a dynamic model with evolving states. Its parameters were fitted to 140 steady-state experiments in a differential Micro-Berty reactor and its predictions were compared with those measurements; dynamic switching experiments in the paper were used for a separate model extension. The authors present the kinetics as a basis for modelling methanol reactors handling changing feed compositions, including for chemical energy storage." ;
    mkg:doi "10.1016/j.ces.2017.09.043" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "The catalyst deactivation is neglected and no side reactions beyond Eqs. (1)–(3) are considered." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Catalyst deactivation neglected; only reactions (1)-(3) considered." ],
        [ mkg:quote "The other steps are assumed to be much faster such that equilibrium can be assumed for them." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Fast steps are at quasi‑equilibrium." ],
        [ mkg:quote "In a first step, constant total numbers of oxidized, reduced as well as hydrogen centers are assumed." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Total numbers of oxidized, reduced and hydrogen centers are constant." ] ;
    mkg:hasFact [ mkg:basis "stated" ;
            mkg:quote "Application to the detailed model reveals that parameters  $ \\beta_{7}, \\beta_{12} $ and  $ \\beta_{13} $ are not structural identifiable." ;
            mkg:text "Three detailed-model parameters, β₇, β₁₂, and β₁₃, were found not to be structurally identifiable by the Profile-Likelihood method." ;
            mkg:topic "parameters" ],
        [ mkg:basis "stated" ;
            mkg:quote "The chemical analysis of feed gases and product gases was performed by a gas chromatographic setup." ;
            mkg:text "Feed and product gas compositions were measured using gas chromatography." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "the ratio of CO to  $ CO_2 $ was varied over the full range from pure CO to pure  $ CO_2 $." ;
            mkg:text "The steady-state experiments varied the CO-to-CO₂ feed ratio from pure CO to pure CO₂." ;
            mkg:topic "feeding" ],
        [ mkg:basis "stated" ;
            mkg:quote "The correct model equations used for all calculations presented in Seidel et al., (2018), are:" ;
            mkg:text "The 2020 corrigendum states that the model equations used in the original calculations were correct, despite typographical errors in some printed equations." ;
            mkg:topic "correction" ],
        [ mkg:basis "stated" ;
            mkg:quote "This results in very slow convergence of the optimization, which was terminated after 24 h." ;
            mkg:text "The authors report that the detailed-model optimization was terminated after 24 hours because convergence was very slow." ;
            mkg:topic "parameters" ],
        [ mkg:basis "stated" ;
            mkg:quote "A commercial synthesis catalyst (BASF S3-86) was used in a crushed form to overcome mass transfer limitations." ;
            mkg:text "The catalyst was crushed to reduce mass-transfer limitations in the experiments." ;
            mkg:topic "catalyst" ],
        [ mkg:basis "inferred" ;
            mkg:text "The model uses partial pressures of CO, hydrogen, methanol, CO₂, and water, together with temperature, as its gas and thermal inputs." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "with reference temperature  $ T_{ref} = 523.15\\ K $" ;
            mkg:text "The reaction-rate temperature dependence is reparameterized using an Arrhenius expression referenced to 523.15 K." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "They are therefore suitable for methanol production under changing feed conditions employed for example in novel applications for chemical energy storage." ;
            mkg:text "The authors propose the kinetic model for methanol production under changing feed conditions, including chemical energy storage applications." ;
            mkg:topic "use" ],
        [ mkg:basis "stated" ;
            mkg:quote "Further, larger deviations are also observed in the other experiments." ;
            mkg:text "The vanden Bussche and Froment comparison model could not reproduce the pure-CO experiments and showed larger deviations on other experiments." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "The Modeling is based on the Langmuir-Hinshelwood mechanism" ;
            mkg:text "The kinetic framework is Langmuir–Hinshelwood." ;
            mkg:topic "mechanism" ],
        [ mkg:basis "stated" ;
            mkg:quote "The highest accuracy for the analytical determination of the composition has been reached by the use of a Flame Ionization Detector (FID) for the carbon-containing components." ;
            mkg:text "Carbon-containing component balances were used in parameter identification because their compositions were measured most accurately with a flame ionization detector." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "The reaction network comprises three main reactions, i.e. hydrogenation of CO and CO₂ as well as the water-gas shift reaction" ;
            mkg:text "The represented reaction network includes CO hydrogenation, CO₂ hydrogenation, and the water-gas shift reaction." ;
            mkg:topic "reactions" ],
        [ mkg:basis "stated" ;
            mkg:quote "A commercial synthesis catalyst (BASF S3-86) was used in a crushed form to overcome mass transfer limitations." ;
            mkg:text "The experiments used BASF S3-86, a commercial Cu/ZnO/Al₂O₃ synthesis catalyst." ;
            mkg:topic "catalyst" ],
        [ mkg:basis "stated" ;
            mkg:quote "As a starting point the kinetic model suggested by Vollbrecht (2007) is considered." ;
            mkg:text "The detailed model was taken as a starting point from Vollbrecht (2007)." ;
            mkg:topic "provenance" ],
        [ mkg:basis "stated" ;
            mkg:quote "These could certainly be reduced by refitting the kinetics to the present experimental data, which however, was beyond the scope of the present study." ;
            mkg:text "The authors note that refitting the vanden Bussche and Froment kinetics to their experimental data might reduce its deviations, but they did not do so." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "methanol synthesis from  $ H_2 $, CO, and  $ CO_2 $" ;
            mkg:text "The model describes methanol synthesis from hydrogen, CO, and CO₂." ;
            mkg:topic "system" ],
        [ mkg:basis "inferred" ;
            mkg:text "The analytical results were balanced before parameter estimation to reduce the effect of measurement uncertainty." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "all stationary experimental conditions and results are summarized in the supplementary material of the paper." ;
            mkg:text "The paper says that supplementary material contains the stationary experimental conditions and results." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "with constant temperature  $ T = 523.15 $ K, pressure  $ p = 50 $ bar and constant space velocity  $ \\dot{V} = 240 $ ml $ ^N $/min" ;
            mkg:text "The dynamic experiments switched between CO and CO₂ feeds at 523.15 K, 50 bar, and a space velocity of 240 mlᴺ/min." ;
            mkg:topic "dynamics" ],
        [ mkg:basis "stated" ;
            mkg:quote "For the parameter estimation, 140 stationary experiments reported in Vollbrecht (2007) were used." ;
            mkg:text "The steady-state parameter fit used 140 experiments reported in Vollbrecht (2007)." ;
            mkg:topic "experiments" ],
        [ mkg:basis "stated" ;
            mkg:quote "The temperature dependency of the adsorption equilibrium constants is much weaker compared to the reaction rate constants and is therefore neglected" ;
            mkg:text "The temperature dependence of adsorption equilibrium constants is neglected as weaker than that of the reaction-rate constants." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "A very popular and widely known kinetic model was proposed by Graaf et al. (1986, 1988) in the 1980s assuming hydrogenation of CO as dominant path to synthesize methanol." ;
            mkg:text "The paper describes Graaf et al. (1986, 1988) as an established model that assumes CO hydrogenation to be the dominant methanol-synthesis path." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "only CO-Feed (experiment 80–140), which can be used to estimate  $ r_{CO} $" ;
            mkg:text "The pure-CO experiments were used to estimate the CO-hydrogenation rate, the mixed-feed experiments for CO₂ hydrogenation, and the pure-CO₂ experiments for the remaining reverse water-gas shift parameter." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The experimental setup is based on a modified, differential CSTR of a Micro-Berty Reactor type described Berty (1999)." ;
            mkg:text "The experimental setup was a modified differential CSTR of the Micro-Berty Reactor type." ;
            mkg:topic "reactor" ],
        [ mkg:basis "stated" ;
            mkg:quote "It is further observed that some of the  $ \\beta $ parameters are zero, namely  $ \\beta_{8}, \\beta_{10}, \\beta_{14} - \\beta_{16} $." ;
            mkg:text "Five fitted beta parameters in the detailed model were reported as zero." ;
            mkg:topic "parameters" ],
        [ mkg:basis "inferred" ;
            mkg:text "The detailed kinetic model has 16 reparameterized beta parameters reported in its parameter table." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "For the estimation of the remaining parameters the steady state experiments were divided into three subsets:" ;
            mkg:text "For parameter estimation, the steady-state experiments were divided into pure-CO, mixed CO/CO₂, and pure-CO₂ feed subsets." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "In all cases, the theoretical results nicely fit the experiments." ;
            mkg:text "The detailed model's simulated mole fractions were reported to fit the steady-state experiments well." ;
            mkg:topic "fit" ],
        [ mkg:basis "inferred" ;
            mkg:text "The detailed model was compared with the same steady-state experimental set used for parameter estimation; the paper does not report an independent validation dataset." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Since local optimization methods do not give satisfying results due to multiple local minima, deterministic global optimization with BARON. Tawarmalani and Sahinidis (2005) in GAMS (GAMS, 2013) is applied." ;
            mkg:text "The parameters were estimated using deterministic global optimization with BARON in GAMS because local methods did not give satisfactory results." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "with pressure between 50–100 bar and temperatures between 473.15 and 573.15 K" ;
            mkg:text "The paper frames its kinetic treatment for industrial methanol synthesis at 50–100 bar and 473.15–573.15 K." ;
            mkg:topic "conditions" ],
        [ mkg:basis "stated" ;
            mkg:quote "Here partial pressures are used instead of fugacities" ;
            mkg:text "The model uses partial pressures rather than fugacities for the reaction kinetics." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "inferred" ;
            mkg:text "The detailed formulation is a steady-state algebraic kinetic model with no ODE-computed states." ;
            mkg:topic "model" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper identifies the software used for estimation but does not state that model code is publicly available." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "Since CO-hydrogenation is neglected in this model, experiments 80–140 with pure CO feed can not be reproduced." ;
            mkg:text "The detailed model includes a CO-hydrogenation pathway, unlike the vanden Bussche and Froment model discussed in the paper." ;
            mkg:topic "mechanism" ],
        [ mkg:basis "stated" ;
            mkg:quote "The dynamic experiments were used to estimate the kinetic parameters  $ k_1^+ $ and  $ k_2^+ $ in Eq. (28). All other parameters  $ \\beta_i $ were fitted to the steady state data." ;
            mkg:text "The paper used the dynamic switching data to fit additional catalyst-morphology rate constants, rather than to fit the detailed fixed-center kinetic parameters." ;
            mkg:topic "dynamics" ],
        [ mkg:basis "stated" ;
            mkg:quote "It is concluded that the simple model fits the experimental results almost equally well compared to the detailed model." ;
            mkg:text "The simplified kinetic model fitted the stationary experimental results almost as well as the detailed model." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "The other steps are assumed to be much faster such that equilibrium can be assumed for them." ;
            mkg:text "The detailed kinetics is based on elementary surface reaction steps, with fast steps treated as quasi-equilibrated." ;
            mkg:topic "mechanism" ],
        [ mkg:basis "stated" ;
            mkg:quote "The temperature was varied in the range from 503.15 to 533.15 K and the pressure in the range from 30 to 60 bar." ;
            mkg:text "The steady-state experiments used for parameter estimation covered 30–60 bar and 503.15–533.15 K." ;
            mkg:topic "conditions" ],
        [ mkg:basis "inferred" ;
            mkg:text "The corrigendum says the equilibrium constants were proposed by Kuznetov and taken from Vollbrecht (2007), and supplies expressions attributed to Skrzypek et al. (1994)." ;
            mkg:topic "provenance" ] ;
    mkg:status "pending" ;
    rdfs:comment "v0 distinct nodes; built from paddle.json (PaddleOCR-VL pipeline) by extractor/graph.py" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq10> a mkg:Law ;
    rdfs:label "seidel_2018 eq 10"@en ;
    mkg:computes <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq10/var/k_i> ;
    mkg:equationNumber "10" ;
    mkg:hasMetadata <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq10_meta> ;
    mkg:hasParameter <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq10/par/A>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq10/par/B>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq10/par/T_ref> ;
    mkg:latex "k_{i}=\\exp\\left(\\underbrace{A}_{\\beta_{1},\\beta_{3},\\beta_{5}}-\\underbrace{B}_{\\beta_{2},\\beta_{4},\\beta_{6}}\\left(\\frac{T_{ref}}{T}-1\\right)\\right)" ;
    mkg:uses <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq10/var/T> .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq10/par/A> a mkg:Parameter ;
    rdfs:label "A (seidel_2018 eq 10)"@en ;
