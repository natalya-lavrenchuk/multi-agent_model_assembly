<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9> a mkg:Law ;
    rdfs:label "seidel_2018 eq 9"@en ;
    mkg:computes <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/var/Theta_star> ;
    mkg:equationNumber "9" ;
    mkg:hasMetadata <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9_meta> ;
    mkg:hasParameter <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/par/K_B5>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/par/K_B8>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/par/K_B9>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/par/K_CH_3OH_star>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/par/K_H_2>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/par/K_H_2O> ;
    mkg:latex "$$ \\boldsymbol{\\Theta}^{*}=\\left(1+\\underbrace{\\frac{K_{\\mathrm{H}_{2}\\mathrm{O}}}{K_{\\mathrm{B}8}K_{\\mathrm{B}9}K_{\\mathrm{H}_{2}}}}_{\\beta_{13}}\\frac{p_{\\mathrm{H}_{2}\\mathrm{O}}}{p_{\\mathrm{H}_{2}}}+\\underbrace{\\frac{K_{\\mathrm{CH}_{3}\\mathrm{OH}}^{*}}{K_{\\mathrm{B}5}K_{\\mathrm{H}_{2}}^{1/2}}}_{\\beta_{16}}\\frac{p_{\\mathrm{CH}_{3}\\mathrm{OH}}}{p_{\\mathrm{H}_{2}}^{1/2}}+\\underbrace{K_{\\mathrm{CH}_{3}\\mathrm{OH}}^{*}}_{\\beta_{14}}p_{\\mathrm{CH}_{3}\\mathrm{OH}}+\\underbrace{\\frac{K_{\\mathrm{H}_{2}\\mathrm{O}}}{K_{\\mathrm{B}9}K_{\\mathrm{H}_{2}}^{1/2}}}_{\\beta_{15}}\\frac{p_{\\mathrm{H}_{2}\\mathrm{O}}}{p_{\\mathrm{H}_{2}}^{1/2}}+\\underbrace{K_{\\mathrm{H}_{2}\\mathrm{O}}}_{\\beta_{12}}p_{\\mathrm{H}_{2}\\mathrm{O}}\\right)^{-1} $$" ;
    mkg:uses <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/var/p_CH_3OH>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/var/p_H_2>,
