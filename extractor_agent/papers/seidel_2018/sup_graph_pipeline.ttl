<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq23> a mkg:Law ;
    rdfs:label "seidel_2018 eq 23"@en ;
    mkg:equationNumber "23" ;
    mkg:hasMetadata <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq23_meta> ;
    mkg:latex "$$ \\frac{\\gamma^{*}}{\\gamma_{0}}=\\frac{1-\\sqrt{K_{1}K_{2}\\frac{p_{\\mathrm{H}_{2}}p_{\\mathrm{C O}}}{p_{\\mathrm{H}_{2}\\mathrm{O}}p_{\\mathrm{C O}_{2}}}}}{1+\\sqrt{K_{1}K_{2}\\frac{p_{\\mathrm{H}_{2}}p_{\\mathrm{C O}}}{p_{\\mathrm{H}_{2}\\mathrm{O}}p_{\\mathrm{C O}_{2}}}}}. $$" ;
    mkg:uses <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq23/var/K_1>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq23/var/K_2>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq23/var/gamma_0>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq23/var/gamma_star>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq23/var/p_CO>,
