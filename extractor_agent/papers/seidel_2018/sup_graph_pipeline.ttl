<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-15_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The expression computes the free hydrogen-site coverage from hydrogen adsorption and dissociation." ;
