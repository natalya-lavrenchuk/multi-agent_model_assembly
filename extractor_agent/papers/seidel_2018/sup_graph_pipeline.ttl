<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq28_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The kinetic law computes the transient change in the reduced surface-center fraction from the gas mole fractions and conversion rate constants." ;
    mkg:doi "10.1016/j.ces.2017.09.043" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "Under transient conditions, reaction equilibrium according to Eqs. (20) and (21) is not valid anymore." ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The law is used under transient conditions, when the surface-center conversion reactions are not at equilibrium." ],
        [ mkg:quote "A maximum coverage of 90% of reduced surface centers is assumed and ensured with a correction factor of -0.1 in Eq. (22) Seidel et al., (2018)." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The reduced surface-center fraction is capped at 90%." ] ;
    mkg:page "4" ;
    mkg:possibleMisprint "The printed Eq. (28) uses (1−φ) in both terms, but the corrigendum says both factors are replaced by (0.9−φ) in the dynamic equation to impose the 90% cap." ;
    mkg:quote "\\begin{align*}\\frac{d\\phi}{dt}&=k_{1}^{+}\\bigg(y_{\\mathrm{H}_{2}}(0.9-\\phi)-\\frac{1}{K_{1}}y_{\\mathrm{H}_{2}\\mathrm{O}}\\phi\\bigg)\\\\&\\quad+k_{2}^{+}\\bigg(y_{\\mathrm{CO}}(0.9-\\phi)-\\frac{1}{K_{2}}y_{\\mathrm{CO}_{2}}\\phi\\bigg).\\end{align*}" ;
    mkg:reviewOutcome "false alarm" ;
    mkg:status "pending" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq33> a mkg:Law ;
    rdfs:label "seidel_2018 eq 33"@en ;
    mkg:computes <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq33/var/y_i> ;
    mkg:equationNumber "33" ;
    mkg:hasMetadata <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq33_meta> ;
    mkg:hasParameter <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq33/par/K>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq33/par/Z>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq33/par/nu_ij> ;
    mkg:latex "\\dot{y}_{i}=Z\\Bigg[\\frac{1}{\\tau}y_{i,0}-\\Bigg(\\frac{1}{\\tau}+\\frac{1}{\\mathcal{K}}\\sum_{i=1}^{N_{K}}\\sum_{j=1}^{N_{R}}\\nu_{i j}r_{j}\\Bigg)y_{i}+\\frac{1}{\\mathcal{K}}\\sum_{j=1}^{N_{R}}\\nu_{i j}r_{j}\\Bigg]" ;
    mkg:uses <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq33/var/r_j>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq33/var/tau>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq33/var/y_i_0> .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq33/par/K> a mkg:Parameter ;
    rdfs:label "K (seidel_2018 eq 33)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Factor scaling the summed reaction-rate term in the reactor mole-fraction balance." ;
    mkg:dimension "[substance] / [mass]" ;
    mkg:reason "It is a catalyst-loading/system factor in the reactor balance, a property of the system rather than a run-set feed condition." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K" ;
    mkg:unit "mol / kg" ;
    mkg:unitString "mol kg⁻¹" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq33/par/Z> a mkg:Parameter ;
    rdfs:label "Z (seidel_2018 eq 33)"@en ;
    mkg:basis "stated" ;
    mkg:description "Compressibility factor." ;
    mkg:dimension "dimensionless" ;
    mkg:page "2" ;
    mkg:quote "compressibility factor" ;
    mkg:reason "It is a compressibility factor, a dimensionless physical property of the gas/system." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "Z" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq33/par/nu_ij> a mkg:Parameter ;
