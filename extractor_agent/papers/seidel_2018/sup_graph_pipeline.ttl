    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "r_{j}" ;
    mkg:unit "mol / kg / s" ;
    mkg:unitString "mol kg⁻¹ s⁻¹" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq33/var/tau> a mkg:Variable ;
