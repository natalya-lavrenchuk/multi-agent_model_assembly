    mkg:status "pending" .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eqC-1> a mkg:Law ;
    rdfs:label "seidel_2018 eq C-1"@en ;
    mkg:computes <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eqC-1/var/K_P1> ;
