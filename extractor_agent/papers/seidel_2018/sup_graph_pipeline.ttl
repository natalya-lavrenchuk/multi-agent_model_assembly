    mkg:dimension "dimensionless" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "K_{P3}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-3/var/T> a mkg:Variable ;
    rdfs:label "T (seidel_2018 eq C-3)"@en ;
    mkg:basis "stated" ;
    mkg:description "Temperature." ;
    mkg:dimension "[temperature]" ;
    mkg:initialQuote "with constant temperature $ T = 523.15 $ K" ;
    mkg:initialValue "523.15 K" ;
    mkg:page "2" ;
    mkg:quote "$ \\phi $ | reduced surface centers: fraction of reduced centers on the catalyst surface | $ K_i $: T | equilibrium constant: temperature in K" ;
    mkg:reason "It is the operating temperature, which the paper varies for the experiments and specifies for the dynamic run." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "T" ;
    mkg:unit "K" ;
    mkg:unitString "K" .

