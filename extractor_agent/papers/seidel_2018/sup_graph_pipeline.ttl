    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "\\tau" ;
    mkg:unit "s" ;
    mkg:unitString "s" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq33/var/y_i> a mkg:Variable ;
