<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-11_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The rate law computes CO hydrogenation from the CO and hydrogen reactants and methanol product, weighted by the catalyst state and available surface coverages." ;
    mkg:doi "10.1016/j.ces.2017.09.043" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "A maximum coverage of 90% of reduced surface centers is assumed" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The reduced surface-center fraction is capped at 90%." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-11/var/phi> ;
            mkg:slot "catalyst" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-11/var/p_CH_3OH> ;
            mkg:slot "product" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-11/var/K_P1> ;
            mkg:slot "equilibrium constant" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-11/par/k_1> ;
            mkg:slot "rate constant" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-11/var/p_H_2> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-11/var/p_CO> ;
            mkg:slot "substrate" ] ;
    mkg:page "11" ;
    mkg:quote "r_{\\mathrm{{C O}}}=(1-\\phi)k_{1}\\left(p_{\\mathrm{{C O}}}p_{\\mathrm{{H}_{2}}}^{2}-\\frac{p_{\\mathrm{{C H}_{3}\\mathrm{{O H}}}}}{K_{\\mathrm{{P}1}}}\\right)\\Theta^{\\odot}\\Theta^{\\otimes^{4}}" ;
    mkg:status "pending" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12> a mkg:Law ;
    rdfs:label "seidel_2018 eq C-12"@en ;
    mkg:computes <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12/var/r_CO_2> ;
    mkg:equationNumber "C-12" ;
    mkg:hasMetadata <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12_meta> ;
    mkg:hasParameter <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12/par/k_2> ;
    mkg:latex "$$ r_{\\mathrm{{C O}_{2}}}=\\phi^{2}k_{2}\\left(p_{\\mathrm{{C O}_{2}}}p_{\\mathrm{{H}_{2}}}^{2}-\\frac{1}{K_{\\mathrm{{P}2}}}\\frac{p_{\\mathrm{{C H}_{3}\\mathrm{{O H}}}}p_{\\mathrm{{H}_{2}\\mathrm{O}}}}{p_{\\mathrm{{H}_{2}}}}\\right)\\Theta^{*^{2}}\\Theta^{\\otimes^{4}} $$" ;
    mkg:uses <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12/var/K_P2>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12/var/Theta_otimes>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12/var/Theta_star>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12/var/p_CH_3OH>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12/var/p_CO_2>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12/var/p_H_2>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12/var/p_H_2O>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12/var/phi> .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12/var/Theta_otimes> a mkg:Variable ;
    rdfs:label "\\Theta^{\\otimes} (seidel_2018 eq C-12)"@en ;
    mkg:description "Free hydrogen surface-center coverage." ;
    mkg:dimension "dimensionless" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "\\Theta^{\\otimes}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

