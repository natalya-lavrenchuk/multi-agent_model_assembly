    rdfs:label "K_{B5} (seidel_2018 eq 9)"@en ;
    mkg:basis "stated" ;
    mkg:description "Equilibrium constant in the surface-step relation involving H3CO* and CH3OH*." ;
    mkg:dimension "dimensionless" ;
    mkg:page "3" ;
    mkg:quote "Elementary step: $ \\text{H} \\otimes + \\text{H}_3\\text{CO} * \\neq = \\text{CH}_3\\text{OH} * + \\otimes $ | Quasi-equilibrium/velocity: $ \\theta_{\\text{H}_3\\text{CO}} = K_{B5}^{-1} \\theta_{\\text{CH}_3\\text{OH}}^{*} \\theta^\\otimes \\theta_H^\\otimes^{-1} $" ;
    mkg:reason "It is an equilibrium constant in an elementary reaction step." ;
