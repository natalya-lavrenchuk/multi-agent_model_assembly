<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-11_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The rate law computes CO hydrogenation from the CO and hydrogen reactants and methanol product, weighted by the catalyst state and available surface coverages." ;
    mkg:doi "10.1016/j.ces.2017.09.043" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "A maximum coverage of 90% of reduced surface centers is assumed" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The reduced surface-center fraction is capped at 90%." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-11/var/p_CH_3OH> ;
            mkg:slot "product" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-11/var/phi> ;
            mkg:slot "catalyst" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-11/par/k_1> ;
            mkg:slot "rate constant" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-11/var/p_CO> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-11/var/p_H_2> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-11/var/K_P1> ;
            mkg:slot "equilibrium constant" ] ;
    mkg:page "11" ;
    mkg:quote "r_{\\mathrm{{C O}}}=(1-\\phi)k_{1}\\left(p_{\\mathrm{{C O}}}p_{\\mathrm{{H}_{2}}}^{2}-\\frac{p_{\\mathrm{{C H}_{3}\\mathrm{{O H}}}}}{K_{\\mathrm{{P}1}}}\\right)\\Theta^{\\odot}\\Theta^{\\otimes^{4}}" ;
    mkg:status "pending" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-12> a mkg:Law ;
    rdfs:label "seidel_2018 eq C-12"@en ;
    mkg:computes <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-12/var/r_CO_2> ;
