<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq23_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:description "The equilibrium expression calculates the relative Cu–Zn surface-contact free-energy term from the gas partial pressures and equilibrium constants." ;
    mkg:doi "10.1016/j.ces.2017.09.043" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "At steady state, reactions (18) and (19) are in equilibrium according to" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "This equilibrium relation applies at steady state." ] ;
    mkg:ocrFixNote "The OCR split p_H2O into p_H2 times O." ;
    mkg:page "4" ;
    mkg:quote "\\frac{\\gamma^{*}}{\\gamma_{0}}=\\frac{1-\\sqrt{K_{1}K_{2}\\frac{p_{\\mathrm{H}_{2}}p_{\\mathrm{C O}}}{p_{\\mathrm{H}_{2}\\mathrm{O}}p_{\\mathrm{C O}_{2}}}}}{1+\\sqrt{K_{1}K_{2}\\frac{p_{\\mathrm{H}_{2}}p_{\\mathrm{C O}}}{p_{\\mathrm{H}_{2}\\mathrm{O}}p_{\\mathrm{C O}_{2}}}}}" ;
    mkg:reviewOutcome "reading corrected" ;
    mkg:status "flagged" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq24> a mkg:Law ;
    rdfs:label "seidel_2018 eq 24"@en ;
    mkg:computes <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq24/var/K_1> ;
    mkg:equationNumber "24" ;
    mkg:hasMetadata <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq24_meta> ;
    mkg:hasParameter <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq24/par/Delta_G_1>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq24/par/R>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq24/par/k_1> ;
    mkg:latex "K_{1}=\\frac{k_{1}^{+}}{k_{1}^{-}}=\\exp\\left(\\frac{-\\Delta G_{1}}{RT}\\right)" ;
    mkg:uses <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq24/var/T> .

