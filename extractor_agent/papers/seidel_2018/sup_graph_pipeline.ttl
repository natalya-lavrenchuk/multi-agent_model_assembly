    mkg:unit "1 / bar ** 2" ;
    mkg:unitString "bar^-2" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-1/var/T> a mkg:Variable ;
    rdfs:label "T (seidel_2018 eq C-1)"@en ;
