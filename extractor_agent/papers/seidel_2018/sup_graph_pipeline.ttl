    mkg:possibleMisprint "The expression contains a doubled plus sign and an outer exponent printed as ^{-} without an exponent, so the printed coverage expression is malformed." ;
    mkg:quote "\\boldsymbol{\\Theta}^{*}=\\left(1+\\underbrace{\\frac{K_{\\mathrm{H}_{2}\\mathrm{O}}}{K_{\\mathrm{B}8}K_{\\mathrm{B}9}K_{\\mathrm{H}_{2}}}}_{\\beta_{13}}\\frac{p_{\\mathrm{H}_{2}\\mathrm{O}}}{p_{\\mathrm{H}_{2}}}+\\underbrace{\\frac{K_{\\mathrm{CH}_{3}\\mathrm{OH}}^{*}}{K_{\\mathrm{B}5}K_{\\mathrm{H}_{2}}^{1/2}}}_{\\beta_{16}}\\frac{p_{\\mathrm{CH}_{3}\\mathrm{OH}}}{p_{\\mathrm{H}_{2}}^{1/2}}+\\underbrace{K_{\\mathrm{CH}_{3}\\mathrm{OH}}^{*}}_{\\beta_{14}}p_{\\mathrm{CH}_{3}\\mathrm{OH}}+\\underbrace{\\frac{K_{\\mathrm{H}_{2}\\mathrm{O}}}{K_{\\mathrm{B}9}K_{\\mathrm{H}_{2}}^{1/2}}}_{\\beta_{15}}\\frac{p_{\\mathrm{H}_{2}\\mathrm{O}}}{p_{\\mathrm{H}_{2}}^{1/2}}+\\underbrace{K_{\\mathrm{H}_{2}\\mathrm{O}}}_{\\beta_{12}}p_{\\mathrm{H}_{2}\\mathrm{O}}\\right)^{-1}" ;
