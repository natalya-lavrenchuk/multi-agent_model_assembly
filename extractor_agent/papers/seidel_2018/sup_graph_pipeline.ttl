<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq10> a mkg:Law ;
    rdfs:label "seidel_2018 eq 10"@en ;
    mkg:computes <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq10/var/k_i> ;
    mkg:equationNumber "10" ;
    mkg:hasMetadata <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq10_meta> ;
    mkg:hasParameter <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq10/par/A>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq10/par/B>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq10/par/T_ref> ;
    mkg:latex "k_{i}=\\exp\\left(\\underbrace{A}_{\\beta_{1},\\beta_{3},\\beta_{5}}-\\underbrace{B}_{\\beta_{2},\\beta_{4},\\beta_{6}}\\left(\\frac{T_{ref}}{T}-1\\right)\\right)" ;
    mkg:uses <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq10/var/T> .

