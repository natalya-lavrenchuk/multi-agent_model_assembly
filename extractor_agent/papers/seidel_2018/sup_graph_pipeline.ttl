kg:seidel_2018_simplified_kinetic_model_dynamic_meta a mkg:Metadata ;
    mkg:completeModel false ;
    mkg:description "This model describes methanol synthesis from hydrogen, carbon monoxide and carbon dioxide over a commercial copper/zinc oxide/alumina catalyst in a differential CSTR. It predicts gas composition and methanol production while tracking changes in the fraction of reduced catalyst surface centers, which affect the activity of the different reactions. The simplified model combines lumped Langmuir–Hinshelwood rate expressions and algebraic surface coverages with dynamic balances for the catalyst and reactor. It was fitted and tested against 140 steady-state experiments and feed-switching experiments reported by Vollbrecht (2007), using global optimization. The dynamic version reproduced the transient experiments better than a version with quasi-static catalyst states, and the simplified model fitted steady-state data almost as well as the detailed model while improving identifiability. The authors propose it for dynamic simulation and future design and control of methanol reactors for chemical energy storage under changing feed conditions; a 2020 corrigendum clarified the equations used." ;
    mkg:doi "10.1016/j.ces.2017.09.043" ;
    mkg:form "DAE" ;
    mkg:hasAssumption [ mkg:quote "The simplified Langmuir-Hinshelwood kinetics is not based on elementary reaction steps but on lumped reaction kinetics for reactions Eqs. (1)–(3) of the methanol synthesis." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Lumped kinetics for reactions (1)-(3)." ],
        [ mkg:quote "The other steps are assumed to be much faster such that equilibrium can be assumed for them." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Fast steps are at quasi‑equilibrium." ],
        [ mkg:quote "The catalyst deactivation is neglected and no side reactions beyond Eqs. (1)–(3) are considered." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Catalyst deactivation neglected; only reactions (1)-(3) considered." ] ;
    mkg:hasFact [ mkg:basis "stated" ;
            mkg:quote "The simplified Langmuir-Hinshelwood kinetics is not based on elementary reaction steps but on lumped reaction kinetics for reactions Eqs. (1)–(3) of the methanol synthesis." ;
            mkg:text "The simplified kinetic model uses lumped reaction kinetics rather than representing the individual elementary steps." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "It is concluded that the simple model fits the experimental results almost equally well compared to the detailed model." ;
            mkg:text "The simplified model fitted the steady-state experimental results almost as well as the detailed model." ;
            mkg:topic "fit" ],
        [ mkg:basis "stated" ;
            mkg:quote "The correct model equations used for all calculations presented in Seidel et al., (2018), are:" ;
            mkg:text "The corrigendum states that the corrected equations are the ones used for all calculations in the original paper." ;
            mkg:topic "corrigendum" ],
        [ mkg:basis "stated" ;
            mkg:quote "A very popular and widely known kinetic model was proposed by Graaf et al. (1986, 1988) in the 1980s assuming hydrogenation of CO as dominant path to synthesize methanol." ;
            mkg:text "The paper identifies Graaf et al. (1986, 1988) as established models that assume a single active-center type and treat CO hydrogenation as the dominant methanol pathway." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "This dynamic optimization problem was solved in MATLAB (MATLAB, 2014) using the TOMLAB toolbox (Holmstroem, 1997)." ;
            mkg:text "The dynamic parameter-estimation problem was solved in MATLAB using the TOMLAB toolbox." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "They are therefore suitable for methanol production under changing feed conditions employed for example in novel applications for chemical energy storage." ;
            mkg:text "The authors intend the model for methanol production under changing feed conditions relevant to chemical energy storage." ;
            mkg:topic "scope" ],
        [ mkg:basis "inferred" ;
            mkg:text "The simplified model improved structural identifiability, although two parameters still had flat optima." ;
            mkg:topic "identifiability" ],
        [ mkg:basis "stated" ;
            mkg:quote "the dynamic change in the surface coverage for each species can be calculated by:" ;
            mkg:text "The dynamic model evolves both the reduced-center fraction and the reactor gas composition." ;
            mkg:topic "dynamics" ],
        [ mkg:basis "stated" ;
            mkg:quote "For the parameter estimation, 140 stationary experiments reported in Vollbrecht (2007) were used." ;
            mkg:text "Parameter estimation used 140 stationary experiments reported in Vollbrecht (2007)." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "For the dynamic transient behavior, it was found that the accumulation on the catalyst surface should be taken into account" ;
            mkg:text "The dynamic reactor model includes accumulation on the catalyst surface as well as gas-phase reactor balances." ;
            mkg:topic "dynamics" ],
        [ mkg:basis "inferred" ;
            mkg:text "The dynamic experiment switched between a CO feed containing 12.6% CO, 72.2% H₂ and 16.0% N₂, and a CO₂ feed containing 11.9% CO₂, 71.5% H₂ and 16.6% N₂." ;
            mkg:topic "feeding" ],
        [ mkg:basis "stated" ;
            mkg:quote "Experiments have shown characteristic methanol overshoots after switching between different gas compositions" ;
            mkg:text "The dynamic experiments showed methanol-production overshoots and relaxation after changes between CO and CO₂ feeds." ;
            mkg:topic "fit" ],
        [ mkg:basis "stated" ;
            mkg:quote "our simplified kinetic model in Seidel et al., (2018) aims at dynamic simulation whereas in Slotboom et al., (2020) focus is on steady states." ;
            mkg:text "The corrigendum distinguishes this model's focus on dynamic simulation from Slotboom et al. (2020), which focused on steady states." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "A maximum coverage of 90% of reduced surface centers is assumed" ;
            mkg:text "The corrected catalyst-state formulation limits the reduced-center fraction to a maximum of 90%." ;
            mkg:topic "morphology" ],
        [ mkg:basis "stated" ;
            mkg:quote "the simplified model with a quasistatic φ from Eq. (28) neglects the lag of the catalyst and is therefore not suitable to describe the transient behavior." ;
            mkg:text "The dynamic catalyst formulation is intended to capture the lag in catalyst state after a feed-composition change." ;
            mkg:topic "dynamics" ],
        [ mkg:basis "stated" ;
            mkg:quote "In the first 140 min in Fig. 6 steady state is established with a pure CO feed." ;
            mkg:text "The dynamic test began with 140 minutes at steady state on CO feed and then switched feeds at intervals of 70 minutes." ;
            mkg:topic "feeding" ],
        [ mkg:basis "inferred" ;
            mkg:text "The parameter estimation used carbon-containing component balances for CO, CO₂ and methanol, with carbon composition measured using an FID." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "the probability for this reaction to take place is not proportional to the product of the total amount of reduced and oxidized surface centers φ(1−φ)." ;
            mkg:text "The 2020 corrigendum clarifies that the RWGS rate is weighted by the reduced-to-oxidized site ratio because the reaction requires nearby centers of both types." ;
            mkg:topic "morphology" ],
        [ mkg:basis "stated" ;
            mkg:quote "It therefore builds a suitable basis for future work on model based design and control of methanol reactors for chemical energy storage under strongly varying conditions." ;
            mkg:text "The authors present the model as a basis for future model-based design and control of methanol reactors under strongly varying conditions." ;
            mkg:topic "use" ],
        [ mkg:basis "inferred" ;
            mkg:text "The model represents methanol synthesis from hydrogen, carbon monoxide and carbon dioxide over a Cu/ZnO/Al₂O₃ catalyst." ;
            mkg:topic "system" ],
        [ mkg:basis "stated" ;
            mkg:quote "Since CO-hydrogenation is neglected in this model, experiments 80–140 with pure CO feed can not be reproduced." ;
            mkg:text "The Bussche and Froment (1996) model could not reproduce the pure-CO-feed experiments because it neglects CO hydrogenation." ;
            mkg:topic "comparison" ],
        [ mkg:basis "inferred" ;
            mkg:text "The model distinguishes oxidized centers associated with CO hydrogenation, reduced centers associated with CO₂ hydrogenation, and centers for hydrogen activation." ;
            mkg:topic "sites" ],
        [ mkg:basis "stated" ;
            mkg:quote "For the interested reader, all stationary experimental conditions and results are summarized in the supplementary material of the paper." ;
            mkg:text "Supplementary material with stationary experimental conditions and results is available online, but the paper does not state that model code is available." ;
            mkg:topic "availability" ],
        [ mkg:basis "inferred" ;
            mkg:text "The two catalyst-conversion rate constants were estimated from the dynamic experiments, while the other kinetic parameters were fitted to steady-state data." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The experimental setup is based on a modified, differential CSTR of a Micro-Berty Reactor type described Berty (1999)." ;
            mkg:text "The steady-state and dynamic experiments were conducted in a modified differential CSTR of the Micro-Berty Reactor type." ;
            mkg:topic "equipment" ],
        [ mkg:basis "stated" ;
            mkg:quote "The temperature was varied in the range from 503.15 to 533.15 K and the pressure in the range from 30 to 60 bar." ;
            mkg:text "The 140 steady-state experiments covered temperatures from 503.15 to 533.15 K and pressures from 30 to 60 bar." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The chemical analysis of feed gases and product gases was performed by a gas chromatographic setup." ;
            mkg:text "Feed and product gas compositions were measured using gas chromatography." ;
            mkg:topic "measurement" ],
        [ mkg:basis "inferred" ;
            mkg:text "The detailed model had three structurally unidentifiable parameters according to the Profile-Likelihood analysis." ;
            mkg:topic "identifiability" ],
        [ mkg:basis "inferred" ;
            mkg:text "The dynamic feed-switching experiment was run at 523.15 K, 50 bar and a space velocity of 240 mlᴺ/min." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The model is extended with a dynamic morphology model taking a variable amount of different active centers for each reaction into account." ;
            mkg:text "The model makes the relative amounts of oxidized and reduced surface centers depend on gas composition and catalyst morphology." ;
            mkg:topic "morphology" ],
        [ mkg:basis "stated" ;
            mkg:quote "with reference temperature Tref = 523.15 K" ;
            mkg:text "The model uses a reparameterized Arrhenius expression with a reference temperature of 523.15 K." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "A commercial synthesis catalyst (BASF S3-86) was used in a crushed form to overcome mass transfer limitations." ;
            mkg:text "The experiments used the commercial BASF S3-86 synthesis catalyst in crushed form." ;
            mkg:topic "catalyst" ],
        [ mkg:basis "stated" ;
            mkg:quote "The reaction network comprises three main reactions, i.e. hydrogenation of CO and CO₂ as well as the water-gas shift reaction" ;
            mkg:text "The reaction network includes CO hydrogenation, CO₂ hydrogenation and the reverse water-gas shift reaction." ;
            mkg:topic "reactions" ],
        [ mkg:basis "inferred" ;
            mkg:text "The steady-state experiments varied the CO-to-CO₂ feed ratio from pure CO to pure CO₂." ;
            mkg:topic "feeding" ],
        [ mkg:basis "stated" ;
            mkg:quote "Since local optimization methods do not give satisfying results due to multiple local minima, deterministic global optimization with BARON." ;
            mkg:text "The authors used deterministic global optimization with BARON in GAMS because local optimization encountered multiple local minima." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "This reduces the problem to a total number of 14 unknown parameters, which are 6 unknown parameters for the reaction rate constants according to Eq. (10) and another 8 unknown adsorption constants." ;
            mkg:text "The simplified rate formulation has 14 unknown parameters: six associated with reaction-rate constants and eight adsorption constants." ;
            mkg:topic "kinetics" ],
        [ mkg:basis "stated" ;
            mkg:quote "the simplified model with dynamic φ from Eq. (28) is able to reproduce the experiments quite well" ;
            mkg:text "The dynamic model with evolving catalyst state reproduced the feed-switching experiments quite well." ;
            mkg:topic "fit" ],
        [ mkg:basis "inferred" ;
            mkg:text "For the conditions studied in the original paper, the fitted simplified-model parameters β₈, β₁₂ and β₁₄ were zero." ;
            mkg:topic "corrigendum" ] ;
    mkg:status "pending" ;
