    mkg:symbol "\\Theta^{\\odot}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-14_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The expression computes the free oxidized-site coverage from CO, methanol, and CO₂ adsorption on oxidized centers." ;
    mkg:doi "10.1016/j.ces.2017.09.043" ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-14/var/p_CO_2> ;
            mkg:slot "adsorbing species" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-14/var/p_CH_3OH> ;
            mkg:slot "adsorbing species" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-14/var/p_CO> ;
            mkg:slot "adsorbing species" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-14/par/K_CH_3OH_odot> ;
            mkg:slot "adsorption constant" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-14/par/K_CO> ;
            mkg:slot "adsorption constant" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-14/par/K_CO_2_odot> ;
            mkg:slot "adsorption constant" ] ;
    mkg:page "11" ;
    mkg:quote "\\Theta^{\\odot}=\\left(1+\\underbrace{K_{\\mathrm{CO}}}_{\\beta_{11}}p_{\\mathrm{CO}}+\\underbrace{K_{\\mathrm{CH}_{3}\\mathrm{OH}}^{\\odot}}_{\\beta_{12}}p_{\\mathrm{CH}_{3}\\mathrm{OH}}+\\underbrace{K_{\\mathrm{CO}_{2}}^{\\odot}}_{\\beta_{14}}p_{\\mathrm{CO}_{2}}\\right)^{-1}" ;
    mkg:status "pending" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-15> a mkg:Law ;
    rdfs:label "seidel_2018 eq C-15"@en ;
    mkg:computes <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-15/var/Theta_otimes> ;
    mkg:equationNumber "C-15" ;
    mkg:hasMetadata <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-15_meta> ;
    mkg:hasParameter <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-15/par/K_H_2> ;
    mkg:latex "\\Theta^{\\otimes}=\\left(1+\\underbrace{\\sqrt{K_{\\mathrm{H}_{2}}}}_{ \\beta_{7}}\\sqrt{p_{\\mathrm{H}_{2}}}\\right)^{-1}" ;
    mkg:uses <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-15/var/p_H_2> .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-15/var/Theta_otimes> a mkg:Variable ;
