    mkg:symbol "p_{H_2}" ;
    mkg:unit "bar" ;
    mkg:unitString "bar" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/var/p_H_2O> a mkg:Variable ;
    rdfs:label "p_{H_2O} (seidel_2018 eq C-16)"@en ;
    mkg:basis "stated" ;
    mkg:description "Partial pressure of water." ;
    mkg:dimension "[mass] / [length] / [time] ** 2" ;
    mkg:measured true ;
    mkg:measuredQuote "measured values of the partial pressures of CO, $CO_2$, $H_2$ and $H_2O$" ;
    mkg:page "3" ;
    mkg:quote "Elementary step: $ \\text{H}_2\\text{O} * \\Rightarrow \\text{H}_2\\text{O} + * $ | Quasi-equilibrium/velocity: $ \\theta_{H_2O}^{*} = K_{H_2O} p_{H_2O} \\Theta^* $" ;
    mkg:reason "A measured process pressure used as a condition in the model, not a constant of its kinetic law." ;
    mkg:siFactor 1e+05 ;
    mkg:status "accepted" ;
    mkg:symbol "p_{H_2O}" ;
    mkg:unit "bar" ;
    mkg:unitString "bar" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-3/var/K_P3> a mkg:Variable ;
