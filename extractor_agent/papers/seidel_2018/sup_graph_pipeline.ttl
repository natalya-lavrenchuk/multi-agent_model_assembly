<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq7_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The free oxidized surface-center coverage is calculated from the contributions of adsorbed species on oxidized centers." ;
    mkg:doi "10.1016/j.ces.2017.09.043" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "Here partial pressures are used instead of fugacities, which is justified by the fact that fugacity coefficients are close to one for the operating conditions considered in this paper (Vollbrecht, 2007)." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Partial pressures are used in place of fugacities." ] ;
    mkg:ocrFixNote "The OCR dropped the 1 in the exponent −1." ;
    mkg:page "3" ;
    mkg:possibleMisprint "The outer exponent is printed as ^{-} without an exponent, leaving the coverage expression incomplete." ;
    mkg:quote "\\Theta^{\\odot}=\\left(1+\\underbrace{K_{\\mathrm{CO}}}_{\\beta_{8}}p_{\\mathrm{CO}}+\\underbrace{\\left(K_{\\mathrm{A3}}K_{\\mathrm{CO}}K_{\\mathrm{H}_{2}}^{3/2}\\right)}_{\\beta_{9}}p_{\\mathrm{H}_{2}}^{3/2}p_{\\mathrm{CO}}+\\underbrace{K_{\\mathrm{CH}_{3}\\mathrm{OH}}^{\\odot}}_{\\beta_{10}}p_{\\mathrm{CH}_{3}\\mathrm{OH}}+\\underbrace{K_{\\mathrm{CO}_{2}}}_{\\beta_{11}}p_{\\mathrm{CO}_{2}}\\right)^{-1}" ;
    mkg:reviewOutcome "reading corrected" ;
    mkg:status "pending" .

