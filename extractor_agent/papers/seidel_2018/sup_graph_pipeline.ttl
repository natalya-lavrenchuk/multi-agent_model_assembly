<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16> a mkg:Law ;
    rdfs:label "seidel_2018 eq C-16"@en ;
    mkg:computes <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/var/Theta_star> ;
    mkg:equationNumber "C-16" ;
    mkg:hasMetadata <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16_meta> ;
    mkg:hasParameter <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/par/K_CH_3OH_star>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/par/K_CO_2_star>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/par/K_H_2>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/par/K_H_2O>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/par/K_O> ;
    mkg:latex "$$ \\Theta^{*}=\\left(1+\\frac{K_{\\mathrm{H}_{2}\\mathrm{O}}K_{\\mathrm{O}}}{K_{\\mathrm{H}_{2}}}\\frac{p_{\\mathrm{H}_{2}\\mathrm{O}}}{p_{\\mathrm{H}_{2}}}+\\underbrace{K_{\\mathrm{CO}_{2}}^{*}}_{\\beta_{13}}p_{\\mathrm{CO}_{2}}+\\underbrace{K_{\\mathrm{CH}_{3}\\mathrm{OH}}^{*}}_{\\beta_{8}}p_{\\mathrm{CH}_{3}\\mathrm{OH}}+\\underbrace{K_{\\mathrm{H}_{2}\\mathrm{O}}}_{\\beta_{9}}p_{\\mathrm{H}_{2}\\mathrm{O}}\\right)^{-1} $$" ;
    mkg:uses <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/var/p_CH_3OH>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/var/p_CO_2>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/var/p_H_2>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/var/p_H_2O> .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/var/Theta_star> a mkg:Variable ;
