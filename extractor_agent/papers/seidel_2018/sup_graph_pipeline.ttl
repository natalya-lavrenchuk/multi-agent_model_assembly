    mkg:latex "\\begin{aligned}\\lg(K_{P1})&=13.8140+3784.4/T-9.2833\\cdot\\lg(T)\\\\&\\quad+3.1475\\times10^{-3}T-4.2613\\times10^{-7}T^{2}\\end{aligned}" ;
    mkg:uses <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eqC-1/var/T> .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eqC-1/var/K_P1> a mkg:Variable ;
    rdfs:label "K_{P1} (seidel_2018 eq C-1)"@en ;
