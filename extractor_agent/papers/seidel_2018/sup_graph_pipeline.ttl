<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The rate law computes the reverse water-gas shift rate from the CO₂-to-CO and water reaction driving force, weighted by the catalyst state and available surface coverages." ;
    mkg:doi "10.1016/j.ces.2017.09.043" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "A maximum coverage of 90% of reduced surface centers is assumed" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The reduced surface-center fraction is capped at 90%." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13/var/K_P3> ;
            mkg:slot "equilibrium constant" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13/var/p_H_2> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13/var/p_CO_2> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13/var/p_H_2O> ;
            mkg:slot "product" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13/par/k_3> ;
            mkg:slot "rate constant" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13/var/phi> ;
            mkg:slot "catalyst" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13/var/p_CO> ;
            mkg:slot "product" ] ;
    mkg:ocrFixNote "The OCR read H₂O as H₂0 (zero)." ;
    mkg:page "11" ;
    mkg:quote "r_{\\mathrm{R W G S}}=\\phi(1-\\phi)^{-1}k_{3}\\left(p_{\\mathrm{C O}_{2}}-\\frac{1}{K_{\\mathrm{P}3}}\\frac{p_{\\mathrm{C O}}p_{\\mathrm{H}_{2}\\mathrm{O}}}{p_{\\mathrm{H}_{2}}}\\right)\\Theta^{*}\\Theta^{\\odot}" ;
    mkg:reviewOutcome "reading corrected" ;
    mkg:status "pending" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-14> a mkg:Law ;
    rdfs:label "seidel_2018 eq C-14"@en ;
    mkg:computes <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-14/var/Theta_odot> ;
    mkg:equationNumber "C-14" ;
    mkg:hasMetadata <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-14_meta> ;
    mkg:hasParameter <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-14/par/K_CH_3OH_odot>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-14/par/K_CO>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-14/par/K_CO_2_odot> ;
    mkg:latex "\\Theta^{\\odot}=\\left(1+\\underbrace{K_{\\mathrm{CO}}}_{\\beta_{11}}p_{\\mathrm{CO}}+\\underbrace{K_{\\mathrm{CH}_{3}\\mathrm{OH}}^{\\odot}}_{\\beta_{12}}p_{\\mathrm{CH}_{3}\\mathrm{OH}}+\\underbrace{K_{\\mathrm{CO}_{2}}^{\\odot}}_{\\beta_{14}}p_{\\mathrm{CO}_{2}}\\right)^{-1}" ;
    mkg:uses <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-14/var/p_CH_3OH>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-14/var/p_CO>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-14/var/p_CO_2> .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-14/var/Theta_odot> a mkg:Variable ;
    rdfs:label "\\Theta^{\\odot} (seidel_2018 eq C-14)"@en ;
    mkg:description "Free oxidized surface-center coverage." ;
    mkg:dimension "dimensionless" ;
