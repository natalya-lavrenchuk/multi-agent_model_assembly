    mkg:page "2" ;
    mkg:quote "Gibbs free energy in J mol $ ^{-1} $" ;
    mkg:reason "A Gibbs free energy parameter fitted to experimental data." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "\\Delta G_{1}" ;
    mkg:unit "J / mol" ;
    mkg:unitString "J mol^-1" .

