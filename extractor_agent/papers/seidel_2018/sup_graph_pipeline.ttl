    mkg:basis "stated" ;
    mkg:description "The expression computes the free reduced-site coverage from CO₂, methanol, and water adsorption and the water-to-hydrogen pressure ratio." ;
    mkg:doi "10.1016/j.ces.2017.09.043" ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/par/K_CH_3OH_star> ;
            mkg:slot "adsorption constant" ],
