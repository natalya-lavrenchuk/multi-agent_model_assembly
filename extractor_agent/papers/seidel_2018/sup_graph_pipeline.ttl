    mkg:page "2" ;
    mkg:quote "stoichiometric coefficient of component i in reaction j" ;
    mkg:reason "It is a stoichiometric coefficient, a fixed coefficient in the reaction matrix." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "\\nu_{ij}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq33/var/r_j> a mkg:Variable ;
    rdfs:label "r_{j} (seidel_2018 eq 33)"@en ;
    mkg:basis "inferred" ;
