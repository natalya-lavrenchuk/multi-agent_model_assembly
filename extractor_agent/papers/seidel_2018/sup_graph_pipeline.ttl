<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq10> a mkg:Law ;
    rdfs:label "seidel_2018 eq 10"@en ;
    mkg:computes <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq10/var/k_i> ;
    mkg:equationNumber "10" ;
    mkg:hasMetadata <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq10_meta> ;
    mkg:hasParameter <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq10/par/A>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq10/par/B>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq10/par/T_ref> ;
    mkg:latex "k_{i}=\\exp\\left(\\underbrace{A}_{\\beta_{1},\\beta_{3},\\beta_{5}}-\\underbrace{B}_{\\beta_{2},\\beta_{4},\\beta_{6}}\\left(\\frac{T_{ref}}{T}-1\\right)\\right)" ;
    mkg:uses <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq10/var/T> .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq10/par/A> a mkg:Parameter ;
    rdfs:label "A (seidel_2018 eq 10)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Linearized Arrhenius parameter in the rate-constant expression, corresponding to its additive term." ;
    mkg:dimension "dimensionless" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "List of estimated parameters for the detailed Eqs. (4)–(9) and simplified model Eqs. (11)–(16) using global optimization." ;
    mkg:reason "It is a constant coefficient in the rate law's linearized Arrhenius expression." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "A" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq10/par/B> a mkg:Parameter ;
    rdfs:label "B (seidel_2018 eq 10)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Linearized Arrhenius parameter multiplying the temperature-dependent term in the rate-constant expression." ;
    mkg:dimension "dimensionless" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "List of estimated parameters for the detailed Eqs. (4)–(9) and simplified model Eqs. (11)–(16) using global optimization." ;
    mkg:reason "It is a constant coefficient in the rate law's linearized Arrhenius expression." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "B" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq10/par/T_ref> a mkg:Parameter ;
    rdfs:label "T_{ref} (seidel_2018 eq 10)"@en ;
    mkg:basis "stated" ;
    mkg:description "Reference temperature for the Arrhenius reparameterization." ;
    mkg:dimension "[temperature]" ;
    mkg:estimation "set" ;
    mkg:estimationQuote "with reference temperature $ T_{ref} = 523.15\\ K $ and equilibrium constants according to Vollbrecht (2007)." ;
    mkg:page "3" ;
    mkg:quote "with reference temperature $ T_{ref} = 523.15\\ K $ and equilibrium constants according to Vollbrecht (2007)." ;
    mkg:reason "It is a fixed reference temperature used in the rate-law reparameterization, not a run condition." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "T_{ref}" ;
    mkg:unit "K" ;
    mkg:unitString "K" ;
    mkg:value 5.2315e+02 .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq10/var/T> a mkg:Variable ;
    rdfs:label "T (seidel_2018 eq 10)"@en ;
    mkg:basis "stated" ;
    mkg:description "Temperature." ;
    mkg:dimension "[temperature]" ;
    mkg:initialQuote "with constant temperature $ T = 523.15 $ K" ;
    mkg:initialValue "523.15 K" ;
    mkg:page "2" ;
    mkg:quote "$ \\phi $ | reduced surface centers: fraction of reduced centers on the catalyst surface | $ K_i $: T | equilibrium constant: temperature in K" ;
    mkg:reason "It is the operating temperature, which the paper varies for the experiments and specifies for the dynamic run." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "T" ;
    mkg:unit "K" ;
    mkg:unitString "K" .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq10/var/k_i> a mkg:Variable ;
    rdfs:label "k_{i} (seidel_2018 eq 10)"@en ;
    mkg:description "Rate constant in the Arrhenius expression." ;
    mkg:symbol "k_{i}" .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq10_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The reparameterized Arrhenius relation computes each rate constant from its linearized parameters and the temperature relative to the reference temperature." ;
    mkg:doi "10.1016/j.ces.2017.09.043" ;
    mkg:form "algebraic" ;
    mkg:page "3" ;
    mkg:quote "k_{i}=\\exp\\left(\\underbrace{A}_{\\beta_{1},\\beta_{3},\\beta_{5}}-\\underbrace{B}_{\\beta_{2},\\beta_{4},\\beta_{6}}\\left(\\frac{T_{ref}}{T}-1\\right)\\right)" ;
    mkg:status "pending" .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq4> a mkg:Law ;
    rdfs:label "seidel_2018 eq 4"@en ;
    mkg:computes <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq4/var/r_CO> ;
    mkg:equationNumber "4" ;
    mkg:hasMetadata <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq4_meta> ;
    mkg:hasParameter <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq4/par/k_1> ;
    mkg:latex "r_{\\mathrm{{C O}}}=k_{1}\\left(p_{\\mathrm{{C O}}}p_{\\mathrm{{H}_{2}}}^{2}-\\frac{p_{\\mathrm{{C H}_{3}\\mathrm{{O H}}}}}{K_{\\mathrm{{P}1}}}\\right)\\Theta^{\\odot}\\Theta^{\\otimes}" ;
    mkg:uses <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq4/var/K_P1>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq4/var/Theta_odot>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq4/var/Theta_otimes>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq4/var/p_CH_3OH>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq4/var/p_CO>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq4/var/p_H_2> .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq4/var/K_P1> a mkg:Variable ;
    rdfs:label "K_{P1} (seidel_2018 eq 4)"@en ;
    mkg:description "Equilibrium constant for the CO-hydrogenation reaction." ;
    mkg:dimension "[length] ** 2 * [time] ** 4 / [mass] ** 2" ;
    mkg:siFactor 1e-10 ;
    mkg:symbol "K_{P1}" ;
    mkg:unit "1 / bar ** 2" ;
    mkg:unitString "bar^-2" .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq4/var/Theta_odot> a mkg:Variable ;
    rdfs:label "\\Theta^{\\odot} (seidel_2018 eq 4)"@en ;
    mkg:description "Free oxidized surface-center coverage." ;
    mkg:dimension "dimensionless" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "\\Theta^{\\odot}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq4/var/Theta_otimes> a mkg:Variable ;
    rdfs:label "\\Theta^{\\otimes} (seidel_2018 eq 4)"@en ;
    mkg:description "Free hydrogen surface-center coverage." ;
    mkg:dimension "dimensionless" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "\\Theta^{\\otimes}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq4/var/r_CO> a mkg:Variable ;
    rdfs:label "r_{CO} (seidel_2018 eq 4)"@en ;
    mkg:description "Modelled reaction rate for CO hydrogenation." ;
    mkg:dimension "[substance] / [mass] / [time]" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "r_{CO}" ;
    mkg:unit "mol / kg / s" ;
    mkg:unitString "mol kg^-1 s^-1" .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq4_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The CO-hydrogenation rate is calculated from the net forward and reverse pressure terms, scaled by the free oxidized and hydrogen-center coverages." ;
    mkg:doi "10.1016/j.ces.2017.09.043" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "Here partial pressures are used instead of fugacities, which is justified by the fact that fugacity coefficients are close to one for the operating conditions considered in this paper (Vollbrecht, 2007)." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Partial pressures are used in place of fugacities." ],
        [ mkg:quote "Using the quasi equilibrium assumption (QEA) for the fast reactions, one can calculate the reaction rates for the CO-hydrogenation,  $ CO_{2} $-hydrogenation and the reverse-water-gas shift reaction as follows" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Quasi‑equilibrium assumption for fast adsorption/desorption steps." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq4/var/p_CO> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq4/var/p_CH_3OH> ;
            mkg:slot "product" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq4/par/k_1> ;
            mkg:slot "rate constant" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq4/var/p_H_2> ;
            mkg:slot "substrate" ] ;
    mkg:page "3" ;
    mkg:quote "r_{\\mathrm{{C O}}}=k_{1}\\left(p_{\\mathrm{{C O}}}p_{\\mathrm{{H}_{2}}}^{2}-\\frac{p_{\\mathrm{{C H}_{3}\\mathrm{{O H}}}}}{K_{\\mathrm{{P}1}}}\\right)\\Theta^{\\odot}\\Theta^{\\otimes}" ;
    mkg:status "pending" .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq7> a mkg:Law ;
    rdfs:label "seidel_2018 eq 7"@en ;
    mkg:computes <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq7/var/Theta_odot> ;
    mkg:equationNumber "7" ;
    mkg:hasMetadata <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq7_meta> ;
    mkg:hasParameter <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq7/par/K_A3>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq7/par/K_CH_3OH_odot>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq7/par/K_CO>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq7/par/K_CO_2>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq7/par/K_H_2> ;
    mkg:latex "$$ \\Theta^{\\odot}=\\left(1+\\underbrace{K_{\\mathrm{CO}}}_{\\beta_{8}}p_{\\mathrm{CO}}+\\underbrace{\\left(K_{\\mathrm{A3}}K_{\\mathrm{CO}}K_{\\mathrm{H}_{2}}^{3/2}\\right)}_{\\beta_{9}}p_{\\mathrm{H}_{2}}^{3/2}p_{\\mathrm{CO}}+\\underbrace{K_{\\mathrm{CH}_{3}\\mathrm{OH}}^{\\odot}}_{\\beta_{10}}p_{\\mathrm{CH}_{3}\\mathrm{OH}}+\\underbrace{K_{\\mathrm{CO}_{2}}}_{\\beta_{11}}p_{\\mathrm{CO}_{2}}\\right)^{-1} $$" ;
    mkg:uses <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq7/var/p_CH_3OH>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq7/var/p_CO>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq7/var/p_CO_2>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq7/var/p_H_2> .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq7/par/K_A3> a mkg:Parameter ;
    rdfs:label "K_{A3} (seidel_2018 eq 7)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Equilibrium constant for the elementary CO-hydrogenation step that forms adsorbed H3CO." ;
    mkg:dimension "dimensionless" ;
    mkg:reason "It is an equilibrium constant for an elementary reaction step." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{A3}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq7/par/K_CH_3OH_odot> a mkg:Parameter ;
    rdfs:label "K_{CH_3OH}^{\\odot} (seidel_2018 eq 7)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Adsorption equilibrium constant for methanol on oxidized surface centers." ;
    mkg:dimension "[length] * [time] ** 2 / [mass]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "List of estimated parameters for the detailed Eqs. (4)–(9) and simplified model Eqs. (11)–(16) using global optimization." ;
    mkg:reason "An adsorption equilibrium constant in the surface-coverage law, so it is a kinetic parameter rather than a run condition." ;
    mkg:siFactor 1e-05 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{CH_3OH}^{\\odot}" ;
    mkg:unit "1 / bar" ;
    mkg:unitString "bar^-1" ;
    mkg:value 0e+00 .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq7/par/K_CO> a mkg:Parameter ;
    rdfs:label "K_{CO} (seidel_2018 eq 7)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Equilibrium constant for CO adsorption on oxidized surface centers." ;
    mkg:dimension "[length] * [time] ** 2 / [mass]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "List of estimated parameters for the detailed Eqs. (4)–(9) and simplified model Eqs. (11)–(16) using global optimization." ;
    mkg:page "3" ;
    mkg:quote "Elementary step: $ \\text{CO} \\odot \\Rightarrow \\text{CO} + \\odot $ | Quasi-equilibrium/velocity: $ \\theta_{CO}^{\\odot} = K_{CO} p_{CO} \\Theta^{\\odot} $" ;
    mkg:reason "It is an adsorption equilibrium constant for CO." ;
    mkg:siFactor 1e-05 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{CO}" ;
    mkg:unit "1 / bar" ;
    mkg:unitString "bar^-1" ;
    mkg:value 0e+00 .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq7/par/K_CO_2> a mkg:Parameter ;
    rdfs:label "K_{CO_2} (seidel_2018 eq 7)"@en ;
    mkg:basis "stated" ;
    mkg:description "Equilibrium constant for carbon dioxide adsorption on oxidized surface centers." ;
    mkg:dimension "[length] * [time] ** 2 / [mass]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "List of estimated parameters for the detailed Eqs. (4)–(9) and simplified model Eqs. (11)–(16) using global optimization." ;
    mkg:page "3" ;
    mkg:quote "Elementary step: $ \\text{CO}_2 + \\odot \\Rightarrow \\text{CO}_2 \\odot $ | Quasi-equilibrium/velocity: $ \\theta_{CO_2}^{\\odot} = K_{CO_2} p_{CO_2} \\Theta^{\\odot} $" ;
    mkg:reason "An adsorption equilibrium constant in the surface-coverage law, so it is a kinetic parameter rather than a run condition." ;
    mkg:siFactor 1e-05 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{CO_2}" ;
    mkg:unit "1 / bar" ;
    mkg:unitString "bar^-1" ;
    mkg:value 1.366e-01 .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq7/par/K_H_2> a mkg:Parameter ;
    rdfs:label "K_{H_2} (seidel_2018 eq 7)"@en ;
    mkg:basis "stated" ;
    mkg:description "Equilibrium constant for hydrogen adsorption/dissociation on the surface." ;
    mkg:dimension "[length] * [time] ** 2 / [mass]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "Therein, a reparametrization is introduced as indicated with the lumped  $ \\beta_{i} $ parameters, which have to be fitted to experimental data." ;
    mkg:page "3" ;
    mkg:quote "Elementary step: $ \\text{H}_2 + 2 \\otimes \\neq 2\\text{H} \\otimes $ | Quasi-equilibrium/velocity: $ \\theta_{\\text{H}}^{*} = K_{H_2}^{1/2} p_{H_2}^{1/2} \\theta^\\otimes $" ;
    mkg:reason "An equilibrium constant of a surface reaction law, so it is a kinetic parameter rather than a run condition." ;
    mkg:siFactor 1e-05 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{H_2}" ;
    mkg:unit "1 / bar" ;
    mkg:unitString "bar^-1" .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq7/var/Theta_odot> a mkg:Variable ;
    rdfs:label "\\Theta^{\\odot} (seidel_2018 eq 7)"@en ;
    mkg:description "Free oxidized surface-center coverage." ;
    mkg:dimension "dimensionless" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "\\Theta^{\\odot}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

