    mkg:basis "stated" ;
    mkg:description "The free reduced surface-center coverage is calculated from the water and methanol adsorption contributions and related surface-step terms." ;
    mkg:doi "10.1016/j.ces.2017.09.043" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "Here partial pressures are used instead of fugacities, which is justified by the fact that fugacity coefficients are close to one for the operating conditions considered in this paper (Vollbrecht, 2007)." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Partial pressures are used in place of fugacities." ] ;
    mkg:ocrFixNote "The OCR read + as ++, dropped the 1 in the exponent −1, and put the ½ power on the wrong term." ;
