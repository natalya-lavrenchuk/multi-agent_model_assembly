            mkg:slot "equilibrium constant" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/var/p_H_2> ;
            mkg:slot "species pressure" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/par/K_O> ;
            mkg:slot "equilibrium constant" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/var/p_CH_3OH> ;
            mkg:slot "species pressure" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/var/p_H_2O> ;
            mkg:slot "species pressure" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/par/K_H_2O> ;
            mkg:slot "equilibrium constant" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/par/K_CO_2_star> ;
            mkg:slot "adsorption constant" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-16/var/p_CO_2> ;
            mkg:slot "species pressure" ] ;
    mkg:ocrFixNote "The OCR dropped the 1 in the exponent −1." ;
    mkg:page "11" ;
    mkg:possibleMisprint "The final parenthesis has exponent “−” rather than “−1,” so the printed expression does not specify the reciprocal." ;
    mkg:quote "\\Theta^{*}=\\left(1+\\frac{K_{\\mathrm{H}_{2}\\mathrm{O}}K_{\\mathrm{O}}}{K_{\\mathrm{H}_{2}}}\\frac{p_{\\mathrm{H}_{2}\\mathrm{O}}}{p_{\\mathrm{H}_{2}}}+\\underbrace{K_{\\mathrm{CO}_{2}}^{*}}_{\\beta_{13}}p_{\\mathrm{CO}_{2}}+\\underbrace{K_{\\mathrm{CH}_{3}\\mathrm{OH}}^{*}}_{\\beta_{8}}p_{\\mathrm{CH}_{3}\\mathrm{OH}}+\\underbrace{K_{\\mathrm{H}_{2}\\mathrm{O}}}_{\\beta_{9}}p_{\\mathrm{H}_{2}\\mathrm{O}}\\right)^{-1}" ;
    mkg:reviewOutcome "reading corrected" ;
    mkg:status "pending" .

