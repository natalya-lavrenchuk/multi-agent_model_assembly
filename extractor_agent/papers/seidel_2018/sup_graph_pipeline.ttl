    mkg:latex "r_{\\mathrm{{C O}}}=(1-\\phi)k_{1}\\left(p_{\\mathrm{{C O}}}p_{\\mathrm{{H}_{2}}}^{2}-\\frac{p_{\\mathrm{{C H}_{3}\\mathrm{{O H}}}}}{K_{\\mathrm{{P}1}}}\\right)\\Theta^{\\odot}\\Theta^{\\otimes^{4}}" ;
    mkg:uses <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-11/var/K_P1>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-11/var/Theta_odot>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-11/var/Theta_otimes>,
