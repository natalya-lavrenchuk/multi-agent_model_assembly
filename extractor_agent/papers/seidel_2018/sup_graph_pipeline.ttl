    rdfs:label "\\Theta^{*} (seidel_2018 eq C-12)"@en ;
    mkg:description "Amount of free reduced surface centers relative to the total amount of reduced surface centers." ;
    mkg:dimension "dimensionless" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "\\Theta^{*}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12/var/r_CO_2> a mkg:Variable ;
    rdfs:label "r_{CO_2} (seidel_2018 eq C-12)"@en ;
    mkg:description "Reaction rate for CO₂ hydrogenation." ;
    mkg:dimension "[substance] / [mass] / [time]" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "r_{CO_2}" ;
    mkg:unit "mol / kg / s" ;
    mkg:unitString "mol kg⁻¹ s⁻¹" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The rate law computes CO₂ hydrogenation from the CO₂ and hydrogen reactants and methanol and water products, weighted by the catalyst state and available surface coverages." ;
    mkg:doi "10.1016/j.ces.2017.09.043" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "A maximum coverage of 90% of reduced surface centers is assumed" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The reduced surface-center fraction is capped at 90%." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12/var/phi> ;
            mkg:slot "catalyst" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12/var/p_H_2O> ;
            mkg:slot "product" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12/var/p_H_2> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12/var/p_CH_3OH> ;
            mkg:slot "product" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12/var/p_CO_2> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12/par/k_2> ;
            mkg:slot "rate constant" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-12/var/K_P2> ;
            mkg:slot "equilibrium constant" ] ;
    mkg:ocrFixNote "The OCR merged p_CH3OH and p_H2O into one symbol." ;
    mkg:page "11" ;
    mkg:quote "r_{\\mathrm{{C O}_{2}}}=\\phi^{2}k_{2}\\left(p_{\\mathrm{{C O}_{2}}}p_{\\mathrm{{H}_{2}}}^{2}-\\frac{1}{K_{\\mathrm{{P}2}}}\\frac{p_{\\mathrm{{C H}_{3}\\mathrm{{O H}}}}p_{\\mathrm{{H}_{2}\\mathrm{O}}}}{p_{\\mathrm{{H}_{2}}}}\\right)\\Theta^{*^{2}}\\Theta^{\\otimes^{4}}" ;
    mkg:reviewOutcome "reading corrected" ;
    mkg:status "pending" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13> a mkg:Law ;
    rdfs:label "seidel_2018 eq C-13"@en ;
    mkg:computes <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13/var/r_RWGS> ;
    mkg:equationNumber "C-13" ;
    mkg:hasMetadata <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13_meta> ;
    mkg:hasParameter <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13/par/k_3> ;
    mkg:latex "$$ r_{\\mathrm{R W G S}}=\\phi(1-\\phi)^{-1}k_{3}\\left(p_{\\mathrm{C O}_{2}}-\\frac{1}{K_{\\mathrm{P}3}}\\frac{p_{\\mathrm{C O}}p_{\\mathrm{H}_{2}\\mathrm{O}}}{p_{\\mathrm{H}_{2}}}\\right)\\Theta^{*}\\Theta^{\\odot} $$" ;
    mkg:uses <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13/var/K_P3>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13/var/Theta_odot>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13/var/Theta_star>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13/var/p_CO>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13/var/p_CO_2>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13/var/p_H_2>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13/var/p_H_2O>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eqC-13/var/phi> .

