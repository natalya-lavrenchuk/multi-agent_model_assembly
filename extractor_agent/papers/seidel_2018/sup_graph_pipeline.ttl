<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq33_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The dynamic reactor balance computes each component’s mole-fraction trajectory from the feed, residence time, and reaction terms." ;
    mkg:doi "10.1016/j.ces.2017.09.043" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "The experimental setup is based on a modified, differential CSTR of a Micro-Berty Reactor type described Berty (1999)." ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The reactor is a modified differential CSTR." ] ;
    mkg:page "5" ;
    mkg:quote "\\dot{y}_{i}=Z\\Bigg[\\frac{1}{\\tau}y_{i,0}-\\Bigg(\\frac{1}{\\tau}+\\frac{1}{\\mathcal{K}}\\sum_{i=1}^{N_{K}}\\sum_{j=1}^{N_{R}}\\nu_{i j}r_{j}\\Bigg)y_{i}+\\frac{1}{\\mathcal{K}}\\sum_{j=1}^{N_{R}}\\nu_{i j}r_{j}\\Bigg]" ;
    mkg:status "flagged" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-1> a mkg:Law ;
    rdfs:label "seidel_2018 eq C-1"@en ;
    mkg:computes <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-1/var/K_P1> ;
    mkg:equationNumber "C-1" ;
    mkg:hasMetadata <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-1_meta> ;
    mkg:latex "\\begin{aligned}\\lg(K_{P1})&=13.8140+3784.4/T-9.2833\\cdot\\lg(T)\\\\&\\quad+3.1475\\times10^{-3}T-4.2613\\times10^{-7}T^{2}\\end{aligned}" ;
    mkg:uses <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-1/var/T> .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-1/var/K_P1> a mkg:Variable ;
    rdfs:label "K_{P1} (seidel_2018 eq C-1)"@en ;
    mkg:description "Equilibrium constant for the CO-hydrogenation reaction." ;
    mkg:dimension "[length] ** 2 * [time] ** 4 / [mass] ** 2" ;
    mkg:siFactor 1e-10 ;
