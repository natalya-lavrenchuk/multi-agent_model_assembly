    mkg:estimationQuote "A maximum binding capacity,  $ q_{max} $, of 73 ± 3 g L⁻¹ and an association equilibrium constant,  $ K_A $, of 6.1 ± 2.9 L g⁻¹ were obtained for IgG adsorption up to 9 g L⁻¹ by AbSolute." ;
    mkg:page "10" ;
    mkg:quote "maximum binding capacity of all the retained solutes" ;
    mkg:reason "It is a maximum binding-capacity constant for the retained solutes, a property of the adsorption isotherm." ;
    mkg:sameQuantityAs "q_{max}" ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "q_{\\max,R}" ;
    mkg:unit "g / l" ;
    mkg:unitString "gL⁻¹" ;
    mkg:value 73 ;
    mkg:valueUncertainty "± 3" .

