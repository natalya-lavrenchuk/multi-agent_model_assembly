    mkg:status "accepted" ;
    mkg:symbol "\\theta_{3}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" ;
    mkg:value 5.49e-01 ;
    mkg:valuesByCase "{\"sequential precision experiment, Monod kinetics\": \"0.523 - (dimensionless) (p.6, Table 2)\"}" .

