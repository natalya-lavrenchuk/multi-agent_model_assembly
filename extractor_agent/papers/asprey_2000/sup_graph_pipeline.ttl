<http://example.org/kg/asprey_2000_contois_kinetics/law/asprey_2000_eq16.2/var/u_2> a mkg:Variable ;
    rdfs:label "u_{2} (asprey_2000 eq 16.2)"@en ;
    mkg:basis "stated" ;
    mkg:description "substrate concentration in the feed" ;
    mkg:dimension "[mass] / [length] ** 3" ;
