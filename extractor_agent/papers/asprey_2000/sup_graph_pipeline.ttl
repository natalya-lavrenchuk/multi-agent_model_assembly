    mkg:description "substrate concentration" ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:initialQuote "The initial substrate concentration, $ x_2(0) $, is always 0.01 g l $ ^{-1} $ and cannot be manipulated for experiment design purposes." ;
    mkg:initialValue "0.01 g l^-1" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "x_{2}" ;
    mkg:unit "g / l" ;
    mkg:unitString "g l^-1" .

