    mkg:estimation "set" ;
    mkg:estimationQuote "The sucrose to glucose or fructose DM conversion parameters ( $ m_{SG} $ and  $ m_{SF} $) were set at 0.526 because one mole of sucrose always produces one mole each of glucose and fructose (Puad et al., 2017)." ;
    mkg:page "11" ;
    mkg:quote "The sucrose to glucose or fructose DM conversion parameters ( $ m_{SG} $ and  $ m_{SF} $) were set at 0.526 because one mole of sucrose always produces one mole each of glucose and fructose (Puad et al., 2017)." ;
    mkg:reason "It is a DM conversion coefficient, a constant of the sucrose hydrolysis law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "m_{SG}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" ;
    mkg:value 5.26e-01 .

