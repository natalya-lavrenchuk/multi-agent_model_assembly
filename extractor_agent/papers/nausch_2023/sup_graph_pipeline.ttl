<http://example.org/kg/nausch_2023/law/nausch_2023_eq5> a mkg:Law ;
    rdfs:label "nausch_2023 eq 5"@en ;
    mkg:computes <http://example.org/kg/nausch_2023/law/nausch_2023_eq5/var/S> ;
