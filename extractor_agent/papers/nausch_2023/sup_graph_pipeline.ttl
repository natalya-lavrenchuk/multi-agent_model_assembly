    mkg:uses <http://example.org/kg/nausch_2023/law/nausch_2023_eq3/var/F_t> .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq3/var/F_t> a mkg:Variable ;
    rdfs:label "F_{t} (nausch_2023 eq 3)"@en ;
    mkg:basis "stated" ;
    mkg:description "Feed rate at time t." ;
    mkg:dimension "[length] ** 3 / [time]" ;
    mkg:page "5" ;
    mkg:quote "we calculated the feed rate $F_{t}$ [$\\mathrm{L}\\ \\mathrm{h}^{-1}$] for each time point $t$" ;
    mkg:reason "A feed flow rate that varies over time during operation." ;
    mkg:siFactor 2.777778e-07 ;
    mkg:status "accepted" ;
    mkg:symbol "F_{t}" ;
    mkg:unit "l / h" ;
    mkg:unitString "L h^-1" .

