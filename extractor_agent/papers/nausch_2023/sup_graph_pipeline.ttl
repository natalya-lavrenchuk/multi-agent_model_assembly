    mkg:estimation "estimated" ;
    mkg:estimationQuote "TABLE 3 Parameter ranges and identified optimal parameter values for the improved model (experiments #1 to #7 were used for model setup)." ;
    mkg:reason "A glucose saturation constant is a constant of the growth and consumption laws." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{G}" ;
    mkg:unit "g / l" ;
    mkg:unitString "g L^-1" ;
    mkg:value 1.8e+01 ;
    mkg:valueUncertainty "17.1 g L^-1" .

