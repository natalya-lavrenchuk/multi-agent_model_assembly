<http://example.org/kg/nausch_2023/law/nausch_2023_eq8_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Phosphate concentration is balanced against feed input, volume change, and phosphate removal." ;
    mkg:doi "10.3389/fpls.2023.1183254" ;
