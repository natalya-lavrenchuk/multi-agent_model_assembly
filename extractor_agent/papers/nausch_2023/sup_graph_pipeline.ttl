@prefix kg: <http://example.org/kg/nausch_2023/> .
@prefix mkg: <http://example.org/mkg#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kg:nausch_2023 a mkg:Sup ;
    rdfs:label "nausch_2023 · Simulation and optimization of nutrient uptake and biomass formation using a multi-parameter Monod-type model of tobacco BY-2 cell suspension cultures in a stirred-tank bioreactor"@en ;
    mkg:hasMetadata kg:nausch_2023_meta ;
    mkg:includes <http://example.org/kg/nausch_2023/law/nausch_2023_eq18>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq19>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq2>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq20>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq3>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq5>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq6>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq7>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq8> .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq18> a mkg:Law ;
    rdfs:label "nausch_2023 eq 18"@en ;
    mkg:computes <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/var/mu> ;
    mkg:equationNumber "18" ;
    mkg:hasMetadata <http://example.org/kg/nausch_2023/law/nausch_2023_eq18_meta> ;
    mkg:hasParameter <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/K_F>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/K_G>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/K_IF>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/K_IG>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/K_IN>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/K_N>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/delta_A>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/delta_P>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/mu_m>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/mu_m_A>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/mu_m_P> ;
    mkg:latex "\\begin{aligned}\\mu=&\\left(\\mu_{m}+\\mu_{m}^{A}\\frac{A}{A+\\delta_{A}}+\\mu_{m}^{P}\\frac{P}{P+\\delta_{P}}\\right)\\\\&\\left(\\frac{G}{G+K_{G}}\\frac{K_{IG}}{G+K_{IG}}+\\frac{F}{F+K_{F}}\\frac{K_{IF}}{F+K_{IF}}\\right)\\left(\\frac{N}{N+K_{N}}\\frac{K_{IN}}{N+K_{IN}}\\right)\\end{aligned}" ;
    mkg:uses <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/var/A>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/var/F>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/var/G>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/var/N>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/var/P> .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq18/var/mu> a mkg:Variable ;
    rdfs:label "\\mu (nausch_2023 eq 18)"@en ;
    mkg:description "Specific growth rate (biomass formation) of active dry mass." ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "\\mu" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq18_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:description "The specific growth rate combines glucose, fructose, and nitrate dependence with additive ammonium- and phosphate-dependent contributions to the maximum growth rate." ;
    mkg:doi "10.3389/fpls.2023.1183254" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "They were assumed known in the context of this study to limit the model complexity and avoid overfitting and their values were set to 10% of the starting concentrations." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The minimum ammonium and phosphate concentrations for growth, represented by δ_A and δ_P, were treated as known and set to 10% of their starting concentrations." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/delta_A> ;
            mkg:slot "growth threshold" ],
        [ mkg:boundTo <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/var/F> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/delta_P> ;
            mkg:slot "growth threshold" ],
        [ mkg:boundTo <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/var/N> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/K_IF> ;
            mkg:slot "inhibition constant" ],
        [ mkg:boundTo <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/K_IG> ;
            mkg:slot "inhibition constant" ],
        [ mkg:boundTo <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/var/G> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/mu_m_P> ;
            mkg:slot "maximum rate" ],
        [ mkg:boundTo <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/K_G> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/K_F> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/K_IN> ;
            mkg:slot "inhibition constant" ],
        [ mkg:boundTo <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/mu_m> ;
            mkg:slot "maximum rate" ],
        [ mkg:boundTo <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/K_N> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/var/P> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/var/A> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/nausch_2023/law/nausch_2023_eq18/par/mu_m_A> ;
            mkg:slot "maximum rate" ] ;
    mkg:page "11" ;
    mkg:possibleMisprint "As listed, the terms A/(A+δ_A) and G/(G+K_G) and G/(G+K_{IG}) pair A in g L⁻¹ with δ_A in mM and G in mM with K_G and K_{IG} in g L⁻¹, making the sums dimensionally inconsistent." ;
    mkg:quote "\\begin{aligned}\\mu=&\\left(\\mu_{m}+\\mu_{m}^{A}\\frac{A}{A+\\delta_{A}}+\\mu_{m}^{P}\\frac{P}{P+\\delta_{P}}\\right)\\\\&\\left(\\frac{G}{G+K_{G}}\\frac{K_{IG}}{G+K_{IG}}+\\frac{F}{F+K_{F}}\\frac{K_{IF}}{F+K_{IF}}\\right)\\left(\\frac{N}{N+K_{N}}\\frac{K_{IN}}{N+K_{IN}}\\right)\\end{aligned}" ;
    mkg:reviewOutcome "false alarm" ;
    mkg:status "pending" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq19> a mkg:Law ;
    rdfs:label "nausch_2023 eq 19"@en ;
    mkg:computes <http://example.org/kg/nausch_2023/law/nausch_2023_eq19/var/F> ;
    mkg:equationNumber "19" ;
    mkg:hasMetadata <http://example.org/kg/nausch_2023/law/nausch_2023_eq19_meta> ;
    mkg:hasParameter <http://example.org/kg/nausch_2023/law/nausch_2023_eq19/par/K_F>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq19/par/K_IF>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq19/par/K_IS>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq19/par/K_S>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq19/par/alpha>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq19/par/m_SF>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq19/par/mu_F> ;
    mkg:latex "\\begin{align*}V\\frac{dF}{dt}+F\\frac{dV}{dt}&=m_{SF}\\alpha\\left(\\frac{S}{S+K_{S}}\\frac{K_{IS}}{S+K_{IS}}\\right)X_{a}V\\\\&\\quad-\\mu_{F}\\left(\\frac{F}{F+K_{F}}\\frac{K_{IF}}{F+K_{IF}}\\right)X_{a}V\\end{align*}" ;
    mkg:uses <http://example.org/kg/nausch_2023/law/nausch_2023_eq19/var/S>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq19/var/V>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq19/var/X_a> .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq19/par/K_F> a mkg:Parameter ;
    rdfs:label "K_{F} (nausch_2023 eq 19)"@en ;
    mkg:basis "stated" ;
    mkg:description "Fructose saturation constant" ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "TABLE 3 Parameter ranges and identified optimal parameter values for the improved model (experiments #1 to #7 were used for model setup)." ;
    mkg:page "14" ;
    mkg:quote "Fructose saturation constant" ;
    mkg:reason "It is a fructose saturation constant, a constant of the kinetic law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{F}" ;
    mkg:unit "g / l" ;
    mkg:unitString "g L^-1" ;
    mkg:value 1.108e+00 ;
    mkg:valueUncertainty "90% CI: 0.71" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq19/par/K_IF> a mkg:Parameter ;
    rdfs:label "K_{IF} (nausch_2023 eq 19)"@en ;
    mkg:basis "stated" ;
    mkg:description "Fructose inhibition constant" ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "TABLE 3 Parameter ranges and identified optimal parameter values for the improved model (experiments #1 to #7 were used for model setup)." ;
    mkg:page "14" ;
    mkg:quote "Fructose inhibition constant" ;
    mkg:reason "It is a fructose inhibition constant, a constant of the kinetic law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{IF}" ;
    mkg:unit "g / l" ;
    mkg:unitString "g L^-1" ;
    mkg:value 1.404e+00 ;
    mkg:valueUncertainty "90% CI: 0.51" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq19/par/K_IS> a mkg:Parameter ;
    rdfs:label "K_{IS} (nausch_2023 eq 19)"@en ;
    mkg:basis "stated" ;
    mkg:description "Sucrose inhibition constant." ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "TABLE 3 Parameter ranges and identified optimal parameter values for the improved model (experiments #1 to #7 were used for model setup)." ;
    mkg:page "14" ;
    mkg:quote "Parameter: $ K_{IS} $ | Description: Sucrose inhibition constant" ;
    mkg:reason "A sucrose inhibition constant in the growth and uptake law, estimated as a model parameter." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{IS}" ;
    mkg:unit "g / l" ;
    mkg:unitString "g L^-1" ;
    mkg:value 1e+02 ;
    mkg:valueUncertainty "90% CI: 73.3" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq19/par/K_S> a mkg:Parameter ;
    rdfs:label "K_{S} (nausch_2023 eq 19)"@en ;
    mkg:basis "stated" ;
    mkg:description "Sucrose saturation constant." ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "TABLE 3 Parameter ranges and identified optimal parameter values for the improved model (experiments #1 to #7 were used for model setup)." ;
    mkg:page "14" ;
    mkg:quote "Parameter: $ K_S $ | Description: Sucrose saturation constant" ;
    mkg:reason "A sucrose saturation constant in the growth and uptake law, estimated as a model parameter." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{S}" ;
    mkg:unit "g / l" ;
    mkg:unitString "g L^-1" ;
    mkg:value 7.253e+01 ;
    mkg:valueUncertainty "90% CI: 73.4" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq19/par/alpha> a mkg:Parameter ;
    rdfs:label "\\alpha (nausch_2023 eq 19)"@en ;
    mkg:basis "stated" ;
    mkg:description "Sucrose hydrolysis constant" ;
    mkg:dimension "1 / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "TABLE 3 Parameter ranges and identified optimal parameter values for the improved model (experiments #1 to #7 were used for model setup) (continued)" ;
    mkg:page "15" ;
    mkg:quote "Sucrose hydrolysis constant" ;
    mkg:reason "It is a sucrose hydrolysis rate constant, a constant of the kinetic law." ;
    mkg:siFactor 2.777778e-04 ;
    mkg:status "accepted" ;
    mkg:symbol "\\alpha" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" ;
    mkg:value 3.96e-01 ;
    mkg:valueUncertainty "90% CI: 0.24" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq19/par/m_SF> a mkg:Parameter ;
    rdfs:label "m_{SF} (nausch_2023 eq 19)"@en ;
    mkg:basis "stated" ;
    mkg:description "Sucrose-to-fructose DM conversion parameter" ;
    mkg:dimension "dimensionless" ;
    mkg:estimation "set" ;
    mkg:estimationQuote "The sucrose to glucose or fructose DM conversion parameters ( $ m_{SG} $ and  $ m_{SF} $) were set at 0.526 because one mole of sucrose always produces one mole each of glucose and fructose (Puad et al., 2017)." ;
    mkg:page "11" ;
    mkg:quote "The sucrose to glucose or fructose DM conversion parameters ( $ m_{SG} $ and  $ m_{SF} $) were set at 0.526 because one mole of sucrose always produces one mole each of glucose and fructose (Puad et al., 2017)." ;
    mkg:reason "It is a DM conversion coefficient, a constant of the sucrose hydrolysis law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "m_{SF}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" ;
    mkg:value 5.26e-01 .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq19/par/mu_F> a mkg:Parameter ;
    rdfs:label "\\mu_{F} (nausch_2023 eq 19)"@en ;
    mkg:basis "stated" ;
    mkg:description "Fructose consumption rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "TABLE 3 Parameter ranges and identified optimal parameter values for the improved model (experiments #1 to #7 were used for model setup) (continued)" ;
    mkg:page "15" ;
    mkg:quote "Fructose consumption rate" ;
    mkg:reason "It is a fructose consumption rate constant in the nutrient-uptake law." ;
    mkg:siFactor 2.777778e-04 ;
    mkg:status "accepted" ;
    mkg:symbol "\\mu_{F}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" ;
    mkg:value 8.34e-02 ;
    mkg:valueUncertainty "90% CI: 2.9 × 10^-2" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq19/var/F> a mkg:Variable ;
    rdfs:label "F (nausch_2023 eq 19)"@en ;
    mkg:description "Fructose concentration" ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:initialQuote "experiments #1 - #7 did not contain fructose or glucose at the start of the fermentation." ;
    mkg:initialValue "0 mM" ;
    mkg:measured true ;
    mkg:measuredQuote "K = 4 full data sets available, i.e., all experiments performed so far in which fructose and glucose were measured: #4-7." ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "F" ;
    mkg:unit "g / l" ;
    mkg:unitString "g L^-1" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq19/var/S> a mkg:Variable ;
    rdfs:label "S (nausch_2023 eq 19)"@en ;
    mkg:description "Sucrose concentration." ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "S" ;
    mkg:unit "g / l" ;
    mkg:unitString "g L^-1" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq19/var/V> a mkg:Variable ;
    rdfs:label "V (nausch_2023 eq 19)"@en ;
    mkg:description "Volume of the cultivation medium." ;
    mkg:dimension "[length] ** 3" ;
    mkg:siFactor 1e-03 ;
    mkg:symbol "V" ;
    mkg:unit "l" ;
    mkg:unitString "L" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq19/var/X_a> a mkg:Variable ;
    rdfs:label "X_{a} (nausch_2023 eq 19)"@en ;
    mkg:description "Viable (active) cell dry mass." ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "X_{a}" ;
    mkg:unit "g / l" ;
    mkg:unitString "g L^-1" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq19_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The fructose balance adds fructose produced by sucrose hydrolysis and subtracts fructose consumed by active cells, accounting for changes in cultivation volume." ;
    mkg:doi "10.3389/fpls.2023.1183254" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "The sucrose to glucose or fructose DM conversion parameters ( $ m_{SG} $ and $ m_{SF} $) were set at 0.526 because one mole of sucrose always produces one mole each of glucose and fructose" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The sucrose-to-fructose conversion parameter was fixed at 0.526." ] ;
    mkg:page "11" ;
    mkg:quote "\\begin{align*}V\\frac{dF}{dt}+F\\frac{dV}{dt}&=m_{SF}\\alpha\\left(\\frac{S}{S+K_{S}}\\frac{K_{IS}}{S+K_{IS}}\\right)X_{a}V\\\\&\\quad-\\mu_{F}\\left(\\frac{F}{F+K_{F}}\\frac{K_{IF}}{F+K_{IF}}\\right)X_{a}V\\end{align*}" ;
    mkg:status "pending" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq2> a mkg:Law ;
    rdfs:label "nausch_2023 eq 2"@en ;
    mkg:computes <http://example.org/kg/nausch_2023/law/nausch_2023_eq2/var/X_a> ;
    mkg:equationNumber "2" ;
    mkg:hasMetadata <http://example.org/kg/nausch_2023/law/nausch_2023_eq2_meta> ;
    mkg:hasParameter <http://example.org/kg/nausch_2023/law/nausch_2023_eq2/par/k_d> ;
    mkg:latex "V\\frac{dX_{a}}{dt}+X_{a}\\frac{dV}{dt}=\\mu X_{a}V-k_{d}X_{a}V" ;
    mkg:uses <http://example.org/kg/nausch_2023/law/nausch_2023_eq2/var/V>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq2/var/mu> .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq2/par/k_d> a mkg:Parameter ;
    rdfs:label "k_{d} (nausch_2023 eq 2)"@en ;
    mkg:basis "stated" ;
    mkg:description "Death rate constant of active dry mass." ;
    mkg:dimension "1 / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "TABLE 3 Parameter ranges and identified optimal parameter values for the improved model (experiments #1 to #7 were used for model setup)." ;
    mkg:page "5" ;
    mkg:quote "$k_{d}$ [$\\mathrm{h}^{-1}$] is the death rate constant of active DM" ;
    mkg:reason "A death-rate constant of active dry mass, estimated as a model parameter." ;
    mkg:siFactor 2.777778e-04 ;
    mkg:status "accepted" ;
    mkg:symbol "k_{d}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" ;
    mkg:value 5.44e-04 ;
    mkg:valueUncertainty "90% CI: 6.2 × 10^-5" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq2/var/V> a mkg:Variable ;
    rdfs:label "V (nausch_2023 eq 2)"@en ;
    mkg:description "Volume of the cultivation medium." ;
    mkg:dimension "[length] ** 3" ;
    mkg:siFactor 1e-03 ;
    mkg:symbol "V" ;
    mkg:unit "l" ;
    mkg:unitString "L" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq2/var/X_a> a mkg:Variable ;
    rdfs:label "X_{a} (nausch_2023 eq 2)"@en ;
    mkg:description "Viable (active) cell dry mass." ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "X_{a}" ;
    mkg:unit "g / l" ;
    mkg:unitString "g L^-1" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq2/var/mu> a mkg:Variable ;
    rdfs:label "\\mu (nausch_2023 eq 2)"@en ;
    mkg:description "Specific growth rate (biomass formation) of active dry mass." ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "\\mu" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq20> a mkg:Law ;
    rdfs:label "nausch_2023 eq 20"@en ;
    mkg:computes <http://example.org/kg/nausch_2023/law/nausch_2023_eq20/var/G> ;
    mkg:equationNumber "20" ;
    mkg:hasMetadata <http://example.org/kg/nausch_2023/law/nausch_2023_eq20_meta> ;
    mkg:hasParameter <http://example.org/kg/nausch_2023/law/nausch_2023_eq20/par/K_G>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq20/par/K_IG>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq20/par/K_IS>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq20/par/K_S>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq20/par/alpha>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq20/par/m_SG>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq20/par/mu_G> ;
    mkg:latex "\\begin{align*}V\\frac{dG}{dt}+G\\frac{dV}{dt}&=m_{SG}\\alpha\\Bigg(\\frac{S}{S+K_{S}}\\frac{K_{IS}}{S+K_{IS}}\\Bigg)X_{a}V\\\\&\\quad-\\mu_{G}\\Bigg(\\frac{G}{G+K_{G}}\\frac{K_{IG}}{G+K_{IG}}\\Bigg)X_{a}V\\end{align*}" ;
    mkg:uses <http://example.org/kg/nausch_2023/law/nausch_2023_eq20/var/S>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq20/var/V>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq20/var/X_a> .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq20/par/K_G> a mkg:Parameter ;
