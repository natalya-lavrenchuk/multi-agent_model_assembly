kg:nausch_2023_meta a mkg:Metadata ;
    mkg:completeModel true ;
    mkg:description "The improved model represents tobacco BY-2 plant cells growing in stirred-tank bioreactors and consuming sucrose-derived sugars, ammonium, nitrate, and phosphate. It predicts cell dry mass and the concentrations of these nutrients and sugars over time, using an unstructured, segregated Monod-type description that distinguishes active and dead biomass and includes sucrose hydrolysis to glucose and fructose. The process uses batch cultivation followed by semi-continuous feeding and broth draining, with feed adjusted in response to biomass growth. The authors developed and tested the model using measurements from nine cultivation runs in 2-L and 5-L reactors, with model fitting and cross-validation based on runs with measured glucose and fructose. They used it to compare growth predictions and optimize the tradeoff between biomass yield and process time, including the starting sucrose and inoculum concentrations." ;
    mkg:doi "10.3389/fpls.2023.1183254" ;
    mkg:form "DAE" ;
    mkg:hasAssumption [ mkg:quote "The model assumes an irreversible progression in which active cells (active DM) are converted into dead cells (dead DM) (Jacob et al., 2020) (Eq. 2)." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The model assumes an irreversible progression in which active cells (active DM) are converted into dead cells (dead DM)." ] ;
    mkg:hasFact [ mkg:basis "inferred" ;
            mkg:text "After fitting the improved model to experiments #4–7, the dry-mass mean absolute error was 0.58 g L⁻¹." ;
            mkg:topic "performance" ],
        [ mkg:basis "inferred" ;
            mkg:text "The standard-condition calibration runs began at 20 ± 5 g L⁻¹ fresh mass, corresponding to 0.75 ± 0.22 g L⁻¹ dry mass, and used 88 mM sucrose." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "To increase the model accuracy further, the unstructured model might be converted to a structured one that includes the intracellular metabolism of nutrients." ;
            mkg:text "The authors identify intracellular nutrient pools and metabolism as possible additions for improving model accuracy." ;
            mkg:topic "limitations" ],
        [ mkg:basis "inferred" ;
            mkg:text "Pareto-selected runs used 67 mM starting sucrose and inoculum dry masses of 0.80 or 0.56 g L⁻¹, and reached about 10.88 or 10.04 g L⁻¹ dry mass within 6 days." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The sucrose to glucose or fructose DM conversion parameters (mSG and mSF) were set at 0.526 because one mole of sucrose always produces one mole each of glucose and fructose" ;
            mkg:text "The sucrose-to-glucose and sucrose-to-fructose conversion coefficients were fixed at 0.526 based on the production of one mole of each monosaccharide from one mole of sucrose." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "inferred" ;
            mkg:text "The improved model tracks volume, active cell dry mass, and six extracellular concentrations, with growth rate calculated as an algebraic quantity." ;
            mkg:topic "model" ],
        [ mkg:basis "inferred" ;
            mkg:text "In cross-validation, the improved model reduced the average normalized test error for dry mass from 0.214 to 0.149 overall and from 0.371 to 0.097 for dry-mass values above 8 g L⁻¹." ;
            mkg:topic "performance" ],
        [ mkg:basis "inferred" ;
            mkg:text "Calculations were performed in Julia, and the nonlinear optimization problem was solved using Ipopt." ;
            mkg:topic "calibration" ],
        [ mkg:basis "stated" ;
            mkg:quote "As proposed by Jacobs et al. (2020), we modeled two physiological states of cell DM" ;
            mkg:text "The model's separation of active and dead biomass follows the approach attributed to Jacob et al. 2020." ;
            mkg:topic "prior work" ],
        [ mkg:basis "stated" ;
            mkg:quote "The dO₂ level was kept constant by controlling the stirrer speed. The pH were monitored but not controlled." ;
            mkg:text "The dissolved-oxygen level was controlled by changing stirrer speed, while pH was monitored but not controlled." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "It has 20 parameters to identify" ;
            mkg:text "The improved model has 20 parameters to identify." ;
            mkg:topic "size" ],
        [ mkg:basis "stated" ;
            mkg:quote "With K = 4 full data sets available, i.e., all experiments performed so far in which fructose and glucose were measured: #4-7. Experiments #1-3 were not considered since the improved model would need the initial concentrations of fructose and glucose." ;
            mkg:text "The initial model was fitted to standard-condition experiments #1–3, while the improved model's four-fold cross-validation used experiments #4–7 because they included measured glucose and fructose." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "The double-walled glass STRs were equipped with dissolved oxygen (dO₂), capacitance, and pH probes, and contained a porous sparger for aeration. Two axial marine and two radial flat-blade impellers were used for mixing." ;
            mkg:text "The stirred tanks had dissolved-oxygen, capacitance, and pH probes, a porous aeration sparger, and two marine and two flat-blade impellers." ;
            mkg:topic "reactor" ],
        [ mkg:basis "stated" ;
            mkg:quote "The improved model was then retrained with all available full data sets (i.e., experiments #4-7) resulting in the proposed identified parameters" ;
            mkg:text "The model tracks sucrose, ammonium, nitrate, phosphate, glucose, fructose, and cell dry mass." ;
            mkg:topic "system" ],
        [ mkg:basis "stated" ;
            mkg:quote "Here, we used the weighted least-squares function as an objective function" ;
            mkg:text "The model parameters were estimated by minimizing a weighted least-squares objective with equal weights assigned to the measured responses." ;
            mkg:topic "calibration" ],
        [ mkg:basis "stated" ;
            mkg:quote "before analysis using commercial assay kits for sucrose" ;
            mkg:text "Sucrose, glucose, fructose, ammonium, nitrate, and phosphate in the filtered medium were measured using commercial assay kits." ;
            mkg:topic "measurements" ],
        [ mkg:basis "stated" ;
            mkg:quote "Here we applied an unstructured segregated Monod-type model to describe the nutrient uptake and biomass formation of tobacco BY-2 cells as model PCC" ;
            mkg:text "The model describes tobacco Nicotiana tabacum BY-2 cell suspension cultures and extracellular nutrient uptake and biomass formation." ;
            mkg:topic "system" ],
        [ mkg:basis "inferred" ;
            mkg:text "During semi-continuous operation, cultivation broth was drained every 22–26 h to restore the starting volume, while feed rate was adjusted according to growth monitored by capacitance." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Therefore, the specific growth term depended on glucose and fructose but not on sucrose. Moreover, the influence of ammonium and phosphate were included in the maximum specific growth as additive terms" ;
            mkg:text "The improved model makes specific growth depend on glucose and fructose rather than sucrose, while also incorporating nitrate and additive ammonium and phosphate contributions." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "The data supporting the findings of this study are available from the corresponding author upon reasonable request." ;
            mkg:text "The data supporting the study's findings are available from the corresponding author upon reasonable request." ;
            mkg:topic "availability" ],
        [ mkg:basis "stated" ;
            mkg:quote "The decline in the concentrations of fructose and glucose was underestimated by the model (50 mM measured compared to 100 mM predicted)" ;
            mkg:text "The improved model underpredicted the decline of glucose and fructose in experiments starting at about 150 mM, where measured concentrations fell by about 50 mM compared with about 100 mM predicted." ;
            mkg:topic "limitations" ],
        [ mkg:basis "stated" ;
            mkg:quote "for each model (i.e., initial and improved), k parameter identifications were performed (each relying on 3 experiments) with the performance measures estimated on the corresponding test set." ;
            mkg:text "The improved model was evaluated by four-fold cross-validation, fitting each fold on three experiments and testing it on the remaining experiment." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "they were assumed known in the context of this study to limit the model complexity and avoid overfitting and their values were set to 10% of the starting concentrations." ;
            mkg:text "The minimum ammonium and phosphate concentrations for growth were treated as known, set to 10% of their starting concentrations, rather than estimated." ;
            mkg:topic "size" ],
        [ mkg:basis "inferred" ;
            mkg:text "The initial model fit biomass up to about 8 g L⁻¹ dry mass but underestimated growth above that density when nutrients approached zero." ;
            mkg:topic "limitations" ],
        [ mkg:basis "stated" ;
            mkg:quote "we applied a Monod-type unstructured segregated model" ;
            mkg:text "The model is described as unstructured, segregated, and Monod-type, separating active and dead cell dry mass without resolving intracellular metabolism." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "we confirmed that a 25% reduction in the concentration of sucrose can increase the volumetric biomass yield by 13%" ;
            mkg:text "The authors report that reducing the sucrose concentration by 25% increased volumetric biomass yield by 13%." ;
            mkg:topic "performance" ],
        [ mkg:basis "stated" ;
            mkg:quote "In experiments #1-7 carbohydrates were provided as 88 mM sucrose whereas it was 151 mM fructose in #8 and 151 mM glucose in #9." ;
            mkg:text "Experiments #8 and #9 replaced sucrose with fructose or glucose, respectively, each at an initial concentration of 151 mM." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "accommodating the hydrolysis of sucrose into fructose and glucose" ;
            mkg:text "The model represents sucrose hydrolysis into glucose and fructose and includes uptake of the resulting monosaccharides." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "the shortest t* (i.e., 102 h) is obtained with the highest initial DM concentration (1.5 g L⁻¹)" ;
            mkg:text "The Pareto front predicted that the shortest process time was about 102 h at the highest tested inoculum dry mass of 1.5 g L⁻¹, while maximum active-biomass yield was about 27.9 at 88 mM sucrose and 0.3 g L⁻¹ inoculum dry mass." ;
            mkg:topic "optimization" ],
        [ mkg:basis "stated" ;
            mkg:quote "because one mole of sucrose always produces one mole each of glucose and fructose (Puad et al., 2017)." ;
            mkg:text "The fixed stoichiometric sucrose conversion coefficients were based on the sugar-uptake model of Puad et al. 2017." ;
            mkg:topic "prior work" ],
        [ mkg:basis "stated" ;
            mkg:quote "The feed medium was of the same composition as the batch medium but contained 59 mM (or 20 g L⁻¹) instead of 88 mM (or 30 g L⁻¹) sucrose." ;
            mkg:text "The feed medium matched the batch medium except that it contained 59 mM sucrose rather than 88 mM." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "A 5-L bioreactor was used in the initial experiments (#1-3) for model setup, whereas 2-L reactors were used for validation experiments (#4-9)." ;
            mkg:text "The cultures were run in 2-L or 5-L stirred-tank reactors, with runs #1–3 in 5-L reactors and runs #4–9 in 2-L reactors." ;
            mkg:topic "reactor" ],
        [ mkg:basis "stated" ;
            mkg:quote "The CI for parameter estimates was processed using a residual-based non-parametric bootstrap resampling approach" ;
            mkg:text "Parameter confidence intervals were estimated using residual-based non-parametric bootstrap resampling, with approximately 1,000 resampled error-matrix sets." ;
            mkg:topic "calibration" ],
        [ mkg:basis "stated" ;
            mkg:quote "Process samples were taken for subsequent analysis every 22–26 h (simultaneously with draining during the semi-continuous phase)." ;
            mkg:text "Process samples were collected every 22–26 h, alongside draining during the semi-continuous phase." ;
            mkg:topic "measurements" ],
        [ mkg:basis "stated" ;
            mkg:quote "including them as factors would have zeroed out the growth rate for times >90 h as the phosphate concentration approaches zero, which did not agree with experimental observations" ;
            mkg:text "The model does not use extracellular phosphate as a multiplicative growth limitation because phosphate became nearly depleted while biomass continued to increase." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "inferred" ;
            mkg:text "The multi-criteria optimization varied starting sucrose from 17 to 88 mM and inoculum dry mass from 0.3 to 1.5 g L⁻¹ to trade off biomass yield against process time." ;
            mkg:topic "optimization" ],
        [ mkg:basis "stated" ;
            mkg:quote "The weighted sum method identified the convex portion of the Pareto front whereas the ε-constraint method identified the remaining (non-convex) section of the front" ;
            mkg:text "The authors used weighted-sum and epsilon-constraint scalarization to identify convex and non-convex sections of the Pareto front." ;
            mkg:topic "optimization" ],
        [ mkg:basis "stated" ;
            mkg:quote "Also, glucose seemed to be preferred over fructose as a carbon source" ;
            mkg:text "The model suggested glucose could support growth better than fructose, and the authors report qualitative confirmation in experiments #8 and #9." ;
            mkg:topic "performance" ],
        [ mkg:basis "inferred" ;
            mkg:text "The improved model's average normalized test error for sucrose was 0.153, compared with 0.198 for the initial model." ;
            mkg:topic "performance" ],
        [ mkg:basis "stated" ;
            mkg:quote "For the dry mass (DM), the weighing dish with the BY-2 pellet was dried at 60°C for 3 days and weighed again." ;
            mkg:text "Dry mass was measured by filtering a 5.0-mL sample and drying the cell pellet at 60°C for 3 days." ;
            mkg:topic "measurements" ],
        [ mkg:basis "stated" ;
            mkg:quote "The feed phase was initiated at a FM of 100 g L⁻¹ and this FM concentration was maintained by adding fresh medium." ;
            mkg:text "The process began as a batch and entered a semi-continuous feed phase at about 100 g L⁻¹ fresh mass, which was maintained by adding fresh medium." ;
            mkg:topic "operation" ] ;
    mkg:status "pending" ;
