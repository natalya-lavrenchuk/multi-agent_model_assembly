<http://example.org/kg/nausch_2023/law/nausch_2023_eq20_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The glucose balance adds glucose produced by sucrose hydrolysis and subtracts glucose consumed by active cells, accounting for changes in cultivation volume." ;
    mkg:doi "10.3389/fpls.2023.1183254" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "The sucrose to glucose or fructose DM conversion parameters ( $ m_{SG} $ and $ m_{SF} $) were set at 0.526 because one mole of sucrose always produces one mole each of glucose and fructose" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The sucrose-to-glucose conversion parameter was fixed at 0.526." ] ;
    mkg:page "11" ;
    mkg:possibleMisprint "G is listed in mM while K_G and K_{IG} are in g L⁻¹, and the balance equates a left-hand side in mM·L per time with source and consumption terms in mass per time because m_{SG} is dimensionless and X_a is in g L⁻¹." ;
    mkg:quote "\\begin{align*}V\\frac{dG}{dt}+G\\frac{dV}{dt}&=m_{SG}\\alpha\\Bigg(\\frac{S}{S+K_{S}}\\frac{K_{IS}}{S+K_{IS}}\\Bigg)X_{a}V\\\\&\\quad-\\mu_{G}\\Bigg(\\frac{G}{G+K_{G}}\\frac{K_{IG}}{G+K_{IG}}\\Bigg)X_{a}V\\end{align*}" ;
    mkg:reviewOutcome "false alarm" ;
    mkg:status "pending" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq2_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Active dry biomass changes through growth and death in the cultivation medium." ;
    mkg:doi "10.3389/fpls.2023.1183254" ;
    mkg:form "ODE" ;
    mkg:page "5" ;
    mkg:quote "V\\frac{dX_{a}}{dt}+X_{a}\\frac{dV}{dt}=\\mu X_{a}V-k_{d}X_{a}V" ;
    mkg:status "pending" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq3> a mkg:Law ;
    rdfs:label "nausch_2023 eq 3"@en ;
    mkg:computes <http://example.org/kg/nausch_2023/law/nausch_2023_eq3/var/V> ;
    mkg:equationNumber "3" ;
    mkg:hasMetadata <http://example.org/kg/nausch_2023/law/nausch_2023_eq3_meta> ;
