@prefix kg: <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/> .
@prefix mkg: <http://example.org/mkg#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/kg/osberghaus_2012_kinetic_sma/osberghaus_2012_kinetic_sma> a mkg:Sup ;
    rdfs:label "osberghaus_2012_kinetic_sma · Determination of parameters for the steric mass action model—A comparison between two approaches (Kinetic SMA)"@en ;
    mkg:hasMetadata <http://example.org/kg/osberghaus_2012_kinetic_sma/osberghaus_2012_kinetic_sma_meta> ;
    mkg:includes <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq1>,
        <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq2>,
        <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq3>,
        <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq7>,
        <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq8> .

kg:osberghaus_2012_rapid_equilibrium_sma a mkg:Sup ;
    rdfs:label "osberghaus_2012_rapid_equilibrium_sma · Determination of parameters for the steric mass action model—A comparison between two approaches (Rapid-equilibrium SMA)"@en ;
    mkg:hasMetadata kg:osberghaus_2012_rapid_equilibrium_sma_meta ;
    mkg:includes <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq1>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq2>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq3>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq4>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq7>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq8> .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq1> a mkg:Law ;
    rdfs:label "osberghaus_2012 eq 1"@en ;
    mkg:computes <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq1/var/q_i> ;
    mkg:equationNumber "1" ;
    mkg:hasMetadata <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq1_meta> ;
    mkg:hasParameter <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq1/par/k_ads_i>,
        <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq1/par/k_des_i>,
        <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq1/par/nu_i> ;
    mkg:latex "\\frac{\\partial q_{i}}{\\partial t}=k_{a d s,i}c_{i}\\overline{{q_{1}}}^{\\nu_{i}}-k_{d e s,i}c_{1}^{\\nu_{i}}q_{i}\\quad i>1" ;
    mkg:uses <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq1/var/c_1>,
        <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq1/var/c_i>,
        <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq1/var/overline_q_1> .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq1/par/k_ads_i> a mkg:Parameter ;
    rdfs:label "k_{ads,i} (osberghaus_2012 eq 1)"@en ;
    mkg:basis "stated" ;
    mkg:description "Adsorption coefficient of component i." ;
    mkg:page "2" ;
    mkg:quote "$ k_{ads} $ and $ k_{des} $ (ad- and desorption coefficient)" ;
    mkg:reason "It is an adsorption coefficient, a constant of the SMA law." ;
    mkg:status "accepted" ;
    mkg:symbol "k_{ads,i}" ;
    mkg:unitString "mM^{-ν}" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq1/par/k_des_i> a mkg:Parameter ;
    rdfs:label "k_{des,i} (osberghaus_2012 eq 1)"@en ;
    mkg:basis "stated" ;
    mkg:description "Desorption coefficient of component i." ;
    mkg:page "2" ;
    mkg:quote "$ k_{ads} $ and $ k_{des} $ (ad- and desorption coefficient)" ;
    mkg:reason "It is a desorption coefficient, a constant of the SMA law." ;
    mkg:status "accepted" ;
    mkg:symbol "k_{des,i}" ;
    mkg:unitString "s mM^{-ν}" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq1/par/nu_i> a mkg:Parameter ;
    rdfs:label "\\nu_{i} (osberghaus_2012 eq 1)"@en ;
    mkg:basis "stated" ;
    mkg:description "Characteristic charge of component i: average number of binding sites of the component." ;
    mkg:dimension "dimensionless" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "The SMA parameters that were estimated by the inverse method are given in Table 2." ;
    mkg:page "2" ;
    mkg:quote "$ \\nu $ (characteristic charge): average number of binding sites of the component (under the assumption of a single charged counterion)" ;
    mkg:reason "It is a characteristic charge, a constant of the SMA law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "\\nu_{i}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" ;
    mkg:valuesByCase "{\"ribonuclease A, pH 5\": \"5.42 ± 0.09\", \"ribonuclease A, pH 7\": \"3.25 ± 0.008\", \"cytochrome c, pH 5\": \"5.3 ± 0.03\", \"cytochrome c, pH 7\": \"4.09 ± 0.009\", \"lysozyme, pH 5\": \"5.07 ± 0.004\", \"lysozyme, pH 7\": \"4.72 ± 0.01\"}" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq1/var/c_1> a mkg:Variable ;
    rdfs:label "c_{1} (osberghaus_2012 eq 1)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Concentration of salt component 1 in the mobile phase." ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:reason "It is the mobile-phase salt concentration used in the desorption term, a run concentration input." ;
    mkg:siFactor 1e+03 ;
    mkg:status "accepted" ;
    mkg:symbol "c_{1}" ;
    mkg:unit "M" ;
    mkg:unitString "M" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq1/var/c_i> a mkg:Variable ;
    rdfs:label "c_{i} (osberghaus_2012 eq 1)"@en ;
    mkg:description "Concentration of component i in the mobile phase on column level." ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:measured true ;
    mkg:measuredQuote "the chromatogram monitored at column outlet at the points in time" ;
    mkg:siFactor 1e+03 ;
    mkg:symbol "c_{i}" ;
    mkg:unit "M" ;
    mkg:unitString "M" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq1/var/overline_q_1> a mkg:Variable ;
    rdfs:label "\\overline{q_1} (osberghaus_2012 eq 1)"@en ;
    mkg:description "Concentration of bound salt ions available for exchange with the protein." ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:siFactor 1e+03 ;
    mkg:symbol "\\overline{q_1}" ;
    mkg:unit "M" ;
    mkg:unitString "M" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq1/var/q_i> a mkg:Variable ;
    rdfs:label "q_{i} (osberghaus_2012 eq 1)"@en ;
    mkg:description "Concentration of component i on the adsorbent surface." ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:siFactor 1e+03 ;
    mkg:symbol "q_{i}" ;
    mkg:unit "M" ;
    mkg:unitString "M" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq1_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The SMA surface-binding rate for each protein component balances adsorption from the mobile phase with desorption back to it." ;
    mkg:doi "10.1016/j.chroma.2012.02.004" ;
    mkg:form "PDE" ;
    mkg:hasAssumption [ mkg:quote "i>1" ;
            mkg:reasoned false ;
            mkg:text "i>1" ] ;
    mkg:page "2" ;
    mkg:quote "\\frac{\\partial q_{i}}{\\partial t}=k_{a d s,i}c_{i}\\overline{{q_{1}}}^{\\nu_{i}}-k_{d e s,i}c_{1}^{\\nu_{i}}q_{i}\\quad i>1" ;
    mkg:status "pending" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq2> a mkg:Law ;
    rdfs:label "osberghaus_2012 eq 2"@en ;
    mkg:computes <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq2/var/Lambda> ;
    mkg:equationNumber "2" ;
    mkg:hasMetadata <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq2_meta> ;
    mkg:hasParameter <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq2/par/nu_i> ;
    mkg:latex "\\Lambda=q_{1}+\\sum_{i=2}^{n}\\nu_{i}q_{i}" ;
    mkg:uses <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq2/var/q_1>,
        <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq2/var/q_i> .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq2/par/nu_i> a mkg:Parameter ;
    rdfs:label "\\nu_{i} (osberghaus_2012 eq 2)"@en ;
    mkg:basis "stated" ;
    mkg:description "Characteristic charge of component i: average number of binding sites of the component." ;
    mkg:dimension "dimensionless" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "The SMA parameters that were estimated by the inverse method are given in Table 2." ;
    mkg:page "2" ;
    mkg:quote "$ \\nu $ (characteristic charge): average number of binding sites of the component (under the assumption of a single charged counterion)" ;
    mkg:reason "It is a characteristic charge, a constant of the SMA law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "\\nu_{i}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" ;
    mkg:valuesByCase "{\"ribonuclease A, pH 5\": \"5.42 ± 0.09\", \"ribonuclease A, pH 7\": \"3.25 ± 0.008\", \"cytochrome c, pH 5\": \"5.3 ± 0.03\", \"cytochrome c, pH 7\": \"4.09 ± 0.009\", \"lysozyme, pH 5\": \"5.07 ± 0.004\", \"lysozyme, pH 7\": \"4.72 ± 0.01\"}" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq2/var/Lambda> a mkg:Variable ;
    rdfs:label "\\Lambda (osberghaus_2012 eq 2)"@en ;
    mkg:description "Parameter describing the ionic capacity of the adsorbent." ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "\\Lambda" ;
    mkg:unit "mM" ;
    mkg:unitString "mM" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq2/var/q_1> a mkg:Variable ;
    rdfs:label "q_{1} (osberghaus_2012 eq 2)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Total salt ion concentration in the bound phase." ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:page "2" ;
    mkg:quote "the total salt ion concentration $q_1$" ;
    mkg:reason "It is a bound salt-ion concentration that varies as salt and proteins occupy the available binding sites." ;
    mkg:siFactor 1e+03 ;
    mkg:status "accepted" ;
    mkg:symbol "q_{1}" ;
    mkg:unit "M" ;
    mkg:unitString "M" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq2/var/q_i> a mkg:Variable ;
    rdfs:label "q_{i} (osberghaus_2012 eq 2)"@en ;
    mkg:description "Concentration of component i on the adsorbent surface." ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:siFactor 1e+03 ;
    mkg:symbol "q_{i}" ;
    mkg:unit "M" ;
    mkg:unitString "M" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq2_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The adsorbent ionic-capacity relation equates bound salt and charge-weighted bound protein to the total ionic capacity." ;
    mkg:doi "10.1016/j.chroma.2012.02.004" ;
    mkg:form "algebraic" ;
    mkg:page "2" ;
    mkg:quote "\\Lambda=q_{1}+\\sum_{i=2}^{n}\\nu_{i}q_{i}" ;
    mkg:status "flagged" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq3> a mkg:Law ;
    rdfs:label "osberghaus_2012 eq 3"@en ;
    mkg:computes <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq3/var/overline_q_1> ;
    mkg:equationNumber "3" ;
    mkg:hasMetadata <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq3_meta> ;
    mkg:hasParameter <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq3/par/sigma_i> ;
    mkg:latex "\\overline{q_{1}}=q_{1}-\\sum_{i=2}^{n}\\sigma_{i}q_{i}" ;
    mkg:uses <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq3/var/q_1>,
        <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq3/var/q_i> .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq3/par/sigma_i> a mkg:Parameter ;
    rdfs:label "\\sigma_{i} (osberghaus_2012 eq 3)"@en ;
    mkg:basis "stated" ;
    mkg:description "Steric factor of component i." ;
    mkg:dimension "dimensionless" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "The SMA parameters that were estimated by the inverse method are given in Table 2." ;
    mkg:page "11" ;
    mkg:quote "steric factor of component i" ;
    mkg:reason "It is a steric factor, a constant of the SMA law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "\\sigma_{i}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" ;
    mkg:valuesByCase "{\"ribonuclease A, pH 5\": \"28.5 ± 2.2\", \"ribonuclease A, pH 7\": \"57.6 ± 0.24\", \"cytochrome c, pH 5\": \"29.8 ± 0.15\", \"cytochrome c, pH 7\": \"53.8 ± 0.28\", \"lysozyme, pH 5\": \"31.2 ± 0.19\", \"lysozyme, pH 7\": \"38.75 ± 0.74\"}" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq3/var/overline_q_1> a mkg:Variable ;
    rdfs:label "\\overline{q_1} (osberghaus_2012 eq 3)"@en ;
    mkg:description "Concentration of bound salt ions available for exchange with the protein." ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:siFactor 1e+03 ;
    mkg:symbol "\\overline{q_1}" ;
    mkg:unit "M" ;
    mkg:unitString "M" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq3/var/q_1> a mkg:Variable ;
    rdfs:label "q_{1} (osberghaus_2012 eq 3)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Total salt ion concentration in the bound phase." ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:page "2" ;
    mkg:quote "the total salt ion concentration $q_1$" ;
    mkg:reason "It is a bound salt-ion concentration that varies as salt and proteins occupy the available binding sites." ;
    mkg:siFactor 1e+03 ;
    mkg:status "accepted" ;
    mkg:symbol "q_{1}" ;
    mkg:unit "M" ;
    mkg:unitString "M" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq3/var/q_i> a mkg:Variable ;
    rdfs:label "q_{i} (osberghaus_2012 eq 3)"@en ;
    mkg:description "Concentration of component i on the adsorbent surface." ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:siFactor 1e+03 ;
    mkg:symbol "q_{i}" ;
    mkg:unit "M" ;
    mkg:unitString "M" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq3_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The concentration of bound salt available for protein exchange is total bound salt minus the salt shielded by bound proteins." ;
    mkg:doi "10.1016/j.chroma.2012.02.004" ;
    mkg:form "algebraic" ;
    mkg:page "2" ;
    mkg:quote "\\overline{q_{1}}=q_{1}-\\sum_{i=2}^{n}\\sigma_{i}q_{i}" ;
    mkg:status "flagged" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq7> a mkg:Law ;
    rdfs:label "osberghaus_2012 eq 7"@en ;
    mkg:computes <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq7/var/c_i> ;
    mkg:equationNumber "7" ;
    mkg:hasMetadata <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq7_meta> ;
    mkg:hasParameter <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq7/par/D_ax>,
        <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq7/par/k_eff_i>,
        <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq7/par/r_p>,
        <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq7/par/varepsilon_c> ;
    mkg:latex "\\frac{\\partial c_{i}}{\\partial t}=-u_{i n t}\\frac{\\partial c_{i}}{\\partial x}+D_{a x}\\frac{\\partial^{2}c_{i}}{\\partial x^{2}}-\\frac{1-\\varepsilon_{c}}{\\varepsilon_{c}}\\cdot\\frac{3}{r_{p}}k_{e f f,i}[c_{i}-c_{p,i}]" ;
    mkg:uses <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq7/var/c_p_i>,
        <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq7/var/u_int> .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq7/par/D_ax> a mkg:Parameter ;
    rdfs:label "D_{ax} (osberghaus_2012 eq 7)"@en ;
    mkg:basis "stated" ;
    mkg:description "Axial dispersion coefficient." ;
    mkg:dimension "[length] ** 2 / [time]" ;
    mkg:page "11" ;
    mkg:quote "axial dispersion" ;
    mkg:reason "Axial dispersion is a packed-bed transport property calculated from tracer-pulse data, not an operating condition." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "D_{ax}" ;
    mkg:unit "m ** 2 / s" ;
    mkg:unitString "m^2 s^-1" ;
    mkg:value 1.574e-10 ;
    mkg:valueUncertainty "about 1.75% relative standard deviation" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq7/par/k_eff_i> a mkg:Parameter ;
    rdfs:label "k_{eff,i} (osberghaus_2012 eq 7)"@en ;
    mkg:basis "stated" ;
    mkg:description "Effective film transfer coefficient for component i." ;
    mkg:dimension "[length] / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "The lumped film diffusion coefficient $ k_{eff} $ was estimated to be $ 1.5 \\times 10^{-6} $ m/s by the inverse fit of the mechanistic model to the tracer peaks from the pulse experiments described in the next section." ;
    mkg:page "11" ;
    mkg:quote "effective film transfer coefficient for component i" ;
    mkg:reason "The effective film transfer coefficient is a fitted mass-transfer coefficient of the system, not an operating condition." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "k_{eff,i}" ;
    mkg:unit "m / s" ;
    mkg:unitString "m/s" ;
    mkg:value 1.5e-06 .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq7/par/r_p> a mkg:Parameter ;
    rdfs:label "r_{p} (osberghaus_2012 eq 7)"@en ;
    mkg:basis "stated" ;
    mkg:description "Particle radius." ;
    mkg:dimension "[length]" ;
    mkg:page "11" ;
    mkg:quote "particle radius" ;
    mkg:reason "Particle radius is a particle geometry property, not an operating condition." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "r_{p}" ;
    mkg:unit "m" ;
    mkg:unitString "m" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq7/par/varepsilon_c> a mkg:Parameter ;
    rdfs:label "\\varepsilon_{c} (osberghaus_2012 eq 7)"@en ;
    mkg:basis "stated" ;
    mkg:description "Column porosity." ;
    mkg:dimension "dimensionless" ;
    mkg:page "3" ;
    mkg:quote "column porosity" ;
    mkg:reason "Column porosity is a packed-bed physical property, not an operating condition." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "\\varepsilon_{c}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" ;
    mkg:value 3.6e-01 ;
    mkg:valueUncertainty "± 0.0009" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq7/var/c_i> a mkg:Variable ;
    rdfs:label "c_{i} (osberghaus_2012 eq 7)"@en ;
    mkg:description "Concentration of component i in the mobile phase on column level." ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:measured true ;
    mkg:measuredQuote "the chromatogram monitored at column outlet at the points in time" ;
    mkg:siFactor 1e+03 ;
    mkg:symbol "c_{i}" ;
    mkg:unit "M" ;
    mkg:unitString "M" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq7/var/c_p_i> a mkg:Variable ;
    rdfs:label "c_{p,i} (osberghaus_2012 eq 7)"@en ;
    mkg:description "Concentration of component i in the mobile phase on particle level." ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:siFactor 1e+03 ;
    mkg:symbol "c_{p,i}" ;
    mkg:unit "M" ;
    mkg:unitString "M" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq7/var/u_int> a mkg:Variable ;
    rdfs:label "u_{int} (osberghaus_2012 eq 7)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Interstitial velocity." ;
    mkg:dimension "[length] / [time]" ;
    mkg:page "3" ;
    mkg:quote "interstitial velocity" ;
    mkg:reason "Interstitial velocity is an operating flow quantity supplied to the transport equation, rather than a fitted material or system property." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "u_{int}" ;
    mkg:unit "m / s" ;
    mkg:unitString "m/s" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq7_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The column-scale concentration balance combines axial convection and dispersion with film transfer between the column fluid and the particles." ;
    mkg:doi "10.1016/j.chroma.2012.02.004" ;
    mkg:form "PDE" ;
    mkg:page "3" ;
    mkg:quote "\\frac{\\partial c_{i}}{\\partial t}=-u_{i n t}\\frac{\\partial c_{i}}{\\partial x}+D_{a x}\\frac{\\partial^{2}c_{i}}{\\partial x^{2}}-\\frac{1-\\varepsilon_{c}}{\\varepsilon_{c}}\\cdot\\frac{3}{r_{p}}k_{e f f,i}[c_{i}-c_{p,i}]" ;
    mkg:status "pending" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq8> a mkg:Law ;
    rdfs:label "osberghaus_2012 eq 8"@en ;
    mkg:computes <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq8/var/c_p_i> ;
