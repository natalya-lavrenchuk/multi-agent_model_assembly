        <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq8/par/r_p>,
        <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq8/par/varepsilon_p> ;
    mkg:latex "\\frac{\\partial c_{p,i}}{\\partial t}=\\frac{3}{\\varepsilon_{p}r_{p}}k_{e f f,i}[c_{i}-c_{p,i}]-\\frac{1-\\varepsilon_{p}}{\\varepsilon_{p}}\\frac{\\partial q_{i}}{\\partial t}" ;
    mkg:uses <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq8/var/c_i>,
        <http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq8/var/q_i> .

