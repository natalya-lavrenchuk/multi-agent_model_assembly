<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq4_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The rapid-equilibrium SMA isotherm computes a component’s equilibrium coefficient from its bound and mobile concentrations, salt concentration, and remaining binding capacity." ;
    mkg:doi "10.1016/j.chroma.2012.02.004" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "i>1" ;
            mkg:reasoned false ;
            mkg:text "i>1" ] ;
    mkg:page "3" ;
    mkg:quote "k_{i,e q}=\\left(\\frac{q_{i}}{c_{i}}\\right)\\left(\\frac{c_{1}}{\\Lambda-\\sum_{i=2}^{n}(\\nu_{i}+\\sigma_{i})q_{i}}\\right)^{\\nu_{i}}\\quad i>1" ;
    mkg:status "flagged" .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq7> a mkg:Law ;
    rdfs:label "osberghaus_2012 eq 7"@en ;
    mkg:computes <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq7/var/c_i> ;
    mkg:equationNumber "7" ;
    mkg:hasMetadata <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq7_meta> ;
    mkg:hasParameter <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq7/par/D_ax>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq7/par/k_eff_i>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq7/par/r_p>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq7/par/varepsilon_c> ;
    mkg:latex "\\frac{\\partial c_{i}}{\\partial t}=-u_{i n t}\\frac{\\partial c_{i}}{\\partial x}+D_{a x}\\frac{\\partial^{2}c_{i}}{\\partial x^{2}}-\\frac{1-\\varepsilon_{c}}{\\varepsilon_{c}}\\cdot\\frac{3}{r_{p}}k_{e f f,i}[c_{i}-c_{p,i}]" ;
    mkg:uses <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq7/var/c_p_i>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq7/var/u_int> .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq7/par/D_ax> a mkg:Parameter ;
    rdfs:label "D_{ax} (osberghaus_2012 eq 7)"@en ;
    mkg:basis "stated" ;
    mkg:description "Axial dispersion coefficient." ;
    mkg:dimension "[length] ** 2 / [time]" ;
    mkg:page "11" ;
    mkg:quote "axial dispersion" ;
    mkg:reason "Axial dispersion is a packed-bed transport property calculated from tracer-pulse data, not an operating condition." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "D_{ax}" ;
    mkg:unit "m ** 2 / s" ;
    mkg:unitString "m^2 s^-1" ;
    mkg:value 1.574e-10 ;
    mkg:valueUncertainty "about 1.75% relative standard deviation" .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq7/par/k_eff_i> a mkg:Parameter ;
