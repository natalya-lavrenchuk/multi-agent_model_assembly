<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq8_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The particle-scale mobile-phase concentration balance combines film transfer from the column fluid with exchange between the mobile and bound phases." ;
    mkg:doi "10.1016/j.chroma.2012.02.004" ;
    mkg:form "PDE" ;
    mkg:page "3" ;
    mkg:quote "\\frac{\\partial c_{p,i}}{\\partial t}=\\frac{3}{\\varepsilon_{p}r_{p}}k_{e f f,i}[c_{i}-c_{p,i}]-\\frac{1-\\varepsilon_{p}}{\\varepsilon_{p}}\\frac{\\partial q_{i}}{\\partial t}" ;
    mkg:status "pending" .

kg:osberghaus_2012_rapid_equilibrium_sma_meta a mkg:Metadata ;
    mkg:completeModel false ;
    mkg:description "The rapid-equilibrium steric mass action model represents protein binding and elution during strong cation-exchange chromatography. It predicts protein retention and outlet chromatograms by combining column transport, particle mass transfer, and SMA sorption, which represents competition between salt ions and proteins for binding capacity as well as protein shielding of binding sites. The paper compares estimating SMA parameters from gradient and breakthrough experiments with estimating them by inverse fitting of a mechanistic column model. Experiments used ribonuclease A, cytochrome c, and lysozyme on a prepacked 1 ml SP Sepharose FF column at pH 5 and pH 7. The authors use the comparison and noise analysis to assess parameter reliability and prediction, and recommend inverse fitting for process development because it predicts complete chromatograms." ;
    mkg:doi "10.1016/j.chroma.2012.02.004" ;
    mkg:form "PDE/algebraic" ;
    mkg:hasAssumption [ mkg:quote "If the assumption of a rapid equilibrium is valid" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Rapid equilibrium is assumed." ] ;
    mkg:hasFact [ mkg:basis "stated" ;
            mkg:quote "The approach based on an inverse method and the mechanistic model has the advantage that not only retention times but also complete elution profiles can be predicted." ;
            mkg:text "Approach I predicts retention using an empirical correlation, whereas the inverse mechanistic approach can predict complete chromatograms." ;
            mkg:topic "prediction" ],
        [ mkg:basis "stated" ;
            mkg:quote "This step was followed by another wash step with 4 cv running buffer. Afterwards, a linear gradient from 0% to 100% high salt buffer was set to elute the protein." ;
            mkg:text "After sample loading and a further four column volumes of washing, proteins were eluted with a linear gradient from 0% to 100% high-salt buffer." ;
            mkg:topic "feeding" ],
        [ mkg:basis "stated" ;
            mkg:quote "Let now θfix be the set of all model input parameters that are fixed on a constant value and θest the set of model input parameters that can be manipulated by the algorithm solving the inverse problem" ;
            mkg:text "The inverse fit estimates the three protein-specific SMA parameters while treating other model inputs as fixed." ;
            mkg:topic "parameters" ],
        [ mkg:basis "stated" ;
            mkg:quote "Prepacked HiTrap SP Sepharose FF 1 ml columns [0.025 m length, 0.7E–2 m ID] from GE Healthcare" ;
            mkg:text "All column experiments used a prepacked 1 ml HiTrap SP Sepharose FF strong cation-exchange column measuring 0.025 m long and 0.7 cm in internal diameter." ;
            mkg:topic "equipment" ],
        [ mkg:basis "stated" ;
            mkg:quote "The fit of the model response to the gradient elution data is for most of the datasets at both pH-conditions highly precise" ;
            mkg:text "The inverse method produced highly precise fits for most gradient datasets at both pH conditions." ;
            mkg:topic "fit" ],
        [ mkg:basis "stated" ;
            mkg:quote "For the solution of the whole differential-algebraic equation system, Danckwert's boundary conditions were employed" ;
            mkg:text "The model solves a differential-algebraic equation system with Danckwerts boundary conditions." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "with qi denoting the concentration of particle-bound component i" ;
            mkg:text "The model tracks mobile-phase concentrations at column and particle levels and component concentrations bound to the particle surface." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "absolute values for SMA parameters are not only dependent on the examined protein and the pH value, but in the same way on the adsorbent and column properties like bed geometry or porosity." ;
            mkg:text "The paper notes that SMA parameter values reported by different studies can vary with protein, pH, adsorbent, column properties, and experimental approach." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "the characteristic charge ν determined by the inverse method is always higher than the value determined by approach I. Conversely, the equilibrium coefficients determined by the model-based inverse method are about ten times smaller" ;
            mkg:text "The two estimation approaches gave similar parameter order relations, although inverse estimates of characteristic charge were consistently higher and equilibrium coefficients about ten times lower." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "Apart from some outliers, the estimations for the steric factor and for the equilibrium coefficients show significantly higher mean relative deviations (about 0.5%) than the estimations for the characteristic charge (about 0.25%)" ;
            mkg:text "Multiple-start optimization indicated mean relative deviations of about 0.25% for characteristic charge estimates and about 0.5% for equilibrium-coefficient and steric-factor estimates, apart from outliers." ;
            mkg:topic "uncertainty" ],
        [ mkg:basis "stated" ;
            mkg:quote "information characterizing the packed bed" ;
            mkg:text "Packed-bed and transport inputs for the inverse model included ionic capacity, axial dispersion, interstitial velocity, porosities, film transfer, and column and particle geometry." ;
            mkg:topic "calibration" ],
        [ mkg:basis "stated" ;
            mkg:quote "The running buffer for all experiments at pH 5 was a 0.02M acetate buffer. The running buffer for all experiments at pH 7 was a 0.02M sodium phosphate buffer; the same buffers with additional 0.5 M NaCl served for elution purposes." ;
            mkg:text "The running buffer was 0.02 M acetate at pH 5 or 0.02 M sodium phosphate at pH 7, and the high-salt elution buffer contained an additional 0.5 M NaCl." ;
            mkg:topic "operation" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper identifies Matlab and Unicorn software used in the work but does not report a public code or data repository." ;
            mkg:topic "availability" ],
        [ mkg:basis "stated" ;
            mkg:quote "Approach I: estimation of SMA parameters based on gradient and frontal experiments according to instructions in [14,16]." ;
            mkg:text "The first approach derived SMA parameters from gradient retention data and frontal breakthrough data using the procedure of Brooks and Cramer (1992) and Shukla et al. (1998)." ;
            mkg:topic "calibration" ],
        [ mkg:basis "stated" ;
            mkg:quote "For the determination of external information in approach I and approach II (εc, εp, εt, the column, particle and total porosity, Λ, the ionic capacity of the column, Dax, the axial dispersion coefficient and V0, the breakthrough volume of a non-retarded species), pulse and displacement experiments were performed according to instructions in [11,26]. All experiments were at least three times repeated for a check of reproducibility and variances." ;
            mkg:text "External bed parameters were characterized using pulse and displacement experiments, with each experiment repeated at least three times." ;
            mkg:topic "calibration" ],
        [ mkg:basis "inferred" ;
            mkg:text "The lumped film-transfer coefficient was estimated by inverse fitting the mechanistic model to tracer peaks from pulse experiments." ;
            mkg:topic "calibration" ],
        [ mkg:basis "stated" ;
            mkg:quote "Based on Eqs. (5) and (6), on the five chromatograms at 5 cv, 10 cv, 30 cv, 60 cv and 120 cv and the breakthrough curve for every single protein, SMA parameters were determined for pH 5 and pH 7." ;
            mkg:text "Each protein and pH condition had five gradient chromatograms and a corresponding breakthrough experiment available for parameter determination." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "every component interacting with the particle surface owns four characterizing parameters (three in case of a rapid equilibrium assumption)" ;
            mkg:text "Each protein is characterized by three SMA parameters under the rapid-equilibrium formulation: characteristic charge, equilibrium coefficient, and steric factor." ;
            mkg:topic "parameters" ],
        [ mkg:basis "stated" ;
            mkg:quote "the application of absolute noise to the chromatograms had nearly no influence on the SMA parameter estimations by the inverse method." ;
            mkg:text "Absolute concentration noise had nearly no influence on inverse-method SMA parameter estimates, even at the highest tested noise level." ;
            mkg:topic "sensitivity" ],
        [ mkg:basis "stated" ;
            mkg:quote "according to instructions in [14,16]" ;
            mkg:text "The paper builds its experimental SMA-parameter procedure on Brooks and Cramer (1992) and Shukla et al. (1998), and discusses the chromatography transport model in relation to von Lieres and Andersson (2010)." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "The absorption at 280 nm and 528 nm was measured online in all experiments." ;
            mkg:text "Online absorbance at 280 nm and 528 nm was measured in all experiments." ;
            mkg:topic "measurement" ],
        [ mkg:basis "inferred" ;
            mkg:text "The SMA steric correction accounts for salt ions shielded from exchange by protein-bound material." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "cytochrome c (horse heart), lysozyme (chicken egg white) and ribonuclease A (bovine pancreas)" ;
            mkg:text "The proteins were bovine-pancreas ribonuclease A, horse-heart cytochrome c, and chicken-egg-white lysozyme." ;
            mkg:topic "system" ],
        [ mkg:basis "stated" ;
            mkg:quote "with a density of 200 knots over the whole column length" ;
            mkg:text "The paper does not state a total number of model states or equations; its numerical solution used 200 knots along the column." ;
            mkg:topic "parameters" ],
        [ mkg:basis "stated" ;
            mkg:quote "On column level, the time- and position-dependent change of concentration" ;
            mkg:text "The chromatography model is a spatially distributed transport-dispersive model with column- and particle-level concentration balances." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "The determination of the parameter σ based on the previously determined parameters ν and keq and additional frontal chromatographic experiments was carried out" ;
            mkg:text "Approach I obtains the steric factor from breakthrough data after determining characteristic charge and equilibrium coefficient from gradient data." ;
            mkg:topic "calibration" ],
        [ mkg:basis "inferred" ;
            mkg:text "Retention-time shifts affected parameter estimates more strongly than concentration noise, with the steric factor most sensitive and characteristic charge least sensitive." ;
            mkg:topic "sensitivity" ],
        [ mkg:basis "stated" ;
            mkg:quote "for both approaches it could be demonstrated that they provide parameters of comparable high predictivity" ;
            mkg:text "The authors report comparable high predictivity from both parameter-estimation approaches, despite differences in their parameter values." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "The minimization of Eq. (9) was in all cases performed with the Matlab procedure lsqnonlin." ;
            mkg:text "The inverse approach estimated SMA parameters by least-squares fitting of the mechanistic model to chromatograms, using Matlab's lsqnonlin procedure." ;
            mkg:topic "calibration" ],
        [ mkg:basis "stated" ;
            mkg:quote "the inverse method for SMA parameter determination is recommended for fast process development." ;
            mkg:text "The authors recommend inverse parameter estimation for fast process development and describe the mechanistic model as useful for optimization, process control, troubleshooting, and error diagnosis." ;
            mkg:topic "use" ],
        [ mkg:basis "stated" ;
            mkg:quote "This experimental setup was executed for five different gradient lengths: 5 cv, 10 cv, 30 cv, 60 cv and 120 cv." ;
            mkg:text "The gradient lengths used to estimate parameters were 5, 10, 30, 60, and 120 column volumes." ;
            mkg:topic "feeding" ],
        [ mkg:basis "stated" ;
            mkg:quote "The observed small deviations of the model fit to the data of elution gradients with 5 cv can be attributed to kinetic effects that were neglected" ;
            mkg:text "The rapid-equilibrium model showed small deviations from data for the shortest, 5-column-volume gradients, which the authors attributed to neglected kinetic effects." ;
            mkg:topic "fit" ],
        [ mkg:basis "stated" ;
            mkg:quote "These approaches for SMA parameter determination were carried out for three proteins (ribonuclease A, cytochrome c and lysozyme) at pH 5 and pH 7." ;
            mkg:text "The case study models ion-exchange chromatography of ribonuclease A, cytochrome c, and lysozyme at pH 5 and pH 7." ;
            mkg:topic "system" ],
        [ mkg:basis "stated" ;
            mkg:quote "the first term on the right hand side describes the convective transport through the column, the second term the dispersive transport and the third term the mass transfer to the particle surface" ;
            mkg:text "The column balance represents convection, axial dispersion, and mass transfer from the mobile phase to the particle surface." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "accounts for the influence of charged modifiers and their rivalry with proteins for binding sites on the absorber surface." ;
            mkg:text "The SMA model represents competition between charged modifiers and proteins for adsorbent binding sites." ;
            mkg:topic "mechanisms" ],
        [ mkg:basis "stated" ;
            mkg:quote "At first the column was equilibrated with the running buffer for four column volumes (cv), then 20 μl of the protein solution were injected." ;
            mkg:text "For gradient runs, each protein was prepared at 0.2 mM and a 20 μl sample was injected after four column volumes of equilibration." ;
            mkg:topic "feeding" ],
        [ mkg:basis "inferred" ;
            mkg:text "The authors tested retention predictions at gradient lengths of 25, 80, and 106 column volumes for every protein at both pH conditions." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "10,000 chromatograms were simulated" ;
            mkg:text "The Monte Carlo analysis generated 10,000 chromatograms and examined concentration-noise and time-shift effects at three gradient lengths." ;
            mkg:topic "sensitivity" ],
        [ mkg:basis "inferred" ;
            mkg:text "The tested validation gradients were within the 5-to-120-column-volume calibration range, and the paper reports no predictions outside that range." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "After equilibrating the column for 10 cv with running buffer, it was isocratically loaded with a system flow rate of 2.17 × 10−4 m/s until the breakthrough was complete." ;
            mkg:text "Breakthrough experiments equilibrated the column for 10 column volumes and then loaded protein isocratically until breakthrough was complete." ;
            mkg:topic "feeding" ],
        [ mkg:basis "stated" ;
            mkg:quote "Let c(tj) be the chromatogram monitored at column outlet at the points in time" ;
            mkg:text "The inverse method fitted the mechanistic model to concentration time series derived from chromatograms measured at the column outlet." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "the experimental results from the single component experiments are superimposed" ;
            mkg:text "The gradient and breakthrough experiments were single-component protein experiments rather than mixture separations." ;
            mkg:topic "data" ],
        [ mkg:basis "stated" ;
            mkg:quote "with a system flow rate of 2.17 × 10−4 m/s [0.5 ml/min]." ;
            mkg:text "The column experiments were run at a flow rate of 0.5 ml/min." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "most of the deviances between prediction and validation are smaller than 1 ml, even for long elution gradients with 106 cv." ;
            mkg:text "Most predicted retention volumes differed from experimental validation by less than 1 ml, including predictions for 106-column-volume gradients." ;
            mkg:topic "validation" ] ;
