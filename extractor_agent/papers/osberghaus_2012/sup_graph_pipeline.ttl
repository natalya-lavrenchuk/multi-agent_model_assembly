<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq4> a mkg:Law ;
    rdfs:label "osberghaus_2012 eq 4"@en ;
    mkg:computes <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq4/var/k_i_eq> ;
    mkg:equationNumber "4" ;
    mkg:hasMetadata <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq4_meta> ;
