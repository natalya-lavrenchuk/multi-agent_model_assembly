<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq7_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The column-scale concentration balance combines axial convection and dispersion with film transfer between the column fluid and the particles." ;
    mkg:doi "10.1016/j.chroma.2012.02.004" ;
    mkg:form "PDE" ;
    mkg:page "3" ;
    mkg:quote "\\frac{\\partial c_{i}}{\\partial t}=-u_{i n t}\\frac{\\partial c_{i}}{\\partial x}+D_{a x}\\frac{\\partial^{2}c_{i}}{\\partial x^{2}}-\\frac{1-\\varepsilon_{c}}{\\varepsilon_{c}}\\cdot\\frac{3}{r_{p}}k_{e f f,i}[c_{i}-c_{p,i}]" ;
    mkg:status "pending" .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq8> a mkg:Law ;
    rdfs:label "osberghaus_2012 eq 8"@en ;
    mkg:computes <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq8/var/c_p_i> ;
    mkg:equationNumber "8" ;
    mkg:hasMetadata <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq8_meta> ;
    mkg:hasParameter <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq8/par/k_eff_i>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq8/par/r_p>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq8/par/varepsilon_p> ;
    mkg:latex "\\frac{\\partial c_{p,i}}{\\partial t}=\\frac{3}{\\varepsilon_{p}r_{p}}k_{e f f,i}[c_{i}-c_{p,i}]-\\frac{1-\\varepsilon_{p}}{\\varepsilon_{p}}\\frac{\\partial q_{i}}{\\partial t}" ;
    mkg:uses <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq8/var/c_i>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq8/var/q_i> .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq8/par/k_eff_i> a mkg:Parameter ;
    rdfs:label "k_{eff,i} (osberghaus_2012 eq 8)"@en ;
    mkg:basis "stated" ;
    mkg:description "Effective film transfer coefficient for component i." ;
    mkg:dimension "[length] / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "The lumped film diffusion coefficient $ k_{eff} $ was estimated to be $ 1.5 \\times 10^{-6} $ m/s by the inverse fit of the mechanistic model to the tracer peaks from the pulse experiments described in the next section." ;
    mkg:page "11" ;
    mkg:quote "effective film transfer coefficient for component i" ;
    mkg:reason "The effective film transfer coefficient is a fitted mass-transfer coefficient of the system, not an operating condition." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "k_{eff,i}" ;
    mkg:unit "m / s" ;
    mkg:unitString "m/s" ;
    mkg:value 1.5e-06 .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq8/par/r_p> a mkg:Parameter ;
