<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq1/var/q_i> a mkg:Variable ;
    rdfs:label "q_{i} (osberghaus_2012 eq 1)"@en ;
    mkg:description "Concentration of component i on the adsorbent surface." ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:siFactor 1e+03 ;
    mkg:symbol "q_{i}" ;
    mkg:unit "M" ;
