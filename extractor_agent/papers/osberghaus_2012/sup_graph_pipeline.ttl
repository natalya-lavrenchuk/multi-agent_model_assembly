<http://example.org/kg/osberghaus_2012_kinetic_sma/law/osberghaus_2012_eq8_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The particle-scale mobile-phase concentration balance combines film transfer from the column fluid with exchange between the mobile and bound phases." ;
    mkg:doi "10.1016/j.chroma.2012.02.004" ;
    mkg:form "PDE" ;
    mkg:page "3" ;
    mkg:quote "\\frac{\\partial c_{p,i}}{\\partial t}=\\frac{3}{\\varepsilon_{p}r_{p}}k_{e f f,i}[c_{i}-c_{p,i}]-\\frac{1-\\varepsilon_{p}}{\\varepsilon_{p}}\\frac{\\partial q_{i}}{\\partial t}" ;
    mkg:status "pending" .

<http://example.org/kg/osberghaus_2012_kinetic_sma/osberghaus_2012_kinetic_sma_meta> a mkg:Metadata ;
    mkg:completeModel false ;
    mkg:description "The model represents protein binding and transport during ion-exchange chromatography on a strong cation-exchange adsorbent. It predicts outlet chromatograms and retention times by combining column convection and axial dispersion, mass transfer between mobile and particle phases, and steric mass action (SMA) sorption. For the parameter-estimation study, the authors fitted an inverse mechanistic model using SMA parameters for ribonuclease A, cytochrome c, and lysozyme, and compared the results with parameters derived from gradient and breakthrough experiments. Experiments used a prepacked 1 ml column at pH 5 and pH 7, with salt gradients of several lengths and separate breakthrough runs. The authors recommend the inverse approach for chromatography process development because it predicts complete chromatograms and can support process optimization, troubleshooting, and error diagnosis." ;
    mkg:doi "10.1016/j.chroma.2012.02.004" ;
    mkg:form "PDE/algebraic" ;
    mkg:hasFact [ mkg:basis "stated" ;
            mkg:quote "The running buffer for all experiments at pH 5 was a 0.02M acetate buffer. The running buffer for all experiments at pH 7 was a 0.02M sodium phosphate buffer; the same buffers with additional 0.5 M NaCl served for elution purposes." ;
            mkg:text "Experiments were conducted at pH 5 in 0.02 M acetate buffer and at pH 7 in 0.02 M sodium phosphate buffer, with 0.5 M NaCl added to the elution buffer." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Only for short gradients with a length of 5 cv the model response slightly deviates from the data." ;
            mkg:text "The inverse model generally fitted the gradient-elution profiles closely, with slight deviations for the shortest, 5-column-volume gradients." ;
            mkg:topic "fit" ],
        [ mkg:basis "stated" ;
            mkg:quote "Prepacked HiTrap SP Sepharose FF 1 ml columns [0.025 m length, 0.7E–2 m ID] from GE Healthcare" ;
            mkg:text "Column experiments used prepacked HiTrap SP Sepharose FF columns with a 1 ml bed, 0.025 m length, and 0.7 cm internal diameter." ;
            mkg:topic "equipment" ],
        [ mkg:basis "stated" ;
            mkg:quote "simultaneous least-squares fits of the mechanistic model to the five chromatograms at 5 cv, 10 cv, 30 cv, 60 cv and 120 cv" ;
            mkg:text "For each protein and pH, the inverse fits used the five gradient chromatograms acquired at 5, 10, 30, 60, and 120 column volumes." ;
            mkg:topic "calibration" ],
        [ mkg:basis "stated" ;
            mkg:quote "Structured multiple start guesses at the beginning of the optimization process" ;
            mkg:text "The inverse estimates were assessed using structured multiple start guesses." ;
            mkg:topic "parameters" ],
        [ mkg:basis "stated" ;
            mkg:quote "The observed small deviations of the model fit to the data of elution gradients with 5 cv can be attributed to kinetic effects that were neglected in order to impossible the comparison of both approaches (only isothermal SMA parameters can be determined with approach I)." ;
            mkg:text "The authors attributed the short-gradient fit deviations to kinetic effects omitted to allow comparison with the isothermal conventional method." ;
            mkg:topic "fit" ],
        [ mkg:basis "stated" ;
            mkg:quote "For the solution of the whole differential-algebraic equation system, Danckwert's boundary conditions were employed" ;
            mkg:text "The column and particle balances were solved with Danckwerts boundary conditions." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "10,000 chromatograms were simulated based on the model equations" ;
            mkg:text "The Monte Carlo sensitivity study generated 10,000 chromatograms for each noise analysis." ;
            mkg:topic "sensitivity" ],
        [ mkg:basis "inferred" ;
            mkg:text "Both approaches predicted retention volumes for 25, 80, and 106 column-volume gradients, and the corresponding experiments were performed for validation." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The absorption at 280 nm and 528 nm was measured online in all experiments." ;
            mkg:text "Absorbance at 280 nm and 528 nm was measured online during all experiments." ;
            mkg:topic "measurements" ],
        [ mkg:basis "stated" ;
            mkg:quote "This experimental setup was executed for five different gradient lengths: 5 cv, 10 cv, 30 cv, 60 cv and 120 cv." ;
            mkg:text "Gradient lengths were 5, 10, 30, 60, and 120 column volumes." ;
            mkg:topic "feeding" ],
        [ mkg:basis "stated" ;
            mkg:quote "for estimating the SMA parameters θest={ν, keq,σ}" ;
            mkg:text "The inverse fit estimated three protein-specific SMA parameters: characteristic charge, equilibrium coefficient, and steric factor." ;
            mkg:topic "parameters" ],
        [ mkg:basis "stated" ;
            mkg:quote "This model was solved in MatLab on a Dual Core Processor with 2.81 GHz in approximately 10 s with a density of 200 knots over the whole column length." ;
            mkg:text "The mechanistic model was solved in Matlab on a dual-core 2.81 GHz processor in about 10 seconds using 200 knots along the column." ;
            mkg:topic "computation" ],
        [ mkg:basis "stated" ;
            mkg:quote "the first term on the right hand side describes the convective transport through the column, the second term the dispersive transport and the third term the mass transfer to the particle surface" ;
            mkg:text "The column balance represents convection, axial dispersion, and mass transfer to the particle surface." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "All experiments were at least three times repeated for a check of reproducibility and variances." ;
            mkg:text "External packed-bed information was determined using pulse and displacement experiments, with those experiments repeated at least three times to check reproducibility and variance." ;
            mkg:topic "calibration" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper identifies Matlab and Unicorn software for analysis and computation but does not state that code or experimental data are publicly available." ;
            mkg:topic "availability" ],
        [ mkg:basis "stated" ;
            mkg:quote "If the assumption of a rapid equilibrium is valid" ;
            mkg:text "The SMA formulation describes adsorption and desorption, with a rapid-equilibrium form available for isothermal sorption." ;
            mkg:topic "sorption" ],
        [ mkg:basis "stated" ;
            mkg:quote "The minimization of Eq. (9) was in all cases performed with the Matlab procedure lsqnonlin." ;
            mkg:text "The inverse approach fitted parameters by minimizing a least-squares residual with Matlab's lsqnonlin procedure." ;
            mkg:topic "parameters" ],
        [ mkg:basis "stated" ;
            mkg:quote "The determination of the parameter σ based on the previously determined parameters ν and keq and additional frontal chromatographic experiments" ;
            mkg:text "The conventional approach estimated characteristic charge and equilibrium coefficient from gradient data, then used breakthrough data to estimate the steric factor." ;
            mkg:topic "calibration" ],
        [ mkg:basis "stated" ;
            mkg:quote "SMA parameters with comparable internal relations and equal predictivity could be determined based on both methods" ;
            mkg:text "The two parameter-estimation approaches produced similar parameter order relations and comparably high predictivity, despite differences in the estimated values." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "the determination of SMA parameters will be performed based on a case study for three proteins (lysozyme, ribonuclease A and cytochrome c)" ;
            mkg:text "The model was studied for ribonuclease A, cytochrome c, and lysozyme in ion-exchange chromatography." ;
            mkg:topic "system" ],
        [ mkg:basis "stated" ;
            mkg:quote "No predictions outside the calibration range were examined, as the considered range with gradient lengths from 5 to 120 cv is very broad." ;
            mkg:text "The tested prediction gradients were inside the 5–120 column-volume calibration range; predictions outside that range were not examined." ;
            mkg:topic "validation" ],
        [ mkg:basis "stated" ;
            mkg:quote "ν (rel. std. deviation of 0.075 for peak shifts of about 50 s (0.43 ml)) is the least sensitive parameter to time-dependent shifts and σ (rel. std. deviation of almost 1.5 for peak shifts of about 50 s (0.43 ml)) the most sensitive parameter." ;
            mkg:text "Retention-time shifts affected parameter estimates more strongly than absolute concentration noise; at shifts of about 50 s, characteristic charge had a relative standard deviation of 0.075 and steric factor nearly 1.5." ;
            mkg:topic "sensitivity" ],
        [ mkg:basis "stated" ;
            mkg:quote "accounts for the influence of charged modifiers and their rivalry with proteins for binding sites on the absorber surface." ;
            mkg:text "The SMA model represents competition between charged modifiers and proteins for adsorbent binding sites." ;
            mkg:topic "sorption" ],
        [ mkg:basis "stated" ;
            mkg:quote "Recently, this method was applied more often for sorption parameter determination, for example in [20,21,4]" ;
            mkg:text "Earlier inverse methods for sorption-parameter determination are cited from Kempe et al. (1999), Titchener-Hooker et al. (2008), and Beckley et al. (2009)." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "then 20 μl of the protein solution were injected. This step was followed by another wash step with 4 cv running buffer. Afterwards, a linear gradient from 0% to 100% high salt buffer was set to elute the protein." ;
            mkg:text "Each gradient experiment injected 20 μl of protein solution at 0.2 mM after column equilibration, followed by a wash and a linear salt gradient." ;
            mkg:topic "feeding" ],
        [ mkg:basis "stated" ;
            mkg:quote "the inverse method for SMA parameter determination is recommended for fast process development." ;
            mkg:text "The authors recommend the inverse method for fast process development and propose its use for process optimization, process control, troubleshooting, and error diagnosis." ;
            mkg:topic "use" ],
        [ mkg:basis "inferred" ;
            mkg:text "Absolute concentration noise had little influence on inverse SMA parameter estimates, even at the strongest tested level of 50 mM." ;
            mkg:topic "sensitivity" ],
        [ mkg:basis "stated" ;
            mkg:quote "the steric factor σ has very similar values in both approaches, the characteristic charge ν determined by the inverse method is always higher than the value determined by approach I. Conversely, the equilibrium coefficients determined by the model-based inverse method are about ten times smaller" ;
            mkg:text "Compared with the conventional approach, the inverse method estimated higher characteristic charges and equilibrium coefficients about ten times smaller, while steric factors were similar." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "Apart from some outliers, the estimations for the steric factor and for the equilibrium coefficients show significantly higher mean relative deviations (about 0.5%) than the estimations for the characteristic charge (about 0.25%)" ;
            mkg:text "Multiple-start estimates had mean relative deviations of about 0.25% for characteristic charge and about 0.5% for steric factor and equilibrium coefficient, apart from some outliers." ;
            mkg:topic "parameters" ],
        [ mkg:basis "stated" ;
            mkg:quote "After equilibrating the column for 10 cv with running buffer, it was isocratically loaded with a system flow rate of 2.17 × 10−4 m/s until the breakthrough was complete." ;
            mkg:text "Breakthrough experiments loaded each protein isocratically until breakthrough was complete after a 10-column-volume equilibration." ;
            mkg:topic "experiments" ],
        [ mkg:basis "inferred" ;
            mkg:text "The inverse method predicts complete chromatograms, whereas the conventional approach predicts retention times." ;
            mkg:topic "prediction" ],
        [ mkg:basis "stated" ;
            mkg:quote "the steric mass action (SMA) model introduced by Brooks and Cramer [14]" ;
            mkg:text "The SMA model was introduced by Brooks and Cramer (1992), and the conventional gradient-and-frontal parameter procedure followed Brooks and Cramer (1992) and Shukla et al. (1998)." ;
            mkg:topic "comparison" ],
        [ mkg:basis "stated" ;
            mkg:quote "each fit having a coefficient of determination R2 of 0.99." ;
            mkg:text "The conventional method's fitted retention-time versus gradient-volume relationship had an R² of 0.99 for the illustrated cytochrome c data." ;
            mkg:topic "calibration" ],
        [ mkg:basis "stated" ;
            mkg:quote "On column level, the time- and position-dependent change of concentration" ;
            mkg:text "The chromatographic model is a time- and position-dependent transport-dispersive model with column-scale and particle-scale balances." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "on a prepacked 1 ml column with the strong cation exchange adsorbent SP Sepharose FF." ;
            mkg:text "The experiments used SP Sepharose FF, a strong cation-exchange adsorbent." ;
            mkg:topic "system" ],
        [ mkg:basis "stated" ;
            mkg:quote "The lumped film diffusion coefficient keff was estimated to be 1.5 × 10−6 m/s by the inverse fit of the mechanistic model to the tracer peaks from the pulse experiments" ;
            mkg:text "The lumped film diffusion coefficient was estimated by inverse fitting the mechanistic model to tracer peaks from pulse experiments." ;
            mkg:topic "calibration" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper does not state a total count of model states or equations." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "keff,i representing the lumped film diffusion coefficient" ;
            mkg:text "The model includes a lumped film diffusion coefficient for transfer to the particle surface." ;
            mkg:topic "model" ],
        [ mkg:basis "stated" ;
            mkg:quote "with a system flow rate of 2.17 × 10−4 m/s [0.5 ml/min]." ;
            mkg:text "The system flow rate was 0.5 ml/min." ;
            mkg:topic "operation" ],
        [ mkg:basis "stated" ;
            mkg:quote "most of the deviances between prediction and validation are smaller than 1 ml, even for long elution gradients with 106 cv." ;
            mkg:text "Most predicted retention-volume deviations from validation experiments were less than 1 ml, including for long gradients." ;
            mkg:topic "validation" ] ;
    mkg:status "pending" ;
    rdfs:comment "v0 distinct nodes; built from paddle.json (PaddleOCR-VL pipeline) by extractor/graph.py" .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq1> a mkg:Law ;
    rdfs:label "osberghaus_2012 eq 1"@en ;
    mkg:computes <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq1/var/q_i> ;
    mkg:equationNumber "1" ;
    mkg:hasMetadata <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq1_meta> ;
    mkg:hasParameter <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq1/par/k_ads_i>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq1/par/k_des_i>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq1/par/nu_i> ;
    mkg:latex "\\frac{\\partial q_{i}}{\\partial t}=k_{a d s,i}c_{i}\\overline{{q_{1}}}^{\\nu_{i}}-k_{d e s,i}c_{1}^{\\nu_{i}}q_{i}\\quad i>1" ;
    mkg:uses <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq1/var/c_1>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq1/var/c_i>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq1/var/overline_q_1> .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq1/par/k_ads_i> a mkg:Parameter ;
