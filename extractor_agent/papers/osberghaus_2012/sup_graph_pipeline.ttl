<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq1_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The SMA surface-binding rate for each protein component balances adsorption from the mobile phase with desorption back to it." ;
    mkg:doi "10.1016/j.chroma.2012.02.004" ;
    mkg:form "PDE" ;
    mkg:hasAssumption [ mkg:quote "i>1" ;
            mkg:reasoned false ;
            mkg:text "i>1" ] ;
    mkg:page "2" ;
    mkg:quote "\\frac{\\partial q_{i}}{\\partial t}=k_{a d s,i}c_{i}\\overline{{q_{1}}}^{\\nu_{i}}-k_{d e s,i}c_{1}^{\\nu_{i}}q_{i}\\quad i>1" ;
    mkg:status "pending" .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq2> a mkg:Law ;
    rdfs:label "osberghaus_2012 eq 2"@en ;
    mkg:computes <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq2/var/Lambda> ;
    mkg:equationNumber "2" ;
    mkg:hasMetadata <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq2_meta> ;
    mkg:hasParameter <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq2/par/nu_i> ;
    mkg:latex "\\Lambda=q_{1}+\\sum_{i=2}^{n}\\nu_{i}q_{i}" ;
    mkg:uses <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq2/var/q_1>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq2/var/q_i> .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq2/par/nu_i> a mkg:Parameter ;
    rdfs:label "\\nu_{i} (osberghaus_2012 eq 2)"@en ;
    mkg:basis "stated" ;
    mkg:description "Characteristic charge of component i: average number of binding sites of the component." ;
    mkg:dimension "dimensionless" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "The SMA parameters that were estimated by the inverse method are given in Table 2." ;
    mkg:page "2" ;
    mkg:quote "$ \\nu $ (characteristic charge): average number of binding sites of the component (under the assumption of a single charged counterion)" ;
    mkg:reason "It is a characteristic charge, a constant of the SMA law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "\\nu_{i}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" ;
    mkg:valuesByCase "{\"ribonuclease A, pH 5\": \"5.42 ± 0.09\", \"ribonuclease A, pH 7\": \"3.25 ± 0.008\", \"cytochrome c, pH 5\": \"5.3 ± 0.03\", \"cytochrome c, pH 7\": \"4.09 ± 0.009\", \"lysozyme, pH 5\": \"5.07 ± 0.004\", \"lysozyme, pH 7\": \"4.72 ± 0.01\"}" .

