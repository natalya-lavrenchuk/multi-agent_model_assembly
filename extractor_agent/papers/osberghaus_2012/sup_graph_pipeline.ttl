        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq3/var/q_i> .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq3/par/sigma_i> a mkg:Parameter ;
    rdfs:label "\\sigma_{i} (osberghaus_2012 eq 3)"@en ;
