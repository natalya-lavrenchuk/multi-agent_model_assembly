        [ mkg:boundTo <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq9/var/S> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq9/par/mu_max> ;
            mkg:slot "maximum rate" ],
        [ mkg:boundTo <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq9/var/X> ;
            mkg:slot "biomass" ] ;
    mkg:page "6" ;
    mkg:quote "\\mu=\\frac{\\mu_{max}S}{K_{s}X+S}" ;
    mkg:status "pending" .

