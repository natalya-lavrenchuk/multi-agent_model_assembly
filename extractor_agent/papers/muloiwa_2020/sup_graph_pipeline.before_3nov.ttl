@prefix mkg: <http://example.org/mkg#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq10> a mkg:Law ;
    rdfs:label "muloiwa_2020 eq 10 (Logarithmic growth)"@en ;
    mkg:computes <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq10/var/mu> ;
    mkg:equationNumber "10" ;
    mkg:hasMetadata <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq10_meta> ;
    mkg:hasParameter <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq10/par/a>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq10/par/b> ;
    mkg:latex "\\mu=a+b~l n\\left(s\\right)" ;
    mkg:uses <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq10/var/s> .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq11> a mkg:Law ;
    rdfs:label "muloiwa_2020 eq 11 (Aiba-Edwards growth)"@en ;
    mkg:computes <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq11/var/mu> ;
    mkg:equationNumber "11" ;
    mkg:hasMetadata <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq11_meta> ;
    mkg:hasParameter <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq11/par/K_I>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq11/par/K_s>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq11/par/mu_max> ;
    mkg:latex "\\mu=\\mu_{max}\\frac{S}{K_{s}+S}\\exp\\left(-\\frac{S}{K_{I}}\\right)" ;
    mkg:uses <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq11/var/S> .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq12> a mkg:Law ;
    rdfs:label "muloiwa_2020 eq 12 (Yano-Koga growth)"@en ;
    mkg:computes <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq12/var/mu> ;
    mkg:equationNumber "12" ;
    mkg:hasMetadata <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq12_meta> ;
    mkg:hasParameter <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq12/par/K_1>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq12/par/K_2>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq12/par/K_s>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq12/par/mu_max> ;
    mkg:latex "\\mu=\\frac{\\mu_{max}}{K_{s}+S+\\frac{s^{2}}{K_{1}}+\\frac{s^{3}}{K_{2}^{2}}}" ;
    mkg:latexCorrected "$$ \\mu=\\frac{\\mu_{max}S}{K_{s}+S+\\frac{S^{2}}{K_{1}}+\\frac{S^{3}}{K_{2}^{2}}} $$" ;
    mkg:uses <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq12/var/S>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq12/var/s> .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq13> a mkg:Law ;
    rdfs:label "muloiwa_2020 eq 13 (Han-Levenspiel growth)"@en ;
    mkg:computes <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq13/var/mu> ;
    mkg:equationNumber "13" ;
    mkg:hasMetadata <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq13_meta> ;
    mkg:hasParameter <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq13/par/K_s>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq13/par/S_m>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq13/par/m>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq13/par/mu_max>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq13/par/n> ;
    mkg:latex "\\mu=\\mu_{max}\\Bigg[1-\\Bigg(\\frac{S}{S_{m}}\\Bigg)\\Bigg]^{n}\\left[\\frac{S}{S+K_{s}\\Big(1-\\frac{S}{S_{m}}\\Big)^{m}}\\right]" ;
    mkg:uses <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq13/var/S> .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq14> a mkg:Law ;
    rdfs:label "muloiwa_2020 eq 14 (Powell growth)"@en ;
    mkg:computes <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq14/var/mu> ;
    mkg:equationNumber "14" ;
    mkg:hasMetadata <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq14_meta> ;
    mkg:hasParameter <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq14/par/K_s>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq14/par/m>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq14/par/mu_max> ;
    mkg:latex "\\mu=\\frac{(\\mu_{m a x}+m)S}{K_{s}+S}-m" ;
    mkg:uses <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq14/var/S> .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq15> a mkg:Law ;
    rdfs:label "muloiwa_2020 eq 15 (Logistic growth)"@en ;
    mkg:computes <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq15/var/mu> ;
    mkg:equationNumber "15" ;
    mkg:hasMetadata <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq15_meta> ;
    mkg:hasParameter <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq15/par/X_m>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq15/par/mu_max> ;
    mkg:latex "\\mu=\\mu_{max}\\left[1-\\frac{X}{X_{m}}\\right]" ;
    mkg:uses <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq15/var/X> .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq16> a mkg:Law ;
    rdfs:label "muloiwa_2020 eq 16 (Luong growth)"@en ;
    mkg:computes <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq16/var/mu> ;
    mkg:equationNumber "16" ;
    mkg:hasMetadata <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq16_meta> ;
    mkg:hasParameter <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq16/par/K_S>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq16/par/S_m>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq16/par/mu_max>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq16/par/n> ;
    mkg:latex "\\mu=\\mu_{m a x}\\frac{S}{K_{S}+S}(1-\\frac{S}{S_{m}})^{n}" ;
    mkg:uses <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq16/var/S> .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq17> a mkg:Law ;
    rdfs:label "muloiwa_2020 eq 17 (Webb growth)"@en ;
    mkg:computes <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq17/var/mu> ;
    mkg:equationNumber "17" ;
    mkg:hasMetadata <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq17_meta> ;
    mkg:hasParameter <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq17/par/K_i>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq17/par/K_s>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq17/par/mu_max> ;
    mkg:latex "\\mu=\\frac{\\mu_{max}S\\left(1+\\frac{S}{K_{i}}\\right)}{S+K_{s}+\\left(\\frac{S^{2}}{K_{i}}\\right)}" ;
    mkg:uses <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq17/var/S> .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq3> a mkg:Law ;
    rdfs:label "muloiwa_2020 eq 3 (Monod growth, substrate-only form)"@en ;
    mkg:computes <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq3/var/mu> ;
    mkg:equationNumber "3" ;
    mkg:hasMetadata <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq3_meta> ;
    mkg:hasParameter <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq3/par/K_s>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq3/par/mu_max> ;
    mkg:latex "\\mu=\\frac{\\mu_{max}S}{K_{s}+S}" ;
    mkg:uses <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq3/var/S> .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq4> a mkg:Law ;
    rdfs:label "muloiwa_2020 eq 4 (Monod growth, biomass-dependent form)"@en ;
    mkg:computes <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq4/var/mu> ;
    mkg:equationNumber "4" ;
    mkg:hasMetadata <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq4_meta> ;
    mkg:hasParameter <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq4/par/K_s>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq4/par/mu_max> ;
    mkg:latex "\\mu=\\frac{\\mu_{max}XS}{K_{s}+S}" ;
    mkg:uses <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq4/var/S>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq4/var/X> .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq5> a mkg:Law ;
    rdfs:label "muloiwa_2020 eq 5 (Blackman growth)"@en ;
    mkg:computes <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq5/var/mu> ;
    mkg:equationNumber "5" ;
    mkg:hasMetadata <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq5_meta> ;
    mkg:hasParameter <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq5/par/K_s>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq5/par/mu_max> ;
    mkg:latex "\\mu=\\frac{\\mu_{max}S}{K_{s}}" ;
    mkg:uses <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq5/var/S> .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq6> a mkg:Law ;
    rdfs:label "muloiwa_2020 eq 6 (Haldane growth)"@en ;
    mkg:computes <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq6/var/mu> ;
    mkg:equationNumber "6" ;
    mkg:hasMetadata <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq6_meta> ;
    mkg:hasParameter <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq6/par/K_i>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq6/par/K_s>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq6/par/mu_max> ;
    mkg:latex "\\mu=\\frac{\\mu_{max}S}{K_{s}+S+\\frac{s^{2}}{K_{i}}}" ;
    mkg:uses <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq6/var/S>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq6/var/s> .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq7> a mkg:Law ;
    rdfs:label "muloiwa_2020 eq 7 (Teissier growth)"@en ;
    mkg:computes <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq7/var/mu> ;
    mkg:equationNumber "7" ;
    mkg:hasMetadata <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq7_meta> ;
    mkg:hasParameter <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq7/par/kappa_T>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq7/par/mu_max> ;
    mkg:latex "\\mu=\\mu_{m a x}\\bigg(1-e^{\\frac{S}{\\kappa_{T}}}\\bigg)" ;
    mkg:latexCorrected "$$ \\mu=\\mu_{max}\\bigg(1-e^{-\\frac{S}{\\kappa_{T}}}\\bigg) $$" ;
    mkg:uses <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq7/var/S> .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq8> a mkg:Law ;
    rdfs:label "muloiwa_2020 eq 8 (Moser growth)"@en ;
    mkg:computes <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq8/var/mu> ;
    mkg:equationNumber "8" ;
    mkg:hasMetadata <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq8_meta> ;
    mkg:hasParameter <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq8/par/K_s>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq8/par/mu_max>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq8/par/n> ;
    mkg:latex "\\mu=\\frac{\\mu_{max}S^{n}}{K_{s}+S^{n}}" ;
    mkg:uses <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq8/var/S> .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq9> a mkg:Law ;
    rdfs:label "muloiwa_2020 eq 9 (Contois growth)"@en ;
    mkg:computes <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq9/var/mu> ;
    mkg:equationNumber "9" ;
    mkg:hasMetadata <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq9_meta> ;
    mkg:hasParameter <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq9/par/K_s>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq9/par/mu_max> ;
    mkg:latex "\\mu=\\frac{\\mu_{max}S}{K_{s}X+S}" ;
    mkg:uses <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq9/var/S>,
        <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq9/var/X> .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq10/var/mu> a mkg:Variable ;
    rdfs:label "\\mu (muloiwa_2020 eq 10)"@en ;
    mkg:description "Specific bacteria growth rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "\\mu" ;
    mkg:unit "1 / s" ;
    mkg:unitNote "dimension only, no unit printed" ;
    mkg:unitString "time^-1" .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq10_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:contextDescription "The paper compares models for bacterial growth in biological wastewater treatment, where microorganisms use dissolved or particulate organic matter as substrate. The models predict specific bacterial growth rate from substrate concentration, and in some cases biomass concentration, using 14 unstructured model families. Their rate expressions represent substrate limitation and, in several models, growth inhibition at high substrate concentrations; the paper reviews them rather than building one complete process model. The evidence comes from published experiments across different organisms, substrates and systems, including batch reactors, with biomass measured by dry weight or optical density. The authors compare reported fits mainly with R² and RMSE, and identify the Haldane model as the most frequently and successfully reported model, while noting that model performance varies with experimental and analytical practice." ;
    mkg:description "Logarithmic specific growth rate is computed as a function of the logarithm of substrate concentration." ;
    mkg:doi "10.1016/j.sajce.2020.07.006" ;
    mkg:form "algebraic" ;
    mkg:freeLaw true ;
    mkg:hasFact [ mkg:basis "stated" ;
            mkg:quote "The model is capable of describing substrate inhibition effects at high substrate concentration in a continuous fermentation bioreactor" ;
            mkg:text "The reviewed studies span different experimental systems, including batch reactors, continuous fermentation, microbial fuel cells, and suspended or immobilized biomass." ;
            mkg:topic "evidence" ],
        [ mkg:basis "stated" ;
            mkg:quote "The Monod model assumes that there is only one growth limiting substrate in the bioreactor" ;
            mkg:text "The Monod model assumes that only one substrate limits growth in the bioreactor." ;
            mkg:topic "formulation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The model can be defined in two forms: based on substrate concentration only, and based on both substrate and biomass concentration." ;
            mkg:text "The Monod model is presented in two forms, one based on substrate concentration alone and one based on substrate and biomass concentration." ;
            mkg:topic "formulation" ],
        [ mkg:basis "stated" ;
            mkg:quote "In biological wastewater treatment process, bacteria are used to oxidise dissolved and particulate carbonaceous organic matter into simple end products." ;
            mkg:text "The process context is biological wastewater treatment, where bacteria oxidize organic matter in wastewater into simpler products and new biomass." ;
            mkg:topic "application" ],
        [ mkg:basis "stated" ;
            mkg:quote "The only author who reported a poor fit was Debasmita and Rajasimman (2013), who reported a poor fit on biodegradation of Atrazine using mixed microorganisms." ;
            mkg:text "The Yano and Koga model is described as accounting for substrate inhibition at high concentrations and is reported to fit atrazine poorly in Debasmita and Rajasimman (2013), with R² of 38%." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "The parameter constants of all the kinetic growth models are estimated using nonlinear least of squares." ;
            mkg:text "The paper states that parameters for all reviewed kinetic growth models were estimated using nonlinear least squares." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Eq. (2) requires the measurement of biomass concentration at different time intervals." ;
            mkg:text "Calculating bacterial growth rate requires biomass measurements at different time intervals." ;
            mkg:topic "measurement" ],
        [ mkg:basis "inferred" ;
            mkg:text "The review compiles fit statistics from published studies rather than reporting a common independent validation exercise." ;
            mkg:topic "evaluation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Although the aim of the Webb model was to improve to Haldane model, Dey and Mukherjee (2010) reported that it did not improve much." ;
            mkg:text "The Webb model modifies the Haldane model, but Dey and Mukherjee (2010) reported that the modification did not substantially improve it." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "The logarithmic model was introduced by Westerhoff et al., (1982)." ;
            mkg:text "The paper traces the Logarithmic, Aiba-Edwards, Han and Levenspiel, Powell, Logistic, Luong, Webb, and Yano and Koga models to Westerhoff et al. (1982), Aiba et al. (1968), Han and Levenspiel (1988), Powell (1967), Verhulst (1838), Luong (1987), Webb (1963), and Yano and Koga (1969)." ;
            mkg:topic "origins" ],
        [ mkg:basis "stated" ;
            mkg:quote "Kinetic growth models are useful because they assist engineers to design and control biological processes" ;
            mkg:text "The paper says kinetic growth models can assist engineers in designing and controlling biological processes." ;
            mkg:topic "use" ],
        [ mkg:basis "stated" ;
            mkg:quote "The model is a substrate independent model, it describes kinetic growth based on biomass concentration only." ;
            mkg:text "The Logistic model predicts growth from biomass concentration and maximum biomass rather than from substrate concentration." ;
            mkg:topic "formulation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The OD method has the advantage of its simplicity, quickness, and automation. The disadvantage of the OD method is the interference with non-cell solids." ;
            mkg:text "Optical-density measurements are described as quick and automatable, but susceptible to interference from non-cell solids." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "One of the earliest kinetic growth models used to describe specific growth rate is the Monod model (Monod, 1942)." ;
            mkg:text "The paper traces the Monod, Blackman, Haldane, Teissier, Moser, and Contois model families to Monod (1949), Blackman (1905), Haldane (1965), Teissier (1942), Moser (1958), and Contois (1959), respectively." ;
            mkg:topic "origins" ],
        [ mkg:basis "stated" ;
            mkg:quote "The model has a reputation of over estimating cell growth, and if the substrate concentration is low, it can produce negative growth rate" ;
            mkg:text "The Logarithmic model is reported to potentially predict negative growth at low substrate concentration and to overestimate growth." ;
            mkg:topic "limitations" ],
        [ mkg:basis "stated" ;
            mkg:quote "The new term is used to describe complete growth inhibition above a critical substrate concentration" ;
            mkg:text "The Luong model is described as predicting complete growth inhibition above a critical substrate concentration." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "The performance review of the models were based on coefficient of determination ( R^{2} ). Another statistical measure of performance was root mean square error (RMSE)." ;
            mkg:text "The review assesses reported model performance using coefficient of determination and root mean square error." ;
            mkg:topic "evaluation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Ford, (2015) Statistical Research Consultant at the University of Virginia reported that R^{2} cannot be used as a measure of goodness to fit, predictive error, and cannot be used to compare models." ;
            mkg:text "The paper notes that R² is disputed as a measure of goodness of fit and predictive error." ;
            mkg:topic "evaluation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The collection of data, analysing of data, and environmental conditions will have an impact on the performance of each kinetic growth model." ;
            mkg:text "The paper cautions that data collection, analysis, environmental conditions, and measurement accuracy can affect the apparent performance of each model." ;
            mkg:topic "limitations" ],
        [ mkg:basis "stated" ;
            mkg:quote "In experimental work, data is sometimes not accurate and this could be attributed primarily to the experimental cultivation systems used to collect the data, and poor selection and sensitivity of analytical methods for measuring biomass and substrate concentration." ;
            mkg:text "The paper concludes that reported results depend in part on experimental cultivation systems and the selection and sensitivity of analytical methods." ;
            mkg:topic "use" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper does not identify a code repository or provide a new common dataset for the compared laws." ;
            mkg:topic "availability" ],
        [ mkg:basis "stated" ;
            mkg:quote "The most notable model the performed well was the Haldane model. The model was the most reported model in the literature with success on different types of substrate." ;
            mkg:text "The authors identify Haldane as the most notable model because it was frequently reported to fit different substrate types successfully." ;
            mkg:topic "use" ],
        [ mkg:basis "stated" ;
            mkg:quote "The model assumes that there is a critical inhibitor concentration where the reaction ceases or the growth rate slows down if that point is reached." ;
            mkg:text "The Han and Levenspiel model represents inhibition from substrate, cells, or products and uses a critical inhibitor concentration at which growth slows or ceases." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "At high substrate concentration, nutrients inhibit the growth of bacteria due to toxic substrate." ;
            mkg:text "The paper identifies substrate inhibition as a concern when high concentrations of toxic substrate hinder bacterial growth." ;
            mkg:topic "application" ],
        [ mkg:basis "stated" ;
            mkg:quote "Despite the poor fit of the Monod model on the literature mentioned above, the model still remains the most widely used to describe specific growth rate and substrate utilization rate" ;
            mkg:text "The paper describes the Monod model as widely used despite its limitations." ;
            mkg:topic "monod" ],
        [ mkg:basis "stated" ;
            mkg:quote "Although the model has been reported to struggle with describing critical values of inhibitory substrate, it has been applied by a number of authors with success" ;
            mkg:text "The Aiba-Edwards model adds an inhibition term to a Monod-type response, but the paper notes that performance varies across studies." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper characterizes the Haldane model as an extension of Monod that adds an inhibition constant to represent growth inhibition at high substrate concentration." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "inferred" ;
            mkg:text "The Contois model differs from substrate-only laws by making specific growth rate depend on both substrate and biomass concentration." ;
            mkg:topic "formulation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The disadvantage of the cell dry weight mass method is interference from dead cells and non-cell solids. Further-more the method is time consuming and labour intense" ;
            mkg:text "The paper warns that dry-weight measurements can include dead cells and non-cell solids and are time-consuming and labor-intensive." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "Wu et al., (2018) reported a satisfactory fit on kinetics and electro genesis change during cyanide degradation in a microbial fuel cell. The OD at 600 nm was used to measure the bacteria growth rates. The Haldane model produced  R^{2}  of 98.6%." ;
            mkg:text "Haldane fits reported in the review include R² of 98.6% for cyanide degradation in Wu et al. (2018) and RMSE of 0.0067 for phenol biodegradation in Dey and Mukherjee (2010)." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "Although the Teissier model was able to fit experimental data on phenol, ethanol, and ammonium, it struggled with fitting data on substrate that exhibits cell inhibition such as lead, cadmium, caffeine, and atrazine." ;
            mkg:text "The paper says Teissier does not represent cell-growth inhibition and reports poor fits for lead, cadmium, caffeine, and atrazine studies." ;
            mkg:topic "noninhibitory" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper presents specific-growth-rate laws rather than one integrated dynamic process model with a shared set of states." ;
            mkg:topic "structure" ],
        [ mkg:basis "stated" ;
            mkg:quote "There are two common methods used to determine biomass concentration: Cell dry weight mass method and the Optical density (OD) method." ;
            mkg:text "The paper identifies cell dry weight and optical density as common biomass measurement methods." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "Hamitouche et al., (2012) reported a poor fit on biodegradation of phenol by mixed culture in a batch reactor. The growth rates were measured using Optical density (OD) at 600 nm to describe the specific growth rates. The model produced  R^{2} 52%." ;
            mkg:text "Reported Monod fits were poor for phenol degradation by mixed culture in Hamitouche et al. (2012), with R² of 52%, and atrazine biodegradation in Debasmita and Rajasimman (2013), with R² of 30.4%." ;
            mkg:topic "monod" ],
        [ mkg:basis "stated" ;
            mkg:quote "The OD at 600 nm was used to measure the bacteria growth rates." ;
            mkg:text "The paper reports that optical density at 600 nm was frequently used in the cited studies, while some studies used dry weight or other optical-density wavelengths." ;
            mkg:topic "evidence" ],
        [ mkg:basis "stated" ;
            mkg:quote "The advantage of the Haldane model is that it is capable of describing all growth phases: lag, exponential, stationary, and death phase" ;
            mkg:text "The Haldane model is said to represent lag, exponential, stationary, and death phases." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "This paper aims to review the performance of 14 unstructured kinetic growth models that are used to describe specific bacteria growth rate." ;
            mkg:text "The paper reviews 14 unstructured kinetic growth model families for describing specific bacterial growth rate." ;
            mkg:topic "scope" ],
        [ mkg:basis "stated" ;
            mkg:quote "Dutta et al., (2015) reported a poor fit on growth kinetics for Cutinase producing Pseudomonas Cepacia using tomato-peel extracted cutin. The OD at 600 nm was used to measure the bacteria growth rates. The Haldane model produced  R^{2} 57%." ;
            mkg:text "The Haldane model had a poor reported fit for cutinase-producing Pseudomonas cepacia in Dutta et al. (2015), with R² of 57%." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "Mahanta et al., (2014) reported results on the comparison between Blackman, Monod, Powell, and Moser models. In the study the Blackman model was the only model that did not fit the experimental data with a reported  R^{2}  of 43.3%." ;
            mkg:text "The paper reports that the Blackman model performed poorly in Mahanta et al. (2014), with R² of 43.3%." ;
            mkg:topic "noninhibitory" ],
        [ mkg:basis "stated" ;
            mkg:quote "Unlike the Monod model, and Contois model, the Moser model is capable of describing the lag phase when substrate concentration is high (Kong, 2017). The Moser model cannot describe the death phase." ;
            mkg:text "The Moser model adds an adjustable exponent to the Monod form and is described as capable of representing lag but not death." ;
            mkg:topic "noninhibitory" ],
        [ mkg:basis "stated" ;
            mkg:quote "Unstructured kinetic growth models describe bacteria growth rate based on biomass and substrate concentration" ;
            mkg:text "The reviewed laws are unstructured models that represent bacterial growth in relation to environmental substrate and, for some models, biomass concentration." ;
            mkg:topic "structure" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper says the Monod model does not represent substrate inhibition, maintenance during the death phase, or lag and death phases." ;
            mkg:topic "monod" ],
        [ mkg:basis "stated" ;
            mkg:quote "Contrary to reported results by Dey and Mukherjee (2010) on phenol degradation, Mohanty et al., (2018) reported a poor fit on phenol degradation." ;
            mkg:text "For phenol degradation, the Aiba-Edwards model gave R² of 78.6% in Mohanty et al. (2018), whereas Dey and Mukherjee (2010) reported RMSE of 0.0078." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "inferred" ;
            mkg:text "The review does not give a single overall parameter count or common parameter-uncertainty analysis for the different laws and studies." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The OD method measures the absorbance of the sample using a spectrophotometer at a wavelength between 540 - 600 nm. A calibration curve of absorbance and cell dry weight mass is required to relate absorbance with cell dry weight mass." ;
            mkg:text "The general optical-density method measures absorbance at wavelengths from 540 to 600 nm and requires a calibration curve relating absorbance to cell dry weight." ;
            mkg:topic "measurement" ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq10/par/b> ;
            mkg:slot "logarithmic coefficient" ],
        [ mkg:boundTo <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq10/var/s> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq10/par/a> ;
            mkg:slot "intercept" ] ;
    mkg:page "6" ;
    mkg:quote "\\mu=a+b~l n\\left(s\\right)" ;
    mkg:status "pending" .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq11/var/mu> a mkg:Variable ;
    rdfs:label "\\mu (muloiwa_2020 eq 11)"@en ;
    mkg:description "Specific bacteria growth rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "\\mu" ;
    mkg:unit "1 / s" ;
    mkg:unitNote "dimension only, no unit printed" ;
    mkg:unitString "time^-1" .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq11_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:contextDescription "The paper compares models for bacterial growth in biological wastewater treatment, where microorganisms use dissolved or particulate organic matter as substrate. The models predict specific bacterial growth rate from substrate concentration, and in some cases biomass concentration, using 14 unstructured model families. Their rate expressions represent substrate limitation and, in several models, growth inhibition at high substrate concentrations; the paper reviews them rather than building one complete process model. The evidence comes from published experiments across different organisms, substrates and systems, including batch reactors, with biomass measured by dry weight or optical density. The authors compare reported fits mainly with R² and RMSE, and identify the Haldane model as the most frequently and successfully reported model, while noting that model performance varies with experimental and analytical practice." ;
    mkg:description "The Aiba–Edwards law computes bacterial specific growth rate from substrate concentration with exponential substrate inhibition." ;
    mkg:doi "10.1016/j.sajce.2020.07.006" ;
    mkg:form "algebraic" ;
    mkg:freeLaw true ;
    mkg:hasFact [ mkg:basis "stated" ;
            mkg:quote "There are two common methods used to determine biomass concentration: Cell dry weight mass method and the Optical density (OD) method." ;
            mkg:text "The paper identifies cell dry weight and optical density as common biomass measurement methods." ;
            mkg:topic "measurement" ],
        [ mkg:basis "inferred" ;
            mkg:text "The review does not give a single overall parameter count or common parameter-uncertainty analysis for the different laws and studies." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The Monod model assumes that there is only one growth limiting substrate in the bioreactor" ;
            mkg:text "The Monod model assumes that only one substrate limits growth in the bioreactor." ;
            mkg:topic "formulation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The disadvantage of the cell dry weight mass method is interference from dead cells and non-cell solids. Further-more the method is time consuming and labour intense" ;
            mkg:text "The paper warns that dry-weight measurements can include dead cells and non-cell solids and are time-consuming and labor-intensive." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "Eq. (2) requires the measurement of biomass concentration at different time intervals." ;
            mkg:text "Calculating bacterial growth rate requires biomass measurements at different time intervals." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "Although the model has been reported to struggle with describing critical values of inhibitory substrate, it has been applied by a number of authors with success" ;
            mkg:text "The Aiba-Edwards model adds an inhibition term to a Monod-type response, but the paper notes that performance varies across studies." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper does not identify a code repository or provide a new common dataset for the compared laws." ;
            mkg:topic "availability" ],
        [ mkg:basis "stated" ;
            mkg:quote "The most notable model the performed well was the Haldane model. The model was the most reported model in the literature with success on different types of substrate." ;
            mkg:text "The authors identify Haldane as the most notable model because it was frequently reported to fit different substrate types successfully." ;
            mkg:topic "use" ],
        [ mkg:basis "stated" ;
            mkg:quote "Unstructured kinetic growth models describe bacteria growth rate based on biomass and substrate concentration" ;
            mkg:text "The reviewed laws are unstructured models that represent bacterial growth in relation to environmental substrate and, for some models, biomass concentration." ;
            mkg:topic "structure" ],
        [ mkg:basis "stated" ;
            mkg:quote "Although the aim of the Webb model was to improve to Haldane model, Dey and Mukherjee (2010) reported that it did not improve much." ;
            mkg:text "The Webb model modifies the Haldane model, but Dey and Mukherjee (2010) reported that the modification did not substantially improve it." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "The OD method measures the absorbance of the sample using a spectrophotometer at a wavelength between 540 - 600 nm. A calibration curve of absorbance and cell dry weight mass is required to relate absorbance with cell dry weight mass." ;
            mkg:text "The general optical-density method measures absorbance at wavelengths from 540 to 600 nm and requires a calibration curve relating absorbance to cell dry weight." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "At high substrate concentration, nutrients inhibit the growth of bacteria due to toxic substrate." ;
            mkg:text "The paper identifies substrate inhibition as a concern when high concentrations of toxic substrate hinder bacterial growth." ;
            mkg:topic "application" ],
        [ mkg:basis "stated" ;
            mkg:quote "The model assumes that there is a critical inhibitor concentration where the reaction ceases or the growth rate slows down if that point is reached." ;
            mkg:text "The Han and Levenspiel model represents inhibition from substrate, cells, or products and uses a critical inhibitor concentration at which growth slows or ceases." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "Contrary to reported results by Dey and Mukherjee (2010) on phenol degradation, Mohanty et al., (2018) reported a poor fit on phenol degradation." ;
            mkg:text "For phenol degradation, the Aiba-Edwards model gave R² of 78.6% in Mohanty et al. (2018), whereas Dey and Mukherjee (2010) reported RMSE of 0.0078." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "The logarithmic model was introduced by Westerhoff et al., (1982)." ;
            mkg:text "The paper traces the Logarithmic, Aiba-Edwards, Han and Levenspiel, Powell, Logistic, Luong, Webb, and Yano and Koga models to Westerhoff et al. (1982), Aiba et al. (1968), Han and Levenspiel (1988), Powell (1967), Verhulst (1838), Luong (1987), Webb (1963), and Yano and Koga (1969)." ;
            mkg:topic "origins" ],
        [ mkg:basis "stated" ;
            mkg:quote "The model can be defined in two forms: based on substrate concentration only, and based on both substrate and biomass concentration." ;
            mkg:text "The Monod model is presented in two forms, one based on substrate concentration alone and one based on substrate and biomass concentration." ;
            mkg:topic "formulation" ],
        [ mkg:basis "inferred" ;
            mkg:text "The review compiles fit statistics from published studies rather than reporting a common independent validation exercise." ;
            mkg:topic "evaluation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Despite the poor fit of the Monod model on the literature mentioned above, the model still remains the most widely used to describe specific growth rate and substrate utilization rate" ;
            mkg:text "The paper describes the Monod model as widely used despite its limitations." ;
            mkg:topic "monod" ],
        [ mkg:basis "stated" ;
            mkg:quote "Dutta et al., (2015) reported a poor fit on growth kinetics for Cutinase producing Pseudomonas Cepacia using tomato-peel extracted cutin. The OD at 600 nm was used to measure the bacteria growth rates. The Haldane model produced  R^{2} 57%." ;
            mkg:text "The Haldane model had a poor reported fit for cutinase-producing Pseudomonas cepacia in Dutta et al. (2015), with R² of 57%." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "The OD method has the advantage of its simplicity, quickness, and automation. The disadvantage of the OD method is the interference with non-cell solids." ;
            mkg:text "Optical-density measurements are described as quick and automatable, but susceptible to interference from non-cell solids." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "The new term is used to describe complete growth inhibition above a critical substrate concentration" ;
            mkg:text "The Luong model is described as predicting complete growth inhibition above a critical substrate concentration." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "One of the earliest kinetic growth models used to describe specific growth rate is the Monod model (Monod, 1942)." ;
            mkg:text "The paper traces the Monod, Blackman, Haldane, Teissier, Moser, and Contois model families to Monod (1949), Blackman (1905), Haldane (1965), Teissier (1942), Moser (1958), and Contois (1959), respectively." ;
            mkg:topic "origins" ],
        [ mkg:basis "inferred" ;
            mkg:text "The Contois model differs from substrate-only laws by making specific growth rate depend on both substrate and biomass concentration." ;
            mkg:topic "formulation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The collection of data, analysing of data, and environmental conditions will have an impact on the performance of each kinetic growth model." ;
            mkg:text "The paper cautions that data collection, analysis, environmental conditions, and measurement accuracy can affect the apparent performance of each model." ;
            mkg:topic "limitations" ],
        [ mkg:basis "stated" ;
            mkg:quote "Ford, (2015) Statistical Research Consultant at the University of Virginia reported that R^{2} cannot be used as a measure of goodness to fit, predictive error, and cannot be used to compare models." ;
            mkg:text "The paper notes that R² is disputed as a measure of goodness of fit and predictive error." ;
            mkg:topic "evaluation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Wu et al., (2018) reported a satisfactory fit on kinetics and electro genesis change during cyanide degradation in a microbial fuel cell. The OD at 600 nm was used to measure the bacteria growth rates. The Haldane model produced  R^{2}  of 98.6%." ;
            mkg:text "Haldane fits reported in the review include R² of 98.6% for cyanide degradation in Wu et al. (2018) and RMSE of 0.0067 for phenol biodegradation in Dey and Mukherjee (2010)." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "In biological wastewater treatment process, bacteria are used to oxidise dissolved and particulate carbonaceous organic matter into simple end products." ;
            mkg:text "The process context is biological wastewater treatment, where bacteria oxidize organic matter in wastewater into simpler products and new biomass." ;
            mkg:topic "application" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper says the Monod model does not represent substrate inhibition, maintenance during the death phase, or lag and death phases." ;
            mkg:topic "monod" ],
        [ mkg:basis "stated" ;
            mkg:quote "The advantage of the Haldane model is that it is capable of describing all growth phases: lag, exponential, stationary, and death phase" ;
            mkg:text "The Haldane model is said to represent lag, exponential, stationary, and death phases." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "The model is capable of describing substrate inhibition effects at high substrate concentration in a continuous fermentation bioreactor" ;
            mkg:text "The reviewed studies span different experimental systems, including batch reactors, continuous fermentation, microbial fuel cells, and suspended or immobilized biomass." ;
            mkg:topic "evidence" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper characterizes the Haldane model as an extension of Monod that adds an inhibition constant to represent growth inhibition at high substrate concentration." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "The only author who reported a poor fit was Debasmita and Rajasimman (2013), who reported a poor fit on biodegradation of Atrazine using mixed microorganisms." ;
            mkg:text "The Yano and Koga model is described as accounting for substrate inhibition at high concentrations and is reported to fit atrazine poorly in Debasmita and Rajasimman (2013), with R² of 38%." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "The model has a reputation of over estimating cell growth, and if the substrate concentration is low, it can produce negative growth rate" ;
            mkg:text "The Logarithmic model is reported to potentially predict negative growth at low substrate concentration and to overestimate growth." ;
            mkg:topic "limitations" ],
        [ mkg:basis "stated" ;
            mkg:quote "The OD at 600 nm was used to measure the bacteria growth rates." ;
            mkg:text "The paper reports that optical density at 600 nm was frequently used in the cited studies, while some studies used dry weight or other optical-density wavelengths." ;
            mkg:topic "evidence" ],
        [ mkg:basis "stated" ;
            mkg:quote "In experimental work, data is sometimes not accurate and this could be attributed primarily to the experimental cultivation systems used to collect the data, and poor selection and sensitivity of analytical methods for measuring biomass and substrate concentration." ;
            mkg:text "The paper concludes that reported results depend in part on experimental cultivation systems and the selection and sensitivity of analytical methods." ;
            mkg:topic "use" ],
        [ mkg:basis "stated" ;
            mkg:quote "This paper aims to review the performance of 14 unstructured kinetic growth models that are used to describe specific bacteria growth rate." ;
            mkg:text "The paper reviews 14 unstructured kinetic growth model families for describing specific bacterial growth rate." ;
            mkg:topic "scope" ],
        [ mkg:basis "stated" ;
            mkg:quote "Kinetic growth models are useful because they assist engineers to design and control biological processes" ;
            mkg:text "The paper says kinetic growth models can assist engineers in designing and controlling biological processes." ;
            mkg:topic "use" ],
        [ mkg:basis "stated" ;
            mkg:quote "The parameter constants of all the kinetic growth models are estimated using nonlinear least of squares." ;
            mkg:text "The paper states that parameters for all reviewed kinetic growth models were estimated using nonlinear least squares." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Although the Teissier model was able to fit experimental data on phenol, ethanol, and ammonium, it struggled with fitting data on substrate that exhibits cell inhibition such as lead, cadmium, caffeine, and atrazine." ;
            mkg:text "The paper says Teissier does not represent cell-growth inhibition and reports poor fits for lead, cadmium, caffeine, and atrazine studies." ;
            mkg:topic "noninhibitory" ],
        [ mkg:basis "stated" ;
            mkg:quote "Unlike the Monod model, and Contois model, the Moser model is capable of describing the lag phase when substrate concentration is high (Kong, 2017). The Moser model cannot describe the death phase." ;
            mkg:text "The Moser model adds an adjustable exponent to the Monod form and is described as capable of representing lag but not death." ;
            mkg:topic "noninhibitory" ],
        [ mkg:basis "stated" ;
            mkg:quote "The model is a substrate independent model, it describes kinetic growth based on biomass concentration only." ;
            mkg:text "The Logistic model predicts growth from biomass concentration and maximum biomass rather than from substrate concentration." ;
            mkg:topic "formulation" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper presents specific-growth-rate laws rather than one integrated dynamic process model with a shared set of states." ;
            mkg:topic "structure" ],
        [ mkg:basis "stated" ;
            mkg:quote "Hamitouche et al., (2012) reported a poor fit on biodegradation of phenol by mixed culture in a batch reactor. The growth rates were measured using Optical density (OD) at 600 nm to describe the specific growth rates. The model produced  R^{2} 52%." ;
            mkg:text "Reported Monod fits were poor for phenol degradation by mixed culture in Hamitouche et al. (2012), with R² of 52%, and atrazine biodegradation in Debasmita and Rajasimman (2013), with R² of 30.4%." ;
            mkg:topic "monod" ],
        [ mkg:basis "stated" ;
            mkg:quote "Mahanta et al., (2014) reported results on the comparison between Blackman, Monod, Powell, and Moser models. In the study the Blackman model was the only model that did not fit the experimental data with a reported  R^{2}  of 43.3%." ;
            mkg:text "The paper reports that the Blackman model performed poorly in Mahanta et al. (2014), with R² of 43.3%." ;
            mkg:topic "noninhibitory" ],
        [ mkg:basis "stated" ;
            mkg:quote "The performance review of the models were based on coefficient of determination ( R^{2} ). Another statistical measure of performance was root mean square error (RMSE)." ;
            mkg:text "The review assesses reported model performance using coefficient of determination and root mean square error." ;
            mkg:topic "evaluation" ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq11/par/K_I> ;
            mkg:slot "inhibition constant" ],
        [ mkg:boundTo <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq11/par/K_s> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq11/par/mu_max> ;
            mkg:slot "maximum rate" ],
        [ mkg:boundTo <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq11/var/S> ;
            mkg:slot "substrate" ] ;
    mkg:page "6" ;
    mkg:quote "\\mu=\\mu_{max}\\frac{S}{K_{s}+S}\\exp\\left(-\\frac{S}{K_{I}}\\right)" ;
    mkg:status "pending" .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq12/var/mu> a mkg:Variable ;
    rdfs:label "\\mu (muloiwa_2020 eq 12)"@en ;
    mkg:description "Specific bacteria growth rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "\\mu" ;
    mkg:unit "1 / s" ;
    mkg:unitNote "dimension only, no unit printed" ;
    mkg:unitString "time^-1" .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq12/var/s> a mkg:Variable ;
    rdfs:label "s (muloiwa_2020 eq 12)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Substrate concentration in the logarithmic growth law" ;
    mkg:reason "Substrate concentration used as an input to the growth-rate laws, rather than computed by them." ;
    mkg:sameQuantityAs "S" ;
    mkg:status "accepted" ;
    mkg:symbol "s" .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq12_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:contextDescription "The paper compares models for bacterial growth in biological wastewater treatment, where microorganisms use dissolved or particulate organic matter as substrate. The models predict specific bacterial growth rate from substrate concentration, and in some cases biomass concentration, using 14 unstructured model families. Their rate expressions represent substrate limitation and, in several models, growth inhibition at high substrate concentrations; the paper reviews them rather than building one complete process model. The evidence comes from published experiments across different organisms, substrates and systems, including batch reactors, with biomass measured by dry weight or optical density. The authors compare reported fits mainly with R² and RMSE, and identify the Haldane model as the most frequently and successfully reported model, while noting that model performance varies with experimental and analytical practice." ;
    mkg:correctionQuote "Where, $\\mu$ specific growth rate, $\\mu_{max}$ maximum specific growth rate, $K_s$ half saturation constant, $S$ substrate concentration, and $K_1$ and $K_2$ positive constants that describe substrate inhibition." ;
    mkg:correctionReason "The numerator is missing S: without it the expression does not have units of a specific growth rate. The lowercase s in the OCR text is a capital S in the PDF." ;
    mkg:correctionStatus "accepted" ;
    mkg:description "The Yano–Koga law computes specific growth rate as a substrate-dependent rate reduced by inhibition at high substrate concentration." ;
    mkg:doi "10.1016/j.sajce.2020.07.006" ;
    mkg:form "algebraic" ;
    mkg:freeLaw true ;
    mkg:hasFact [ mkg:basis "inferred" ;
            mkg:text "The paper says the Monod model does not represent substrate inhibition, maintenance during the death phase, or lag and death phases." ;
            mkg:topic "monod" ],
        [ mkg:basis "stated" ;
            mkg:quote "Contrary to reported results by Dey and Mukherjee (2010) on phenol degradation, Mohanty et al., (2018) reported a poor fit on phenol degradation." ;
            mkg:text "For phenol degradation, the Aiba-Edwards model gave R² of 78.6% in Mohanty et al. (2018), whereas Dey and Mukherjee (2010) reported RMSE of 0.0078." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "Unlike the Monod model, and Contois model, the Moser model is capable of describing the lag phase when substrate concentration is high (Kong, 2017). The Moser model cannot describe the death phase." ;
            mkg:text "The Moser model adds an adjustable exponent to the Monod form and is described as capable of representing lag but not death." ;
            mkg:topic "noninhibitory" ],
        [ mkg:basis "stated" ;
            mkg:quote "Although the Teissier model was able to fit experimental data on phenol, ethanol, and ammonium, it struggled with fitting data on substrate that exhibits cell inhibition such as lead, cadmium, caffeine, and atrazine." ;
            mkg:text "The paper says Teissier does not represent cell-growth inhibition and reports poor fits for lead, cadmium, caffeine, and atrazine studies." ;
            mkg:topic "noninhibitory" ],
        [ mkg:basis "inferred" ;
            mkg:text "The review compiles fit statistics from published studies rather than reporting a common independent validation exercise." ;
            mkg:topic "evaluation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The logarithmic model was introduced by Westerhoff et al., (1982)." ;
            mkg:text "The paper traces the Logarithmic, Aiba-Edwards, Han and Levenspiel, Powell, Logistic, Luong, Webb, and Yano and Koga models to Westerhoff et al. (1982), Aiba et al. (1968), Han and Levenspiel (1988), Powell (1967), Verhulst (1838), Luong (1987), Webb (1963), and Yano and Koga (1969)." ;
            mkg:topic "origins" ],
        [ mkg:basis "stated" ;
            mkg:quote "Although the model has been reported to struggle with describing critical values of inhibitory substrate, it has been applied by a number of authors with success" ;
            mkg:text "The Aiba-Edwards model adds an inhibition term to a Monod-type response, but the paper notes that performance varies across studies." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "inferred" ;
            mkg:text "The Contois model differs from substrate-only laws by making specific growth rate depend on both substrate and biomass concentration." ;
            mkg:topic "formulation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The performance review of the models were based on coefficient of determination ( R^{2} ). Another statistical measure of performance was root mean square error (RMSE)." ;
            mkg:text "The review assesses reported model performance using coefficient of determination and root mean square error." ;
            mkg:topic "evaluation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Kinetic growth models are useful because they assist engineers to design and control biological processes" ;
            mkg:text "The paper says kinetic growth models can assist engineers in designing and controlling biological processes." ;
            mkg:topic "use" ],
        [ mkg:basis "stated" ;
            mkg:quote "One of the earliest kinetic growth models used to describe specific growth rate is the Monod model (Monod, 1942)." ;
            mkg:text "The paper traces the Monod, Blackman, Haldane, Teissier, Moser, and Contois model families to Monod (1949), Blackman (1905), Haldane (1965), Teissier (1942), Moser (1958), and Contois (1959), respectively." ;
            mkg:topic "origins" ],
        [ mkg:basis "stated" ;
            mkg:quote "The new term is used to describe complete growth inhibition above a critical substrate concentration" ;
            mkg:text "The Luong model is described as predicting complete growth inhibition above a critical substrate concentration." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "Mahanta et al., (2014) reported results on the comparison between Blackman, Monod, Powell, and Moser models. In the study the Blackman model was the only model that did not fit the experimental data with a reported  R^{2}  of 43.3%." ;
            mkg:text "The paper reports that the Blackman model performed poorly in Mahanta et al. (2014), with R² of 43.3%." ;
            mkg:topic "noninhibitory" ],
        [ mkg:basis "stated" ;
            mkg:quote "This paper aims to review the performance of 14 unstructured kinetic growth models that are used to describe specific bacteria growth rate." ;
            mkg:text "The paper reviews 14 unstructured kinetic growth model families for describing specific bacterial growth rate." ;
            mkg:topic "scope" ],
        [ mkg:basis "stated" ;
            mkg:quote "The collection of data, analysing of data, and environmental conditions will have an impact on the performance of each kinetic growth model." ;
            mkg:text "The paper cautions that data collection, analysis, environmental conditions, and measurement accuracy can affect the apparent performance of each model." ;
            mkg:topic "limitations" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper does not identify a code repository or provide a new common dataset for the compared laws." ;
            mkg:topic "availability" ],
        [ mkg:basis "stated" ;
            mkg:quote "In biological wastewater treatment process, bacteria are used to oxidise dissolved and particulate carbonaceous organic matter into simple end products." ;
            mkg:text "The process context is biological wastewater treatment, where bacteria oxidize organic matter in wastewater into simpler products and new biomass." ;
            mkg:topic "application" ],
        [ mkg:basis "stated" ;
            mkg:quote "The OD at 600 nm was used to measure the bacteria growth rates." ;
            mkg:text "The paper reports that optical density at 600 nm was frequently used in the cited studies, while some studies used dry weight or other optical-density wavelengths." ;
            mkg:topic "evidence" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper characterizes the Haldane model as an extension of Monod that adds an inhibition constant to represent growth inhibition at high substrate concentration." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "At high substrate concentration, nutrients inhibit the growth of bacteria due to toxic substrate." ;
            mkg:text "The paper identifies substrate inhibition as a concern when high concentrations of toxic substrate hinder bacterial growth." ;
            mkg:topic "application" ],
        [ mkg:basis "inferred" ;
            mkg:text "The review does not give a single overall parameter count or common parameter-uncertainty analysis for the different laws and studies." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The model has a reputation of over estimating cell growth, and if the substrate concentration is low, it can produce negative growth rate" ;
            mkg:text "The Logarithmic model is reported to potentially predict negative growth at low substrate concentration and to overestimate growth." ;
            mkg:topic "limitations" ],
        [ mkg:basis "stated" ;
            mkg:quote "In experimental work, data is sometimes not accurate and this could be attributed primarily to the experimental cultivation systems used to collect the data, and poor selection and sensitivity of analytical methods for measuring biomass and substrate concentration." ;
            mkg:text "The paper concludes that reported results depend in part on experimental cultivation systems and the selection and sensitivity of analytical methods." ;
            mkg:topic "use" ],
        [ mkg:basis "stated" ;
            mkg:quote "There are two common methods used to determine biomass concentration: Cell dry weight mass method and the Optical density (OD) method." ;
            mkg:text "The paper identifies cell dry weight and optical density as common biomass measurement methods." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "Wu et al., (2018) reported a satisfactory fit on kinetics and electro genesis change during cyanide degradation in a microbial fuel cell. The OD at 600 nm was used to measure the bacteria growth rates. The Haldane model produced  R^{2}  of 98.6%." ;
            mkg:text "Haldane fits reported in the review include R² of 98.6% for cyanide degradation in Wu et al. (2018) and RMSE of 0.0067 for phenol biodegradation in Dey and Mukherjee (2010)." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "Although the aim of the Webb model was to improve to Haldane model, Dey and Mukherjee (2010) reported that it did not improve much." ;
            mkg:text "The Webb model modifies the Haldane model, but Dey and Mukherjee (2010) reported that the modification did not substantially improve it." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "The model is a substrate independent model, it describes kinetic growth based on biomass concentration only." ;
            mkg:text "The Logistic model predicts growth from biomass concentration and maximum biomass rather than from substrate concentration." ;
            mkg:topic "formulation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The only author who reported a poor fit was Debasmita and Rajasimman (2013), who reported a poor fit on biodegradation of Atrazine using mixed microorganisms." ;
            mkg:text "The Yano and Koga model is described as accounting for substrate inhibition at high concentrations and is reported to fit atrazine poorly in Debasmita and Rajasimman (2013), with R² of 38%." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "The OD method has the advantage of its simplicity, quickness, and automation. The disadvantage of the OD method is the interference with non-cell solids." ;
            mkg:text "Optical-density measurements are described as quick and automatable, but susceptible to interference from non-cell solids." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "Unstructured kinetic growth models describe bacteria growth rate based on biomass and substrate concentration" ;
            mkg:text "The reviewed laws are unstructured models that represent bacterial growth in relation to environmental substrate and, for some models, biomass concentration." ;
            mkg:topic "structure" ],
        [ mkg:basis "stated" ;
            mkg:quote "Ford, (2015) Statistical Research Consultant at the University of Virginia reported that R^{2} cannot be used as a measure of goodness to fit, predictive error, and cannot be used to compare models." ;
            mkg:text "The paper notes that R² is disputed as a measure of goodness of fit and predictive error." ;
            mkg:topic "evaluation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The most notable model the performed well was the Haldane model. The model was the most reported model in the literature with success on different types of substrate." ;
            mkg:text "The authors identify Haldane as the most notable model because it was frequently reported to fit different substrate types successfully." ;
            mkg:topic "use" ],
        [ mkg:basis "inferred" ;
            mkg:text "The paper presents specific-growth-rate laws rather than one integrated dynamic process model with a shared set of states." ;
            mkg:topic "structure" ],
        [ mkg:basis "stated" ;
            mkg:quote "Despite the poor fit of the Monod model on the literature mentioned above, the model still remains the most widely used to describe specific growth rate and substrate utilization rate" ;
            mkg:text "The paper describes the Monod model as widely used despite its limitations." ;
            mkg:topic "monod" ],
        [ mkg:basis "stated" ;
            mkg:quote "The model assumes that there is a critical inhibitor concentration where the reaction ceases or the growth rate slows down if that point is reached." ;
            mkg:text "The Han and Levenspiel model represents inhibition from substrate, cells, or products and uses a critical inhibitor concentration at which growth slows or ceases." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "The model can be defined in two forms: based on substrate concentration only, and based on both substrate and biomass concentration." ;
            mkg:text "The Monod model is presented in two forms, one based on substrate concentration alone and one based on substrate and biomass concentration." ;
            mkg:topic "formulation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The OD method measures the absorbance of the sample using a spectrophotometer at a wavelength between 540 - 600 nm. A calibration curve of absorbance and cell dry weight mass is required to relate absorbance with cell dry weight mass." ;
            mkg:text "The general optical-density method measures absorbance at wavelengths from 540 to 600 nm and requires a calibration curve relating absorbance to cell dry weight." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "The disadvantage of the cell dry weight mass method is interference from dead cells and non-cell solids. Further-more the method is time consuming and labour intense" ;
            mkg:text "The paper warns that dry-weight measurements can include dead cells and non-cell solids and are time-consuming and labor-intensive." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "Dutta et al., (2015) reported a poor fit on growth kinetics for Cutinase producing Pseudomonas Cepacia using tomato-peel extracted cutin. The OD at 600 nm was used to measure the bacteria growth rates. The Haldane model produced  R^{2} 57%." ;
            mkg:text "The Haldane model had a poor reported fit for cutinase-producing Pseudomonas cepacia in Dutta et al. (2015), with R² of 57%." ;
            mkg:topic "inhibition" ],
        [ mkg:basis "stated" ;
            mkg:quote "The Monod model assumes that there is only one growth limiting substrate in the bioreactor" ;
            mkg:text "The Monod model assumes that only one substrate limits growth in the bioreactor." ;
            mkg:topic "formulation" ],
        [ mkg:basis "stated" ;
            mkg:quote "Eq. (2) requires the measurement of biomass concentration at different time intervals." ;
            mkg:text "Calculating bacterial growth rate requires biomass measurements at different time intervals." ;
            mkg:topic "measurement" ],
        [ mkg:basis "stated" ;
            mkg:quote "The parameter constants of all the kinetic growth models are estimated using nonlinear least of squares." ;
            mkg:text "The paper states that parameters for all reviewed kinetic growth models were estimated using nonlinear least squares." ;
            mkg:topic "estimation" ],
        [ mkg:basis "stated" ;
            mkg:quote "The model is capable of describing substrate inhibition effects at high substrate concentration in a continuous fermentation bioreactor" ;
            mkg:text "The reviewed studies span different experimental systems, including batch reactors, continuous fermentation, microbial fuel cells, and suspended or immobilized biomass." ;
            mkg:topic "evidence" ],
        [ mkg:basis "stated" ;
            mkg:quote "Hamitouche et al., (2012) reported a poor fit on biodegradation of phenol by mixed culture in a batch reactor. The growth rates were measured using Optical density (OD) at 600 nm to describe the specific growth rates. The model produced  R^{2} 52%." ;
            mkg:text "Reported Monod fits were poor for phenol degradation by mixed culture in Hamitouche et al. (2012), with R² of 52%, and atrazine biodegradation in Debasmita and Rajasimman (2013), with R² of 30.4%." ;
            mkg:topic "monod" ],
        [ mkg:basis "stated" ;
            mkg:quote "The advantage of the Haldane model is that it is capable of describing all growth phases: lag, exponential, stationary, and death phase" ;
            mkg:text "The Haldane model is said to represent lag, exponential, stationary, and death phases." ;
            mkg:topic "inhibition" ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq12/par/mu_max> ;
            mkg:slot "maximum rate" ],
        [ mkg:boundTo <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq12/par/K_s> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq12/par/K_2> ;
            mkg:slot "inhibition constant" ],
        [ mkg:boundTo <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq12/par/K_1> ;
            mkg:slot "inhibition constant" ],
        [ mkg:boundTo <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq12/var/S> ;
            mkg:slot "substrate" ] ;
    mkg:page "7" ;
    mkg:possibleMisprint "The denominator has substrate-concentration units while \\mu_{max} has time⁻¹ units, so the expression yields time⁻¹ per concentration rather than the stated specific-growth-rate units." ;
    mkg:quote "\\mu=\\frac{\\mu_{max}}{K_{s}+S+\\frac{s^{2}}{K_{1}}+\\frac{s^{3}}{K_{2}^{2}}}" ;
    mkg:reviewOutcome "paper misprint" ;
    mkg:status "pending" .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq13/var/mu> a mkg:Variable ;
    rdfs:label "\\mu (muloiwa_2020 eq 13)"@en ;
    mkg:description "Specific bacteria growth rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "\\mu" ;
    mkg:unit "1 / s" ;
    mkg:unitNote "dimension only, no unit printed" ;
    mkg:unitString "time^-1" .

<http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq13_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:contextDescription "The paper compares models for bacterial growth in biological wastewater treatment, where microorganisms use dissolved or particulate organic matter as substrate. The models predict specific bacterial growth rate from substrate concentration, and in some cases biomass concentration, using 14 unstructured model families. Their rate expressions represent substrate limitation and, in several models, growth inhibition at high substrate concentrations; the paper reviews them rather than building one complete process model. The evidence comes from published experiments across different organisms, substrates and systems, including batch reactors, with biomass measured by dry weight or optical density. The authors compare reported fits mainly with R² and RMSE, and identify the Haldane model as the most frequently and successfully reported model, while noting that model performance varies with experimental and analytical practice." ;
    mkg:description "The Han–Levenspiel law computes specific growth rate from substrate concentration with growth slowing or ceasing at a critical inhibitor concentration." ;
    mkg:doi "10.1016/j.sajce.2020.07.006" ;
    mkg:form "algebraic" ;
    mkg:freeLaw true ;
