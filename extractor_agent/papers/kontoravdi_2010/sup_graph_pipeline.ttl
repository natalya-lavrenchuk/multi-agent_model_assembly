    mkg:latex "m_{g l n}=\\frac{\\alpha_{1}[G L N]}{\\alpha_{2}+[G L N]}" ;
    mkg:uses <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq12/var/C_GLN> .

