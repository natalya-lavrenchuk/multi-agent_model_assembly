            mkg:slot "death threshold" ] ;
    mkg:page "7" ;
    mkg:possibleMisprint "The definition of \\mu_{d,max} calls it the maximum specific growth rate, but Eq. 7 and the surrounding text use it as the maximum specific cell-death rate." ;
    mkg:quote "\\mu_{d}=\\frac{\\mu_{d,m a x}}{1+(K_{d,a m m}/[A M M])^{n}},\\quad n>1" ;
    mkg:reviewOutcome "false alarm" ;
    mkg:status "pending" .

<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq8> a mkg:Law ;
    rdfs:label "kontoravdi_2010 eq 8"@en ;
    mkg:computes <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq8/var/C_GLC> ;
    mkg:equationNumber "8" ;
    mkg:hasMetadata <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq8_meta> ;
    mkg:latex "$$ \\frac{d(V[G L C])}{d t}=-Q_{g l c}V X_{\\nu}+F_{i n}[G L C]_{i n}-F_{o u t}[G L C], $$" ;
    mkg:uses <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq8/var/C_GLC_in>,
        <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq8/var/F_in>,
        <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq8/var/F_out>,
        <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq8/var/Q_glc>,
        <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq8/var/V>,
        <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq8/var/X_nu> .

<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq8/var/C_GLC> a mkg:Variable ;
    rdfs:label "[GLC] (kontoravdi_2010 eq 8)"@en ;
    mkg:description "Extracellular glucose concentration." ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:measured true ;
    mkg:measuredQuote "Extra-cellular glucose, glutamine, lactate and ammonia concentrations were measured with the YSI Bioprofiler 200 (Nova Biomedical, UK)." ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "[GLC]" ;
    mkg:unit "mM" ;
    mkg:unitString "mM" .

<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq8/var/C_GLC_in> a mkg:Variable ;
    rdfs:label "[GLC]_{in} (kontoravdi_2010 eq 8)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Glucose concentration in the incoming feed." ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:initialQuote "the concentrations of glucose and glutamine in the feed were set at 500 and 100 mM, respectively." ;
    mkg:initialValue "500 mM" ;
    mkg:reason "An inlet feed concentration set for the culture run, so it is an operating condition." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "[GLC]_{in}" ;
    mkg:unit "mM" ;
    mkg:unitString "mM" .

<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq8/var/F_in> a mkg:Variable ;
