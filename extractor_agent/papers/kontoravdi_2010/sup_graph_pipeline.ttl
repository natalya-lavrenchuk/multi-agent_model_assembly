    mkg:latex "Q_{g l c}=\\frac{\\mu}{Y_{x,g l c}}+m_{g l c}" ;
    mkg:uses <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq9/var/mu> .

<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq9/var/Q_glc> a mkg:Variable ;
