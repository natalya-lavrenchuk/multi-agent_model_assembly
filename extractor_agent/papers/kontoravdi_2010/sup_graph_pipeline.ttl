<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq27> a mkg:Law ;
    rdfs:label "kontoravdi_2010 eq 27"@en ;
    mkg:computes <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq27/var/C_MAb> ;
    mkg:equationNumber "27" ;
    mkg:hasMetadata <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq27_meta> ;
    mkg:hasParameter <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq27/par/gamma_1>,
        <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq27/par/gamma_2> ;
    mkg:latex "\\frac{d([{M A}b])}{d t}=(\\gamma_{2}-\\gamma_{1}\\mu)Q_{{M A}b}V X_{\\nu}-F_{{o u t}}[{M A}b]" ;
    mkg:latexCorrected "$$ \\frac{d(V[MAb])}{dt}=(\\gamma_{2}-\\gamma_{1}\\mu)Q_{MAb}V X_{\\nu}-F_{out}[MAb], $$" ;
    mkg:uses <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq27/var/F_out>,
        <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq27/var/Q_MAb>,
        <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq27/var/V>,
        <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq27/var/X_nu>,
        <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq27/var/mu> .

