    mkg:status "accepted" ;
    mkg:symbol "F_{in}" ;
    mkg:unit "l / h" ;
    mkg:unitString "L h^-1" .

<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq8/var/F_out> a mkg:Variable ;
