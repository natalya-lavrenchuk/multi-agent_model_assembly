<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq9_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:description "Specific glucose uptake is calculated as the growth-associated glucose demand plus the glucose maintenance demand." ;
    mkg:doi "10.1016/j.compchemeng.2010.03.012" ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq9/par/m_glc> ;
            mkg:slot "maintenance coefficient" ],
        [ mkg:boundTo <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq9/par/Y_x_glc> ;
            mkg:slot "yield" ] ;
    mkg:page "7" ;
    mkg:quote "Q_{g l c}=\\frac{\\mu}{Y_{x,g l c}}+m_{g l c}" ;
    mkg:status "pending" .

<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq11/par/Y_x_gln> a mkg:Parameter ;
    rdfs:label "Y_{x,gln} (kontoravdi_2010 eq 11)"@en ;
    mkg:basis "stated" ;
    mkg:description "Yield of cells on glutamine." ;
