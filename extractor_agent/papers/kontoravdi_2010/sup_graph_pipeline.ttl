    mkg:status "accepted" ;
    mkg:symbol "Y_{x,gln}" ;
    mkg:unit "cells / mmol" ;
    mkg:unitString "cell/mmol" ;
    mkg:valueUncertainty "2.546 × 10^7 (95% confidence interval; fed-batch)" ;
    mkg:valuesByCase "{\"batch operation\": \"5.6 × 10^8 cell/mmol\", \"fed-batch operation\": \"8 × 10^8 cell/mmol\"}" .

