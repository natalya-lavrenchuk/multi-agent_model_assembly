<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq8_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Glucose balance around the bioreactor accounting for cellular uptake and glucose entering and leaving with the flow." ;
    mkg:doi "10.1016/j.compchemeng.2010.03.012" ;
    mkg:form "ODE" ;
    mkg:ocrFixNote "The OCR dropped the d in d(V[GLC])/dt." ;
    mkg:page "7" ;
    mkg:quote "\\frac{d(V[G L C])}{d t}=-Q_{g l c}V X_{\\nu}+F_{i n}[G L C]_{i n}-F_{o u t}[G L C]" ;
    mkg:reviewOutcome "reading corrected" ;
    mkg:status "pending" .

<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq9> a mkg:Law ;
    rdfs:label "kontoravdi_2010 eq 9"@en ;
    mkg:computes <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq9/var/Q_glc> ;
    mkg:equationNumber "9" ;
    mkg:hasMetadata <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq9_meta> ;
