<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq5_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:correctionQuote "The specific cell growth rate is determined by the concentrations of the glucose, glutamine, lactate and ammonia, following Monod kinetics:" ;
    mkg:correctionReason "The second Monod term is for glutamine, so its concentration should be [GLN] in both numerator and denominator." ;
    mkg:correctionStatus "accepted" ;
    mkg:description "Nutrient-limitation factor for cell growth computed as a product of two saturation terms, both printed with extracellular glucose." ;
    mkg:doi "10.1016/j.compchemeng.2010.03.012" ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq5/par/K_gln> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq5/par/K_glc> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq5/var/C_GLC> ;
            mkg:slot "substrate" ] ;
    mkg:page "7" ;
    mkg:possibleMisprint "The second saturation term uses [GLC] in both numerator and denominator even though K_{gln} is the glutamine Monod constant and the text says growth depends on glucose and glutamine; it should use the glutamine concentration." ;
    mkg:quote "f_{l i m}=\\left(\\frac{[G L C]}{K_{g l c}+[G L C]}\\right)\\left(\\frac{[G L C]}{K_{g l n}+[G L C]}\\right)" ;
    mkg:reviewOutcome "paper misprint" ;
    mkg:status "pending" .

