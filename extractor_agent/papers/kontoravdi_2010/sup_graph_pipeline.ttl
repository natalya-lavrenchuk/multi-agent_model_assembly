<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq27_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:correctionReason "The production and outlet terms are amount rates, so the balance left-hand side should differentiate the amount V[MAb]." ;
    mkg:correctionStatus "accepted" ;
    mkg:description "The extracellular MAb balance computes production by viable cells, adjusted for growth, and loss through outlet flow." ;
    mkg:doi "10.1016/j.compchemeng.2010.03.012" ;
    mkg:form "ODE" ;
    mkg:page "7" ;
    mkg:possibleMisprint "The production and outlet terms are missing division by V: with [MAb] defined as a concentration, Q_MAb V X_ν and F_out[MAb] have amount-per-time units rather than concentration-per-time units." ;
    mkg:quote "\\frac{d([{M A}b])}{d t}=(\\gamma_{2}-\\gamma_{1}\\mu)Q_{{M A}b}V X_{\\nu}-F_{{o u t}}[{M A}b]" ;
    mkg:reviewOutcome "paper misprint" ;
    mkg:status "pending" .

