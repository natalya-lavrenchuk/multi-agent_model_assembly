<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq4/par/mu_max> a mkg:Parameter ;
    rdfs:label "\\mu_{max} (kontoravdi_2010 eq 4)"@en ;
    mkg:basis "stated" ;
    mkg:description "Maximum specific growth rate." ;
    mkg:dimension "1 / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "The results of the designed experiments were used to estimate the values of model parameters" ;
    mkg:page "2" ;
    mkg:quote "maximum specific growth rate" ;
    mkg:reason "It is a maximum specific growth-rate constant, estimated from fed-batch data." ;
    mkg:siFactor 2.777778e-04 ;
    mkg:status "accepted" ;
    mkg:symbol "\\mu_{max}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" ;
    mkg:value 5.4e-02 ;
    mkg:valueUncertainty "90% CI: 8.306 × 10^-4; 95% CI: 9.909 × 10^-4; 99% CI: 1.305 × 10^-3" .

