<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq11_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:description "Specific glutamine uptake is calculated as the growth-associated glutamine demand plus the glutamine maintenance demand." ;
    mkg:doi "10.1016/j.compchemeng.2010.03.012" ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq11/par/Y_x_gln> ;
            mkg:slot "yield" ],
        [ mkg:boundTo <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq11/var/m_gln> ;
            mkg:slot "maintenance coefficient" ] ;
    mkg:page "7" ;
    mkg:quote "Q_{g l n}=\\frac{\\mu}{Y_{x,g l n}}+m_{g l n}" ;
    mkg:status "pending" .

<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq12> a mkg:Law ;
    rdfs:label "kontoravdi_2010 eq 12"@en ;
    mkg:computes <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq12/var/m_gln> ;
