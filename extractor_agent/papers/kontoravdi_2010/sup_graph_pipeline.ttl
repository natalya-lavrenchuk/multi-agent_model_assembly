<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq9/par/Y_x_glc> a mkg:Parameter ;
    rdfs:label "Y_{x,glc} (kontoravdi_2010 eq 9)"@en ;
    mkg:basis "stated" ;
    mkg:description "Yield of cells on glucose." ;
    mkg:dimension "[cell] / [substance]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "Table 2 Parameter estimation results for fed-batch culture." ;
    mkg:page "3" ;
    mkg:quote "the yield of cells on glucose" ;
    mkg:reason "A cell-yield coefficient in the nutrient-dependent growth law, treated as a fitted model parameter." ;
    mkg:siFactor 1e+03 ;
    mkg:status "accepted" ;
    mkg:symbol "Y_{x,glc}" ;
    mkg:unit "cells / mmol" ;
    mkg:unitString "cell/mmol" ;
    mkg:valueUncertainty "2.654 × 10^7 (95% confidence interval; fed-batch)" ;
    mkg:valuesByCase "{\"batch operation\": \"1.1 × 10^8 cell/mmol\", \"fed-batch operation\": \"2.6 × 10^8 cell/mmol\"}" .

<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq9/par/m_glc> a mkg:Parameter ;
    rdfs:label "m_{glc} (kontoravdi_2010 eq 9)"@en ;
    mkg:basis "stated" ;
    mkg:description "Maintenance coefficient of glucose." ;
    mkg:dimension "[substance] / [cell] / [time]" ;
    mkg:page "2" ;
    mkg:quote "maintenance coefficient of glucose" ;
    mkg:reason "A glucose maintenance coefficient, a constant in the glucose uptake-rate law." ;
    mkg:siFactor 2.777778e-07 ;
    mkg:status "accepted" ;
    mkg:symbol "m_{glc}" ;
    mkg:unit "mmol / cells / h" ;
    mkg:unitString "mmol/cell/h" ;
    mkg:valuesByCase "{\"batch operation\": \"4.9 × 10^-14 mmol/cell/h\", \"fed-batch operation\": \"4.9 × 10^-14 mmol/cell/h\"}" .

