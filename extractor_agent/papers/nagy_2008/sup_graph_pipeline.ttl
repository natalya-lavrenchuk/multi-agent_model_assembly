@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kg:nagy_2008 a mkg:Sup ;
    rdfs:label "nagy_2008 · Determination of the Kinetic Parameters for the Crystallization of Paracetamol from Water Using Metastable Zone Width Experiments"@en ;
    mkg:hasMetadata kg:nagy_2008_meta ;
    mkg:includes <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.1>,
        <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.2>,
        <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.3>,
        <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.4>,
        <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.5>,
        <http://example.org/kg/nagy_2008/law/nagy_2008_eq12>,
        <http://example.org/kg/nagy_2008/law/nagy_2008_eq13>,
        <http://example.org/kg/nagy_2008/law/nagy_2008_eq21> .

<http://example.org/kg/nagy_2008/law/nagy_2008_eq11.1> a mkg:Law ;
    rdfs:label "nagy_2008 eq 11.1"@en ;
    mkg:computes <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.1/var/mu_0> ;
    mkg:equationNumber "11.1" ;
    mkg:hasMetadata <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.1_meta> ;
    mkg:latex "\\dot{\\mu}_{0} = B" ;
    mkg:uses <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.1/var/B> .

<http://example.org/kg/nagy_2008/law/nagy_2008_eq11.1/var/B> a mkg:Variable ;
    rdfs:label "B (nagy_2008 eq 11.1)"@en ;
    mkg:description "Primary number nucleation rate." ;
    mkg:dimension "1 / [mass] / [time]" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "B" ;
    mkg:unit "number / kg / s" ;
    mkg:unitNote "dimension only, no unit printed solvent" ;
    mkg:unitString "number kg solvent^-1 time^-1" .

<http://example.org/kg/nagy_2008/law/nagy_2008_eq11.1/var/mu_0> a mkg:Variable ;
    rdfs:label "\\mu_{0} (nagy_2008 eq 11.1)"@en ;
    mkg:description "Zeroth moment of the crystal size distribution." ;
    mkg:dimension "1 / [mass]" ;
    mkg:initialQuote "For unseeded systems, the initial condition for eq 11 is given by $\\mu_i(0) = 0$ ($i = 0, 1, 2, 3$), and $C(0) = C_i$." ;
    mkg:initialValue "0 number kg solvent^-1" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "\\mu_{0}" ;
    mkg:unit "number / kg" ;
    mkg:unitNote "dimension only, no unit printed solvent" ;
    mkg:unitString "number kg solvent^-1" .

<http://example.org/kg/nagy_2008/law/nagy_2008_eq11.1_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The zeroth-moment balance tracks the accumulation of crystal number through primary nucleation." ;
    mkg:doi "10.1021/ie060637c" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "when only one characteristic size is considered" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The moment model considers only one characteristic crystal size." ],
        [ mkg:quote "The consideration of primary nucleation as the dominant form of nucleation is valid from t = 0 to a short period after t_ind, where the surface area of the crystals are not large enough for substantial secondary nucleation to occur." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Primary nucleation is treated as dominant from the start of supersaturation until a short period after the induction time." ],
        [ mkg:quote "For unseeded systems, the initial condition for eq 11 is given by" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The model is applied to an unseeded system with zero initial moments." ] ;
    mkg:page "3" ;
    mkg:quote "\\dot{\\mu}_{0} = B" ;
    mkg:status "flagged" .

<http://example.org/kg/nagy_2008/law/nagy_2008_eq11.2> a mkg:Law ;
    rdfs:label "nagy_2008 eq 11.2"@en ;
    mkg:computes <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.2/var/mu_1> ;
    mkg:equationNumber "11.2" ;
    mkg:hasMetadata <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.2_meta> ;
    mkg:hasParameter <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.2/par/r_0> ;
    mkg:latex "\\dot{\\mu}_{1} = G\\mu_{0}+Br_{0}" ;
    mkg:uses <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.2/var/B>,
        <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.2/var/G>,
        <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.2/var/mu_0> .

<http://example.org/kg/nagy_2008/law/nagy_2008_eq11.2/par/r_0> a mkg:Parameter ;
    rdfs:label "r_{0} (nagy_2008 eq 11.2)"@en ;
    mkg:basis "stated" ;
    mkg:description "Crystal size at nucleation." ;
    mkg:dimension "[length]" ;
    mkg:estimation "set" ;
    mkg:estimationQuote "The size of the nuclei is considered negligible ( $ r_0 \\simeq 0 $)." ;
    mkg:page "3" ;
    mkg:quote "and $ r_{0} $ is the crystal size at nucleation." ;
    mkg:reason "A crystal-size-at-nucleation parameter that the model treats as negligible." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "r_{0}" ;
    mkg:unit "m" ;
    mkg:unitNote "dimension only, no unit printed" ;
    mkg:unitString "length" ;
    mkg:value 0 .

<http://example.org/kg/nagy_2008/law/nagy_2008_eq11.2/var/B> a mkg:Variable ;
    rdfs:label "B (nagy_2008 eq 11.2)"@en ;
    mkg:description "Primary number nucleation rate." ;
    mkg:dimension "1 / [mass] / [time]" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "B" ;
    mkg:unit "number / kg / s" ;
    mkg:unitNote "dimension only, no unit printed solvent" ;
    mkg:unitString "number kg solvent^-1 time^-1" .

<http://example.org/kg/nagy_2008/law/nagy_2008_eq11.2/var/G> a mkg:Variable ;
    rdfs:label "G (nagy_2008 eq 11.2)"@en ;
    mkg:description "Growth rate." ;
    mkg:dimension "[length] / [time]" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "G" ;
    mkg:unit "m / s" ;
    mkg:unitNote "dimension only, no unit printed" ;
    mkg:unitString "length time^-1" .

<http://example.org/kg/nagy_2008/law/nagy_2008_eq11.2/var/mu_0> a mkg:Variable ;
    rdfs:label "\\mu_{0} (nagy_2008 eq 11.2)"@en ;
    mkg:description "Zeroth moment of the crystal size distribution." ;
    mkg:dimension "1 / [mass]" ;
    mkg:initialQuote "For unseeded systems, the initial condition for eq 11 is given by $\\mu_i(0) = 0$ ($i = 0, 1, 2, 3$), and $C(0) = C_i$." ;
    mkg:initialValue "0 number kg solvent^-1" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "\\mu_{0}" ;
    mkg:unit "number / kg" ;
    mkg:unitNote "dimension only, no unit printed solvent" ;
    mkg:unitString "number kg solvent^-1" .

<http://example.org/kg/nagy_2008/law/nagy_2008_eq11.2/var/mu_1> a mkg:Variable ;
    rdfs:label "\\mu_{1} (nagy_2008 eq 11.2)"@en ;
    mkg:description "First moment of the crystal size distribution." ;
    mkg:dimension "[length] / [mass]" ;
    mkg:initialQuote "For unseeded systems, the initial condition for eq 11 is given by $\\mu_i(0) = 0$ ($i = 0, 1, 2, 3$), and $C(0) = C_i$." ;
    mkg:initialValue "0 length number kg solvent^-1" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "\\mu_{1}" ;
    mkg:unit "number * m / kg" ;
    mkg:unitNote "dimension only, no unit printed solvent" ;
    mkg:unitString "length number kg solvent^-1" .

<http://example.org/kg/nagy_2008/law/nagy_2008_eq11.2_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The first crystal-size moment changes through growth of existing crystals and the nucleation source at size r0." ;
    mkg:doi "10.1021/ie060637c" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:reasoned true ;
            mkg:severity "warning" ;
            mkg:text "The size of newly formed nuclei is treated as negligible." ],
        [ mkg:quote "The consideration of primary nucleation as the dominant form of nucleation is valid from t = 0 to a short period after t_ind, where the surface area of the crystals are not large enough for substantial secondary nucleation to occur." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Primary nucleation is treated as dominant from the start of supersaturation until a short period after the induction time." ],
        [ mkg:quote "when only one characteristic size is considered" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The moment model considers only one characteristic crystal size." ],
        [ mkg:quote "For unseeded systems, the initial condition for eq 11 is given by" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The model is applied to an unseeded system with zero initial moments." ] ;
    mkg:page "3" ;
    mkg:quote "\\dot{\\mu}_{1} = G\\mu_{0}+Br_{0}" ;
    mkg:status "flagged" .

<http://example.org/kg/nagy_2008/law/nagy_2008_eq11.3> a mkg:Law ;
    rdfs:label "nagy_2008 eq 11.3"@en ;
