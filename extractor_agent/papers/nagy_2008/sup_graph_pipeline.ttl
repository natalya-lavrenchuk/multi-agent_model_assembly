<http://example.org/kg/nagy_2008/law/nagy_2008_eq11.5> a mkg:Law ;
    rdfs:label "nagy_2008 eq 11.5"@en ;
    mkg:computes <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.5/var/C> ;
    mkg:equationNumber "11.5" ;
    mkg:hasMetadata <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.5_meta> ;
    mkg:hasParameter <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.5/par/k_v>,
        <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.5/par/r_0>,
        <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.5/par/rho_c> ;
    mkg:latex "\\dot{C} = -\\rho_{c}k_{v}(3G\\mu_{2}+Br_{0}^{~3})" ;
    mkg:uses <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.5/var/B>,
        <http://example.org/kg/nagy_2008/law/nagy_2008_eq11.5/var/G>,
