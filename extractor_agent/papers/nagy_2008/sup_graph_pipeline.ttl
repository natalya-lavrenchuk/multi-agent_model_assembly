<http://example.org/kg/nagy_2008/law/nagy_2008_eq11.5_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The solution concentration decreases as crystal volume is generated by growth and nucleation." ;
    mkg:doi "10.1021/ie060637c" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "The consideration of primary nucleation as the dominant form of nucleation is valid from t = 0 to a short period after t_ind, where the surface area of the crystals are not large enough for substantial secondary nucleation to occur." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Primary nucleation is treated as dominant from the start of supersaturation until a short period after the induction time." ],
        [ mkg:quote "For unseeded systems, the initial condition for eq 11 is given by" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The model is applied to an unseeded system with zero initial moments." ],
        [ mkg:quote "when only one characteristic size is considered" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The moment model considers only one characteristic crystal size." ],
        [ mkg:reasoned true ;
            mkg:severity "warning" ;
            mkg:text "The size of newly formed nuclei is treated as negligible." ] ;
    mkg:page "3" ;
    mkg:quote "\\dot{C} = -\\rho_{c}k_{v}(3G\\mu_{2}+Br_{0}^{~3})" ;
    mkg:status "flagged" .

