<http://example.org/kg/nagy_2008/law/nagy_2008_eq12/par/k_g> a mkg:Parameter ;
    rdfs:label "k_{g} (nagy_2008 eq 12)"@en ;
    mkg:basis "stated" ;
    mkg:description "kinetic constant for growth rate" ;
    mkg:dimension "[length] / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "To estimate the four kinetic parameters $(k_b, b, k_g, g)$, the experimental data are fitted to the output of the model (concentration $C$ and moment ratios $\\mu_1/\\mu_0$, $\\mu_2/\\mu_0$, and $\\mu_3/\\mu_0$) by the nonlinear least-squares technique." ;
    mkg:page "7" ;
    mkg:quote "$ k_{g} $ = kinetic constant for growth rate" ;
    mkg:reason "A kinetic constant in the crystal-growth rate law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "k_{g}" ;
    mkg:unit "m / s" ;
    mkg:unitNote "dimension only, no unit printed" ;
    mkg:unitString "length time^-1" ;
    mkg:value 4.11e+00 ;
    mkg:valueUncertainty "± 1.23" .

<http://example.org/kg/nagy_2008/law/nagy_2008_eq12/var/Delta_C> a mkg:Variable ;
    rdfs:label "\\Delta C (nagy_2008 eq 12)"@en ;
    mkg:basis "inferred" ;
    mkg:description "supersaturation" ;
    mkg:dimension "dimensionless" ;
    mkg:reason "A process supersaturation quantity that varies with solution concentration and equilibrium concentration." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "\\Delta C" ;
    mkg:unit "dimensionless" ;
    mkg:unitNote "PCM water" ;
    mkg:unitString "g PCM/g water" .

<http://example.org/kg/nagy_2008/law/nagy_2008_eq13/par/k_b> a mkg:Parameter ;
    rdfs:label "k_{b} (nagy_2008 eq 13)"@en ;
    mkg:basis "stated" ;
    mkg:description "kinetic constant for number nucleation rate" ;
    mkg:dimension "1 / [length] ** 3 / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "To estimate the four kinetic parameters $(k_b, b, k_g, g)$, the experimental data are fitted to the output of the model (concentration $C$ and moment ratios $\\mu_1/\\mu_0$, $\\mu_2/\\mu_0$, and $\\mu_3/\\mu_0$) by the nonlinear least-squares technique." ;
    mkg:page "7" ;
    mkg:quote "$ k_{b} $ = kinetic constant for number nucleation rate" ;
    mkg:reason "A kinetic constant in the primary number nucleation-rate law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "k_{b}" ;
    mkg:unit "number / m ** 3 / s" ;
    mkg:unitNote "dimension only, no unit printed" ;
    mkg:unitString "number volume^-1 time^-1" ;
    mkg:value 4.581e+01 ;
    mkg:valueUncertainty "± 4.55" .

