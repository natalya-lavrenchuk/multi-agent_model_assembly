<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq3/par/K> a mkg:Parameter ;
    rdfs:label "K (lopezmeza_2016 eq 3)"@en ;
    mkg:basis "stated" ;
    mkg:description "Monod half-velocity constant (the K_s parameter)." ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "The kinetic parameter values for this Monod-type model for both naive and recombinant CHO cells were obtained using a Lineweaver–Burk linearization strategy" ;
    mkg:page "9" ;
    mkg:quote "$K_\\text{s}$ is the half-velocity constant" ;
    mkg:reason "Monod half-velocity constant, a kinetic saturation constant." ;
    mkg:sameQuantityAs "s" ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K" ;
    mkg:unit "mg / ml" ;
    mkg:unitString "mg/mL" ;
    mkg:valuesByCase "{\"n-CHO, 33 °C\": \"0.286 mg/mL\", \"n-CHO, 37 °C\": \"1.023 mg/mL\", \"r-CHO, 33 °C\": \"0.664 mg/mL\", \"r-CHO, 37 °C\": \"0.664 mg/mL\"}" .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq3/par/mu_max> a mkg:Parameter ;
    rdfs:label "\\mu_{max} (lopezmeza_2016 eq 3)"@en ;
    mkg:basis "stated" ;
    mkg:description "Maximum specific growth rate." ;
    mkg:dimension "1 / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "The kinetic parameter values for this Monod-type model for both naive and recombinant CHO cells were obtained using a Lineweaver–Burk linearization strategy" ;
    mkg:page "9" ;
    mkg:quote "$\\mu_{\\text{max}}$ is the maximum specific growth rate" ;
    mkg:reason "Maximum specific growth rate, an estimated constant in the Monod growth law." ;
    mkg:siFactor 2.777778e-04 ;
    mkg:status "accepted" ;
    mkg:symbol "\\mu_{max}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" ;
    mkg:valuesByCase "{\"n-CHO, 33 °C\": \"0.038 h^-1\", \"n-CHO, 37 °C\": \"0.05 h^-1\", \"r-CHO, 33 °C\": \"0.040 h^-1\", \"r-CHO, 37 °C\": \"0.040 h^-1\"}" .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq3/var/C_S> a mkg:Variable ;
