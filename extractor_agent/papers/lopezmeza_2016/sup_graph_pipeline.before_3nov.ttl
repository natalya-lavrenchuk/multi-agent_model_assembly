<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq5_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Antibody accumulation is modeled as the sum of a term proportional to cell growth and a term proportional to viable cell concentration." ;
    mkg:doi "10.1007/s10616-015-9889-2" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "We also assumed that a Luedeking–Piret model could describe the kinetics of mAb throughout the entire duration of the cell culture." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The Luedeking–Piret law is assumed to describe antibody kinetics throughout the entire cell-culture duration." ] ;
    mkg:page "4" ;
    mkg:quote "\\mathbf{d}[\\boldsymbol{P}]/\\mathbf{d}\\mathbf{t}=\\mathbf{r}_{\\mathbf{p}}=\\alpha\\mathbf{r}_{\\mathbf{x}}+\\boldsymbol{\\beta}[\\boldsymbol{X}];\\quad\\mathbf{r}_{\\mathbf{x}}=\\mathbf{d}[\\boldsymbol{X}]/\\mathbf{d}\\mathbf{t}" ;
    mkg:status "pending" .

kg:lopezmeza_2016_meta a mkg:Metadata ;
    mkg:completeModel true ;
    mkg:description "The model describes growth, glucose use, and infliximab-biosimilar production by native and recombinant CHO-S cells. It combines first-order growth during the exponential phase with a threshold-modified Monod growth relationship, a cell-yield description of glucose consumption, and a Luedeking–Piret description of antibody formation. The authors developed it using batch cultures in shake flasks at different initial glucose concentrations and temperatures, then evaluated its product-formation description in instrumented batch and fed-batch bioreactors. Cell, glucose, lactate, and active antibody concentrations were measured daily. The authors present the simple kinetic models as tools for understanding and characterizing cell-culture processes, and for applications such as monitoring, control, and optimization." ;
    mkg:doi "10.1007/s10616-015-9889-2" ;
    mkg:form "DAE" ;
    mkg:hasFact [ mkg:basis "stated" ;
            mkg:quote "The viable cell [X] and glucose concentration [S] profiles observed in the exponential phase of batch experiments were fitted to second-order polynomial equations using Excel Software" ;
            mkg:text "Cell and glucose profiles during exponential growth were fitted with second-order polynomials and differentiated to estimate growth and glucose-consumption rates." ;
            mkg:topic "data processing" ],
        [ mkg:basis "stated" ;
            mkg:quote "Batch cultures were performed using naive (n-CHO) or recombinant cells (r-CHO) in 125-mL shake flasks with 30-mL working volume." ;
            mkg:text "Shake-flask batch cultures used 125-mL flasks with a 30-mL working volume." ;
            mkg:topic "equipment" ],
        [ mkg:basis "stated" ;
            mkg:quote "The fed-batch protocol consisted of a temperature reduction (31 °C) on the seventh day and five intermittent feed additions (CD EfficientFeed™ B, Invitrogen, Carlsbad, CA, USA) of 10 % the initial volume starting on day 1." ;
            mkg:text "The methods describe fed-batch operation with five intermittent additions of feed, each 10% of the initial culture volume, starting on day 1, and a temperature reduction on day 7." ;
            mkg:topic "feeding" ],
        [ mkg:basis "stated" ;
            mkg:quote "The values of α and β were chosen to fit several experimental data sets of cell concentration and mAb production profiles." ;
