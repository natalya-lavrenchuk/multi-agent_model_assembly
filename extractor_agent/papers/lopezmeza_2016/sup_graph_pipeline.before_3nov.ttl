@prefix kg: <http://example.org/kg/lopezmeza_2016/> .
@prefix mkg: <http://example.org/mkg#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kg:lopezmeza_2016 a mkg:Sup ;
    rdfs:label "lopezmeza_2016 · Using simple models to describe the kinetics of growth, glucose consumption, and monoclonal antibody formation in naive and infliximab producer CHO cells"@en ;
    mkg:hasMetadata kg:lopezmeza_2016_meta ;
    mkg:includes <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq1>,
        <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq3>,
        <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq4>,
        <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq5> .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq1> a mkg:Law ;
    rdfs:label "lopezmeza_2016 eq 1"@en ;
    mkg:computes <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq1/var/C_X> ;
    mkg:equationNumber "1" ;
    mkg:hasMetadata <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq1_meta> ;
    mkg:latex "\\mathbf{d}[\\boldsymbol{X}]/\\mathbf{d}\\mathbf{t}=\\mu[\\boldsymbol{X}];\\mathrm{~w i t h~}[\\boldsymbol{X}]=[\\boldsymbol{X}]_{\\mathrm{o}}\\circledast\\mathbf{t}=\\mathbf{t}_{\\mathrm{o}}=0.0" ;
    mkg:uses <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq1/var/mu> .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq1/var/C_X> a mkg:Variable ;
    rdfs:label "[X] (lopezmeza_2016 eq 1)"@en ;
    mkg:description "Cell concentration." ;
    mkg:dimension "[cell] / [length] ** 3" ;
    mkg:initialQuote "Cultures were seeded at a viable cell density of ~2 × 10⁵ cells/mL" ;
    mkg:initialValue "~2 × 10^5 cells/mL" ;
    mkg:measured true ;
    mkg:measuredQuote "Cell density and viability were evaluated via the trypan blue dye exclusion assay using a flow cytometer" ;
    mkg:siFactor 1e+06 ;
    mkg:symbol "[X]" ;
    mkg:unit "cells / ml" ;
    mkg:unitString "cells/mL" .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq1/var/mu> a mkg:Variable ;
    rdfs:label "\\mu (lopezmeza_2016 eq 1)"@en ;
    mkg:description "Specific growth rate of the cells." ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "\\mu" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq1_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Cell growth during the initial exponential phase is modeled as an increase proportional to biomass concentration." ;
    mkg:doi "10.1007/s10616-015-9889-2" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "[ X ]=[ X ]_{ o }\\circledast t = t _{ o }=0.0" ;
            mkg:reasoned false ;
            mkg:text "[ X ]=[ X ]_{ o }\\circledast t = t _{ o }=0.0" ],
        [ mkg:quote "during the initial stage of exponential growth at each initial substrate concentration" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The law is applied during the initial exponential-growth stage at each initial substrate concentration." ],
        [ mkg:quote "μ is the specific growth rate with a constant value at least during the initial portion of the exponential phase." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The specific growth rate is treated as constant during at least the initial portion of the exponential phase." ] ;
    mkg:page "4" ;
    mkg:quote "\\mathbf{d}[\\boldsymbol{X}]/\\mathbf{d}\\mathbf{t}=\\mu[\\boldsymbol{X}];\\mathrm{~w i t h~}[\\boldsymbol{X}]=[\\boldsymbol{X}]_{\\mathrm{o}}\\circledast\\mathbf{t}=\\mathbf{t}_{\\mathrm{o}}=0.0" ;
    mkg:status "pending" .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq3> a mkg:Law ;
    rdfs:label "lopezmeza_2016 eq 3"@en ;
    mkg:computes <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq3/var/mu> ;
    mkg:equationNumber "3" ;
    mkg:hasMetadata <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq3_meta> ;
    mkg:hasParameter <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq3/par/K>,
        <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq3/par/mu_max>,
        <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq3/par/s> ;
    mkg:latex "\\mathbf{\\upmu}=\\mathbf{\\upmu}_\\mathrm{max}[\\mathbf{\\upS}]*/(\\mathbf{K}\\mathbf{s}+[\\mathbf{\\upS}]*);\\mathrm{~with~}[\\mathbf{\\upS}]*=[\\mathbf{\\upS}]_\\mathrm{o}-[\\mathbf{\\upS}]_\\mathrm{t}" ;
    mkg:uses <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq3/var/C_S> .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq3/par/s> a mkg:Parameter ;
    rdfs:label "s (lopezmeza_2016 eq 3)"@en ;
    mkg:basis "stated" ;
    mkg:description "Monod half-velocity constant (the K_s parameter)." ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "The kinetic parameter values for this Monod-type model for both naive and recombinant CHO cells were obtained using a Lineweaver–Burk linearization strategy" ;
    mkg:page "9" ;
    mkg:quote "$K_\\text{s}$ is the half-velocity constant" ;
    mkg:reason "The s token is the substrate subscript in K_s, the Monod half-velocity constant." ;
    mkg:sameQuantityAs "K" ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "s" ;
    mkg:unit "mg / ml" ;
    mkg:unitString "mg/mL" ;
    mkg:valuesByCase "{\"n-CHO, 33 °C\": \"0.286 mg/mL\", \"n-CHO, 37 °C\": \"1.023 mg/mL\", \"r-CHO, 33 °C\": \"0.664 mg/mL\", \"r-CHO, 37 °C\": \"0.664 mg/mL\"}" .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq3/var/mu> a mkg:Variable ;
    rdfs:label "\\mu (lopezmeza_2016 eq 3)"@en ;
    mkg:description "Specific growth rate of the cells." ;
    mkg:dimension "1 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "\\mu" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq3_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "A Monod-type law computes specific growth rate from glucose concentration above the growth threshold." ;
    mkg:doi "10.1007/s10616-015-9889-2" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "[ S ]*=[ S ]_ o -[ S ]_ t" ;
            mkg:reasoned false ;
            mkg:text "[ S ]*=[ S ]_ o -[ S ]_ t" ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq3/par/mu_max> ;
            mkg:slot "maximum rate" ],
        [ mkg:boundTo <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq3/var/C_S> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq3/par/K> ;
            mkg:slot "saturation constant" ] ;
    mkg:page "4" ;
    mkg:quote "\\mathbf{\\upmu}=\\mathbf{\\upmu}_\\mathrm{max}[\\mathbf{\\upS}]*/(\\mathbf{K}\\mathbf{s}+[\\mathbf{\\upS}]*);\\mathrm{~with~}[\\mathbf{\\upS}]*=[\\mathbf{\\upS}]_\\mathrm{o}-[\\mathbf{\\upS}]_\\mathrm{t}" ;
    mkg:status "pending" .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq4> a mkg:Law ;
    rdfs:label "lopezmeza_2016 eq 4"@en ;
    mkg:computes <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq4/var/r_s> ;
    mkg:equationNumber "4" ;
    mkg:hasMetadata <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq4_meta> ;
    mkg:hasParameter <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq4/par/Y_x_s> ;
    mkg:latex "\\mathbf{r}_{\\mathrm{s}}=\\mathrm{d}[S]/\\mathrm{d t}=\\mathbf{r}_{\\mathrm{x}}/\\mathbf{Y}_{\\mathrm{x}/\\mathrm{s}}" ;
    mkg:latexCorrected "$$ \\mathbf{r}_{\\mathrm{s}}=\\mathrm{d}[S]/\\mathrm{d}t=-\\mathbf{r}_{\\mathrm{x}}/\\mathbf{Y}_{\\mathrm{x}/\\mathrm{s}} $$" ;
    mkg:uses <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq4/var/C_S>,
        <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq4/var/r_x> .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq4/par/Y_x_s> a mkg:Parameter ;
    rdfs:label "Y_{x/s} (lopezmeza_2016 eq 4)"@en ;
    mkg:basis "stated" ;
    mkg:description "Cell yield coefficient." ;
    mkg:dimension "[cell] / [mass]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "the yield coefficient was calculated from the slopes of $r_x$ versus $r_s$ plots at different $[S]_o$ values" ;
    mkg:page "4" ;
    mkg:quote "$Y_{x/s}$ is a cell yield coefficient" ;
    mkg:reason "Cell yield coefficient, a material conversion yield determined from experimental rate data." ;
    mkg:siFactor 1e+06 ;
    mkg:status "accepted" ;
    mkg:symbol "Y_{x/s}" ;
    mkg:unit "cells / mg" ;
    mkg:unitString "cell/mg" ;
    mkg:valuesByCase "{\"n-CHO, 33 °C (Table 2 summary)\": \"≈ 6.08 × 10^6 cell/mg\", \"n-CHO, 37 °C (Table 2 summary)\": \"≈ 6.08 × 10^6 cell/mg\", \"r-CHO, 33 °C (Table 2 summary)\": \"≈ 2.59 × 10^6 cell/mg\", \"r-CHO, 37 °C\": \"1.70 × 10^6 cell/mg\", \"n-CHO, 33 °C, initial substrate 4.8 mg/mL\": \"1.08E+7 cells/mg\", \"n-CHO, 33 °C, initial substrate 3.6 mg/mL\": \"7.25E+6 cells/mg\", \"n-CHO, 33 °C, initial substrate 2.4 mg/mL\": \"3.58E+6 cells/mg\", \"n-CHO, 33 °C, initial substrate 1.2 mg/mL\": \"2.69E+6 cells/mg\", \"r-CHO, 33 °C, initial substrate 4.8 mg/mL\": \"2.79E+6 cells/mg\", \"r-CHO, 33 °C, initial substrate 3.6 mg/mL\": \"3.19E+6 cells/mg\", \"r-CHO, 33 °C, initial substrate 2.4 mg/mL\": \"1.81E+6 cells/mg\", \"r-CHO, 33 °C, initial substrate 1.2 mg/mL\": \"7.18E+5 cells/mg\"}" .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq4/var/C_S> a mkg:Variable ;
    rdfs:label "[S] (lopezmeza_2016 eq 4)"@en ;
    mkg:basis "stated" ;
    mkg:description "Glucose concentration." ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:initialQuote "Experiments were run at different initial substrate concentrations, ranging from 1.2 to 4.8 g/L of glucose (1.2, 2.4, 3.6, and 4.8 g/L)." ;
    mkg:initialValue "1.2, 2.4, 3.6, and 4.8 g/L" ;
    mkg:measured true ;
    mkg:measuredQuote "Glucose and lactic acid concentrations were measured by HPLC" ;
    mkg:reason "Glucose concentration is a measured, run-dependent substrate concentration that changes during culture." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "[S]" ;
    mkg:unit "g / l" ;
    mkg:unitString "g/L" .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq4/var/r_s> a mkg:Variable ;
    rdfs:label "r_{s} (lopezmeza_2016 eq 4)"@en ;
    mkg:description "Global rate of glucose consumption." ;
    mkg:dimension "[mass] / [length] ** 3 / [time]" ;
    mkg:siFactor 2.777778e-04 ;
    mkg:symbol "r_{s}" ;
    mkg:unit "g / h / l" ;
    mkg:unitString "g L^-1 h^-1" .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq4/var/r_x> a mkg:Variable ;
    rdfs:label "r_{x} (lopezmeza_2016 eq 4)"@en ;
    mkg:basis "stated" ;
    mkg:description "Rate of cell growth." ;
    mkg:dimension "[cell] / [length] ** 3 / [time]" ;
    mkg:page "4" ;
    mkg:quote "$r_x$ is the rate of cell growth" ;
    mkg:reason "A time-varying cell-growth rate derived from the changing cell concentration." ;
    mkg:siFactor 2.777778e+02 ;
    mkg:status "accepted" ;
    mkg:symbol "r_{x}" ;
    mkg:unit "cells / h / ml" ;
    mkg:unitString "cells mL^-1 h^-1" .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq4_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:correctionQuote "“Polynomial equations were derived to calculate the experimental cell production rate (r_x), where r_x = d[X]/dt, and [X] is cell concentration; and the glucose consumption rate (r_s), where rs = d[S]/dt, and [S] is glucose concentration.”" ;
    mkg:correctionReason "The paper defines \\(r_s=d[S]/dt\\) and reports a positive yield coefficient, so the growth term needs a minus sign; as printed, it predicts increasing substrate during growth." ;
    mkg:correctionStatus "accepted" ;
    mkg:description "The glucose-consumption balance relates the global glucose rate to cell-growth rate through the cell yield coefficient." ;
    mkg:doi "10.1007/s10616-015-9889-2" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "we assumed that the substrate consumption during the first 7 days of culture was devoted to cell growth; that is, no significant glucose consumption was a result of product assembly." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "For yield estimation in recombinant cultures, substrate consumed during the first seven culture days is attributed to cell growth, with no significant glucose consumption attributed to product assembly." ] ;
    mkg:page "4" ;
    mkg:possibleMisprint "The equality r_s = d[S]/dt = r_x/Y_{x/s} has the wrong sign if r_s denotes positive glucose consumption, since consumption decreases [S] while r_x/Y_{x/s} is positive." ;
    mkg:quote "\\mathbf{r}_{\\mathrm{s}}=\\mathrm{d}[S]/\\mathrm{d t}=\\mathbf{r}_{\\mathrm{x}}/\\mathbf{Y}_{\\mathrm{x}/\\mathrm{s}}" ;
    mkg:reviewOutcome "paper misprint" ;
    mkg:status "pending" .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq5> a mkg:Law ;
    rdfs:label "lopezmeza_2016 eq 5"@en ;
    mkg:computes <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq5/var/C_P> ;
    mkg:equationNumber "5" ;
    mkg:hasMetadata <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq5_meta> ;
    mkg:hasParameter <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq5/par/alpha>,
        <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq5/par/beta> ;
    mkg:latex "\\mathbf{d}[\\boldsymbol{P}]/\\mathbf{d}\\mathbf{t}=\\mathbf{r}_{\\mathbf{p}}=\\alpha\\mathbf{r}_{\\mathbf{x}}+\\boldsymbol{\\beta}[\\boldsymbol{X}];\\quad\\mathbf{r}_{\\mathbf{x}}=\\mathbf{d}[\\boldsymbol{X}]/\\mathbf{d}\\mathbf{t}" ;
    mkg:uses <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq5/var/C_X>,
        <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq5/var/r_p>,
        <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq5/var/r_x> .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq5/par/alpha> a mkg:Parameter ;
    rdfs:label "\\alpha (lopezmeza_2016 eq 5)"@en ;
    mkg:basis "stated" ;
    mkg:description "Luedeking–Piret constant." ;
    mkg:dimension "[mass] / [cell]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "The values of α and β were chosen to fit several experimental data sets of cell concentration and mAb production profiles." ;
    mkg:page "5" ;
    mkg:quote "$ \\alpha $ and $ \\beta $ are the Luedeking–Piret constants" ;
    mkg:reason "It is a constant of the Luedeking–Piret product-formation law." ;
    mkg:siFactor 1e-09 ;
    mkg:status "accepted" ;
    mkg:symbol "\\alpha" ;
    mkg:unit "µg / cells" ;
    mkg:unitString "μg/cell" ;
    mkg:valuesByCase "{\"n-CHO, 33 °C\": \"0 μg/cell\", \"n-CHO, 37 °C\": \"0 μg/cell\", \"r-CHO, 33 °C\": \"7.65 × 10^-7 μg/cell\", \"r-CHO, 37 °C\": \"7.65 × 10^-7 μg/cell\"}" .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq5/par/beta> a mkg:Parameter ;
    rdfs:label "\\beta (lopezmeza_2016 eq 5)"@en ;
    mkg:basis "stated" ;
    mkg:description "Luedeking–Piret constant." ;
    mkg:dimension "[mass] / [cell] / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "The values of α and β were chosen to fit several experimental data sets of cell concentration and mAb production profiles." ;
    mkg:page "5" ;
    mkg:quote "$ \\alpha $ and $ \\beta $ are the Luedeking–Piret constants" ;
    mkg:reason "It is a constant of the Luedeking–Piret product-formation law." ;
    mkg:siFactor 2.777778e-13 ;
    mkg:status "accepted" ;
    mkg:symbol "\\beta" ;
    mkg:unit "µg / cells / h" ;
    mkg:unitString "μg/cell/h" ;
    mkg:valuesByCase "{\"n-CHO, 33 °C\": \"0 μg/cell/h\", \"n-CHO, 37 °C\": \"0 μg/cell/h\", \"r-CHO, 33 °C\": \"7.65 × 10^-8 μg/cell/h\", \"r-CHO, 37 °C\": \"1.38–3.38 × 10^-8 μg/cell/h\"}" .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq5/var/C_P> a mkg:Variable ;
    rdfs:label "[P] (lopezmeza_2016 eq 5)"@en ;
    mkg:description "mAb concentration at a given point." ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:measured true ;
    mkg:measuredQuote "An enzyme-linked immunosorbent assay (ELISA) was used to quantify the active monoclonal antibody in the collected samples" ;
    mkg:siFactor 1e-03 ;
