    mkg:measuredQuote "Cell density and viability were evaluated via the trypan blue dye exclusion assay using a flow cytometer" ;
    mkg:siFactor 1e+06 ;
    mkg:symbol "[X]" ;
    mkg:unit "cells / ml" ;
    mkg:unitString "cells/mL" .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq5/var/r_p> a mkg:Variable ;
    rdfs:label "r_{p} (lopezmeza_2016 eq 5)"@en ;
    mkg:basis "stated" ;
    mkg:description "Rate of accumulation of product in time within the reaction vessel." ;
