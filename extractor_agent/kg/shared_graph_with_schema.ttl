    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "R_{m}" ;
    mkg:unit "1 / m" ;
    mkg:unitString "m⁻¹" .

<http://example.org/kg/ho_2000/law/ho_2000_eq11/var/Delta_P> a mkg:Variable ;
