<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq24_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:description "The equilibrium constant for the first surface-center conversion is calculated from its Gibbs free energy and temperature." ;
    mkg:doi "10.1016/j.ces.2017.09.043" ;
    mkg:form "algebraic" ;
    mkg:page "4" ;
    mkg:quote "K_{1}=\\frac{k_{1}^{+}}{k_{1}^{-}}=\\exp\\left(\\frac{-\\Delta G_{1}}{RT}\\right)" ;
    mkg:status "pending" .

