<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq2> a mkg:Law ;
    rdfs:label "osberghaus_2012 eq 2"@en ;
    mkg:computes <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq2/var/Lambda> ;
    mkg:equationNumber "2" ;
    mkg:hasMetadata <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq2_meta> ;
    mkg:hasParameter <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq2/par/nu_i> ;
    mkg:latex "\\Lambda=q_{1}+\\sum_{i=2}^{n}\\nu_{i}q_{i}" ;
    mkg:uses <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq2/var/q_1>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq2/var/q_i> .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq2/par/nu_i> a mkg:Parameter ;
    rdfs:label "\\nu_{i} (osberghaus_2012 eq 2)"@en ;
    mkg:basis "stated" ;
    mkg:description "Characteristic charge of component i: average number of binding sites of the component." ;
    mkg:dimension "dimensionless" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "The SMA parameters that were estimated by the inverse method are given in Table 2." ;
    mkg:page "2" ;
    mkg:quote "$ \\nu $ (characteristic charge): average number of binding sites of the component (under the assumption of a single charged counterion)" ;
    mkg:reason "It is a characteristic charge, a constant of the SMA law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "\\nu_{i}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" ;
    mkg:valuesByCase "{\"ribonuclease A, pH 5\": \"5.42 ± 0.09\", \"ribonuclease A, pH 7\": \"3.25 ± 0.008\", \"cytochrome c, pH 5\": \"5.3 ± 0.03\", \"cytochrome c, pH 7\": \"4.09 ± 0.009\", \"lysozyme, pH 5\": \"5.07 ± 0.004\", \"lysozyme, pH 7\": \"4.72 ± 0.01\"}" .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq2/var/Lambda> a mkg:Variable ;
    rdfs:label "\\Lambda (osberghaus_2012 eq 2)"@en ;
    mkg:description "Parameter describing the ionic capacity of the adsorbent." ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:siFactor 1e+00 ;
    mkg:symbol "\\Lambda" ;
    mkg:unit "mM" ;
    mkg:unitString "mM" .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq2/var/q_1> a mkg:Variable ;
    rdfs:label "q_{1} (osberghaus_2012 eq 2)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Total salt ion concentration in the bound phase." ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:page "2" ;
    mkg:quote "the total salt ion concentration $q_1$" ;
    mkg:reason "It is a bound salt-ion concentration that varies as salt and proteins occupy the available binding sites." ;
    mkg:siFactor 1e+03 ;
    mkg:status "accepted" ;
    mkg:symbol "q_{1}" ;
    mkg:unit "M" ;
    mkg:unitString "M" .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq2/var/q_i> a mkg:Variable ;
    rdfs:label "q_{i} (osberghaus_2012 eq 2)"@en ;
    mkg:description "Concentration of component i on the adsorbent surface." ;
    mkg:dimension "[substance] / [length] ** 3" ;
    mkg:siFactor 1e+03 ;
    mkg:symbol "q_{i}" ;
    mkg:unit "M" ;
    mkg:unitString "M" .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq2_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The adsorbent ionic-capacity relation equates bound salt and charge-weighted bound protein to the total ionic capacity." ;
    mkg:doi "10.1016/j.chroma.2012.02.004" ;
    mkg:form "algebraic" ;
    mkg:page "2" ;
    mkg:quote "\\Lambda=q_{1}+\\sum_{i=2}^{n}\\nu_{i}q_{i}" ;
    mkg:status "flagged" .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq3> a mkg:Law ;
    rdfs:label "osberghaus_2012 eq 3"@en ;
    mkg:computes <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq3/var/overline_q_1> ;
    mkg:equationNumber "3" ;
    mkg:hasMetadata <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq3_meta> ;
    mkg:hasParameter <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq3/par/sigma_i> ;
    mkg:latex "\\overline{q_{1}}=q_{1}-\\sum_{i=2}^{n}\\sigma_{i}q_{i}" ;
    mkg:uses <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq3/var/q_1>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq3/var/q_i> .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq3/par/sigma_i> a mkg:Parameter ;
    rdfs:label "\\sigma_{i} (osberghaus_2012 eq 3)"@en ;
    mkg:basis "stated" ;
    mkg:description "Steric factor of component i." ;
    mkg:dimension "dimensionless" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "The SMA parameters that were estimated by the inverse method are given in Table 2." ;
    mkg:page "11" ;
    mkg:quote "steric factor of component i" ;
    mkg:reason "It is a steric factor, a constant of the SMA law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "\\sigma_{i}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" ;
    mkg:valuesByCase "{\"ribonuclease A, pH 5\": \"28.5 ± 2.2\", \"ribonuclease A, pH 7\": \"57.6 ± 0.24\", \"cytochrome c, pH 5\": \"29.8 ± 0.15\", \"cytochrome c, pH 7\": \"53.8 ± 0.28\", \"lysozyme, pH 5\": \"31.2 ± 0.19\", \"lysozyme, pH 7\": \"38.75 ± 0.74\"}" .

