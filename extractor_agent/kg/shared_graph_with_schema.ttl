<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq28/var/y_CO> a mkg:Variable ;
    rdfs:label "y_{CO} (seidel_2018 eq 28)"@en ;
    mkg:basis "stated" ;
    mkg:description "Mole fraction of carbon monoxide." ;
    mkg:dimension "dimensionless" ;
    mkg:initialQuote "dynamic experiments with step changes between CO feed ( $ y_{CO} = 12.6\\% $, $ y_{H_2} = 72.2\\% $ and $ y_{N_2} = 16.0\\% $), and $ CO_2 $ feed ( $ y_{CO_2} = 11.9\\% $, $ y_{H_2} = 71.5\\% $ and $ y_{N_2} = 16.6\\% $)" ;
