<http://example.org/kg/nausch_2023/law/nausch_2023_eq20_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The glucose balance adds glucose produced by sucrose hydrolysis and subtracts glucose consumed by active cells, accounting for changes in cultivation volume." ;
    mkg:doi "10.3389/fpls.2023.1183254" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "The sucrose to glucose or fructose DM conversion parameters ( $ m_{SG} $ and $ m_{SF} $) were set at 0.526 because one mole of sucrose always produces one mole each of glucose and fructose" ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The sucrose-to-glucose conversion parameter was fixed at 0.526." ] ;
    mkg:page "11" ;
    mkg:possibleMisprint "G is listed in mM while K_G and K_{IG} are in g L⁻¹, and the balance equates a left-hand side in mM·L per time with source and consumption terms in mass per time because m_{SG} is dimensionless and X_a is in g L⁻¹." ;
    mkg:quote "\\begin{align*}V\\frac{dG}{dt}+G\\frac{dV}{dt}&=m_{SG}\\alpha\\Bigg(\\frac{S}{S+K_{S}}\\frac{K_{IS}}{S+K_{IS}}\\Bigg)X_{a}V\\\\&\\quad-\\mu_{G}\\Bigg(\\frac{G}{G+K_{G}}\\frac{K_{IG}}{G+K_{IG}}\\Bigg)X_{a}V\\end{align*}" ;
    mkg:reviewOutcome "false alarm" ;
    mkg:status "pending" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq2_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Active dry biomass changes through growth and death in the cultivation medium." ;
    mkg:doi "10.3389/fpls.2023.1183254" ;
    mkg:form "ODE" ;
    mkg:page "5" ;
    mkg:quote "V\\frac{dX_{a}}{dt}+X_{a}\\frac{dV}{dt}=\\mu X_{a}V-k_{d}X_{a}V" ;
    mkg:status "pending" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq3> a mkg:Law ;
    rdfs:label "nausch_2023 eq 3"@en ;
    mkg:computes <http://example.org/kg/nausch_2023/law/nausch_2023_eq3/var/V> ;
    mkg:equationNumber "3" ;
    mkg:hasMetadata <http://example.org/kg/nausch_2023/law/nausch_2023_eq3_meta> ;
    mkg:latex "\\frac{dV}{dt}=F_{t}" ;
    mkg:uses <http://example.org/kg/nausch_2023/law/nausch_2023_eq3/var/F_t> .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq3/var/F_t> a mkg:Variable ;
    rdfs:label "F_{t} (nausch_2023 eq 3)"@en ;
    mkg:basis "stated" ;
    mkg:description "Feed rate at time t." ;
    mkg:dimension "[length] ** 3 / [time]" ;
    mkg:page "5" ;
    mkg:quote "we calculated the feed rate $F_{t}$ [$\\mathrm{L}\\ \\mathrm{h}^{-1}$] for each time point $t$" ;
    mkg:reason "A feed flow rate that varies over time during operation." ;
    mkg:siFactor 2.777778e-07 ;
    mkg:status "accepted" ;
    mkg:symbol "F_{t}" ;
    mkg:unit "l / h" ;
    mkg:unitString "L h^-1" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq3/var/V> a mkg:Variable ;
    rdfs:label "V (nausch_2023 eq 3)"@en ;
    mkg:description "Volume of the cultivation medium." ;
    mkg:dimension "[length] ** 3" ;
    mkg:siFactor 1e-03 ;
    mkg:symbol "V" ;
    mkg:unit "l" ;
    mkg:unitString "L" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq3_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The cultivation-medium volume changes at the instantaneous feed rate." ;
    mkg:doi "10.3389/fpls.2023.1183254" ;
    mkg:form "ODE" ;
    mkg:page "6" ;
    mkg:quote "\\frac{dV}{dt}=F_{t}" ;
    mkg:status "pending" .

<http://example.org/kg/nausch_2023/law/nausch_2023_eq5> a mkg:Law ;
    rdfs:label "nausch_2023 eq 5"@en ;
    mkg:computes <http://example.org/kg/nausch_2023/law/nausch_2023_eq5/var/S> ;
    mkg:equationNumber "5" ;
    mkg:hasMetadata <http://example.org/kg/nausch_2023/law/nausch_2023_eq5_meta> ;
    mkg:hasParameter <http://example.org/kg/nausch_2023/law/nausch_2023_eq5/par/K_IS>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq5/par/K_S>,
        <http://example.org/kg/nausch_2023/law/nausch_2023_eq5/par/mu_S> ;
    mkg:latex "V\\frac{dS}{dt}+S\\frac{dV}{dt}=F_{t}S_{f}-\\mu_{S}\\left(\\frac{S}{S+K_{S}}\\frac{K_{IS}}{S+K_{IS}}\\right)X_{a}V" ;
    mkg:uses <http://example.org/kg/nausch_2023/law/nausch_2023_eq5/var/F_t>,
