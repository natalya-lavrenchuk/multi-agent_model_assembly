<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq3_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The concentration of bound salt available for protein exchange is total bound salt minus the salt shielded by bound proteins." ;
    mkg:doi "10.1016/j.chroma.2012.02.004" ;
    mkg:form "algebraic" ;
    mkg:page "2" ;
    mkg:quote "\\overline{q_{1}}=q_{1}-\\sum_{i=2}^{n}\\sigma_{i}q_{i}" ;
    mkg:status "flagged" .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq4> a mkg:Law ;
    rdfs:label "osberghaus_2012 eq 4"@en ;
    mkg:computes <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq4/var/k_i_eq> ;
    mkg:equationNumber "4" ;
    mkg:hasMetadata <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq4_meta> ;
    mkg:hasParameter <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq4/par/nu_i>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq4/par/sigma_i> ;
    mkg:latex "k_{i,e q}=\\left(\\frac{q_{i}}{c_{i}}\\right)\\left(\\frac{c_{1}}{\\Lambda-\\sum_{i=2}^{n}(\\nu_{i}+\\sigma_{i})q_{i}}\\right)^{\\nu_{i}}\\quad i>1" ;
    mkg:uses <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq4/var/Lambda>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq4/var/c_1>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq4/var/c_i>,
        <http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq4/var/q_i> .

<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq4/par/nu_i> a mkg:Parameter ;
