    mkg:page "4" ;
    mkg:possibleMisprint "The printed Eq. (22) omits the -0.1 correction factor that the corrigendum says was used to cap the reduced surface-center fraction at 0.9." ;
    mkg:quote "\\phi=\\frac{1}{2}\\left(1-\\frac{\\gamma^{*}}{\\gamma_{0}}\\right)-0.1" ;
    mkg:reviewOutcome "false alarm" ;
    mkg:status "pending" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq23> a mkg:Law ;
    rdfs:label "seidel_2018 eq 23"@en ;
