<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq24/par/k_1> a mkg:Parameter ;
    rdfs:label "k_{1} (seidel_2018 eq 24)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Rate constant for CO hydrogenation." ;
    mkg:dimension "[substance] * [time] ** 5 * [length] ** 3 / [mass] ** 4" ;
