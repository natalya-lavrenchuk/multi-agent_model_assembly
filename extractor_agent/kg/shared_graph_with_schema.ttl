    mkg:reason "A constant of the glutamine maintenance coefficient." ;
    mkg:siFactor 2.777778e-07 ;
    mkg:status "accepted" ;
    mkg:symbol "\\alpha_{1}" ;
    mkg:unit "l * mM / cells / h" ;
    mkg:unitString "mM L/cell/h" ;
    mkg:valuesByCase "{\"batch operation\": \"3.4 × 10^-13 (p.4, Table 1)\", \"fed-batch operation\": \"3.4 × 10^-13 (p.4, Table 1)\"}" .

<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq12/par/alpha_2> a mkg:Parameter ;
