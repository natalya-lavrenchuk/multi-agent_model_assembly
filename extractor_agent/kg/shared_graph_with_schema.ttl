<http://example.org/kg/wang_2019/law/wang_2019_eq2/var/X_carb> a mkg:Variable ;
    rdfs:label "X_{carb} (wang_2019 eq 2)"@en ;
    mkg:description "Concentration of carbohydrates as C" ;
    mkg:dimension "[substance] / [length] ** 3" ;
