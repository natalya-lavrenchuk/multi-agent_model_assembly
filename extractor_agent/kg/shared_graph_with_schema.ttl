    mkg:status "accepted" ;
    mkg:symbol "d_{gln}" ;
    mkg:unit "1 / h (x0.001)" ;
    mkg:unitString "10^-3 h^-1" ;
    mkg:value 7.2e+00 ;
    mkg:valueUncertainty "± 0.4" .

<http://example.org/kg/xing_2010/law/xing_2010_eq6.5/par/r_amm> a mkg:Parameter ;
    rdfs:label "r_{amm} (xing_2010 eq 6.5)"@en ;
