            mkg:slot "exponent" ],
        [ mkg:boundTo <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq13/par/n> ;
            mkg:slot "exponent" ],
        [ mkg:boundTo <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq13/par/K_s> ;
            mkg:slot "saturation constant" ],
        [ mkg:boundTo <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq13/var/S> ;
            mkg:slot "substrate" ],
        [ mkg:boundTo <http://example.org/kg/muloiwa_2020_free_laws/law/muloiwa_2020_eq13/par/mu_max> ;
