    mkg:estimation "estimated" ;
    mkg:estimationQuote "As the values for batch cultures represent initial estimates, these are estimated using the data for fed-batch operation." ;
    mkg:page "3" ;
    mkg:quote "gene copy number of MAb heavy chains" ;
    mkg:reason "A gene copy number per cell, estimated as a model parameter." ;
    mkg:siFactor 1e+00 ;
