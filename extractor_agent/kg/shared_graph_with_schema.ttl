        <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-16/var/p_H_2>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-16/var/p_H_2O> .

