<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eq33/var/y_i_0> a mkg:Variable ;
    rdfs:label "y_{i,0} (seidel_2018 eq 33)"@en ;
    mkg:basis "stated" ;
    mkg:description "Input mole fraction of component i." ;
