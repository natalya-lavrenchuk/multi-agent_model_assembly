    mkg:reason "A respiration rate constant in the carbohydrate respiration law, so it is a parameter." ;
    mkg:siFactor 1.157407e-05 ;
    mkg:status "accepted" ;
    mkg:symbol "m_{c}" ;
    mkg:unit "1 / d" ;
    mkg:unitString "d^{-1}" ;
    mkg:value 2.7548e+00 ;
    mkg:valueUncertainty "0.7898" .

<http://example.org/kg/wang_2019/law/wang_2019_eq2/par/m_cN> a mkg:Parameter ;
