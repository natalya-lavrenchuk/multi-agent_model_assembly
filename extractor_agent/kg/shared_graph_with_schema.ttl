<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The free reduced surface-center coverage is calculated from the water and methanol adsorption contributions and related surface-step terms." ;
    mkg:doi "10.1016/j.ces.2017.09.043" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "Here partial pressures are used instead of fugacities, which is justified by the fact that fugacity coefficients are close to one for the operating conditions considered in this paper (Vollbrecht, 2007)." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Partial pressures are used in place of fugacities." ] ;
    mkg:ocrFixNote "The OCR read + as ++, dropped the 1 in the exponent −1, and put the ½ power on the wrong term." ;
    mkg:page "3" ;
    mkg:possibleMisprint "The expression contains a doubled plus sign and an outer exponent printed as ^{-} without an exponent, so the printed coverage expression is malformed." ;
    mkg:quote "\\boldsymbol{\\Theta}^{*}=\\left(1+\\underbrace{\\frac{K_{\\mathrm{H}_{2}\\mathrm{O}}}{K_{\\mathrm{B}8}K_{\\mathrm{B}9}K_{\\mathrm{H}_{2}}}}_{\\beta_{13}}\\frac{p_{\\mathrm{H}_{2}\\mathrm{O}}}{p_{\\mathrm{H}_{2}}}+\\underbrace{\\frac{K_{\\mathrm{CH}_{3}\\mathrm{OH}}^{*}}{K_{\\mathrm{B}5}K_{\\mathrm{H}_{2}}^{1/2}}}_{\\beta_{16}}\\frac{p_{\\mathrm{CH}_{3}\\mathrm{OH}}}{p_{\\mathrm{H}_{2}}^{1/2}}+\\underbrace{K_{\\mathrm{CH}_{3}\\mathrm{OH}}^{*}}_{\\beta_{14}}p_{\\mathrm{CH}_{3}\\mathrm{OH}}+\\underbrace{\\frac{K_{\\mathrm{H}_{2}\\mathrm{O}}}{K_{\\mathrm{B}9}K_{\\mathrm{H}_{2}}^{1/2}}}_{\\beta_{15}}\\frac{p_{\\mathrm{H}_{2}\\mathrm{O}}}{p_{\\mathrm{H}_{2}}^{1/2}}+\\underbrace{K_{\\mathrm{H}_{2}\\mathrm{O}}}_{\\beta_{12}}p_{\\mathrm{H}_{2}\\mathrm{O}}\\right)^{-1}" ;
    mkg:reviewOutcome "reading corrected" ;
    mkg:status "pending" .

