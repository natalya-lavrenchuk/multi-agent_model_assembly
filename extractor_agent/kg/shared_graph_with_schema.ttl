<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq15_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:correctionQuote "The mass balances for lactate and ammonia are" ;
    mkg:correctionReason "The right-hand side is an amount rate, so the mass-balance left-hand side should differentiate the amount V[AMM]." ;
    mkg:correctionStatus "accepted" ;
    mkg:description "The extracellular ammonia balance accounts for cellular production, glutamine degradation, and removal through the outlet." ;
    mkg:doi "10.1016/j.compchemeng.2010.03.012" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "The maximum total volume of feed was fixed at 8.75 mL, which represents less than 5% of the total culture volume (200 mL), so as to avoid dilution effects." ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "Feed volume was kept small relative to culture volume to avoid dilution effects." ] ;
    mkg:page "7" ;
    mkg:possibleMisprint "The right-hand terms have units of amount per time, whereas d([AMM])/dt has units of concentration per time; the balance is missing division by V, or the left-hand side should be the derivative of V[AMM]." ;
    mkg:quote "\\frac{d([{A M M}])}{d t}=Q_{{a m m}}V X_{\\nu}+K_{{d g l n}}V[{G L N}]-F_{{o u t}}[{A M M}]" ;
    mkg:reviewOutcome "paper misprint" ;
    mkg:status "pending" .

<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq16> a mkg:Law ;
    rdfs:label "kontoravdi_2010 eq 16"@en ;
    mkg:computes <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq16/var/Q_amm> ;
    mkg:equationNumber "16" ;
    mkg:hasMetadata <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq16_meta> ;
    mkg:hasParameter <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq16/par/Y_amm_gln> ;
    mkg:latex "Q_{a m m}=Y_{a m m,g l n}Q_{g l n}" ;
    mkg:uses <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq16/var/Q_gln> .

<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq16_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:description "Specific ammonia production is calculated from glutamine uptake using the ammonia-on-glutamine yield." ;
    mkg:doi "10.1016/j.compchemeng.2010.03.012" ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq16/par/Y_amm_gln> ;
            mkg:slot "yield" ],
        [ mkg:boundTo <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq16/var/Q_amm> ;
            mkg:slot "product" ],
        [ mkg:boundTo <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq16/var/Q_gln> ;
            mkg:slot "substrate" ] ;
    mkg:page "7" ;
    mkg:quote "Q_{a m m}=Y_{a m m,g l n}Q_{g l n}" ;
    mkg:status "pending" .

