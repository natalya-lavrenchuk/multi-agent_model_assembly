<http://example.org/kg/osberghaus_2012_rapid_equilibrium_sma/law/osberghaus_2012_eq1/par/nu_i> a mkg:Parameter ;
    rdfs:label "\\nu_{i} (osberghaus_2012 eq 1)"@en ;
