<http://example.org/kg/zentou_2019_andrews/law/zentou_2019_eq5/par/K_S> a mkg:Parameter ;
    rdfs:label "K_{S} (zentou_2019 eq 5)"@en ;
    mkg:basis "stated" ;
    mkg:description "Half velocity constant, i.e., substrate concentration at half of the maximum growth rate." ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "The experimental growth data was fitted to determine the mathematical parameters ( $ \\mu_{max} $, $ K_s $, and $ K_i $) using Origin 2018a software based on the SubstrateInhib function" ;
    mkg:page "4" ;
    mkg:quote "$ K_{s} $ is the half velocity constant, i.e., the substrate concentration at half of the maximum growth rate (g.L $ ^{-1} $)." ;
    mkg:reason "Half velocity constant, a substrate saturation constant of the growth law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{S}" ;
    mkg:unit "g / l" ;
    mkg:unitString "g.L $ ^{-1} $" ;
    mkg:value 4.753789e+01 .

<http://example.org/kg/zentou_2019_andrews/law/zentou_2019_eq5/par/K_i> a mkg:Parameter ;
    rdfs:label "K_{i} (zentou_2019 eq 5)"@en ;
    mkg:basis "stated" ;
    mkg:description "Substrate inhibition coefficient." ;
    mkg:dimension "[mass] / [length] ** 3" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "The experimental growth data was fitted to determine the mathematical parameters ( $ \\mu_{max} $, $ K_s $, and $ K_i $) using Origin 2018a software based on the SubstrateInhib function" ;
    mkg:page "4" ;
    mkg:quote "$ K_i $ (g.L $ ^{-1} $) is the substrate inhibition coefficient." ;
    mkg:reason "Substrate inhibition coefficient, a constant of the Andrews growth law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{i}" ;
    mkg:unit "g / l" ;
    mkg:unitString "g.L $ ^{-1} $" ;
    mkg:value 1.810164e+02 ;
    mkg:valueUncertainty "± 29.14" .

<http://example.org/kg/zentou_2019_andrews/law/zentou_2019_eq5/par/mu_max> a mkg:Parameter ;
    rdfs:label "\\mu_{max} (zentou_2019 eq 5)"@en ;
    mkg:basis "stated" ;
    mkg:description "Maximum specific growth rate." ;
    mkg:dimension "1 / [time]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "The experimental growth data was fitted to determine the mathematical parameters ( $ \\mu_{max} $, $ K_s $, and $ K_i $) using Origin 2018a software based on the SubstrateInhib function" ;
    mkg:page "4" ;
    mkg:quote "$ \\mu_{max} $ is the maximum specific growth rate ( $ h^{-1} $)" ;
    mkg:reason "Maximum specific growth rate, a fitted constant of the growth law." ;
    mkg:siFactor 2.777778e-04 ;
    mkg:status "accepted" ;
    mkg:symbol "\\mu_{max}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h $ ^{-1} $" ;
    mkg:value 5.086e-01 .

<http://example.org/kg/zentou_2019_andrews/law/zentou_2019_eq5/var/S> a mkg:Variable ;
