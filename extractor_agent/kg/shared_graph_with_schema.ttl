        [ mkg:boundTo <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq12/par/alpha_1> ;
            mkg:slot "maximum rate" ] ;
    mkg:page "7" ;
    mkg:quote "m_{g l n}=\\frac{\\alpha_{1}[G L N]}{\\alpha_{2}+[G L N]}" ;
    mkg:status "pending" .

<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq13> a mkg:Law ;
    rdfs:label "kontoravdi_2010 eq 13"@en ;
