    mkg:status "accepted" ;
    mkg:symbol "R_{NH_3,b}" ;
    mkg:unit "kmol / h / m ** 3" ;
    mkg:unitString "kmol m^{-3} h^{-1}" .

<http://example.org/kg/cheema_2018/law/cheema_2018_eq4/var/T_b> a mkg:Variable ;
    rdfs:label "T_{b} (cheema_2018 eq 4)"@en ;
