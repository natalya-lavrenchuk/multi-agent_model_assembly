    mkg:quote "Specific heat capacity" ;
    mkg:reason "It is the specific heat capacity of the reacting mixture, a physical property." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "c_{p_b}" ;
    mkg:unit "kJ / K / kmol" ;
    mkg:unitString "kJ kmol^-1 K^-1" .

<http://example.org/kg/cheema_2018/law/cheema_2018_eq4/var/R_NH_3_b> a mkg:Variable ;
    rdfs:label "R_{NH_3,b} (cheema_2018 eq 4)"@en ;
    mkg:basis "stated" ;
    mkg:description "Ammonia reaction rate in catalyst bed b." ;
    mkg:dimension "[substance] / [length] ** 3 / [time]" ;
    mkg:reason "Reaction rate, a process quantity that varies with local bed conditions." ;
