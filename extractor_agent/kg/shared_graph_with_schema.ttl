<http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq28_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Normalized pressure rises over time during constant-flow filtration as complete blocking and cake filtration act together." ;
    mkg:doi "10.1016/j.memsci.2004.12.053" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "In this model it was assumed that cake formation and complete pore blockage occur simultaneously." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Cake formation and complete pore blockage occur simultaneously." ],
        [ mkg:quote "When the flux rate is kept constant" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The filtration is operated at constant flow rate." ],
        [ mkg:quote "The combined cake-complete model idealizes fouling as occurring by the independent effect of complete blocking and caking." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "The effects of complete blocking and caking are treated as independent." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq28/par/K_c> ;
            mkg:slot "cake filtration constant" ],
