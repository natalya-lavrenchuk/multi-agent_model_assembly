    mkg:unit "mmol / cells / h" ;
    mkg:unitString "mmol cell^-1 h^-1" .

<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq12_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:description "The glutamine maintenance coefficient increases with glutamine concentration and approaches a finite maximum." ;
    mkg:doi "10.1016/j.compchemeng.2010.03.012" ;
    mkg:form "algebraic" ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq12/par/alpha_2> ;
