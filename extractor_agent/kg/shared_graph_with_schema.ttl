<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq14_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:description "Specific lactate production is calculated from glucose uptake using the lactate-on-glucose yield." ;
    mkg:doi "10.1016/j.compchemeng.2010.03.012" ;
