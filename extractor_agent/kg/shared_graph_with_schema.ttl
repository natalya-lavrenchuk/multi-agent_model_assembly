    rdfs:label "seidel_2018 eq 25"@en ;
    mkg:computes <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq25/var/K_2> ;
    mkg:equationNumber "25" ;
