<http://example.org/kg/bolton_2006_cake_intermediate_blocking/law/bolton_2006_eq30_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "Calculates normalized pressure over time for constant-flow filtration combining intermediate blocking and cake filtration." ;
    mkg:doi "10.1016/j.memsci.2004.12.053" ;
    mkg:form "algebraic" ;
    mkg:hasAssumption [ mkg:quote "When the flux rate is kept constant" ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The filtration is operated at constant flow rate." ] ;
    mkg:hasRole [ mkg:boundTo <http://example.org/kg/bolton_2006_cake_intermediate_blocking/law/bolton_2006_eq30/par/K_i> ;
