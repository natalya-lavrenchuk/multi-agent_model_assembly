<http://example.org/kg/bolton_2006_cake_intermediate_blocking/law/bolton_2006_eq17> a mkg:Law ;
    rdfs:label "bolton_2006 eq 17"@en ;
    mkg:computes <http://example.org/kg/bolton_2006_cake_intermediate_blocking/law/bolton_2006_eq17/var/V> ;
    mkg:equationNumber "17" ;
    mkg:hasMetadata <http://example.org/kg/bolton_2006_cake_intermediate_blocking/law/bolton_2006_eq17_meta> ;
    mkg:hasParameter <http://example.org/kg/bolton_2006_cake_intermediate_blocking/law/bolton_2006_eq17/par/K_c>,
        <http://example.org/kg/bolton_2006_cake_intermediate_blocking/law/bolton_2006_eq17/par/K_i> ;
    mkg:latex "V=\\frac{1}{K_{\\mathrm{i}}}\\ln\\left(1+\\frac{K_{\\mathrm{i}}}{K_{\\mathrm{c}}J_{0}}((1+2K_{\\mathrm{c}}J_{0}^{2}t)^{1/2}-1)\\right)" ;
    mkg:uses <http://example.org/kg/bolton_2006_cake_intermediate_blocking/law/bolton_2006_eq17/var/J_0>,
        <http://example.org/kg/bolton_2006_cake_intermediate_blocking/law/bolton_2006_eq17/var/t> .

<http://example.org/kg/bolton_2006_cake_intermediate_blocking/law/bolton_2006_eq17/par/K_c> a mkg:Parameter ;
    rdfs:label "K_{c} (bolton_2006 eq 17)"@en ;
    mkg:basis "stated" ;
    mkg:description "Cake filtration constant" ;
    mkg:dimension "[time] / [length] ** 2" ;
    mkg:page "10" ;
    mkg:quote "cake filtration constant" ;
    mkg:reason "It is a fitted cake filtration constant of the fouling law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{c}" ;
    mkg:unit "s / m ** 2" ;
    mkg:unitString "s/m^2" ;
    mkg:valuesByCase "{\"Cake-complete, human plasma IgG, constant pressure\": \"1.30 × 10^3 s/m^2\", \"Cake-intermediate, human plasma IgG, constant flow\": \"4.93 × 10^4 s/m^2\", \"Cake-complete, human plasma IgG, constant flow\": \"5.74 × 10^4 s/m^2\", \"Cake-standard, human plasma IgG, constant flow\": \"7.82 × 10^4 s/m^2\", \"Cake-intermediate, BSA, constant pressure\": \"2.26 × 10^5 s/m^2\", \"Cake-complete, BSA, constant pressure\": \"3.05 × 10^5 s/m^2\", \"Cake-standard, BSA, constant pressure\": \"4.81 × 10^5 s/m^2\"}" .

