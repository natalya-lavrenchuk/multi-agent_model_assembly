<http://example.org/kg/cheema_2018/law/cheema_2018_eq4/var/dot_m_b_in> a mkg:Variable ;
    rdfs:label "\\dot{m}_{b_{in}} (cheema_2018 eq 4)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Mass flow rate of the reacting mixture entering catalyst bed b." ;
    mkg:dimension "[mass] / [time]" ;
    mkg:initialQuote "Table 2 Catalyst bed volumes and normal operation flow rates" ;
    mkg:initialValue "321.70 kg h^-1 (bed 1); 485.53 kg h^-1 (bed 2); 662.54 kg h^-1 (bed 3)" ;
    mkg:reason "It is an inlet flow rate, an operating quantity varied as feed flow in the process." ;
