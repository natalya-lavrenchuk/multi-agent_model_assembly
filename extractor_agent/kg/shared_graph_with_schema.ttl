    mkg:estimation "estimated" ;
    mkg:estimationQuote "Table 3. Model Parameters Estimated by MCMC Sampling Procedure" ;
    mkg:page "11" ;
    mkg:quote "KD_{lac} = half-maximum-rate concentration of lactate for cell death rate, mM" ;
    mkg:reason "It is a half-maximum-rate concentration constant in the cell-death law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "KD_{lac}" ;
    mkg:unit "mM" ;
    mkg:unitString "mM" ;
    mkg:value 4.58e+01 ;
    mkg:valueUncertainty "± 4.1" .

<http://example.org/kg/xing_2010/law/xing_2010_eq7.2/par/k_d> a mkg:Parameter ;
    rdfs:label "k_{d} (xing_2010 eq 7.2)"@en ;
    mkg:basis "stated" ;
    mkg:description "Maximum cell death rate" ;
    mkg:dimension "1 / [time]" ;
    mkg:page "11" ;
    mkg:quote "k_d = maximum cell death rate, h^{-1}" ;
    mkg:reason "It is the maximum cell death rate constant in the cell-death law." ;
    mkg:siFactor 2.777778e-04 ;
    mkg:status "accepted" ;
    mkg:symbol "k_{d}" ;
    mkg:unit "1 / h" ;
    mkg:unitString "h^-1" ;
    mkg:value 1.6e-02 .

