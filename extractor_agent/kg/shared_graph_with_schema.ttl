    mkg:status "accepted" ;
    mkg:symbol "K_{F}" ;
    mkg:unit "g / l" ;
    mkg:unitString "g L^-1" ;
    mkg:value 1.108e+00 ;
    mkg:valueUncertainty "90% CI: 0.71" .

