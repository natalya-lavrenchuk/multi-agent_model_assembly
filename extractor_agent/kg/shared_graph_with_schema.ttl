<http://example.org/kg/birol_2002/law/birol_2002_eq17_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:correctionReason "The printed factor \\(F/s_{\\mathrm{f}}\\) is not a dilution rate: Table 2 gives \\(F\\) in l/h and \\(s_{\\mathrm{f}}\\) in g/l, whereas dividing by culture volume \\(V\\) in l gives the required inverse-time factor." ;
    mkg:correctionStatus "accepted" ;
    mkg:description "Culture-temperature balance accounting for feed-temperature effects, reaction heat, and heat exchange with cooling liquid." ;
    mkg:doi "10.1016/S0098-1354(02)00127-8" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "A lab-scale fermentor was assumed in deciding to use a cooling coil, building the model, and developing the related equations." ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "The energy-balance model assumes a lab-scale fermentor with a cooling coil." ] ;
    mkg:page "7" ;
    mkg:possibleMisprint "The feed-temperature term uses F/s_f, but s_f is a feed concentration (g/l), so this factor is dimensionally inconsistent as a dilution rate and likely should be F/V." ;
    mkg:quote "\\begin{aligned}\\frac{\\mathrm{d}T}{\\mathrm{d}t}=&\\frac{F}{s_{\\mathrm{f}}}(T_{\\mathrm{f}}-T)+\\frac{1}{V\\rho c_{\\mathrm{p}}}\\\\&\\times\\left[Q_{\\mathrm{rxn}}-\\frac{a F_{\\mathrm{c}}^{b+1}}{F_{\\mathrm{c}}+(a F_{\\mathrm{c}}^{b}/2\\rho_{\\mathrm{c}}c_{\\mathrm{pc}})}\\right]\\end{aligned}" ;
    mkg:reviewOutcome "paper misprint" ;
    mkg:status "pending" .

<http://example.org/kg/birol_2002/law/birol_2002_eq18> a mkg:Law ;
    rdfs:label "birol_2002 eq 18"@en ;
    mkg:computes <http://example.org/kg/birol_2002/law/birol_2002_eq18/var/CO_2> ;
    mkg:equationNumber "18" ;
    mkg:hasMetadata <http://example.org/kg/birol_2002/law/birol_2002_eq18_meta> ;
    mkg:hasParameter <http://example.org/kg/birol_2002/law/birol_2002_eq18/par/alpha_1>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq18/par/alpha_2>,
        <http://example.org/kg/birol_2002/law/birol_2002_eq18/par/alpha_3> ;
    mkg:latex "\\frac{\\mathrm{d}\\mathrm{CO}_{2}}{\\mathrm{~d}t}=\\alpha_{1}\\frac{\\mathrm{d}X}{\\mathrm{d}t}+\\alpha_{2}X+\\alpha_{3}" ;
    mkg:uses <http://example.org/kg/birol_2002/law/birol_2002_eq18/var/X> .

<http://example.org/kg/birol_2002/law/birol_2002_eq18/par/alpha_1> a mkg:Parameter ;
    rdfs:label "\\alpha_{1} (birol_2002 eq 18)"@en ;
    mkg:basis "stated" ;
    mkg:description "Constant relating CO₂ to growth" ;
    mkg:dimension "[substance] / [mass]" ;
    mkg:estimation "set" ;
    mkg:estimationQuote "Here, the values of $ \\alpha_1 $, $ \\alpha_2 $ and $ \\alpha_3 $ are chosen to give $ \\text{CO}_2 $ profiles similar to the predictions of Montague et al. (1986)." ;
    mkg:page "4" ;
    mkg:quote "Constant relating $ CO_2 $ to growth" ;
    mkg:reason "A proportionality constant relating carbon dioxide evolution to growth, so it is a constant of the law." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "\\alpha_{1}" ;
    mkg:unit "mmol / g" ;
    mkg:unitNote "CO_2 biomass" ;
    mkg:unitString "mmol CO_2/g biomass" ;
    mkg:value 1.43e-01 .

<http://example.org/kg/birol_2002/law/birol_2002_eq18/par/alpha_2> a mkg:Parameter ;
