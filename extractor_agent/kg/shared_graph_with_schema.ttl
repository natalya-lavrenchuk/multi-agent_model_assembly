        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-14/par/K_CO_2_odot> ;
            mkg:slot "adsorption constant" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-14/par/K_CH_3OH_odot> ;
            mkg:slot "adsorption constant" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-14/var/p_CH_3OH> ;
            mkg:slot "adsorbing species" ],
        [ mkg:boundTo <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-14/par/K_CO> ;
            mkg:slot "adsorption constant" ] ;
    mkg:page "11" ;
    mkg:quote "\\Theta^{\\odot}=\\left(1+\\underbrace{K_{\\mathrm{CO}}}_{\\beta_{11}}p_{\\mathrm{CO}}+\\underbrace{K_{\\mathrm{CH}_{3}\\mathrm{OH}}^{\\odot}}_{\\beta_{12}}p_{\\mathrm{CH}_{3}\\mathrm{OH}}+\\underbrace{K_{\\mathrm{CO}_{2}}^{\\odot}}_{\\beta_{14}}p_{\\mathrm{CO}_{2}}\\right)^{-1}" ;
    mkg:status "pending" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-15> a mkg:Law ;
    rdfs:label "seidel_2018 eq C-15"@en ;
