    mkg:hasParameter <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq8/par/K_H_2> ;
    mkg:latex "\\Theta^{\\otimes}=\\left(1+\\underbrace{\\sqrt{K_{\\mathrm{H}_{2}}}}_{ \\beta_{7}}\\sqrt{p_{\\mathrm{H}_{2}}}\\right)^{-1}" ;
    mkg:uses <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq8/var/p_H_2> .

