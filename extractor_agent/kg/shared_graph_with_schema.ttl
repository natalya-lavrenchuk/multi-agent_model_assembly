    mkg:page "3" ;
    mkg:quote "V=\\frac{J_{0}}{K_{\\mathrm{b}}}\\left(1-\\exp\\left(\\frac{-K_{\\mathrm{b}}}{K_{\\mathrm{c}}J_{0}^{2}}\\left(\\sqrt{1+2K_{\\mathrm{c}}J_{0}^{2}t}-1\\right)\\right)\\right)" ;
