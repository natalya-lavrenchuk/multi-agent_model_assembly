<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.1/var/p_H_2O> a mkg:Variable ;
    rdfs:label "p_{H_2O} (vandenbussche_1996 eq 3.1)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Partial pressure of water." ;
    mkg:dimension "[mass] / [length] / [time] ** 2" ;
    mkg:initialQuote "Operating Conditions for the Simulation of the Bench Scale Reactor" ;
    mkg:initialValue "0.00 mol%" ;
    mkg:reason "A gas-phase partial pressure that changes as water is produced and consumed is a process quantity, not a law constant." ;
    mkg:siFactor 1e+05 ;
    mkg:status "accepted" ;
    mkg:symbol "p_{H_2O}" ;
    mkg:unit "bar" ;
    mkg:unitString "bar" .

<http://example.org/kg/vandenbussche_1996/law/vandenbussche_1996_eq3.2/var/p_H_2O> a mkg:Variable ;
