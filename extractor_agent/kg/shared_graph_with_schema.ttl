    mkg:page "7" ;
    mkg:quote "Q_{l a c}=Y_{l a c,g l c}Q_{g l c}" ;
    mkg:status "pending" .

<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq15> a mkg:Law ;
    rdfs:label "kontoravdi_2010 eq 15"@en ;
    mkg:computes <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq15/var/C_AMM> ;
