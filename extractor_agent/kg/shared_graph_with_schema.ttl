    mkg:unitString "unitless" .

<http://example.org/kg/wang_2019/law/wang_2019_eq3_meta> a mkg:Metadata ;
    mkg:basis "inferred" ;
    mkg:description "Neutral lipids accumulate through carbon reused from carbohydrate metabolism during nitrogen-available growth and carbon redirected from carbohydrates under nitrogen deficiency." ;
    mkg:doi "10.1021/acs.est.9b02908" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:reasoned true ;
            mkg:severity "warning" ;
            mkg:text "Carbon contributions to lipid synthesis from functional biomass components are represented within the R₇ carbon-partitioning process." ],
        [ mkg:quote "We modeled carbohydrates in the form of glucose and neutral lipids in the form of triacylglycerols." ;
            mkg:reasoned false ;
            mkg:severity "warning" ;
            mkg:text "Carbohydrates are represented as glucose and neutral lipids as triacylglycerols." ] ;
    mkg:page "2" ;
    mkg:quote "\\frac{dX_{nl}}{dt} = \\beta \\cdot \\exp(k_{nl} \\cdot I_{avg}) \\cdot \\nu_N \\cdot X_{cd}   +q_{nl} \\cdot \\frac{q_n}{Q_n} \\cdot P \\cdot X_{cd}" ;
    mkg:status "pending" .

<http://example.org/kg/wang_2019/law/wang_2019_eq4> a mkg:Law ;
    rdfs:label "wang_2019 eq 4"@en ;
    mkg:computes <http://example.org/kg/wang_2019/law/wang_2019_eq4/var/X_chl> ;
    mkg:equationNumber "4" ;
    mkg:hasMetadata <http://example.org/kg/wang_2019/law/wang_2019_eq4_meta> ;
    mkg:hasParameter <http://example.org/kg/wang_2019/law/wang_2019_eq4/par/k_chl>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq4/par/theta> ;
    mkg:latex "\\frac{dX_{chl}}{dt} = \\theta \\cdot \\exp(-k_{chl} \\cdot I_{avg}) \\cdot \\nu_N \\cdot X_{cd} - m_{chl} \\cdot X_{chl}" ;
    mkg:uses <http://example.org/kg/wang_2019/law/wang_2019_eq4/var/I_avg>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq4/var/X_cd>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq4/var/m_chl>,
        <http://example.org/kg/wang_2019/law/wang_2019_eq4/var/nu_N> .

<http://example.org/kg/wang_2019/law/wang_2019_eq4/par/k_chl> a mkg:Parameter ;
    rdfs:label "k_{chl} (wang_2019 eq 4)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Light-response coefficient in the exponential regulation of Chl-a synthesis" ;
    mkg:dimension "[length] ** 2 * [time] / [substance]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "Our model was systematically calibrated via identifiability analysis, uncertainty quantification, and sensitivity analysis." ;
    mkg:reason "An exponential light-response coefficient in the Chl-a synthesis law, so it is a parameter." ;
    mkg:siFactor 8.64e+04 ;
    mkg:status "accepted" ;
    mkg:symbol "k_{chl}" ;
    mkg:unit "d * m ** 2 / mol" ;
    mkg:unitNote "photons" ;
    mkg:unitString "m^{2} d (mol photons)^{-1}" ;
    mkg:value 2.48e-02 ;
    mkg:valueUncertainty "0.0021" .

<http://example.org/kg/wang_2019/law/wang_2019_eq4/par/theta> a mkg:Parameter ;
    rdfs:label "\\theta (wang_2019 eq 4)"@en ;
    mkg:basis "stated" ;
    mkg:description "Maximum Chl-a:N ratio regulating Chl-a synthesis" ;
    mkg:dimension "dimensionless" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "Our model was systematically calibrated via identifiability analysis, uncertainty quantification, and sensitivity analysis." ;
    mkg:page "4" ;
    mkg:quote "maximum Chl-a:N ratio" ;
    mkg:reason "A maximum Chl-a:N ratio in the Chl-a synthesis law, so it is a parameter." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "\\theta" ;
    mkg:unit "dimensionless" ;
    mkg:unitNote "X_{chl}-C N" ;
    mkg:unitString "mol X_{chl}-C (mol N)^{-1}" ;
    mkg:value 2.185e-01 ;
    mkg:valueUncertainty "0.0068" .

