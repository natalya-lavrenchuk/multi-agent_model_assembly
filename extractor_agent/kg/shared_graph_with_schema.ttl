    mkg:initialQuote "Dynamic experiments with step changes between CO feed ( $ y_{CO} = 12.6\\% $,  $ y_{H_2} = 72.2\\% $ and  $ y_{N_2} = 16.0\\% $), and  $ CO_2 $ feed" ;
    mkg:initialValue "CO feed: 12.6%; H₂: 72.2%; N₂: 16.0%" ;
    mkg:measured true ;
    mkg:measuredQuote "measured in- and output mole fractions  $ y_{i,0} $ and  $ y_i $" ;
    mkg:page "2" ;
    mkg:quote "mole fraction of component i at input" ;
    mkg:reason "It is the input/feed mole fraction, an inlet condition specified for each run." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "y_{i,0}" ;
    mkg:unit "dimensionless" ;
