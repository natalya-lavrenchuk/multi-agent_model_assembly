<http://example.org/kg/bolton_2006_cake_complete_blocking/law/bolton_2006_eq16_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:description "The equation gives filtered volume over time for the combined cake-filtration and complete-blocking model." ;
