    mkg:page "3" ;
    mkg:quote "k_{i}=\\exp\\left(\\underbrace{A}_{\\beta_{1},\\beta_{3},\\beta_{5}}-\\underbrace{B}_{\\beta_{2},\\beta_{4},\\beta_{6}}\\left(\\frac{T_{ref}}{T}-1\\right)\\right)" ;
    mkg:status "pending" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq22> a mkg:Law ;
    rdfs:label "seidel_2018 eq 22"@en ;
