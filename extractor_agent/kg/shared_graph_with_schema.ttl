<http://example.org/kg/bolton_2006_intermediate_standard_blocking/law/bolton_2006_eq19> a mkg:Law ;
    rdfs:label "bolton_2006 eq 19"@en ;
    mkg:computes <http://example.org/kg/bolton_2006_intermediate_standard_blocking/law/bolton_2006_eq19/var/V> ;
    mkg:equationNumber "19" ;
    mkg:hasMetadata <http://example.org/kg/bolton_2006_intermediate_standard_blocking/law/bolton_2006_eq19_meta> ;
    mkg:hasParameter <http://example.org/kg/bolton_2006_intermediate_standard_blocking/law/bolton_2006_eq19/par/K_i>,
        <http://example.org/kg/bolton_2006_intermediate_standard_blocking/law/bolton_2006_eq19/par/K_s> ;
    mkg:latex "V=\\frac{1}{K_{\\mathrm{i}}}\\ln\\left(1+\\frac{2K_{\\mathrm{i}}J_{0}t}{2+K_{\\mathrm{s}}J_{0}t}\\right)" ;
    mkg:uses <http://example.org/kg/bolton_2006_intermediate_standard_blocking/law/bolton_2006_eq19/var/J_0>,
        <http://example.org/kg/bolton_2006_intermediate_standard_blocking/law/bolton_2006_eq19/var/t> .

