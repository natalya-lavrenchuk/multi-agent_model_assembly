    rdfs:label "\\Delta G_{2} (seidel_2018 eq 25)"@en ;
    mkg:basis "stated" ;
    mkg:description "Gibbs free energy for the second surface-center conversion." ;
    mkg:dimension "[mass] * [length] ** 2 / [time] ** 2 / [substance]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "$ \\Delta G_1 $ and $ \\Delta G_2 $ were fitted separately to experimental data in Seidel et al., (2018) as described in our paper." ;
    mkg:page "2" ;
    mkg:quote "Gibbs free energy in J mol $ ^{-1} $" ;
    mkg:reason "A Gibbs free energy parameter fitted to experimental data." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "\\Delta G_{2}" ;
    mkg:unit "J / mol" ;
    mkg:unitString "J mol^-1" .

<http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq25/par/R> a mkg:Parameter ;
    rdfs:label "R (seidel_2018 eq 25)"@en ;
    mkg:basis "stated" ;
    mkg:description "Gas constant." ;
    mkg:dimension "[mass] * [length] ** 2 / [time] ** 2 / [substance] / [temperature]" ;
    mkg:estimation "set" ;
    mkg:estimationQuote "gas constant" ;
    mkg:page "2" ;
    mkg:quote "R | equilibrium constant: gas constant in J mol $ ^{-1} $ K $ ^{-1} $" ;
    mkg:reason "A universal physical constant." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "R" ;
    mkg:unit "J / K / mol" ;
    mkg:unitString "J mol^-1 K^-1" .

