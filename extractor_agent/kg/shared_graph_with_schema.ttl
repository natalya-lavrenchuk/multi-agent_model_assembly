    rdfs:label "k_{2} (seidel_2018 eq 25)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Rate constant multiplying the carbon-dioxide hydrogenation rate expression." ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "The model parameters were fitted to steady state and dynamic experimental data for varying $ CO/CO_{2} $ feed ratios using global optimization." ;
    mkg:reason "A rate constant in the carbon-dioxide hydrogenation rate law." ;
    mkg:status "accepted" ;
    mkg:symbol "k_{2}" .

