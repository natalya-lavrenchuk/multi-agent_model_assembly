<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9> a mkg:Law ;
    rdfs:label "seidel_2018 eq 9"@en ;
    mkg:computes <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/var/Theta_star> ;
    mkg:equationNumber "9" ;
    mkg:hasMetadata <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9_meta> ;
    mkg:hasParameter <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/par/K_B5>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/par/K_B8>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/par/K_B9>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/par/K_CH_3OH_star>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/par/K_H_2>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/par/K_H_2O> ;
    mkg:latex "$$ \\boldsymbol{\\Theta}^{*}=\\left(1+\\underbrace{\\frac{K_{\\mathrm{H}_{2}\\mathrm{O}}}{K_{\\mathrm{B}8}K_{\\mathrm{B}9}K_{\\mathrm{H}_{2}}}}_{\\beta_{13}}\\frac{p_{\\mathrm{H}_{2}\\mathrm{O}}}{p_{\\mathrm{H}_{2}}}+\\underbrace{\\frac{K_{\\mathrm{CH}_{3}\\mathrm{OH}}^{*}}{K_{\\mathrm{B}5}K_{\\mathrm{H}_{2}}^{1/2}}}_{\\beta_{16}}\\frac{p_{\\mathrm{CH}_{3}\\mathrm{OH}}}{p_{\\mathrm{H}_{2}}^{1/2}}+\\underbrace{K_{\\mathrm{CH}_{3}\\mathrm{OH}}^{*}}_{\\beta_{14}}p_{\\mathrm{CH}_{3}\\mathrm{OH}}+\\underbrace{\\frac{K_{\\mathrm{H}_{2}\\mathrm{O}}}{K_{\\mathrm{B}9}K_{\\mathrm{H}_{2}}^{1/2}}}_{\\beta_{15}}\\frac{p_{\\mathrm{H}_{2}\\mathrm{O}}}{p_{\\mathrm{H}_{2}}^{1/2}}+\\underbrace{K_{\\mathrm{H}_{2}\\mathrm{O}}}_{\\beta_{12}}p_{\\mathrm{H}_{2}\\mathrm{O}}\\right)^{-1} $$" ;
    mkg:uses <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/var/p_CH_3OH>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/var/p_H_2>,
        <http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/var/p_H_2O> .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/par/K_B5> a mkg:Parameter ;
    rdfs:label "K_{B5} (seidel_2018 eq 9)"@en ;
    mkg:basis "stated" ;
    mkg:description "Equilibrium constant in the surface-step relation involving H3CO* and CH3OH*." ;
    mkg:dimension "dimensionless" ;
    mkg:page "3" ;
    mkg:quote "Elementary step: $ \\text{H} \\otimes + \\text{H}_3\\text{CO} * \\neq = \\text{CH}_3\\text{OH} * + \\otimes $ | Quasi-equilibrium/velocity: $ \\theta_{\\text{H}_3\\text{CO}} = K_{B5}^{-1} \\theta_{\\text{CH}_3\\text{OH}}^{*} \\theta^\\otimes \\theta_H^\\otimes^{-1} $" ;
    mkg:reason "It is an equilibrium constant in an elementary reaction step." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{B5}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/par/K_B8> a mkg:Parameter ;
    rdfs:label "K_{B8} (seidel_2018 eq 9)"@en ;
    mkg:basis "stated" ;
    mkg:description "Equilibrium constant for the elementary step converting adsorbed oxygen to hydroxyl." ;
    mkg:dimension "dimensionless" ;
    mkg:page "3" ;
    mkg:quote "Elementary step: $ \\text{H} \\otimes + \\text{O} * = \\text{OH} * + \\otimes $ | Quasi-equilibrium/velocity: $ \\theta_0^{*} = K_{B8}^{-1} \\theta_{\\text{OH}}^{*} \\theta^\\otimes \\theta_H^\\otimes^{-1} $" ;
    mkg:reason "An equilibrium constant of an elementary surface reaction, so it is a kinetic parameter rather than a run condition." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{B8}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/par/K_B9> a mkg:Parameter ;
    rdfs:label "K_{B9} (seidel_2018 eq 9)"@en ;
    mkg:basis "stated" ;
    mkg:description "Equilibrium constant for the elementary step converting hydroxyl to water on the surface." ;
    mkg:dimension "dimensionless" ;
    mkg:page "3" ;
    mkg:quote "Elementary step: $ \\text{H} \\otimes + \\text{OH} * \\neq = \\text{H}_2\\text{O} * + \\otimes $ | Quasi-equilibrium/velocity: $ \\theta_{\\text{OH}}^{*} = K_{B9}^{-1} \\theta_{\\text{H}_2\\text{O}}^{*} \\theta^\\otimes \\theta_H^\\otimes^{-1} $" ;
    mkg:reason "An equilibrium constant of an elementary surface reaction, so it is a kinetic parameter rather than a run condition." ;
    mkg:siFactor 1e+00 ;
    mkg:status "accepted" ;
    mkg:symbol "K_{B9}" ;
    mkg:unit "dimensionless" ;
    mkg:unitString "-" .

<http://example.org/kg/seidel_2018_detailed_kinetic_model/law/seidel_2018_eq9/par/K_CH_3OH_star> a mkg:Parameter ;
    rdfs:label "K_{CH_3OH}^{*} (seidel_2018 eq 9)"@en ;
    mkg:basis "inferred" ;
    mkg:description "Adsorption equilibrium constant for methanol on reduced surface centers." ;
    mkg:dimension "[length] * [time] ** 2 / [mass]" ;
    mkg:estimation "estimated" ;
