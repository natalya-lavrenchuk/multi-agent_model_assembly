<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq13_meta> a mkg:Metadata ;
    mkg:basis "stated" ;
    mkg:correctionQuote "The mass balances for lactate and ammonia are" ;
    mkg:correctionReason "The right-hand side is an amount rate, so the mass-balance left-hand side should differentiate the amount V[LAC]." ;
    mkg:correctionStatus "accepted" ;
    mkg:description "The extracellular lactate balance accounts for cellular production and removal through the outlet." ;
    mkg:doi "10.1016/j.compchemeng.2010.03.012" ;
    mkg:form "ODE" ;
    mkg:hasAssumption [ mkg:quote "The maximum total volume of feed was fixed at 8.75 mL, which represents less than 5% of the total culture volume (200 mL), so as to avoid dilution effects." ;
            mkg:reasoned false ;
            mkg:severity "blocking" ;
            mkg:text "Feed volume was kept small relative to culture volume to avoid dilution effects." ] ;
    mkg:page "7" ;
    mkg:possibleMisprint "The right-hand terms have units of amount per time, whereas d([LAC])/dt has units of concentration per time; the balance is missing division by V, or the left-hand side should be the derivative of V[LAC]." ;
    mkg:quote "\\frac{d([L A C])}{d t}=Q_{l a c}V X_{\\nu}-F_{o u t}[L A C]" ;
    mkg:reviewOutcome "paper misprint" ;
    mkg:status "pending" .

<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq14> a mkg:Law ;
    rdfs:label "kontoravdi_2010 eq 14"@en ;
    mkg:computes <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq14/var/Q_lac> ;
    mkg:equationNumber "14" ;
    mkg:hasMetadata <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq14_meta> ;
    mkg:hasParameter <http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq14/par/Y_lac_glc> ;
    mkg:latex "Q_{l a c}=Y_{l a c,g l c}Q_{g l c}" ;
