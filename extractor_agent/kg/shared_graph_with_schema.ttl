    mkg:quote "\\mathbf{\\upmu}=\\mathbf{\\upmu}_\\mathrm{max}[\\mathbf{\\upS}]*/(\\mathbf{K}+[\\mathbf{\\upS}]*);\\mathrm{~with~}[\\mathbf{\\upS}]*=[\\mathbf{\\upS}]_\\mathrm{o}-[\\mathbf{\\upS}]_\\mathrm{t}" ;
    mkg:reviewOutcome "reading corrected" ;
    mkg:status "pending" .

<http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq4> a mkg:Law ;
    rdfs:label "lopezmeza_2016 eq 4"@en ;
    mkg:computes <http://example.org/kg/lopezmeza_2016/law/lopezmeza_2016_eq4/var/r_s> ;
