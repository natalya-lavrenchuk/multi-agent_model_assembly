        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq23/var/p_CO_2>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_steady_state/law/seidel_2018_eq23/var/p_H_2>,
