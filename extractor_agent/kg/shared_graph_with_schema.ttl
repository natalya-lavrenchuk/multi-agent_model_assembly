    mkg:computes <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-16/var/Theta_star> ;
    mkg:equationNumber "C-16" ;
    mkg:hasMetadata <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-16_meta> ;
    mkg:hasParameter <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-16/par/K_CH_3OH_star>,
        <http://example.org/kg/seidel_2018_simplified_kinetic_model_dynamic/law/seidel_2018_eqC-16/par/K_CO_2_star>,
