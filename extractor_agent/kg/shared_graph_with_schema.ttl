<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq11/par/Y_x_gln> a mkg:Parameter ;
    rdfs:label "Y_{x,gln} (kontoravdi_2010 eq 11)"@en ;
    mkg:basis "stated" ;
    mkg:description "Yield of cells on glutamine." ;
    mkg:dimension "[cell] / [substance]" ;
    mkg:estimation "estimated" ;
    mkg:estimationQuote "Table 2 Parameter estimation results for fed-batch culture." ;
    mkg:page "3" ;
    mkg:quote "the yield of cells on glutamine" ;
    mkg:reason "A cell-yield coefficient in the nutrient-dependent growth law, treated as a fitted model parameter." ;
    mkg:siFactor 1e+03 ;
    mkg:status "accepted" ;
    mkg:symbol "Y_{x,gln}" ;
    mkg:unit "cells / mmol" ;
    mkg:unitString "cell/mmol" ;
    mkg:valueUncertainty "2.546 × 10^7 (95% confidence interval; fed-batch)" ;
    mkg:valuesByCase "{\"batch operation\": \"5.6 × 10^8 cell/mmol\", \"fed-batch operation\": \"8 × 10^8 cell/mmol\"}" .

<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq11/var/m_gln> a mkg:Variable ;
    rdfs:label "m_{gln} (kontoravdi_2010 eq 11)"@en ;
    mkg:description "Glutamine maintenance coefficient." ;
    mkg:dimension "[substance] / [cell] / [time]" ;
    mkg:siFactor 2.777778e-07 ;
    mkg:symbol "m_{gln}" ;
    mkg:unit "mmol / cells / h" ;
    mkg:unitString "mmol cell^-1 h^-1" .

<http://example.org/kg/kontoravdi_2010/law/kontoravdi_2010_eq12/par/alpha_1> a mkg:Parameter ;
