<http://example.org/kg/anane_2017/law/eq15> a mkg:Law ;
    rdfs:label "eq 15" ;
    mkg:computes <http://example.org/kg/anane_2017/law/eq15/var/q_s> ;
    mkg:equationNumber "15" ;
    mkg:hasMetadata <http://example.org/kg/anane_2017/law/eq15/meta> ;
    mkg:hasParameter <http://example.org/kg/anane_2017/law/eq15/par/K_ia>,
        <http://example.org/kg/anane_2017/law/eq15/par/K_s>,
        <http://example.org/kg/anane_2017/law/eq15/par/q_smax> ;
    mkg:latex "q_{s}=\\frac{q_{s max}}{1+\\frac{A}{K_{ia}}}\\cdot\\frac{S}{S+K_{s}}" ;
    mkg:uses <http://example.org/kg/anane_2017/law/eq15/var/A>,
        <http://example.org/kg/anane_2017/law/eq15/var/S> .

