    mkg:page "2" ;
    mkg:quote "$ \\alpha_{1} $,  $ \\alpha_{2} $ constants of glutamine maintenance coefficient (mM L/cell/h and mM, respectively)" ;
    mkg:reason "Same reasoning as α_{1}; presented as a constant of the maintenance term and listed with a numeric value, implying it is a model parameter to be estimated." ;
    mkg:status "accepted" ;
    mkg:symbol "\\alpha_{2}" .

