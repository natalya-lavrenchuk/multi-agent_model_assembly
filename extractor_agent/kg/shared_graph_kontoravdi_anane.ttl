<http://example.org/kg/anane_2017/law/eq12> a mkg:Law ;
    rdfs:label "eq 12" ;
    mkg:computes <http://example.org/kg/anane_2017/law/eq12/var/X> ;
    mkg:equationNumber "12" ;
    mkg:hasMetadata <http://example.org/kg/anane_2017/law/eq12/meta> ;
    mkg:latex "\\frac{dX}{dt}=\\frac{F}{V}\\left(0-X\\right)+\\mu X" ;
    mkg:uses <http://example.org/kg/anane_2017/law/eq12/var/F>,
        <http://example.org/kg/anane_2017/law/eq12/var/V>,
        <http://example.org/kg/anane_2017/law/eq12/var/mu> .

<http://example.org/kg/anane_2017/law/eq12/meta> a mkg:Metadata ;
    mkg:doi "10.1016/j.bej.2017.05.013" ;
    mkg:form "ODE" ;
    mkg:page "4" ;
    mkg:quote "\\frac{dX}{dt}=\\frac{F}{V}\\left(0-X\\right)+\\mu X" ;
    mkg:status "pending" .

<http://example.org/kg/anane_2017/law/eq12/var/F> a mkg:Variable ;
    rdfs:label "F (eq 12)" ;
    mkg:basis "stated" ;
    mkg:page "4" ;
    mkg:quote "the feed F (which can be constant or a function of time)" ;
    mkg:reason "Feed flow rate is supplied or manipulated during the run." ;
    mkg:status "accepted" ;
    mkg:symbol "F" .

<http://example.org/kg/anane_2017/law/eq12/var/V> a mkg:Variable ;
    rdfs:label "V (eq 12)" ;
    mkg:basis "stated" ;
    mkg:page "3" ;
    mkg:quote "Using the biomass concentration (X, g/L) and broth volume (V, L) at the end of the batch phase, the exponential feed rate (F, L/h) was calculated as" ;
    mkg:reason "V is the reactor broth volume, which changes during a run and is supplied/updated externally." ;
    mkg:status "accepted" ;
    mkg:symbol "V" .

<http://example.org/kg/anane_2017/law/eq12/var/X> a mkg:Variable ;
    rdfs:label "X (eq 12)" ;
    mkg:symbol "X" .

<http://example.org/kg/anane_2017/law/eq12/var/mu> a mkg:Variable ;
    rdfs:label "\\mu (eq 12)" ;
    mkg:symbol "\\mu" .

<http://example.org/kg/anane_2017/law/eq13> a mkg:Law ;
    rdfs:label "eq 13" ;
    mkg:computes <http://example.org/kg/anane_2017/law/eq13/var/mu> ;
    mkg:equationNumber "13" ;
    mkg:hasMetadata <http://example.org/kg/anane_2017/law/eq13/meta> ;
    mkg:hasParameter <http://example.org/kg/anane_2017/law/eq13/par/Y_em>,
        <http://example.org/kg/anane_2017/law/eq13/par/Y_xa>,
        <http://example.org/kg/anane_2017/law/eq13/par/Y_xsof>,
        <http://example.org/kg/anane_2017/law/eq13/par/q_m> ;
    mkg:latex "\\mu=\\left(q_{s o x}-q_{m}\\right)Y_{e m}+q_{s o f}Y_{x s o f}+q_{s A}Y_{x a}" ;
    mkg:uses <http://example.org/kg/anane_2017/law/eq13/var/q_sA>,
        <http://example.org/kg/anane_2017/law/eq13/var/q_sof>,
        <http://example.org/kg/anane_2017/law/eq13/var/q_sox> .

<http://example.org/kg/anane_2017/law/eq13/meta> a mkg:Metadata ;
    mkg:doi "10.1016/j.bej.2017.05.013" ;
    mkg:form "algebraic" ;
    mkg:page "4" ;
    mkg:quote "\\mu=\\left(q_{s o x}-q_{m}\\right)Y_{e m}+q_{s o f}Y_{x s o f}+q_{s A}Y_{x a}" ;
    mkg:status "pending" .

<http://example.org/kg/anane_2017/law/eq13/par/Y_em> a mkg:Parameter ;
    rdfs:label "Y_{em} (eq 13)" ;
    mkg:basis "stated" ;
    mkg:page "5" ;
    mkg:quote "Parameter  $ ^{{a}} $: $ Y_{{em}} $ | Units: gg $ ^{-1} $ | Initial guess (literature) $ ^{{b}} $: 0.50 | Estimate: 0.5333" ;
    mkg:reason "Y_em is listed in the parameter table with an estimate, so it is an estimable parameter." ;
    mkg:status "accepted" ;
    mkg:symbol "Y_{em}" .

<http://example.org/kg/anane_2017/law/eq13/par/Y_xa> a mkg:Parameter ;
    rdfs:label "Y_{xa} (eq 13)" ;
    mkg:basis "inferred" ;
    mkg:reason "The table explicitly lists Y_{xa} as a parameter with an estimated value, indicating it is fitted to data. [quote not found in the paper]" ;
    mkg:status "pending" ;
    mkg:symbol "Y_{xa}" .

<http://example.org/kg/anane_2017/law/eq13/par/Y_xsof> a mkg:Parameter ;
    rdfs:label "Y_{xsof} (eq 13)" ;
    mkg:basis "inferred" ;
    mkg:reason "The table identifies Y_{xsof} as a parameter and provides an estimate, showing it is an estimable kinetic yield. [quote not found in the paper]" ;
    mkg:status "pending" ;
    mkg:symbol "Y_{xsof}" .

