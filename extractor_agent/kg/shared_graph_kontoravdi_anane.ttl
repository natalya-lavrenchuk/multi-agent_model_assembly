    rdfs:label "\\alpha_{1} (eq 12)" ;
    mkg:basis "stated" ;
    mkg:page "2" ;
    mkg:quote "$ \\alpha_{1} $,  $ \\alpha_{2} $ constants of glutamine maintenance coefficient (mM L/cell/h and mM, respectively)" ;
    mkg:reason "Explicitly described as a constant of the glutamine maintenance coefficient; values are provided in a table, indicating they are parameters to be fitted or taken from prior work. Since the paper does not state they are fixed from literature, they are treated as estimable." ;
    mkg:status "accepted" ;
    mkg:symbol "\\alpha_{1}" .

<http://example.org/kg/kontoravdi_2005/law/eq12/par/alpha_2> a mkg:Parameter ;
    rdfs:label "\\alpha_{2} (eq 12)" ;
